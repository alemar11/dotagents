#!/usr/bin/env python3
"""Stateless structural validator for the SE Contract Repair boundary."""

from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path
from typing import Any


REQUEST_KEYS = {
    "repair_id", "source_spec_ref", "originating_issue_refs", "known_issue_refs",
    "conflicting_clauses", "reason", "contract_evidence_refs",
    "repository_evidence_refs", "test_evidence_refs", "runtime_evidence_refs",
}
RESULT_KEYS = {
    "repair_id", "repair_outcome", "source_spec_ref", "changed_artifact_refs",
    "created_artifact_refs", "superseded_artifact_refs", "audit_ref",
    "readback_refs", "completed_operations", "missing_operations", "blocker",
}
AUDIT_KEYS = REQUEST_KEYS | {
    "changed_artifact_refs", "created_artifact_refs", "superseded_artifact_refs",
    "executor_owned_preserved_refs", "readback_refs", "completed_operations",
    "missing_operations",
}
RUNTIME_KEYS = {
    "run_id", "root_task_id", "task_id", "thread_id", "worker_id", "host_id",
    "project_id", "operation_id", "assignment_id", "worktree", "checkout_path",
    "claim_id", "generation", "contract_generation", "bootstrap_id",
}
UUID_RE = re.compile(
    r"^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-"
    r"[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
)


def exact_object(value: object, keys: set[str], label: str) -> dict[str, Any]:
    if not isinstance(value, dict) or set(value) != keys:
        raise ValueError(f"{label} keys are not exact")
    return value


def strings(value: object, label: str, *, allow_empty: bool = False) -> list[str]:
    if not isinstance(value, list) or (not value and not allow_empty):
        raise ValueError(f"{label} must be a {'possibly empty' if allow_empty else 'nonempty'} list")
    if any(not isinstance(item, str) or not item.strip() for item in value):
        raise ValueError(f"{label} must contain nonempty strings")
    if len(value) != len(set(value)):
        raise ValueError(f"{label} must not contain duplicates")
    return value


def reject_runtime_identity(value: object, label: str) -> None:
    if isinstance(value, dict):
        forbidden = set(value) & RUNTIME_KEYS
        if forbidden:
            raise ValueError(f"{label} contains runtime identity: {sorted(forbidden)}")
        for key, child in value.items():
            reject_runtime_identity(child, f"{label}.{key}")
    elif isinstance(value, list):
        for index, child in enumerate(value):
            reject_runtime_identity(child, f"{label}[{index}]")


def artifact_map(value: object, label: str) -> dict[str, dict[str, Any]]:
    if not isinstance(value, list):
        raise ValueError(f"{label} must be a list")
    result: dict[str, dict[str, Any]] = {}
    for index, item in enumerate(value):
        artifact = exact_object(item, {"ref", "kind", "stable", "executor_owned"}, f"{label}[{index}]")
        ref = artifact["ref"]
        if not isinstance(ref, str) or not ref or ref in result:
            raise ValueError(f"{label} refs must be unique nonempty strings")
        if artifact["kind"] not in {"spec", "issue"}:
            raise ValueError(f"{label}[{index}].kind is invalid")
        if not isinstance(artifact["stable"], dict) or not isinstance(artifact["executor_owned"], dict):
            raise ValueError(f"{label}[{index}] content must be objects")
        result[ref] = artifact
    return result


def validate(payload: object) -> dict[str, Any]:
    envelope = exact_object(payload, {"request", "before", "after", "result", "audit"}, "envelope")
    request = exact_object(envelope["request"], REQUEST_KEYS, "contract_repair_request")
    result = exact_object(envelope["result"], RESULT_KEYS, "contract_repair_result")
    audit = exact_object(envelope["audit"], AUDIT_KEYS, "contract_repair_audit")
    reject_runtime_identity(envelope, "contract repair envelope")

    if not UUID_RE.fullmatch(str(request["repair_id"])):
        raise ValueError("repair_id must be a canonical lowercase UUID")
    for field in ("source_spec_ref", "reason"):
        if not isinstance(request[field], str) or not request[field].strip():
            raise ValueError(f"{field} must be nonempty")
    for field in ("originating_issue_refs", "conflicting_clauses", "contract_evidence_refs"):
        strings(request[field], field)
    strings(request["known_issue_refs"], "known_issue_refs", allow_empty=True)
    evidence_fields = ("repository_evidence_refs", "test_evidence_refs", "runtime_evidence_refs")
    for field in evidence_fields:
        strings(request[field], field, allow_empty=True)
    if not any(request[field] for field in evidence_fields):
        raise ValueError("at least one repository, test, or runtime evidence ref is required")

    before = artifact_map(envelope["before"], "before")
    after = artifact_map(envelope["after"], "after")
    preserved = []
    for ref in before.keys() & after.keys():
        if before[ref]["executor_owned"] != after[ref]["executor_owned"]:
            raise ValueError(f"executor-owned content changed for {ref}")
        preserved.append(ref)

    outcome = result["repair_outcome"]
    if outcome not in {"applied", "proposed", "no-op", "blocked"}:
        raise ValueError("repair_outcome is invalid")
    if result["repair_id"] != request["repair_id"] or result["source_spec_ref"] != request["source_spec_ref"]:
        raise ValueError("result identity does not match request")
    for field in (
        "changed_artifact_refs", "created_artifact_refs", "superseded_artifact_refs",
        "readback_refs", "completed_operations", "missing_operations",
    ):
        strings(result[field], f"result.{field}", allow_empty=True)
    if result["audit_ref"] is not None and (not isinstance(result["audit_ref"], str) or not result["audit_ref"]):
        raise ValueError("audit_ref must be null or a nonempty string")
    if result["blocker"] is not None and (not isinstance(result["blocker"], str) or not result["blocker"]):
        raise ValueError("blocker must be null or a nonempty string")
    if outcome in {"applied", "no-op"}:
        if result["missing_operations"] or result["blocker"] is not None or not result["readback_refs"]:
            raise ValueError("resumable outcomes require complete readback and no remainder")
    if outcome == "proposed" and result["completed_operations"]:
        raise ValueError("proposed result must not contain durable completed operations")
    if outcome == "blocked" and result["blocker"] is None:
        raise ValueError("blocked result requires a blocker")

    expected_audit = {key: request[key] for key in REQUEST_KEYS}
    expected_audit.update({key: result[key] for key in (
        "changed_artifact_refs", "created_artifact_refs", "superseded_artifact_refs",
        "readback_refs", "completed_operations", "missing_operations",
    )})
    expected_audit["executor_owned_preserved_refs"] = sorted(preserved)
    if audit != expected_audit:
        raise ValueError("audit is inconsistent with request, result, or preservation readback")

    actual_created = sorted(after.keys() - before.keys())
    actual_superseded = sorted(before.keys() - after.keys())
    actual_changed = sorted(
        ref for ref in before.keys() & after.keys() if before[ref]["stable"] != after[ref]["stable"]
    )
    if result["created_artifact_refs"] != actual_created:
        raise ValueError("created refs do not match bundle readback")
    if result["superseded_artifact_refs"] != actual_superseded:
        raise ValueError("superseded refs do not match bundle readback")
    if result["changed_artifact_refs"] != actual_changed:
        raise ValueError("changed refs do not match bundle readback")
    return {"valid": True, "repair_id": request["repair_id"], "repair_outcome": outcome}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("input", type=Path)
    args = parser.parse_args()
    try:
        payload = json.loads(args.input.read_text(encoding="utf-8"))
        print(json.dumps(validate(payload), sort_keys=True))
        return 0
    except (OSError, json.JSONDecodeError, ValueError) as error:
        print(str(error), file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
