#!/usr/bin/env bash
set -euo pipefail

# Check policy references and template paths; maintainers review the policy prose.

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
plugin_root=$(cd -- "$script_dir/.." && pwd -P)
owner="$plugin_root/references/hosted-content-safety.md"

fail() {
  echo "hosted-content-safety: $1" >&2
  exit 1
}

test -s "$owner" || fail "missing or empty canonical owner"

# Resolve actual links to the policy owner; consumers may route indirectly.
python3 - "$plugin_root" "$owner" <<'PYLINKS'
import re
import sys
from pathlib import Path

root, owner = map(Path, sys.argv[1:])
for source in root.rglob("*.md"):
    for target in re.findall(r"\]\(([^)]+)\)", source.read_text(encoding="utf-8")):
        path = target.split("#", 1)[0]
        if Path(path).name == owner.name and "://" not in path:
            if (source.parent / path).resolve() != owner.resolve():
                raise SystemExit(f"hosted-content-safety: invalid policy link in {source.relative_to(root)}: {target}")
PYLINKS

hosted_templates=(
  "$plugin_root/skills/spec/templates/spec.md"
  "$plugin_root/skills/spec/templates/maintenance-changelog.md"
)

if rg -n -- '/Users/|/home/|/private/|[A-Za-z]:[\\/]' "${hosted_templates[@]}"; then
  fail "hosted template contains a machine-specific absolute path"
else
  scan_status=$?
  [[ "$scan_status" == 1 ]] || fail "could not inspect every hosted template"
fi

echo "hosted-content-safety: ok"
