#!/usr/bin/env sh

set -eu

PROJECT_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
PLUGIN_ROOT="$(CDPATH= cd -- "$PROJECT_ROOT/../.." && pwd)"
REPO_ROOT="$(CDPATH= cd -- "$PLUGIN_ROOT/../.." && pwd)"

cd "$PROJECT_ROOT"
python3 -m unittest discover -s tests -p 'test_*.py'
scripts/build-artifact

if ! codex plugin marketplace list --json | grep -q '"name": "alemar11"'; then
  echo "GitStack marketplace is not configured." >&2
  echo "Run: codex plugin marketplace add $REPO_ROOT" >&2
  exit 1
fi

codex plugin remove gitstack@alemar11 --json >/dev/null 2>&1 || true
codex plugin add gitstack@alemar11 --json
codex plugin list --json
