#!/usr/bin/env python3
from __future__ import annotations

import os
import re
import tempfile
import zipfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
PLUGIN = ROOT.parents[1]
SOURCE = ROOT / "src"
TARGET = PLUGIN / "scripts" / "g"

manifest = (ROOT / "pyproject.toml").read_text(encoding="utf-8")
match = re.search(r'^version = "([0-9]+\.[0-9]+\.[0-9]+)"$', manifest, re.MULTILINE)
if not match:
    raise SystemExit("pyproject.toml must declare a semver project version")
version = match.group(1)
init = (SOURCE / "g" / "__init__.py").read_text(encoding="utf-8")
if f'__version__ = "{version}"' not in init:
    raise SystemExit("g.__version__ does not match pyproject.toml")

TARGET.parent.mkdir(parents=True, exist_ok=True)
with tempfile.NamedTemporaryFile(prefix="g-build-", dir=TARGET.parent, delete=False) as handle:
    temporary = Path(handle.name)
    handle.write(b"#!/usr/bin/env python3\n")

try:
    with zipfile.ZipFile(temporary, "a", compression=zipfile.ZIP_DEFLATED, compresslevel=9) as archive:
        entries = [("__main__.py", b"from g.cli import main\nraise SystemExit(main())\n")]
        entries.extend(
            (path.relative_to(SOURCE).as_posix(), path.read_bytes())
            for path in sorted(SOURCE.rglob("*.py"))
            if "__pycache__" not in path.parts
        )
        for name, data in entries:
            info = zipfile.ZipInfo(name, date_time=(1980, 1, 1, 0, 0, 0))
            info.create_system = 3
            info.compress_type = zipfile.ZIP_DEFLATED
            info.external_attr = 0o644 << 16
            archive.writestr(info, data)
    os.chmod(temporary, 0o755)
    if not TARGET.exists() or temporary.read_bytes() != TARGET.read_bytes():
        os.replace(temporary, TARGET)
    else:
        temporary.unlink()
    os.chmod(TARGET, 0o755)
finally:
    if temporary.exists():
        temporary.unlink()
print(f"built {TARGET} ({version})")
