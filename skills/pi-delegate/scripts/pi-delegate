#!/usr/bin/env python3
"""Launch a fixed-model Pi coding session from the caller's project."""

from __future__ import annotations

import argparse
import json
import os
import queue
import re
import signal
import shutil
import subprocess
import sys
import threading
import time
import uuid
from dataclasses import dataclass, replace
from pathlib import Path
from typing import Any, Sequence


VERSION = "0.3.0"
MODEL_PROVIDER = "zai-coding-cn"
MODEL_ID = "glm-5.2"
MODEL_SELECTOR = f"{MODEL_PROVIDER}/{MODEL_ID}"
THINKING_LEVELS = ("off", "minimal", "low", "medium", "high", "xhigh", "max")
DEFAULT_THINKING_LEVEL = "medium"
DEFAULT_HEARTBEAT_SECONDS = 30
DEFAULT_TIMEOUT = "30m"
INSTALL_COMMAND = "npm install -g --ignore-scripts @earendil-works/pi-coding-agent"
SESSION_ID_PATTERN = re.compile(r"^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$")
TIMEOUT_PATTERN = re.compile(
    r"^(?:(?P<hours>\d+)h)?(?:(?P<minutes>\d+)m)?(?:(?P<seconds>\d+)s)?$"
)
CONTROLLER_SIGNALS = tuple(
    candidate
    for name in ("SIGTERM", "SIGINT", "SIGHUP")
    if (candidate := getattr(signal, name, None)) is not None
)
FORCE_KILL_SIGNAL = getattr(signal, "SIGKILL", signal.SIGTERM)


class CliError(Exception):
    """A stable command-line failure."""

    def __init__(self, code: str, message: str, *, exit_code: int = 2) -> None:
        super().__init__(message)
        self.code = code
        self.message = message
        self.exit_code = exit_code


@dataclass(frozen=True)
class StreamResult:
    return_code: int
    final_response: str | None
    status: str
    signal_name: str | None
    session_id: str | None
    suppressed_diagnostic_lines: int


def parse_timeout(value: str) -> int:
    match = TIMEOUT_PATTERN.fullmatch(value)
    if match is None or not any(match.groupdict().values()):
        raise argparse.ArgumentTypeError(
            "timeout must use whole-number h/m/s units such as 30m, 90s, or 1h30m"
        )
    seconds = (
        int(match.group("hours") or 0) * 3600
        + int(match.group("minutes") or 0) * 60
        + int(match.group("seconds") or 0)
    )
    if seconds <= 0:
        raise argparse.ArgumentTypeError("timeout must be greater than zero")
    return seconds


def emit(payload: dict[str, Any], *, as_json: bool) -> None:
    if as_json:
        print(json.dumps(payload, sort_keys=True))
        return

    if payload.get("command") == "doctor":
        readiness = "ready" if payload["ready"] else "not ready"
        print(f"pi-delegate {VERSION}: {readiness}")
        for check in payload["checks"]:
            marker = "ok" if check["ok"] else "error"
            print(f"- {check['name']}: {marker} ({check['detail']})")
        if payload.get("install_command"):
            print(f"Install Pi with: {payload['install_command']}")
        return

    if payload.get("ok"):
        print(payload["final_response"])
        return

    print(payload["error"]["message"], file=sys.stderr)


def run_process(args: Sequence[str], *, cwd: Path) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            list(args),
            cwd=str(cwd),
            text=True,
            capture_output=True,
            check=False,
        )
    except OSError as error:
        raise CliError("process_start_failed", str(error), exit_code=1) from error


def emit_progress(
    *,
    event: str,
    sequence: int,
    started_at: float,
    run_id: str,
    session_id: str | None,
    name: str,
    cwd: Path,
    thinking_level: str,
    detail: dict[str, Any] | None = None,
) -> None:
    payload: dict[str, Any] = {
        "schema_version": "1.0.0",
        "type": "progress",
        "event": event,
        "sequence": sequence,
        "elapsed_seconds": round(time.monotonic() - started_at, 3),
        "run_id": run_id,
        "session_id": session_id,
        "name": name,
        "project_root": str(cwd),
        "model": MODEL_SELECTOR,
        "thinking_level": thinking_level,
    }
    if detail:
        payload.update(detail)
    print(json.dumps(payload, sort_keys=True), file=sys.stderr, flush=True)


def assistant_text(message: Any) -> str | None:
    if not isinstance(message, dict) or message.get("role") != "assistant":
        return None

    content = message.get("content")
    if isinstance(content, str):
        return content.strip() or None
    if not isinstance(content, list):
        return None

    parts = [
        item.get("text", "")
        for item in content
        if isinstance(item, dict) and item.get("type") == "text"
    ]
    text = "".join(parts).strip()
    return text or None


def final_assistant_text(event: dict[str, Any]) -> str | None:
    if event.get("type") == "message_end":
        return assistant_text(event.get("message"))
    if event.get("type") != "agent_end":
        return None

    messages = event.get("messages")
    if not isinstance(messages, list):
        return None
    for message in reversed(messages):
        text = assistant_text(message)
        if text:
            return text
    return None


def progress_event(event: dict[str, Any]) -> tuple[str, dict[str, Any]] | None:
    event_type = event.get("type")
    if event_type == "session":
        return "session_ready", {}
    if event_type in {"agent_start", "turn_start", "turn_end", "agent_end"}:
        return event_type, {}
    if event_type in {"compaction_start", "compaction_end"}:
        detail = {"reason": event.get("reason")}
        if event_type == "compaction_end":
            detail["aborted"] = bool(event.get("aborted"))
        return event_type, detail
    if event_type == "auto_retry_start":
        return (
            "retry_started",
            {
                "attempt": event.get("attempt"),
                "max_attempts": event.get("maxAttempts"),
                "delay_ms": event.get("delayMs"),
            },
        )
    if event_type == "auto_retry_end":
        return (
            "retry_finished",
            {
                "attempt": event.get("attempt"),
                "success": bool(event.get("success")),
            },
        )
    if event_type == "tool_execution_start":
        return "tool_started", {"tool_name": event.get("toolName")}
    if event_type == "tool_execution_end":
        return (
            "tool_finished",
            {
                "tool_name": event.get("toolName"),
                "is_error": bool(event.get("isError")),
            },
        )
    return None


def send_process_tree_signal(process: subprocess.Popen[str], sig: signal.Signals) -> None:
    if os.name == "posix":
        try:
            os.killpg(process.pid, sig)
        except ProcessLookupError:
            pass
        return

    if os.name == "nt":
        command = ["taskkill", "/pid", str(process.pid), "/t"]
        if sig == FORCE_KILL_SIGNAL:
            command.append("/f")
        subprocess.run(
            command,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        return

    try:
        process.send_signal(sig)
    except ProcessLookupError:
        pass


def terminate_process_tree(
    process: subprocess.Popen[str],
    *,
    grace_seconds: float = 5,
) -> None:
    send_process_tree_signal(process, signal.SIGTERM)
    try:
        process.wait(timeout=grace_seconds)
    except subprocess.TimeoutExpired:
        pass
    send_process_tree_signal(process, FORCE_KILL_SIGNAL)
    try:
        process.wait(timeout=1)
    except subprocess.TimeoutExpired:
        pass


def signal_name(return_code: int) -> str | None:
    if return_code >= 0 or os.name != "posix":
        return None
    try:
        return signal.Signals(-return_code).name
    except ValueError:
        return f"SIGNAL_{-return_code}"


def stream_pi(
    command: Sequence[str],
    *,
    task: str,
    cwd: Path,
    progress: bool,
    heartbeat_seconds: int,
    timeout_seconds: int,
    run_id: str,
    session_id: str | None,
    name: str,
    thinking_level: str,
) -> StreamResult:
    popen_options: dict[str, Any] = {}
    if os.name == "posix":
        popen_options["start_new_session"] = True
    elif os.name == "nt":
        popen_options["creationflags"] = subprocess.CREATE_NEW_PROCESS_GROUP

    try:
        process = subprocess.Popen(
            list(command),
            cwd=str(cwd),
            text=True,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            bufsize=1,
            **popen_options,
        )
    except OSError as error:
        raise CliError("process_start_failed", str(error), exit_code=1) from error

    assert process.stdin is not None
    assert process.stdout is not None
    assert process.stderr is not None
    lines: queue.Queue[str | None] = queue.Queue()
    diagnostic_lines = 0

    def read_stdout() -> None:
        try:
            for line in process.stdout:
                lines.put(line)
        finally:
            lines.put(None)

    reader = threading.Thread(target=read_stdout, daemon=True)
    reader.start()

    def drain_stderr() -> None:
        nonlocal diagnostic_lines
        for _line in process.stderr:
            diagnostic_lines += 1

    stderr_reader = threading.Thread(target=drain_stderr, daemon=True)
    stderr_reader.start()

    started_at = time.monotonic()
    deadline = started_at + timeout_seconds
    next_heartbeat = started_at + heartbeat_seconds
    sequence = 0
    last_event_type = "process_started"
    final_response: str | None = None
    saw_agent_end = False
    active_session_id = session_id
    abort_signal: signal.Signals | None = None
    previous_handlers: dict[signal.Signals, Any] = {}

    def request_abort(received: int, _frame: Any) -> None:
        nonlocal abort_signal
        abort_signal = signal.Signals(received)

    for handled_signal in CONTROLLER_SIGNALS:
        previous_handlers[handled_signal] = signal.getsignal(handled_signal)
        signal.signal(handled_signal, request_abort)

    try:
        process.stdin.write(task)
        process.stdin.close()
    except BrokenPipeError:
        pass
    except OSError as error:
        terminate_process_tree(process)
        for handled_signal, previous_handler in previous_handlers.items():
            signal.signal(handled_signal, previous_handler)
        raise CliError(
            "process_start_failed",
            f"Could not send the task to Pi: {error}.",
            exit_code=1,
        ) from error

    if progress:
        sequence += 1
        emit_progress(
            event="process_started",
            sequence=sequence,
            started_at=started_at,
            run_id=run_id,
            session_id=active_session_id,
            name=name,
            cwd=cwd,
            thinking_level=thinking_level,
            detail={"timeout_seconds": timeout_seconds},
        )

    try:
        while True:
            now = time.monotonic()
            if abort_signal is not None:
                terminate_process_tree(process)
                return_code = 128 + int(abort_signal)
                result = StreamResult(
                    return_code=return_code,
                    final_response=final_response,
                    status="aborted",
                    signal_name=abort_signal.name,
                    session_id=active_session_id,
                    suppressed_diagnostic_lines=diagnostic_lines,
                )
                break
            if now >= deadline:
                terminate_process_tree(process)
                result = StreamResult(
                    return_code=124,
                    final_response=final_response,
                    status="timeout",
                    signal_name=signal.SIGTERM.name,
                    session_id=active_session_id,
                    suppressed_diagnostic_lines=diagnostic_lines,
                )
                break

            wait_seconds = min(1.0, deadline - now, max(0.0, next_heartbeat - now))
            try:
                line = lines.get(timeout=wait_seconds)
            except queue.Empty:
                now = time.monotonic()
                if progress and now >= next_heartbeat:
                    sequence += 1
                    emit_progress(
                        event="heartbeat",
                        sequence=sequence,
                        started_at=started_at,
                        run_id=run_id,
                        session_id=active_session_id,
                        name=name,
                        cwd=cwd,
                        thinking_level=thinking_level,
                        detail={"last_event": last_event_type},
                    )
                    next_heartbeat = now + heartbeat_seconds
                continue

            if line is None:
                return_code = process.wait()
                observed_signal = signal_name(return_code)
                status = "completed" if return_code == 0 else "failed"
                result = StreamResult(
                    return_code=return_code,
                    final_response=final_response,
                    status=status,
                    signal_name=observed_signal,
                    session_id=active_session_id,
                    suppressed_diagnostic_lines=diagnostic_lines,
                )
                break

            try:
                event = json.loads(line)
            except json.JSONDecodeError as error:
                terminate_process_tree(process)
                raise CliError(
                    "pi_protocol_error",
                    f"Pi emitted invalid JSON event data: {error.msg}.",
                    exit_code=1,
                ) from error
            if not isinstance(event, dict) or not isinstance(event.get("type"), str):
                terminate_process_tree(process)
                raise CliError(
                    "pi_protocol_error",
                    "Pi emitted a JSON event without a valid type.",
                    exit_code=1,
                )

            last_event_type = event["type"]
            if event["type"] == "session" and isinstance(event.get("id"), str):
                active_session_id = event["id"]
            candidate = final_assistant_text(event)
            if candidate:
                final_response = candidate
            if event["type"] == "agent_end":
                saw_agent_end = True

            public_event = progress_event(event)
            if progress and public_event is not None:
                event_name, detail = public_event
                sequence += 1
                emit_progress(
                    event=event_name,
                    sequence=sequence,
                    started_at=started_at,
                    run_id=run_id,
                    session_id=active_session_id,
                    name=name,
                    cwd=cwd,
                    thinking_level=thinking_level,
                    detail=detail,
                )
    finally:
        for handled_signal, previous_handler in previous_handlers.items():
            signal.signal(handled_signal, previous_handler)

    reader.join(timeout=1)
    stderr_reader.join(timeout=1)
    result = replace(
        result,
        suppressed_diagnostic_lines=diagnostic_lines,
    )

    protocol_error: str | None = None
    if result.status == "completed" and not saw_agent_end:
        protocol_error = "Pi exited successfully without an agent_end event."
    elif result.status == "completed" and not final_response:
        protocol_error = "Pi completed without a final assistant response."

    if progress:
        sequence += 1
        emit_progress(
            event="process_finished",
            sequence=sequence,
            started_at=started_at,
            run_id=run_id,
            session_id=result.session_id,
            name=name,
            cwd=cwd,
            thinking_level=thinking_level,
            detail={
                "status": "failed" if protocol_error else result.status,
                "exit_code": result.return_code,
                "signal": result.signal_name,
                "suppressed_diagnostic_lines": result.suppressed_diagnostic_lines,
                **({"error_code": "pi_protocol_error"} if protocol_error else {}),
            },
        )

    if protocol_error:
        raise CliError(
            "pi_protocol_error",
            protocol_error,
            exit_code=1,
        )
    return result


def find_exact_model(output: str) -> bool:
    for line in output.splitlines():
        fields = line.split()
        if len(fields) >= 2 and fields[0] == MODEL_PROVIDER and fields[1] == MODEL_ID:
            return True
    return False


def collect_doctor(*, cwd: Path) -> dict[str, Any]:
    checks: list[dict[str, Any]] = []

    python_path = shutil.which("python3")
    checks.append(
        {
            "name": "python3",
            "ok": python_path is not None,
            "detail": python_path or "not found on PATH",
        }
    )

    pi_path = shutil.which("pi")
    checks.append(
        {
            "name": "pi",
            "ok": pi_path is not None,
            "detail": pi_path or "not found on PATH",
        }
    )

    pi_version: str | None = None
    model_available = False
    if pi_path is not None:
        version_result = run_process([pi_path, "--version"], cwd=cwd)
        pi_version = version_result.stdout.strip() if version_result.returncode == 0 else None
        checks.append(
            {
                "name": "pi_version",
                "ok": pi_version is not None,
                "detail": pi_version or "unable to read Pi version",
            }
        )

        models_result = run_process(
            [pi_path, "--offline", "--list-models", MODEL_ID],
            cwd=cwd,
        )
        model_available = models_result.returncode == 0 and find_exact_model(models_result.stdout)
        model_detail = MODEL_SELECTOR if model_available else f"{MODEL_SELECTOR} is unavailable"
        if models_result.returncode != 0:
            model_detail = "Pi could not read its offline model catalog"
        checks.append(
            {
                "name": "model",
                "ok": model_available,
                "detail": model_detail,
            }
        )

    ready = all(check["ok"] for check in checks)
    payload: dict[str, Any] = {
        "schema_version": "1.0.0",
        "command": "doctor",
        "ready": ready,
        "version": VERSION,
        "project_root": str(cwd),
        "model": MODEL_SELECTOR,
        "pi_version": pi_version,
        "checks": checks,
    }
    if pi_path is None:
        payload["install_command"] = INSTALL_COMMAND
    if pi_path is not None and not model_available:
        payload["setup_hint"] = (
            "Configure the ZAI Coding Plan China provider in Pi; "
            "the launcher will not fall back to another model."
        )
    return payload


def validate_session_id(value: str) -> str:
    if not SESSION_ID_PATTERN.fullmatch(value):
        raise argparse.ArgumentTypeError(
            "session ID must contain only alphanumeric characters, '-', '_', and '.', "
            "and start and end with an alphanumeric character"
        )
    return value


def resolve_task(args: argparse.Namespace) -> str:
    if args.task is not None and args.task_file is not None:
        raise CliError(
            "ambiguous_task",
            "Provide exactly one of a task argument, --task-file, or stdin.",
        )

    if args.task is not None:
        task = args.task
    elif args.task_file is not None:
        try:
            task = args.task_file.read_text(encoding="utf-8")
        except OSError as error:
            raise CliError("task_file_error", str(error)) from error
    else:
        if sys.stdin.isatty():
            raise CliError(
                "missing_task",
                "Provide a task argument, --task-file, or task text on stdin.",
            )
        task = sys.stdin.read()

    task = task.strip()
    if not task:
        raise CliError("empty_task", "The delegated task must not be empty.")
    return task


def run_delegation(args: argparse.Namespace, *, cwd: Path) -> tuple[dict[str, Any], int]:
    doctor = collect_doctor(cwd=cwd)
    if not doctor["ready"]:
        return (
            {
                "schema_version": "1.0.0",
                "command": "run",
                "ok": False,
                "error": {
                    "code": "preflight_failed",
                    "message": "Pi preflight failed. Run --json doctor for details.",
                },
                "doctor": doctor,
            },
            1,
        )

    task = resolve_task(args)
    run_id = f"codex-pi-run-{uuid.uuid4().hex}"
    session_id = args.session_id
    if session_id is None and not args.resume_last:
        session_id = f"codex-pi-{uuid.uuid4().hex}"
    pi_path = next(
        check["detail"] for check in doctor["checks"] if check["name"] == "pi"
    )
    command = [
        pi_path,
        "--mode",
        "json",
        "--model",
        MODEL_SELECTOR,
        "--thinking",
        args.thinking_level,
        "--name",
        args.name,
        "--approve",
    ]
    if args.resume_last:
        command.append("--continue")
    else:
        command.extend(["--session-id", session_id])
    stream_result = stream_pi(
        command,
        task=task,
        cwd=cwd,
        progress=args.progress,
        heartbeat_seconds=args.heartbeat_seconds,
        timeout_seconds=args.timeout,
        run_id=run_id,
        session_id=session_id,
        name=args.name,
        thinking_level=args.thinking_level,
    )

    if stream_result.status != "completed":
        error_code = {
            "timeout": "pi_timeout",
            "aborted": "pi_aborted",
        }.get(stream_result.status, "pi_failed")
        if (
            stream_result.status == "failed"
            and stream_result.signal_name == "SIGKILL"
        ):
            error_code = "host_killed"
        message = {
            "pi_timeout": f"Pi did not finish within {args.timeout} seconds.",
            "pi_aborted": (
                f"Pi delegation was aborted by {stream_result.signal_name or 'a signal'}."
            ),
            "host_killed": "Pi was killed by SIGKILL; inspect host limits and the working tree.",
        }.get(
            error_code,
            f"Pi exited with status {stream_result.return_code}.",
        )
        return (
            {
                "schema_version": "1.0.0",
                "command": "run",
                "ok": False,
                "status": stream_result.status,
                "model": MODEL_SELECTOR,
                "thinking_level": args.thinking_level,
                "run_id": run_id,
                "session_id": stream_result.session_id,
                "project_root": str(cwd),
                "timeout_seconds": args.timeout,
                "signal": stream_result.signal_name,
                "suppressed_diagnostic_lines": (
                    stream_result.suppressed_diagnostic_lines
                ),
                "final_response": stream_result.final_response,
                "error": {
                    "code": error_code,
                    "message": message,
                    "exit_code": stream_result.return_code,
                },
            },
            1,
        )

    return (
        {
            "schema_version": "1.0.0",
            "command": "run",
            "ok": True,
            "status": "completed",
            "version": VERSION,
            "model": MODEL_SELECTOR,
            "thinking_level": args.thinking_level,
            "progress_enabled": args.progress,
            "run_id": run_id,
            "session_id": stream_result.session_id,
            "project_root": str(cwd),
            "timeout_seconds": args.timeout,
            "signal": None,
            "suppressed_diagnostic_lines": (
                stream_result.suppressed_diagnostic_lines
            ),
            "final_response": stream_result.final_response,
        },
        0,
    )


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="pi-delegate",
        description=(
            "Delegate one coding task to Pi in the current project with the fixed "
            f"{MODEL_SELECTOR} model."
        ),
        formatter_class=lambda prog: argparse.HelpFormatter(prog, width=120),
    )
    parser.add_argument("--version", action="version", version=f"pi-delegate {VERSION}")
    parser.add_argument(
        "--json",
        action="store_true",
        help="Emit one stable JSON object on stdout.",
    )

    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser(
        "doctor",
        help="Check Python, Pi, and fixed-model readiness without a model request.",
    )

    run_parser = subparsers.add_parser(
        "run",
        help="Launch or continue a persistent Pi coding session.",
    )
    run_parser.add_argument(
        "--thinking-level",
        choices=THINKING_LEVELS,
        default=DEFAULT_THINKING_LEVEL,
        help=f"Pi thinking level (default: {DEFAULT_THINKING_LEVEL}).",
    )
    session_group = run_parser.add_mutually_exclusive_group()
    session_group.add_argument(
        "--session-id",
        type=validate_session_id,
        help="Continue an exact project session; a new ID is generated when omitted.",
    )
    session_group.add_argument(
        "--resume-last",
        action="store_true",
        help="Continue Pi's most recent session for the current project.",
    )
    run_parser.add_argument(
        "--name",
        default="Codex Pi delegation",
        help="Human-readable Pi session name.",
    )
    run_parser.add_argument(
        "--progress",
        action="store_true",
        help="Stream sanitized JSONL progress records to stderr.",
    )
    run_parser.add_argument(
        "--heartbeat-seconds",
        type=int,
        choices=range(1, 301),
        default=DEFAULT_HEARTBEAT_SECONDS,
        metavar="SECONDS",
        help=(
            "Progress heartbeat interval from 1 to 300 seconds "
            f"(default: {DEFAULT_HEARTBEAT_SECONDS})."
        ),
    )
    run_parser.add_argument(
        "--timeout",
        type=parse_timeout,
        default=parse_timeout(DEFAULT_TIMEOUT),
        metavar="DURATION",
        help=f"Hard run timeout using h/m/s units (default: {DEFAULT_TIMEOUT}).",
    )
    run_parser.add_argument(
        "--task-file",
        type=Path,
        help="Read the delegated task from a UTF-8 file.",
    )
    run_parser.add_argument(
        "task",
        nargs="?",
        help="Delegated coding task. Use --task-file or stdin for long prompts.",
    )
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    cwd = Path.cwd().resolve()

    try:
        if args.command == "doctor":
            payload = collect_doctor(cwd=cwd)
            emit(payload, as_json=args.json)
            return 0 if payload["ready"] else 1

        payload, exit_code = run_delegation(args, cwd=cwd)
        emit(payload, as_json=args.json)
        return exit_code
    except CliError as error:
        payload = {
            "schema_version": "1.0.0",
            "command": args.command,
            "ok": False,
            "error": {"code": error.code, "message": error.message},
        }
        emit(payload, as_json=args.json)
        return error.exit_code


if __name__ == "__main__":
    sys.exit(main())
