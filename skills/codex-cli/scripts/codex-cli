#!/usr/bin/env python3
"""Launch one explicit, model-aware Codex CLI task."""

from __future__ import annotations

import argparse
import hashlib
import json
import math
import os
from pathlib import Path
import secrets
import shutil
import stat
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass
from typing import Any, Sequence


VERSION = "0.1.2"
EFFORT_ORDER = ("low", "medium", "high", "xhigh", "max", "ultra")
TASK_PROFILE_EFFORTS = {
    "routine": "low",
    "standard": "medium",
    "complex": "high",
    "risky": "xhigh",
    "critical": "max",
    "extreme": "ultra",
}
MODEL_TASK_PROFILE_EFFORTS = {
    "sol": TASK_PROFILE_EFFORTS,
    "terra": TASK_PROFILE_EFFORTS,
    "luna": {
        # Luna stays at max for ordinary and higher-stakes work. The routine
        # profile is the explicit automatic scale-back case.
        "routine": "low",
        "standard": "max",
        "complex": "max",
        "risky": "max",
        "critical": "max",
        "extreme": "ultra",
    },
}
DEFAULT_TASK_PROFILES = {
    "sol": "standard",
    "terra": "complex",
    "luna": "critical",
}
MODEL_PROFILES = {
    "sol": {
        "model_id": "gpt-5.6-sol",
        "reasoning_efforts": ("low", "medium", "high", "xhigh", "max", "ultra"),
        "default_reasoning_effort": "medium",
        "default_task_profile": "standard",
    },
    "terra": {
        "model_id": "gpt-5.6-terra",
        "reasoning_efforts": ("low", "medium", "high", "xhigh", "max", "ultra"),
        "default_reasoning_effort": "high",
        "default_task_profile": "complex",
    },
    "luna": {
        "model_id": "gpt-5.6-luna",
        "reasoning_efforts": ("low", "medium", "high", "xhigh", "max"),
        "default_reasoning_effort": "max",
        "default_task_profile": "critical",
    },
}


class CodexCliError(RuntimeError):
    """A user-actionable launcher error with a stable machine code."""

    def __init__(
        self,
        message: str,
        *,
        code: str = "codex-cli-error",
        json_output: bool = False,
    ) -> None:
        super().__init__(message)
        self.code = code
        self.json_output = json_output


@dataclass(frozen=True)
class ReasoningResolution:
    model: str
    model_id: str
    task_profile: str | None
    requested_reasoning_effort: str
    reasoning_effort: str
    reasoning_adjustment: str | None

    def as_dict(self) -> dict[str, Any]:
        return {
            "model": self.model,
            "model_id": self.model_id,
            "task_profile": self.task_profile,
            "requested_reasoning_effort": self.requested_reasoning_effort,
            "reasoning_effort": self.reasoning_effort,
            "reasoning_adjustment": self.reasoning_adjustment,
        }


@dataclass(frozen=True)
class Invocation:
    command: list[str]
    working_directory: Path
    resolution: ReasoningResolution


@dataclass
class PinnedOutput:
    path: Path
    parent: Path
    parent_fd: int
    parent_identity: tuple[int, int]
    existing_mode: int

    def close(self) -> None:
        if self.parent_fd < 0:
            return
        descriptor = self.parent_fd
        self.parent_fd = -1
        try:
            os.close(descriptor)
        except OSError:
            pass


def resolve_reasoning(
    model: str,
    task_profile: str | None,
    explicit_effort: str = "auto",
) -> ReasoningResolution:
    if model not in MODEL_PROFILES:
        raise CodexCliError(
            f"unsupported model alias: {model}",
            code="model-invalid",
        )
    direct_effort_override = explicit_effort != "auto" and task_profile is None
    if task_profile is None and not direct_effort_override:
        task_profile = DEFAULT_TASK_PROFILES[model]
    if task_profile is not None and task_profile not in TASK_PROFILE_EFFORTS:
        raise CodexCliError(
            f"unsupported task profile: {task_profile}",
            code="task-profile-invalid",
        )
    if explicit_effort not in {"auto", *EFFORT_ORDER}:
        raise CodexCliError(
            f"unsupported reasoning effort: {explicit_effort}",
            code="reasoning-effort-invalid",
        )

    profile = MODEL_PROFILES[model]
    supported = profile["reasoning_efforts"]
    if explicit_effort == "auto":
        assert task_profile is not None
        requested = MODEL_TASK_PROFILE_EFFORTS[model][task_profile]
        adjustment: str | None = None
        if requested not in supported:
            requested_index = EFFORT_ORDER.index(requested)
            supported_below = [
                effort
                for effort in supported
                if EFFORT_ORDER.index(effort) <= requested_index
            ]
            if not supported_below:
                raise CodexCliError(
                    f"model {model} has no compatible effort for task profile {task_profile}",
                    code="reasoning-effort-unavailable",
                )
            effective = supported_below[-1]
            adjustment = f"task-profile-{requested}-capped-at-{effective}"
        else:
            effective = requested
    else:
        requested = explicit_effort
        if requested not in supported:
            allowed = ", ".join(supported)
            raise CodexCliError(
                f"reasoning effort {requested} is not supported by {model}; allowed: {allowed}",
                code="reasoning-effort-unsupported",
            )
        effective = requested
        adjustment = None

    return ReasoningResolution(
        model=model,
        model_id=profile["model_id"],
        task_profile=task_profile,
        requested_reasoning_effort=requested,
        reasoning_effort=effective,
        reasoning_adjustment=adjustment,
    )


def resolve_executable(value: str) -> str:
    candidate = Path(value).expanduser()
    explicit_path = (
        candidate.is_absolute()
        or candidate.parent != Path(".")
        or os.sep in value
        or (os.altsep is not None and os.altsep in value)
    )
    if explicit_path:
        candidate = candidate.absolute()
        if candidate.is_symlink():
            raise CodexCliError(
                f"Codex executable must be a runnable regular non-symlink file: {candidate}",
                code="codex-executable-unavailable",
            )
        candidate = candidate.resolve(strict=False)
        if not candidate.is_file() or not os.access(candidate, os.X_OK):
            raise CodexCliError(
                f"Codex executable must be a runnable regular non-symlink file: {candidate}",
                code="codex-executable-unavailable",
            )
        return str(candidate)
    resolved = shutil.which(value)
    if resolved is None:
        raise CodexCliError(
            f"Codex executable was not found on PATH: {value}",
            code="codex-executable-unavailable",
        )
    resolved_path = Path(resolved).expanduser()
    if not resolved_path.is_absolute():
        resolved_path = (Path.cwd() / resolved_path).absolute()
    resolved_path = resolved_path.resolve(strict=False)
    if not resolved_path.is_file() or not os.access(resolved_path, os.X_OK):
        raise CodexCliError(
            f"Codex executable is not runnable: {resolved_path}",
            code="codex-executable-unavailable",
        )
    return str(resolved_path)


def resolve_working_directory(value: str) -> Path:
    directory = Path(value).expanduser().resolve()
    if not directory.is_dir():
        raise CodexCliError(
            f"working directory is not a directory: {directory}",
            code="working-directory-invalid",
        )
    return directory


def read_regular_utf8_file(raw_path: str, *, label: str) -> str:
    path = Path(raw_path).expanduser()
    if path.is_symlink() or not path.is_file():
        raise CodexCliError(
            f"{label} must be a regular non-symlink file: {path}",
            code=f"{label}-invalid",
        )
    descriptor: int | None = None
    try:
        flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
        descriptor = os.open(path, flags)
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode):
            raise CodexCliError(
                f"{label} must be a regular non-symlink file: {path}",
                code=f"{label}-invalid",
            )
        with os.fdopen(descriptor, "r", encoding="utf-8") as file_handle:
            descriptor = None
            return file_handle.read()
    except UnicodeDecodeError as exc:
        raise CodexCliError(
            f"{label} is not valid UTF-8: {path}",
            code=f"{label}-non-utf8",
        ) from exc
    except OSError as exc:
        raise CodexCliError(
            f"{label} could not be read: {path}: {exc}",
            code=f"{label}-unreadable",
        ) from exc
    finally:
        if descriptor is not None:
            os.close(descriptor)


def load_prompt(args: argparse.Namespace) -> str:
    sources = sum(
        value is not None
        for value in (args.prompt, args.prompt_file)
    )
    if sources > 1:
        raise CodexCliError(
            "choose exactly one of --prompt or --prompt-file",
            code="prompt-source-conflict",
        )
    if args.prompt is not None:
        prompt = args.prompt
    elif args.prompt_file is not None:
        prompt = read_regular_utf8_file(args.prompt_file, label="prompt-file")
    else:
        if sys.stdin.isatty():
            raise CodexCliError(
                "a complete prompt is required through --prompt, --prompt-file, or stdin",
                code="prompt-missing",
            )
        try:
            prompt = sys.stdin.read()
        except OSError as exc:
            raise CodexCliError(
                f"stdin prompt could not be read: {exc}",
                code="prompt-unreadable",
            ) from exc
    if not prompt.strip():
        raise CodexCliError("prompt must not be empty", code="prompt-empty")
    return prompt


def validate_schema_path(raw_path: str | None) -> str | None:
    if raw_path is None:
        return None
    path = Path(raw_path).expanduser()
    try:
        schema_text = read_regular_utf8_file(raw_path, label="output-schema")
        json.loads(schema_text)
    except (CodexCliError, json.JSONDecodeError) as exc:
        raise CodexCliError(
            f"output schema is not readable JSON: {path}",
            code="output-schema-invalid",
        ) from exc
    return str(path.resolve())


def validate_output_path(raw_path: str | None) -> Path | None:
    if raw_path is None:
        return None
    path = Path(raw_path).expanduser()
    if not path.is_absolute():
        path = Path.cwd() / path
    path = Path(os.path.normpath(str(path)))
    if path.is_symlink():
        raise CodexCliError(
            f"output path must not be a symlink: {path}",
            code="output-symlink",
        )
    if path.exists() and not path.is_file():
        raise CodexCliError(
            f"output path must be a regular file: {path}",
            code="output-invalid",
        )
    if not path.parent.is_dir():
        raise CodexCliError(
            f"output parent directory does not exist: {path.parent}",
            code="output-invalid",
        )
    # Resolve only parent aliases before pinning. Keep the final component
    # unchanged so the descriptor-relative lstat can reject a final symlink,
    # including one created after this initial validation.
    return path.parent.resolve(strict=False) / path.name


def _output_directory_flags() -> int:
    directory_flag = getattr(os, "O_DIRECTORY", 0)
    nofollow_flag = getattr(os, "O_NOFOLLOW", 0)
    if (
        os.name != "posix"
        or not directory_flag
        or not nofollow_flag
        or os.open not in os.supports_dir_fd
        or os.stat not in os.supports_dir_fd
        or os.unlink not in os.supports_dir_fd
        or os.rename not in os.supports_dir_fd
    ):
        raise CodexCliError(
            "secure launcher-owned output requires POSIX directory-descriptor support",
            code="output-protection-unavailable",
        )
    return (
        os.O_RDONLY
        | directory_flag
        | nofollow_flag
        | getattr(os, "O_CLOEXEC", 0)
    )


def _open_output_directory(path: Path) -> int:
    flags = _output_directory_flags()
    root = Path(path.anchor)
    descriptor = os.open(str(root), flags)
    try:
        for component in path.relative_to(root).parts:
            if component in {"", "."}:
                continue
            next_descriptor = os.open(component, flags, dir_fd=descriptor)
            os.close(descriptor)
            descriptor = next_descriptor
        return descriptor
    except OSError as exc:
        try:
            os.close(descriptor)
        except OSError:
            pass
        raise exc


def _directory_identity(descriptor: int) -> tuple[int, int]:
    directory_stat = os.fstat(descriptor)
    if not stat.S_ISDIR(directory_stat.st_mode):
        raise CodexCliError(
            "output parent is not a regular directory",
            code="output-parent-unavailable",
        )
    return directory_stat.st_dev, directory_stat.st_ino


def pin_output_path(raw_path: str | None) -> PinnedOutput | None:
    path = validate_output_path(raw_path)
    if path is None:
        return None
    try:
        parent_fd = _open_output_directory(path.parent)
    except CodexCliError:
        raise
    except OSError as exc:
        raise CodexCliError(
            f"output parent is not a stable non-symlink directory: {path.parent}: {exc}",
            code="output-parent-unavailable",
        ) from exc

    try:
        parent_identity = _directory_identity(parent_fd)
        try:
            existing_stat = os.stat(
                path.name,
                dir_fd=parent_fd,
                follow_symlinks=False,
            )
        except FileNotFoundError:
            existing_mode = 0o600
        except OSError as exc:
            raise CodexCliError(
                f"output path could not be inspected: {path}: {exc}",
                code="output-invalid",
            ) from exc
        else:
            if stat.S_ISLNK(existing_stat.st_mode):
                raise CodexCliError(
                    f"output path must not be a symlink: {path}",
                    code="output-symlink",
                )
            if not stat.S_ISREG(existing_stat.st_mode):
                raise CodexCliError(
                    f"output path is not a regular file: {path}",
                    code="output-invalid",
                )
            existing_mode = stat.S_IMODE(existing_stat.st_mode)
        return PinnedOutput(
            path=path,
            parent=path.parent,
            parent_fd=parent_fd,
            parent_identity=parent_identity,
            existing_mode=existing_mode,
        )
    except BaseException:
        os.close(parent_fd)
        raise


def _verify_output_directory(target: PinnedOutput) -> None:
    try:
        current_fd = _open_output_directory(target.parent)
    except (CodexCliError, OSError) as exc:
        raise CodexCliError(
            f"output parent changed during delegated execution: {target.parent}",
            code="output-parent-changed",
        ) from exc
    try:
        current_identity = _directory_identity(current_fd)
    finally:
        os.close(current_fd)
    if current_identity != target.parent_identity:
        raise CodexCliError(
            f"output parent changed during delegated execution: {target.parent}",
            code="output-parent-changed",
        )


def _create_output_temporary(target: PinnedOutput) -> tuple[int, str]:
    flags = (
        os.O_WRONLY
        | os.O_CREAT
        | os.O_EXCL
        | getattr(os, "O_NOFOLLOW", 0)
        | getattr(os, "O_CLOEXEC", 0)
    )
    for _ in range(16):
        temporary_name = f".{target.path.name}.{secrets.token_hex(12)}"
        try:
            descriptor = os.open(
                temporary_name,
                flags,
                0o600,
                dir_fd=target.parent_fd,
            )
        except FileExistsError:
            continue
        return descriptor, temporary_name
    raise CodexCliError(
        f"could not allocate a private output temporary file in {target.parent}",
        code="output-unwritable",
    )


def write_regular_output(target: PinnedOutput, content: str) -> None:
    _verify_output_directory(target)
    try:
        existing_stat = os.stat(
            target.path.name,
            dir_fd=target.parent_fd,
            follow_symlinks=False,
        )
    except FileNotFoundError:
        pass
    except OSError as exc:
        raise CodexCliError(
            f"output path could not be inspected: {target.path}: {exc}",
            code="output-unwritable",
        ) from exc
    else:
        if stat.S_ISLNK(existing_stat.st_mode):
            raise CodexCliError(
                f"output path must not be a symlink: {target.path}",
                code="output-symlink",
            )
        if not stat.S_ISREG(existing_stat.st_mode):
            raise CodexCliError(
                f"output path is not a regular file: {target.path}",
                code="output-invalid",
            )

    descriptor: int | None = None
    temporary_name: str | None = None

    try:
        descriptor, temporary_name = _create_output_temporary(target)
        chmod = getattr(os, "fchmod", None)
        if chmod is not None:
            chmod(descriptor, target.existing_mode)
        with os.fdopen(descriptor, "w", encoding="utf-8") as output_handle:
            descriptor = None
            output_handle.write(content)

        _verify_output_directory(target)
        try:
            current_stat = os.stat(
                target.path.name,
                dir_fd=target.parent_fd,
                follow_symlinks=False,
            )
        except FileNotFoundError:
            pass
        else:
            if stat.S_ISLNK(current_stat.st_mode):
                raise CodexCliError(
                    f"output path must not be a symlink: {target.path}",
                    code="output-symlink",
                )
            if not stat.S_ISREG(current_stat.st_mode):
                raise CodexCliError(
                    f"output path is not a regular file: {target.path}",
                    code="output-invalid",
                )
        os.rename(
            temporary_name,
            target.path.name,
            src_dir_fd=target.parent_fd,
            dst_dir_fd=target.parent_fd,
        )
        temporary_name = None
    except OSError as exc:
        raise CodexCliError(
            f"delegated output could not be written: {target.path}: {exc}",
            code="output-unwritable",
        ) from exc
    finally:
        if descriptor is not None:
            os.close(descriptor)
        if temporary_name is not None:
            try:
                os.unlink(temporary_name, dir_fd=target.parent_fd)
            except FileNotFoundError:
                pass


def close_process_stdin(process: subprocess.Popen[str]) -> None:
    if process.stdin is None:
        return
    try:
        process.stdin.close()
    except BrokenPipeError:
        pass


def terminate_process(process: subprocess.Popen[str]) -> None:
    try:
        running = process.poll()
    except OSError:
        running = None
    if running is not None:
        return
    try:
        process.terminate()
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait(timeout=5)
    except (OSError, subprocess.SubprocessError):
        pass


def send_prompt(process: subprocess.Popen[str], prompt: str) -> None:
    if process.stdin is None:
        raise CodexCliError(
            "Codex CLI stdin was not available",
            code="codex-stdin-unavailable",
        )
    try:
        process.stdin.write(prompt)
    except BrokenPipeError as exc:
        close_process_stdin(process)
        terminate_process(process)
        raise CodexCliError(
            "Codex CLI closed stdin before the complete prompt was delivered",
            code="prompt-transport-failed",
        ) from exc
    try:
        process.stdin.close()
    except BrokenPipeError as exc:
        terminate_process(process)
        raise CodexCliError(
            "Codex CLI closed stdin before the complete prompt was delivered",
            code="prompt-transport-failed",
        ) from exc


def build_invocation(
    args: argparse.Namespace,
    *,
    output_last_message: str | None = None,
) -> Invocation:
    resolution = resolve_reasoning(
        args.model,
        args.task_profile,
        args.reasoning_effort,
    )
    executable = resolve_executable(args.codex_bin)
    working_directory = resolve_working_directory(args.cd)
    schema_path = validate_schema_path(args.output_schema)
    validate_output_path(args.output)

    command = [
        executable,
        "--ask-for-approval",
        args.ask_for_approval,
        "--model",
        resolution.model_id,
        "--config",
        f'model_reasoning_effort="{resolution.reasoning_effort}"',
        "--sandbox",
        args.sandbox,
        "--cd",
        str(working_directory),
    ]
    if args.search:
        command.append("--search")
    command.extend(
        [
            "exec",
            "--ephemeral",
            "--skip-git-repo-check",
            "--color",
            "never",
        ]
    )
    if schema_path is not None:
        command.extend(["--output-schema", schema_path])
    if output_last_message is not None:
        command.extend(["--output-last-message", output_last_message])
    command.append("-")
    return Invocation(command, working_directory, resolution)


def codex_version(
    executable: str,
) -> tuple[bool, str | None, str | None, str | None]:
    try:
        result = subprocess.run(
            [executable, "--version"],
            capture_output=True,
            text=True,
            encoding="utf-8",
            timeout=10,
            check=False,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        return False, None, str(exc), None
    stdout = (result.stdout or "").strip() or None
    stderr = (result.stderr or "").strip() or None
    output = stdout or stderr
    if result.returncode != 0:
        return False, output, stderr or stdout or "version check failed", stderr
    return True, output, None, stderr


def base_result(invocation: Invocation) -> dict[str, Any]:
    return {
        "tool": "codex-cli",
        "version": VERSION,
        **invocation.resolution.as_dict(),
        "sandbox": None,
        "ask_for_approval": None,
    }


def doctor(args: argparse.Namespace) -> int:
    payload: dict[str, Any] = {
        "tool": "codex-cli",
        "version": VERSION,
        "command": "doctor",
        "default_model": "sol",
        "default_task_profile_by_model": DEFAULT_TASK_PROFILES,
        "task_profile_effort_by_model": MODEL_TASK_PROFILE_EFFORTS,
        "models": {
            alias: {
                "model_id": profile["model_id"],
                "reasoning_efforts": list(profile["reasoning_efforts"]),
                "default_reasoning_effort": profile["default_reasoning_effort"],
                "default_task_profile": profile["default_task_profile"],
            }
            for alias, profile in MODEL_PROFILES.items()
        },
    }
    try:
        executable = resolve_executable(args.codex_bin)
        available, installed_version, error, stderr = codex_version(executable)
        payload["codex"] = {
            "ok": available,
            "path": executable,
            "version": installed_version,
            "error": error,
            "stderr": stderr,
        }
        payload["ok"] = available
    except CodexCliError as exc:
        payload["codex"] = {
            "ok": False,
            "path": None,
            "version": None,
            "error": str(exc),
            "error_code": exc.code,
            "stderr": None,
        }
        payload["ok"] = False

    if args.json_output:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print(f"codex-cli {VERSION}")
        print(f"codex executable: {payload['codex']['path'] or 'unavailable'}")
        print(f"codex version: {payload['codex']['version'] or 'unavailable'}")
        print(f"status: {'ready' if payload['ok'] else 'unavailable'}")
        if payload["codex"].get("stderr"):
            print(f"codex stderr: {payload['codex']['stderr']}", file=sys.stderr)
    return 0 if payload["ok"] else 2


def dry_run(args: argparse.Namespace, prompt: str) -> int:
    invocation = build_invocation(
        args,
        output_last_message="<temporary-last-message-file>",
    )
    payload = base_result(invocation)
    payload.update(
        {
            "ok": True,
            "dry_run": True,
            "command": invocation.command,
            "working_directory": str(invocation.working_directory),
            "sandbox": args.sandbox,
            "ask_for_approval": args.ask_for_approval,
            "prompt_characters": len(prompt),
            "prompt_sha256": hashlib.sha256(prompt.encode("utf-8")).hexdigest(),
        }
    )
    if args.json_output:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print("codex-cli dry run")
        print(f"model: {payload['model_id']}")
        print(f"reasoning: {payload['reasoning_effort']}")
        print(f"task profile: {payload['task_profile']}")
        print(f"prompt characters: {payload['prompt_characters']}")
        print("command:")
        print(json.dumps(invocation.command))
    return 0


def run_task(args: argparse.Namespace, prompt: str) -> int:
    output_target = pin_output_path(args.output)
    try:
        return _run_task(args, prompt, output_target)
    finally:
        if output_target is not None:
            output_target.close()


def _run_task(
    args: argparse.Namespace,
    prompt: str,
    output_target: PinnedOutput | None,
) -> int:
    try:
        temporary_directory_context = tempfile.TemporaryDirectory(
            prefix="codex-cli-",
        )
    except OSError as exc:
        raise CodexCliError(
            f"Codex CLI temporary workspace could not be created: {exc}",
            code="codex-temp-unavailable",
            json_output=args.json_output,
        ) from exc

    process: subprocess.Popen[str] | None = None
    with temporary_directory_context as temporary_directory:
        last_message_path = Path(temporary_directory) / "last-message.txt"
        stdout_path = Path(temporary_directory) / "stdout.txt"
        stderr_path = Path(temporary_directory) / "stderr.txt"
        invocation = build_invocation(args, output_last_message=str(last_message_path))

        started = time.monotonic()
        try:
            with (
                stdout_path.open("w", encoding="utf-8") as stdout_handle,
                stderr_path.open("w", encoding="utf-8") as stderr_handle,
            ):
                process = subprocess.Popen(
                    invocation.command,
                    cwd=str(invocation.working_directory),
                    stdin=subprocess.PIPE,
                    stdout=stdout_handle,
                    stderr=stderr_handle,
                    text=True,
                    encoding="utf-8",
                )
                send_prompt(process, prompt)
                while process.poll() is None:
                    try:
                        process.wait(timeout=args.heartbeat_seconds)
                    except subprocess.TimeoutExpired:
                        elapsed = int(time.monotonic() - started)
                        print(
                            "codex-cli still running: "
                            f"elapsed={elapsed}s model={invocation.resolution.model_id} "
                            f"reasoning={invocation.resolution.reasoning_effort}",
                            file=sys.stderr,
                        )
        except OSError as exc:
            raise CodexCliError(
                f"Codex CLI could not be launched: {exc}",
                code="codex-launch-failed",
            ) from exc
        finally:
            if process is not None:
                terminate_process(process)

        stdout = stdout_path.read_text(encoding="utf-8", errors="replace")
        stderr = stderr_path.read_text(encoding="utf-8", errors="replace")
        final_output = ""
        if last_message_path.is_file():
            final_output = last_message_path.read_text(
                encoding="utf-8",
                errors="replace",
            )
        if not final_output:
            final_output = stdout
        exit_code = process.returncode if process.returncode is not None else 1

        if exit_code == 0 and not final_output.strip():
            raise CodexCliError(
                "Codex CLI returned no final answer",
                code="codex-empty-result",
            )

        if output_target is not None and exit_code == 0 and final_output:
            write_regular_output(output_target, final_output)

    payload = base_result(invocation)
    payload.update(
        {
            "ok": exit_code == 0,
            "exit_code": exit_code,
            "sandbox": args.sandbox,
            "ask_for_approval": args.ask_for_approval,
            "prompt_characters": len(prompt),
            "prompt_sha256": hashlib.sha256(prompt.encode("utf-8")).hexdigest(),
            "final_output": final_output,
            "stderr": stderr,
        }
    )
    if args.json_output:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        if exit_code != 0:
            print(
                f"codex-cli failed with exit code {exit_code} "
                f"({invocation.resolution.model_id}, {invocation.resolution.reasoning_effort})",
                file=sys.stderr,
            )
            if stderr.strip():
                print(stderr.rstrip(), file=sys.stderr)
        print(final_output, end="" if final_output.endswith("\n") else "\n")
    return 0 if exit_code == 0 else exit_code


class JsonAwareArgumentParser(argparse.ArgumentParser):
    def __init__(self, *args: Any, json_requested: bool = False, **kwargs: Any) -> None:
        super().__init__(*args, **kwargs)
        self.json_requested = json_requested

    def error(self, message: str) -> None:
        raise CodexCliError(
            f"argument error: {message}",
            code="argument-invalid",
            json_output=self.json_requested,
        )


def parser(*, json_requested: bool = False) -> argparse.ArgumentParser:
    argument_parser = JsonAwareArgumentParser(
        json_requested=json_requested,
        description="Launch one complete prompt in an ephemeral Codex CLI task.",
    )
    argument_parser.add_argument(
        "--version",
        action="store_true",
        help="Print this launcher version.",
    )
    argument_parser.add_argument(
        "--json",
        dest="json_output",
        action="store_true",
        help="Print one machine-readable launcher result.",
    )
    argument_parser.add_argument(
        "command",
        nargs="?",
        choices=("doctor",),
        help="Optional read-only command.",
    )
    argument_parser.add_argument(
        "--codex-bin",
        default=os.environ.get("CODEX_BIN", "codex"),
        help="Codex executable path or name.",
    )
    argument_parser.add_argument(
        "--model",
        choices=tuple(MODEL_PROFILES),
        default="sol",
        help="Model alias; defaults to sol.",
    )
    argument_parser.add_argument(
        "--task-profile",
        choices=tuple(TASK_PROFILE_EFFORTS),
        default=None,
        help=(
            "Task classification; omitted uses standard for Sol, complex for "
            "Terra, and critical for Luna when reasoning-effort is auto. "
            "An explicit reasoning override without a profile reports no "
            "task classification."
        ),
    )
    argument_parser.add_argument(
        "--reasoning-effort",
        choices=("auto", *EFFORT_ORDER),
        default="auto",
        help="Reasoning value; auto resolves from task profile.",
    )
    argument_parser.add_argument(
        "--prompt",
        help="Complete prompt text. Omit it to read the prompt from stdin or --prompt-file.",
    )
    argument_parser.add_argument(
        "--prompt-file",
        help="UTF-8 file containing the complete prompt.",
    )
    argument_parser.add_argument(
        "--cd",
        default=os.getcwd(),
        help="Delegated working directory; defaults to the current directory.",
    )
    argument_parser.add_argument(
        "--sandbox",
        choices=("read-only", "workspace-write", "danger-full-access"),
        default="read-only",
        help="Codex sandbox policy; defaults to read-only.",
    )
    argument_parser.add_argument(
        "--ask-for-approval",
        choices=("never", "on-request", "untrusted"),
        default="never",
        help="Codex approval policy; defaults to never.",
    )
    argument_parser.add_argument(
        "--search",
        action="store_true",
        help="Enable Codex web search for this delegated task.",
    )
    argument_parser.add_argument(
        "--output-schema",
        help="JSON Schema file for the delegated final answer.",
    )
    argument_parser.add_argument(
        "--output",
        help="Write the delegated final answer to this explicit path.",
    )
    argument_parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Resolve inputs and print the launch plan without calling Codex.",
    )
    argument_parser.add_argument(
        "--heartbeat-seconds",
        type=float,
        default=60.0,
        help="Progress interval for long runs; defaults to 60 seconds.",
    )
    return argument_parser


def main(argv: Sequence[str] | None = None) -> int:
    raw_argv = list(sys.argv[1:] if argv is None else argv)
    json_requested = "--json" in raw_argv
    try:
        args = parser(json_requested=json_requested).parse_args(raw_argv)
        if not math.isfinite(args.heartbeat_seconds) or args.heartbeat_seconds <= 0:
            raise CodexCliError(
                "--heartbeat-seconds must be greater than zero",
                code="heartbeat-invalid",
                json_output=args.json_output,
            )
        if args.version:
            if args.json_output:
                print(
                    json.dumps(
                        {
                            "ok": True,
                            "tool": "codex-cli",
                            "version": VERSION,
                            "command": "version",
                        },
                        indent=2,
                        sort_keys=True,
                    )
                )
            else:
                print(f"codex-cli {VERSION}")
            return 0
        if args.command == "doctor":
            return doctor(args)
        prompt = load_prompt(args)
        if args.dry_run:
            return dry_run(args, prompt)
        return run_task(args, prompt)
    except CodexCliError as exc:
        payload = {
            "ok": False,
            "tool": "codex-cli",
            "version": VERSION,
            "error_code": exc.code,
            "error": str(exc),
        }
        if json_requested or exc.json_output:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(f"codex-cli: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
