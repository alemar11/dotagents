{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_status",
    "summary",
    "changed_files",
    "validation",
    "generated_artifacts",
    "internal_subagents",
    "risks",
    "blockers",
    "recommended_root_action"
  ],
  "allOf": [
    {
      "if": {
        "properties": { "result_status": { "const": "ready" } },
        "required": ["result_status"]
      },
      "then": {
        "properties": { "validation": { "minItems": 1 } }
      }
    },
    {
      "if": {
        "properties": { "result_status": { "const": "blocked" } },
        "required": ["result_status"]
      },
      "then": {
        "properties": { "blockers": { "minItems": 1 } }
      }
    }
  ],
  "properties": {
    "result_status": {
      "type": "string",
      "enum": ["ready", "blocked"]
    },
    "summary": { "type": "string" },
    "changed_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "result", "evidence"],
        "properties": {
          "command": { "type": "string" },
          "result": { "type": "string", "enum": ["passed", "failed", "not-run"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "generated_artifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "internal_subagents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scope", "outcome", "topology"],
        "properties": {
          "id": { "type": "string" },
          "scope": { "type": "string" },
          "outcome": { "type": "string" },
          "topology": { "type": "string", "enum": ["serial", "parallel"] }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommended_root_action": { "type": "string" }
  }
}
