#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path
from shutil import which
from typing import Any


VERSION = "1.0.0"
REPO_PATTERN = re.compile(r"^[^/\s]+/[^/\s]+$")
ISSUE_LIST_FIELDS = "number,title,author,labels,createdAt,updatedAt,url"
PR_LIST_FIELDS = "number,title,author,isDraft,reviewDecision,mergeStateStatus,statusCheckRollup,createdAt,updatedAt,url"
RUN_LIST_FIELDS = "status,conclusion,workflowName,displayTitle,headBranch,url,createdAt,updatedAt"
REPO_VIEW_FIELDS = "issues,pullRequests,latestRelease,url,isArchived,isFork,pushedAt"
FAILURE_CONCLUSIONS = {"failure", "cancelled", "timed_out", "action_required", "startup_failure"}


@dataclass(frozen=True)
class RunResult:
    returncode: int
    stdout: str
    stderr: str


class PortfolioError(Exception):
    def __init__(self, message: str, *, code: str = "command_failed", exit_code: int = 1) -> None:
        super().__init__(message)
        self.message = message
        self.code = code
        self.exit_code = exit_code


def run(command: list[str]) -> RunResult:
    try:
        completed = subprocess.run(command, text=True, capture_output=True)
    except FileNotFoundError:
        return RunResult(127, "", f"{command[0]} is not installed or not on PATH.")
    return RunResult(completed.returncode, completed.stdout, completed.stderr)


def gh_json(args: list[str]) -> object:
    result = run(["gh", *args])
    if result.returncode != 0:
        message = (result.stderr or result.stdout or "gh command failed").strip()
        raise PortfolioError(message, exit_code=result.returncode)
    try:
        return json.loads(result.stdout or "null")
    except json.JSONDecodeError as exc:
        raise PortfolioError(f"Failed to parse gh JSON output: {exc}") from exc


def validate_repo(repo: str) -> str:
    value = repo.strip()
    if not REPO_PATTERN.fullmatch(value):
        raise PortfolioError(f"Invalid repository '{repo}'. Use owner/repo.", code="invalid_arguments", exit_code=64)
    return value


def read_repo_file(path: str) -> list[str]:
    try:
        content = Path(path).read_text(encoding="utf-8")
    except OSError as exc:
        raise PortfolioError(f"Could not read --repo-file '{path}': {exc}", code="invalid_arguments", exit_code=64) from exc
    repos: list[str] = []
    for raw_line in content.splitlines():
        line = raw_line.strip()
        if line and not line.startswith("#"):
            repos.append(line.split()[0])
    return repos


def collect_repos(args: argparse.Namespace) -> list[str]:
    raw_repos = list(args.repo or [])
    if args.repo_file:
        raw_repos.extend(read_repo_file(args.repo_file))
    if not raw_repos:
        raise PortfolioError("Pass at least one --repo owner/repo or --repo-file path.", code="invalid_arguments", exit_code=64)
    seen: set[str] = set()
    repos: list[str] = []
    for raw in raw_repos:
        repo = validate_repo(raw)
        if repo not in seen:
            seen.add(repo)
            repos.append(repo)
    return repos


def login_of(author: Any) -> str:
    return str(author.get("login") or "") if isinstance(author, dict) else ""


def label_names(labels: Any) -> list[str]:
    return [str(item["name"]) for item in labels or [] if isinstance(item, dict) and item.get("name")]


def simplify_issue(item: dict[str, Any]) -> dict[str, Any]:
    return {
        "number": item.get("number"),
        "title": item.get("title") or "",
        "author": login_of(item.get("author")),
        "labels": label_names(item.get("labels")),
        "updated_at": item.get("updatedAt") or "",
        "url": item.get("url") or "",
    }


def status_rollup_summary(value: Any) -> str:
    if not isinstance(value, list):
        return "unknown"
    failing = pending = success = 0
    for item in value:
        if not isinstance(item, dict):
            continue
        state = str(item.get("conclusion") or item.get("state") or item.get("status") or "").lower()
        if state in FAILURE_CONCLUSIONS | {"error"}:
            failing += 1
        elif state in {"pending", "queued", "in_progress", "requested", "waiting", "expected"}:
            pending += 1
        elif state in {"success", "completed", "neutral", "skipped"}:
            success += 1
    if failing:
        return f"{failing} failing"
    if pending:
        return f"{pending} pending"
    if success:
        return f"{success} passing"
    return "none"


def simplify_pr(item: dict[str, Any]) -> dict[str, Any]:
    return {
        "number": item.get("number"),
        "title": item.get("title") or "",
        "author": login_of(item.get("author")),
        "is_draft": bool(item.get("isDraft")),
        "review_decision": item.get("reviewDecision"),
        "merge_state": item.get("mergeStateStatus"),
        "status": status_rollup_summary(item.get("statusCheckRollup")),
        "updated_at": item.get("updatedAt") or "",
        "url": item.get("url") or "",
    }


def connection_total(value: Any, *, fallback: int = 0) -> int:
    if isinstance(value, dict) and isinstance(value.get("totalCount"), int):
        return int(value["totalCount"])
    return fallback


def summarize_ci(runs: Any) -> dict[str, Any]:
    if not isinstance(runs, list) or not runs:
        return {"state": "none", "text": "no recent runs", "recent": []}
    simplified = [
        {
            "workflow": item.get("workflowName") or item.get("name") or "",
            "title": item.get("displayTitle") or "",
            "branch": item.get("headBranch") or "",
            "status": item.get("status") or "",
            "conclusion": item.get("conclusion"),
            "updated_at": item.get("updatedAt") or item.get("createdAt") or "",
            "url": item.get("url") or "",
        }
        for item in runs
        if isinstance(item, dict)
    ]
    failures = [item for item in simplified if str(item.get("conclusion") or "").lower() in FAILURE_CONCLUSIONS]
    pending = [item for item in simplified if str(item.get("status") or "").lower() not in {"completed", ""}]
    if failures:
        first = failures[0]
        return {"state": "failing", "text": f"{len(failures)} failing/cancelled; latest {first['workflow'] or first['title'] or 'run'}", "recent": simplified[:5]}
    if pending:
        first = pending[0]
        return {"state": "pending", "text": f"{len(pending)} pending; latest {first['workflow'] or first['title'] or 'run'}", "recent": simplified[:5]}
    return {"state": "green", "text": f"{len(simplified)} recent successful/neutral run(s)", "recent": simplified[:5]}


def latest_release_payload(repo: str, release: Any) -> dict[str, Any]:
    if not isinstance(release, dict) or not release:
        return {"status": "missing", "tag": None, "name": None, "published_at": None, "url": None}
    tag = str(release.get("tagName") or "")
    return {
        "status": "found",
        "tag": tag or None,
        "name": release.get("name") or None,
        "published_at": release.get("publishedAt") or release.get("createdAt"),
        "url": release.get("url") or (f"https://github.com/{repo}/releases/tag/{tag}" if tag else None),
    }


def top_queue_signals(repo_payload: dict[str, Any]) -> list[str]:
    signals: list[str] = []
    if repo_payload.get("is_archived"):
        signals.append("archived")
    if repo_payload["ci"]["state"] == "failing":
        signals.append("failing CI")
    if repo_payload["open_prs"]:
        signals.append(f"{repo_payload['open_prs']} open PRs")
    if repo_payload["open_issues"]:
        signals.append(f"{repo_payload['open_issues']} open issues")
    if repo_payload["latest_release"]["status"] == "missing":
        signals.append("no release")
    return signals[:4]


def next_action(repo_payload: dict[str, Any]) -> str:
    if repo_payload.get("is_archived"):
        return "confirm archived repo is intentionally in scope"
    if repo_payload["ci"]["state"] == "failing":
        return "inspect recent CI failures"
    if repo_payload["open_prs"]:
        return "review open PRs"
    if repo_payload["open_issues"]:
        return "triage open issues"
    if repo_payload["latest_release"]["status"] == "missing":
        return "check release readiness"
    return "queue empty; check freshness/release need"


def scan_repo(repo: str, limit: int) -> dict[str, Any]:
    repo_info = gh_json(["repo", "view", repo, "--json", REPO_VIEW_FIELDS])
    issues = gh_json(["issue", "list", "--repo", repo, "--state", "open", "--limit", str(limit), "--json", ISSUE_LIST_FIELDS])
    prs = gh_json(["pr", "list", "--repo", repo, "--state", "open", "--limit", str(limit), "--json", PR_LIST_FIELDS])
    runs = gh_json(["run", "list", "--repo", repo, "--limit", "5", "--json", RUN_LIST_FIELDS])
    issue_items = [simplify_issue(item) for item in issues if isinstance(item, dict)] if isinstance(issues, list) else []
    pr_items = [simplify_pr(item) for item in prs if isinstance(item, dict)] if isinstance(prs, list) else []
    payload = {
        "repo": repo,
        "ok": True,
        "repo_url": repo_info.get("url") if isinstance(repo_info, dict) else None,
        "is_archived": bool(repo_info.get("isArchived")) if isinstance(repo_info, dict) else False,
        "is_fork": bool(repo_info.get("isFork")) if isinstance(repo_info, dict) else False,
        "pushed_at": repo_info.get("pushedAt") if isinstance(repo_info, dict) else None,
        "open_issues": connection_total(repo_info.get("issues"), fallback=len(issue_items)) if isinstance(repo_info, dict) else len(issue_items),
        "open_prs": connection_total(repo_info.get("pullRequests"), fallback=len(pr_items)) if isinstance(repo_info, dict) else len(pr_items),
        "issues": issue_items,
        "pull_requests": pr_items,
        "ci": summarize_ci(runs),
        "latest_release": latest_release_payload(repo, repo_info.get("latestRelease") if isinstance(repo_info, dict) else None),
    }
    payload["top_queue_signals"] = top_queue_signals(payload)
    payload["next_action"] = next_action(payload)
    return payload


def error_payload(repo: str, exc: PortfolioError) -> dict[str, Any]:
    return {"repo": repo, "ok": False, "error": {"code": exc.code, "message": exc.message}}


def render_text(payload: dict[str, Any]) -> str:
    lines = ["Portfolio scan:"]
    for repo in payload["repos"]:
        if repo.get("ok"):
            signals = ", ".join(repo.get("top_queue_signals") or ["none"])
            release = repo["latest_release"].get("tag") or repo["latest_release"].get("status")
            lines.append(f"- {repo['repo']}: issues={repo['open_issues']} prs={repo['open_prs']} ci={repo['ci']['text']} release={release} signals={signals} next={repo['next_action']}")
        else:
            lines.append(f"- {repo['repo']}: error={repo.get('error', {}).get('message')}")
    return "\n".join(lines) + "\n"


def doctor_payload() -> dict[str, object]:
    git_path = which("git")
    gh_path = which("gh")
    auth = run(["gh", "auth", "status"]) if gh_path else RunResult(127, "", "gh missing")
    return {
        "ok": bool(git_path and gh_path),
        "version": VERSION,
        "checks": {
            "git": {"ok": bool(git_path), "path": git_path},
            "gh": {"ok": bool(gh_path), "path": gh_path, "authenticated": auth.returncode == 0 if gh_path else False},
        },
    }


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Read-only multi-repo GitHub queue, CI, and release scan.")
    parser.add_argument("--repo", action="append", default=[], help="Repository in owner/repo format. Repeatable.")
    parser.add_argument("--repo-file", help="File with one owner/repo per line.")
    parser.add_argument("--limit", type=int, default=20, help="Issue and PR sample limit per repo.")
    parser.add_argument("--json", action="store_true", help="Emit a stable JSON envelope.")
    parser.add_argument("--version", action="store_true", help="Print version and exit.")
    parser.add_argument("command", nargs="?", choices=["doctor"], help="Run doctor checks.")
    return parser


def emit_success(data: object, command: list[str]) -> None:
    print(json.dumps({"ok": True, "version": VERSION, "command": command, "data": data}, indent=2))


def emit_error(exc: PortfolioError, command: list[str]) -> None:
    print(json.dumps({"ok": False, "version": VERSION, "command": command, "error": {"code": exc.code, "message": exc.message}}, indent=2))


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.version:
        print(VERSION)
        return 0
    if args.command == "doctor":
        payload = doctor_payload()
        if args.json:
            print(json.dumps(payload, indent=2))
        else:
            print(f"portfolio-scan {VERSION}")
            print(f"git: {'ok' if payload['checks']['git']['ok'] else 'missing'}")
            print(f"gh: {'ok' if payload['checks']['gh']['ok'] else 'missing'}")
        return 0 if payload["ok"] else 1
    try:
        if args.limit <= 0:
            raise PortfolioError("--limit must be positive.", code="invalid_arguments", exit_code=64)
        repos = collect_repos(args)
        results: list[dict[str, Any]] = []
        for repo in repos:
            try:
                results.append(scan_repo(repo, args.limit))
            except PortfolioError as exc:
                results.append(error_payload(repo, exc))
        successful = sum(1 for item in results if item.get("ok"))
        payload = {"summary": {"requested": len(repos), "successful": successful, "failed": len(repos) - successful, "limit": args.limit}, "repos": results}
        if args.json:
            emit_success(payload, ["scan"])
        else:
            print(render_text(payload), end="")
        return 0 if successful else 2
    except PortfolioError as exc:
        if args.json:
            emit_error(exc, ["scan"])
        else:
            print(exc.message, file=sys.stderr)
        return exc.exit_code


if __name__ == "__main__":
    raise SystemExit(main())
