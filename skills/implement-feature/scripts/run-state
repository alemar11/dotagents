class StateError(Exception):
    def __init__(self, code: str, message: str, exit_code: int = 2) -> None:
        super().__init__(message)
        self.code = code
        self.message = message
        self.exit_code = exit_code


class StructuredArgumentParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        raise StateError("invalid-command-line", message)


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def root_task_title(assignment_count: int) -> str:
    spec_label = "Spec" if assignment_count == 1 else "Specs"
    return f"🤖 Implement Feature · {assignment_count} {spec_label}"


WORKER_TASK_TITLE_PREFIX = "🛠️ Implement Feature · "
SCOPE_REPAIR_TASK_TITLE_PREFIX = "🧭 Scope Repair · "


def feature_spec_title_from_worker_task_title(title: str, field: str) -> str:
    canonical_title = string(title, field, 256)
    if not canonical_title.startswith(WORKER_TASK_TITLE_PREFIX):
        raise StateError(
            "invalid-input",
            f"{field} must use {WORKER_TASK_TITLE_PREFIX}<Feature Spec title>",
        )
    feature_spec_title = canonical_title.removeprefix(WORKER_TASK_TITLE_PREFIX)
    if (
        not feature_spec_title.strip()
        or feature_spec_title != feature_spec_title.strip()
    ):
        raise StateError(
            "invalid-input",
            f"{field} must contain an exact nonempty Feature Spec title",
        )
    return feature_spec_title


def scope_repair_task_title(worker_task_title: str) -> str:
    feature_spec_title = feature_spec_title_from_worker_task_title(
        worker_task_title,
        "assignment title",
    )
    return f"{SCOPE_REPAIR_TASK_TITLE_PREFIX}{feature_spec_title}"


def canonical_json(value: Any) -> str:
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False)


def protocol_fields(name: str) -> dict[str, str]:
    return dict(PROTOCOLS[name])


def require_protocol(value: dict[str, Any], name: str, label: str) -> None:
    expected = PROTOCOLS[name]
    if (
        value.get("schema") != expected["schema"]
        or value.get("schema_version") != expected["schema_version"]
    ):
        raise StateError(
            "unsupported-input-protocol",
            f"{label} must use {expected['schema']} at {expected['schema_version']}",
        )


def current_runtime_sha256() -> str:
    try:
        return hashlib.sha256(Path(__file__).resolve().read_bytes()).hexdigest()
    except OSError as error:
        raise StateError(
            "runtime-identity-unavailable",
            "the shipped run-state artifact could not be fingerprinted",
            4,
        ) from error


def new_operation_id() -> str:
    return f"op-{secrets.token_hex(16)}"


def bootstrap_id_for(operation_id: str) -> str:
    if not operation_id.startswith("op-"):
        raise StateError("invalid-operation-id", "operation_id must use the generated op- form")
    return f"bootstrap-{operation_id[3:]}"


def scope_revision_id_for(operation_id: str, contract_generation: int) -> str:
    if not operation_id.startswith("op-"):
        raise StateError("invalid-operation-id", "operation_id must use the generated op- form")
    if contract_generation < 2:
        raise StateError(
            "invalid-contract-generation",
            "scope revisions require contract_generation 2 or greater",
        )
    return f"scope-revision-{contract_generation}-{operation_id[3:]}"


def new_scope_repair_id() -> str:
    return str(uuid.uuid4())


def cache_root() -> Path:
    return Path.home() / ".cache" / "dotagents" / "skills" / "implement-feature"


def database_path() -> Path:
    return cache_root() / "run-state.sqlite3"


def ensure_private_cache_root() -> None:
    root = cache_root()
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    if root.is_symlink() or not root.is_dir():
        raise StateError("unsafe-cache-root", f"cache root is not a real directory: {root}", 4)
    os.chmod(root, 0o700)


def validate_database(path: Path) -> None:
    if path.is_symlink():
        raise StateError("unsafe-state-database", f"database is a symlink: {path}", 4)
    info = path.stat()
    if not stat.S_ISREG(info.st_mode):
        raise StateError("unsafe-state-database", f"database is not regular: {path}", 4)
    if info.st_mode & 0o077:
        raise StateError("unsafe-state-permissions", f"database must be owner-only: {path}", 4)


def open_database(path: Path, *, write: bool) -> sqlite3.Connection:
    target = path if write else f"{path.resolve().as_uri()}?mode=ro"
    connection = sqlite3.connect(
        target,
        timeout=SQLITE_BUSY_TIMEOUT_MS / 1000,
        isolation_level=None,
        uri=not write,
    )
    try:
        connection.row_factory = sqlite3.Row
        connection.execute("PRAGMA foreign_keys = ON")
        connection.execute(f"PRAGMA busy_timeout = {SQLITE_BUSY_TIMEOUT_MS}")
        if not write:
            connection.execute("PRAGMA query_only = ON")
        pragma = (
            f"PRAGMA journal_mode = {SQLITE_JOURNAL_MODE}"
            if write
            else "PRAGMA journal_mode"
        )
        journal_mode = connection.execute(pragma).fetchone()[0]
        if str(journal_mode).lower() != SQLITE_JOURNAL_MODE.lower():
            raise StateError(
                "sqlite-journal-mode-mismatch",
                f"SQLite journal mode must be {SQLITE_JOURNAL_MODE.lower()}, found {journal_mode}",
                4,
            )
    except Exception:
        connection.close()
        raise
    return connection


def connect(*, write: bool) -> sqlite3.Connection:
    path = database_path()
    if not path.exists():
        raise StateError(
            "state-uninitialized",
            f"database schema {DATABASE_SCHEMA_VERSION} has not been initialized",
            3,
        )
    try:
        validate_database(path)
        connection = open_database(path, write=write)
        if write:
            connection.execute("BEGIN IMMEDIATE")
        ensure_schema(connection, allow_create=False)
    except Exception:
        if "connection" in locals():
            connection.rollback()
            connection.close()
        raise
    return connection


CURRENT_SCHEMA_COLUMNS = {
    "runtime_metadata": ("singleton", "schema_version"),
    "runs": (
