)
REPOSITORY_KEY_RE = re.compile(
    r"^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?$"
)
CRITERION_ID_RE = re.compile(
    r"^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?:ac-[0-9]{2}$"
)
PROOF_ID_RE = re.compile(
    r"^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?:proof-"
    r"[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
)
INLINE_CODE_RE = re.compile(r"`([^`]+)`")
OWNED_ID_LIKE_RE = re.compile(
    r"[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?:(?:ac-|proof-)"
)

