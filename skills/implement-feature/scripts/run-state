def render(payload: dict[str, Any], command: str, as_json: bool) -> None:
    envelope = {
        **protocol_fields("cli_envelope"),
        "ok": True,
        "command": command,
        "cli_version": CLI_VERSION,
        "runtime_contract_version": RUNTIME_CONTRACT_VERSION,
        **payload,
    }
    print(canonical_json(envelope) if as_json else json.dumps(envelope, indent=2, sort_keys=True, ensure_ascii=False))


def failure_payload(command: str, code: str, message: str) -> dict[str, Any]:
    return {
        **protocol_fields("cli_envelope"),
        "ok": False,
        "command": command,
        "cli_version": CLI_VERSION,
        "runtime_contract_version": RUNTIME_CONTRACT_VERSION,
        "error": {"code": code, "message": message},
    }


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    raw_arguments = list(sys.argv[1:] if argv is None else argv)
    args: argparse.Namespace | None = None
    as_json = "--json" in raw_arguments
    try:
        args = parser.parse_args(raw_arguments)
        as_json = args.json
        render(args.handler(args), args.command_name, args.json)
        return 0
    except StateError as error:
        payload = failure_payload(
            getattr(args, "command_name", "unknown"),
            error.code,
            error.message,
        )
        if as_json:
            print(canonical_json(payload))
        else:
            print(f"{error.code}: {error.message}", file=sys.stderr)
        return error.exit_code
    except sqlite3.Error as error:
        primary = (getattr(error, "sqlite_errorcode", 0) or 0) & 0xFF
        busy = primary in {sqlite3.SQLITE_BUSY, sqlite3.SQLITE_LOCKED}
        code = "state-busy" if busy else "state-database-error"
        message = f"state database remained busy for {SQLITE_BUSY_TIMEOUT_MS} ms" if busy else str(error)
        payload = failure_payload(
            getattr(args, "command_name", "unknown"),
            code,
            message,
        )
        if as_json:
            print(canonical_json(payload))
        else:
            print(f"{code}: {message}", file=sys.stderr)
        return 4


if __name__ == "__main__":
    raise SystemExit(main())
