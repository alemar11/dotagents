def command_assignment_resume(args: argparse.Namespace) -> dict[str, Any]:
    run_id = token(args.run_id, "run_id")
    assignment_id = token(args.assignment_id, "assignment_id")
    connection = connect(write=True)
    try:
        run = get_run(connection, run_id)
        require_revision(run, args.expected_revision)
        assignment = get_assignment(connection, run_id, assignment_id)
        if assignment["state"] not in {
            "blocked-durable-contract", "blocked-app-capability"
        }:
            raise StateError(
                "invalid-assignment-transition",
                "resume requires a recoverable blocked assignment",
                4,
            )
        restored = assignment["blocked_from_state"]
        if restored not in {"active", "peer-input-ready"}:
            raise StateError(
                "invalid-state-schema",
                "blocked assignment has no valid resume state",
                4,
            )
        claim = assignment_claim(connection, run_id, assignment_id)
        if not claim["active"]:
            raise StateError(
                "assignment-claim-not-active",
                "blocked assignment resume requires its retained claim",
                4,
            )
        connection.execute(
            """UPDATE assignments SET state=?,blocked_from_state=NULL,updated_at=?
               WHERE run_id=? AND assignment_id=?""",
            (restored, utc_now(), run_id, assignment_id),
        )
        run_status = recompute_run_status(connection, run_id)
        revision = advance(connection, run)
        connection.commit()
        return {
            "run_id": run_id, "revision": revision,
            "assignment_id": assignment_id, "state": restored,
            "run_status": run_status, "claim_retained": True,
        }
    except Exception:
        connection.rollback()
        raise
    finally:
        connection.close()


def command_assignment_abort(args: argparse.Namespace) -> dict[str, Any]:
    run_id = token(args.run_id, "run_id")
    assignment_id = token(args.assignment_id, "assignment_id")
    connection = connect(write=True)
    try:
        run = get_run(connection, run_id)
        require_revision(run, args.expected_revision)
        assignment = get_assignment(connection, run_id, assignment_id)
        if assignment["state"] not in {"planned", "preimplementation-aborted"}:
            raise StateError(
                "invalid-assignment-transition",
                "assignment abort requires no worker or a reconciled archived pre-bootstrap worker",
                4,
            )
        bootstrap = connection.execute(
            """SELECT status FROM app_operations
               WHERE run_id=? AND assignment_id=? AND action='send-bootstrap'
                 AND status IN ('pending','unknown','succeeded') LIMIT 1""",
            (run_id, assignment_id),
        ).fetchone()
        if bootstrap:
            raise StateError(
                "bootstrap-reconciliation-required",
                "assignment abort requires proof that bootstrap authority was never delivered",
                4,
            )
        unresolved = connection.execute(
            """SELECT COUNT(*) FROM app_operations
               WHERE run_id=? AND assignment_id=? AND status IN ('pending','unknown')""",
            (run_id, assignment_id),
        ).fetchone()[0]
        if unresolved:
            raise StateError("unresolved-app-operation", "reconcile assignment task changes before abort", 4)
        now = utc_now()
        connection.execute(
            """UPDATE assignments SET state='preimplementation-aborted',updated_at=?
               WHERE run_id=? AND assignment_id=?""",
            (now, run_id, assignment_id),
        )
        updated = connection.execute(
            """UPDATE spec_claims SET active=0,released_at=?,release_reason='preimplementation-aborted'
               WHERE run_id=? AND assignment_id=? AND active=1""",
            (now, run_id, assignment_id),
        ).rowcount
        if updated != 1:
            raise StateError("assignment-claim-not-active", "assignment abort requires an active claim", 4)
        status = recompute_run_status(connection, run_id)
        revision = advance(connection, run)
        connection.commit()
        return {
            "run_id": run_id, "revision": revision, "assignment_id": assignment_id,
            "state": "preimplementation-aborted", "run_status": status,
            "claim_released": True,
        }
    except Exception:
        connection.rollback()
        raise
    finally:
        connection.close()


def validate_claim_recovery_observation(value: dict[str, Any]) -> dict[str, Any]:
    exact_keys(
        value,
        {
            "schema_version", "owner_run_id", "owner_assignment_id", "owner_expected_revision",
            "repository_identity", "tracker_backend", "source_spec_ref", "worker_state",
            "checkout_state", "readback_ref",
        },
        "claim recovery observation",
    )
    if value["schema_version"] != STATE_SCHEMA_VERSION:
        raise StateError("unsupported-input-schema", "claim recovery observation schema_version must be 2")
    if not isinstance(value["owner_expected_revision"], int) or value["owner_expected_revision"] < 1:
        raise StateError("invalid-input", "owner_expected_revision must be a positive integer")
    worker_state = string(value["worker_state"], "worker_state", 32)
    if worker_state not in {"active", "archived", "completed", "not-found", "unknown"}:
        raise StateError("invalid-input", "worker_state is not supported")
    checkout_state = string(value["checkout_state"], "checkout_state", 32)
    if checkout_state not in {"present", "released", "not-found", "unknown"}:
        raise StateError("invalid-input", "checkout_state is not supported")
    repository = string(value["repository_identity"], "repository_identity", 8192)
    tracker_backend = string(value["tracker_backend"], "tracker_backend", 16)
    source_spec_ref, claim_identity = canonical_source_spec_ref(
        value["source_spec_ref"], repository, tracker_backend
    )
    return {
        "owner_run_id": token(value["owner_run_id"], "owner_run_id"),
        "owner_assignment_id": token(value["owner_assignment_id"], "owner_assignment_id"),
        "owner_expected_revision": value["owner_expected_revision"],
        "repository_identity": repository,
        "tracker_backend": tracker_backend,
        "source_spec_ref": source_spec_ref,
        "claim_spec_identity": claim_identity,
        "worker_state": worker_state,
        "checkout_state": checkout_state,
        "readback_ref": string(value["readback_ref"], "readback_ref", 2048),
    }


def command_assignment_recover(args: argparse.Namespace) -> dict[str, Any]:
    run_id = token(args.run_id, "run_id")
    assignment_id = token(args.assignment_id, "assignment_id")
    observed = validate_claim_recovery_observation(
        read_json_file(args.observation, "owner recovery observation")
    )
    connection = connect(write=True)
    try:
        run = get_run(connection, run_id)
        require_revision(run, args.expected_revision)
        assignment = get_assignment(connection, run_id, assignment_id)
        if (
            observed["owner_run_id"] != run_id
            or observed["owner_assignment_id"] != assignment_id
            or observed["owner_expected_revision"] != run["revision"]
        ):
            raise StateError(
                "recovery-owner-drift",
                "owner recovery evidence must name this exact run, assignment, and revision",
                4,
            )
        if (
            assignment["repository_identity"] != observed["repository_identity"]
            or assignment["tracker_backend"] != observed["tracker_backend"]
            or assignment["claim_spec_identity"] != observed["claim_spec_identity"]
        ):
            raise StateError(
                "claim-identity-drift",
                "owner recovery evidence belongs to another Feature Spec",
                4,
            )
        if assignment["state"] not in {
            "active", "peer-input-ready",
            "blocked-durable-contract", "blocked-app-capability",
        }:
            raise StateError(
                "invalid-assignment-transition",
                "owner recovery requires a post-bootstrap nonterminal assignment",
                4,
            )
        claim = assignment_claim(connection, run_id, assignment_id)
        if not claim["active"]:
            raise StateError(
                "assignment-claim-not-active",
                "owner recovery requires the assignment's retained claim",
                4,
            )
        if observed["worker_state"] == "active" or observed["checkout_state"] == "present":
            connection.rollback()
            return {
                "run_id": run_id, "revision": run["revision"],
                "assignment_id": assignment_id, "state": assignment["state"],
                "outcome": (
                    "owner-active"
                    if observed["worker_state"] == "active"
                    else "checkout-still-bound"
                ),
                "claim_released": False,
            }
        unresolved = connection.execute(
            """SELECT COUNT(*) FROM app_operations
               WHERE run_id=? AND assignment_id=? AND status IN ('pending','unknown')""",
            (run_id, assignment_id),
        ).fetchone()[0]
        if (
            observed["worker_state"] == "unknown"
            or observed["checkout_state"] == "unknown"
            or unresolved
        ):
            raise StateError(
                "owner-recovery-insufficient",
                "owner recovery requires terminal worker, released checkout, and reconciled task operations",
                4,
            )
        if observed["worker_state"] not in {"archived", "completed", "not-found"}:
            raise StateError(
                "owner-recovery-insufficient",
                "owner recovery worker state is not terminal",
                4,
            )
        if observed["checkout_state"] not in {"released", "not-found"}:
            raise StateError(
                "owner-recovery-insufficient",
                "owner recovery checkout remains bound",
                4,
            )
        now = utc_now()
        connection.execute(
            """UPDATE assignments
               SET state='abandoned',blocked_from_state=NULL,updated_at=?
               WHERE run_id=? AND assignment_id=?""",
            (now, run_id, assignment_id),
        )
        connection.execute(
            """UPDATE spec_claims
               SET active=0,released_at=?,release_reason='abandoned',
                   recovery_readback_ref=?
               WHERE run_id=? AND assignment_id=?""",
            (now, observed["readback_ref"], run_id, assignment_id),
        )
        run_status = recompute_run_status(connection, run_id)
        revision = advance(connection, run)
        connection.commit()
        return {
            "run_id": run_id, "revision": revision,
            "assignment_id": assignment_id, "state": "abandoned",
            "run_status": run_status, "outcome": "owner-abandoned",
            "claim_released": True,
        }
    except Exception:
        connection.rollback()
        raise
    finally:
        connection.close()


def command_claim_reconcile(args: argparse.Namespace) -> dict[str, Any]:
    run_id = token(args.run_id, "run_id")
    assignment_id = token(args.assignment_id, "assignment_id")
    observed = validate_claim_recovery_observation(
        read_json_file(args.observation, "claim recovery observation")
    )
    connection = connect(write=True)
    try:
        waiter_run = get_run(connection, run_id)
        require_revision(waiter_run, args.expected_revision)
        waiter = get_assignment(connection, run_id, assignment_id)
        if waiter["state"] not in {
            "waiting-for-spec", "blocked-by-active-spec",
            "abandoned-recovery-required",
        }:
            raise StateError("assignment-not-waiting", f"assignment is {waiter['state']}", 4)
        if (
            waiter["repository_identity"] != observed["repository_identity"]
            or waiter["tracker_backend"] != observed["tracker_backend"]
            or waiter["claim_spec_identity"] != observed["claim_spec_identity"]
        ):
            raise StateError("claim-identity-drift", "recovery evidence belongs to another Feature Spec", 4)
        owner = active_spec_owner(
            connection, waiter["repository_identity"], waiter["claim_spec_identity"]
        )
        if owner is None:
            raise StateError("claim-owner-changed", "the observed owner no longer holds the claim", 4)
        if (
            owner["run_id"] != observed["owner_run_id"]
            or owner["assignment_id"] != observed["owner_assignment_id"]
        ):
            raise StateError("claim-owner-changed", "the active claim owner differs from the observation", 4)
        owner_run = get_run(connection, owner["run_id"])
        require_revision(owner_run, observed["owner_expected_revision"])

        if observed["worker_state"] == "active" or observed["checkout_state"] == "present":
            if waiter["state"] == "abandoned-recovery-required":
                now = utc_now()
                connection.execute(
                    """UPDATE assignments
                       SET state='blocked-by-active-spec',updated_at=?
                       WHERE run_id=? AND assignment_id=?""",
                    (now, run_id, assignment_id),
                )
                connection.execute(
                    """UPDATE spec_claims SET recovery_readback_ref=?
                       WHERE run_id=? AND assignment_id=?""",
                    (observed["readback_ref"], run_id, assignment_id),
                )
                status = recompute_run_status(connection, run_id)
                revision = advance(connection, waiter_run)
                connection.commit()
                return {
                    "run_id": run_id, "revision": revision,
                    "assignment_id": assignment_id,
                    "state": "blocked-by-active-spec",
                    "run_status": status,
                    "outcome": (
                        "owner-active"
                        if observed["worker_state"] == "active"
                        else "checkout-still-bound"
                    ),
                    "claim_acquired": False,
                }
            connection.rollback()
            return {
                "run_id": run_id, "revision": waiter_run["revision"],
                "assignment_id": assignment_id, "state": waiter["state"],
                "outcome": "owner-active" if observed["worker_state"] == "active" else "checkout-still-bound",
                "claim_acquired": False,
            }

        unresolved = connection.execute(
            """SELECT COUNT(*) FROM app_operations
               WHERE run_id=? AND assignment_id=? AND status IN ('pending','unknown')""",
            (owner["run_id"], owner["assignment_id"]),
        ).fetchone()[0]
        if (
            observed["worker_state"] == "unknown"
            or observed["checkout_state"] == "unknown"
            or unresolved
        ):
            now = utc_now()
            connection.execute(
                """UPDATE assignments SET state='abandoned-recovery-required',updated_at=?
                   WHERE run_id=? AND assignment_id=?""",
                (now, run_id, assignment_id),
            )
            status = recompute_run_status(connection, run_id)
            revision = advance(connection, waiter_run)
            connection.commit()
            return {
                "run_id": run_id, "revision": revision, "assignment_id": assignment_id,
                "state": "abandoned-recovery-required", "run_status": status,
                "outcome": "insufficient-evidence", "claim_acquired": False,
            }

        bootstrap_succeeded = connection.execute(
            """SELECT 1 FROM app_operations
               WHERE run_id=? AND assignment_id=? AND action='send-bootstrap' AND status='succeeded'
               LIMIT 1""",
            (owner["run_id"], owner["assignment_id"]),
        ).fetchone() is not None
        terminal_state = "abandoned" if bootstrap_succeeded else "preimplementation-aborted"
        release_reason = terminal_state
        now = utc_now()
        connection.execute(
            "UPDATE assignments SET state=?,updated_at=? WHERE run_id=? AND assignment_id=?",
            (terminal_state, now, owner["run_id"], owner["assignment_id"]),
        )
        released = connection.execute(
            """UPDATE spec_claims SET active=0,released_at=?,release_reason=?,recovery_readback_ref=?
               WHERE run_id=? AND assignment_id=? AND active=1""",
            (
                now, release_reason, observed["readback_ref"],
                owner["run_id"], owner["assignment_id"],
            ),
        ).rowcount
        if released != 1:
            raise StateError("claim-owner-changed", "the owner claim changed during reconciliation", 4)
        recompute_run_status(connection, owner["run_id"])
        owner_revision = advance(connection, owner_run)

        acquired = connection.execute(
            """UPDATE spec_claims SET active=1,acquired_at=?,released_at=NULL,
               release_reason=NULL,recovery_readback_ref=NULL
               WHERE run_id=? AND assignment_id=? AND active=0""",
            (now, run_id, assignment_id),
        ).rowcount
        if acquired != 1:
            raise StateError("claim-acquisition-failed", "waiting claim could not be acquired", 4)
        connection.execute(
            """UPDATE assignments SET state='planned',unchanged_wait_sweeps=0,
               waiting_owner_run_id=NULL,waiting_owner_assignment_id=NULL,
               waiting_owner_root_task_id=NULL,updated_at=?
               WHERE run_id=? AND assignment_id=?""",
            (now, run_id, assignment_id),
        )
        connection.execute("UPDATE runs SET status='active' WHERE run_id=?", (run_id,))
        revision = advance(connection, waiter_run)
        connection.commit()
        return {
            "run_id": run_id, "revision": revision, "assignment_id": assignment_id,
            "state": "planned", "outcome": release_reason,
            "claim_acquired": True, "owner_run_id": owner["run_id"],
            "owner_revision": owner_revision,
        }
    except Exception:
        connection.rollback()
        raise
    finally:
        connection.close()


def command_claim_abandon(args: argparse.Namespace) -> dict[str, Any]:
    run_id = token(args.run_id, "run_id")
    assignment_id = token(args.assignment_id, "assignment_id")
    owner_run_id = token(args.owner_run_id, "owner_run_id")
    owner_assignment_id = token(args.owner_assignment_id, "owner_assignment_id")
    connection = connect(write=True)
    try:
        waiter_run = get_run(connection, run_id)
        require_revision(waiter_run, args.expected_revision)
        waiter = get_assignment(connection, run_id, assignment_id)
        if waiter["state"] != "abandoned-recovery-required":
            raise StateError(
                "manual-abandon-not-authorized",
                "manual abandon requires a prior abandoned-recovery-required result",
                4,
            )
        owner_run = get_run(connection, owner_run_id)
        require_revision(owner_run, args.owner_expected_revision)
        owner = active_spec_owner(
            connection, waiter["repository_identity"], waiter["claim_spec_identity"]
        )
        if owner is None or (owner["run_id"], owner["assignment_id"]) != (owner_run_id, owner_assignment_id):
            raise StateError("claim-owner-changed", "the active claim owner differs from the explicit override", 4)
        now = utc_now()
        connection.execute(
            "UPDATE assignments SET state='abandoned',updated_at=? WHERE run_id=? AND assignment_id=?",
            (now, owner_run_id, owner_assignment_id),
        )
        connection.execute(
            """UPDATE spec_claims SET active=0,released_at=?,release_reason='manual-abandon'
               WHERE run_id=? AND assignment_id=? AND active=1""",
            (now, owner_run_id, owner_assignment_id),
        )
        recompute_run_status(connection, owner_run_id)
        owner_revision = advance(connection, owner_run)
        connection.execute(
            """UPDATE spec_claims SET active=1,acquired_at=?,released_at=NULL,release_reason=NULL
               WHERE run_id=? AND assignment_id=? AND active=0""",
            (now, run_id, assignment_id),
        )
        connection.execute(
            """UPDATE assignments SET state='planned',unchanged_wait_sweeps=0,
               waiting_owner_run_id=NULL,waiting_owner_assignment_id=NULL,
               waiting_owner_root_task_id=NULL,updated_at=?
               WHERE run_id=? AND assignment_id=?""",
            (now, run_id, assignment_id),
        )
        connection.execute("UPDATE runs SET status='active' WHERE run_id=?", (run_id,))
        revision = advance(connection, waiter_run)
        connection.commit()
        return {
            "run_id": run_id, "revision": revision, "assignment_id": assignment_id,
            "state": "planned", "outcome": "manual-abandon",
            "claim_acquired": True, "owner_run_id": owner_run_id,
            "owner_revision": owner_revision,
        }
    except Exception:
        connection.rollback()
        raise
    finally:
        connection.close()


def command_run_finish(args: argparse.Namespace) -> dict[str, Any]:
    run_id = token(args.run_id, "run_id")
    connection = connect(write=True)
    try:
        run = get_run(connection, run_id)
        require_revision(run, args.expected_revision)
        finishable_statuses = {"active", "blocked"} if args.outcome == "abandoned" else {"active"}
        if run["status"] not in finishable_statuses:
            raise StateError("run-not-finishable", f"run is {run['status']}", 4)
        unresolved = connection.execute("SELECT COUNT(*) FROM app_operations WHERE run_id=? AND status IN ('pending','unknown')", (run_id,)).fetchone()[0]
        if unresolved:
            raise StateError("unresolved-app-operations", "finish requires complete task change reconciliation", 4)
        states = [row[0] for row in connection.execute("SELECT state FROM assignments WHERE run_id=?", (run_id,))]
        if args.outcome in {"pr-ready", "local-branch-ready", "delivery-ready"}:
            delivery_rows = list(
                connection.execute(
                    "SELECT delivery_type,state FROM assignments WHERE run_id=?",
                    (run_id,),
                )
            )
            expected_state = {
                "github-pr": "pr-ready",
                "local-branch": "local-branch-ready",
            }
            if any(
                row["state"] != expected_state[row["delivery_type"]]
                for row in delivery_rows
            ):
                raise StateError("run-incomplete", "delivery finish requires every assignment ready for its delivery type", 4)
            delivery_types = {row["delivery_type"] for row in delivery_rows}
            expected_outcome = (
                "pr-ready" if delivery_types == {"github-pr"}
                else "local-branch-ready" if delivery_types == {"local-branch"}
                else "delivery-ready"
            )
            if args.outcome != expected_outcome:
                raise StateError(
                    "delivery-outcome-mismatch",
                    f"run delivery vector requires outcome {expected_outcome}",
                    4,
                )
            active_claims = connection.execute(
                "SELECT COUNT(*) FROM spec_claims WHERE run_id=? AND active=1", (run_id,)
            ).fetchone()[0]
            if active_claims:
                raise StateError("claims-not-released", "every delivery-ready assignment must release its claim before run finish", 4)
        elif args.outcome == "preimplementation-aborted":
            if run["implementation_started"]:
                raise StateError("implementation-already-started", "preimplementation abort cannot release a post-bootstrap claim", 4)
            if any(state not in {"planned", "preimplementation-aborted"} for state in states):
                raise StateError(
                    "preimplementation-not-reconciled",
                    "preimplementation abort requires terminal worker readback",
                    4,
                )
        else:
            terminal_states = {
                "pr-ready", "local-branch-ready",
                "preimplementation-aborted", "abandoned",
            }
            if "abandoned" not in states or any(
                state not in terminal_states for state in states
            ):
                raise StateError(
                    "run-incomplete",
                    "abandoned finish requires every assignment terminal and at least one abandoned",
                    4,
                )
            active_claims = connection.execute(
                "SELECT COUNT(*) FROM spec_claims WHERE run_id=? AND active=1",
                (run_id,),
            ).fetchone()[0]
            if active_claims:
                raise StateError(
                    "claims-not-released",
                    "abandoned finish requires every assignment claim released",
                    4,
                )
        now = utc_now()
        terminal = args.outcome
        connection.execute("UPDATE runs SET status=?,revision=?,updated_at=?,finished_at=? WHERE run_id=?", (terminal, run["revision"] + 1, now, now, run_id))
        if args.outcome == "preimplementation-aborted":
            connection.execute(
                """UPDATE assignments SET state='preimplementation-aborted',updated_at=?
                   WHERE run_id=? AND state='planned'""",
                (now, run_id),
            )
            connection.execute(
                """UPDATE spec_claims SET active=0,released_at=?,release_reason='preimplementation-aborted'
                   WHERE run_id=? AND active=1""",
                (now, run_id),
            )
        connection.commit()
        return {
            "run_id": run_id, "revision": run["revision"] + 1, "outcome": terminal,
            "claims_released": args.outcome in {
                "preimplementation-aborted", "abandoned",
            },
        }
    except Exception:
        connection.rollback()
        raise
    finally:
        connection.close()


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="run-state", description="Schema-2 SQLite coordination for Implement Feature controllers in the ChatGPT desktop app.")
    parser.add_argument("--json", action="store_true", help="emit one machine-readable JSON object")
    parser.add_argument("--version", action="version", version=CLI_VERSION)
    commands = parser.add_subparsers(dest="command", required=True)
    doctor = commands.add_parser("doctor", help="inspect shared state readiness without writing")
    doctor.set_defaults(handler=command_doctor, command_name="doctor")

    run = commands.add_parser("run", help="start, wait, inspect, list, or finish root runs")
    run_commands = run.add_subparsers(dest="run_command", required=True)
    start = run_commands.add_parser("start", help="atomically acquire each free Feature Spec claim")
    start.add_argument("--manifest", required=True)
    start.set_defaults(handler=command_run_start, command_name="run start")
    wait = run_commands.add_parser("wait-sweep", help="perform one bounded Feature Spec owner sweep")
    wait.add_argument("--run-id", required=True)
    wait.add_argument("--assignment-id", required=True)
    wait.add_argument("--expected-revision", type=int, required=True)
    wait.set_defaults(handler=command_run_wait_sweep, command_name="run wait-sweep")
    show = run_commands.add_parser("show", help="read one run, its assignments, claims, and unresolved task changes")
    show.add_argument("--run-id", required=True)
    show.set_defaults(handler=command_run_show, command_name="run show")
    listing = run_commands.add_parser("list", help="list root runs")
    listing.add_argument("--status", choices=("waiting-for-spec", "active", "blocked", "pr-ready", "local-branch-ready", "delivery-ready", "preimplementation-aborted", "abandoned", "all"), default="active")
    listing.set_defaults(handler=command_run_list, command_name="run list")
    finish = run_commands.add_parser("finish", help="close a delivery-ready, preimplementation-aborted, or owner-abandoned run")
    finish.add_argument("--run-id", required=True)
    finish.add_argument("--expected-revision", type=int, required=True)
    finish.add_argument("--outcome", choices=("pr-ready", "local-branch-ready", "delivery-ready", "preimplementation-aborted", "abandoned"), required=True)
    finish.set_defaults(handler=command_run_finish, command_name="run finish")

    claim = commands.add_parser("claim", help="inspect or reconcile canonical Feature Spec ownership")
    claim_commands = claim.add_subparsers(dest="claim_command", required=True)
    find = claim_commands.add_parser("find", help="find the active owner of one canonical Feature Spec")
    find.add_argument("--repository-identity", required=True)
    find.add_argument("--tracker-backend", choices=("github", "local"), required=True)
    find.add_argument("--source-spec-ref", required=True)
    find.set_defaults(handler=command_claim_find, command_name="claim find")
    reconcile = claim_commands.add_parser("reconcile", help="reconcile a waiting claim from authoritative ChatGPT task inspection")
    reconcile.add_argument("--run-id", required=True)
    reconcile.add_argument("--assignment-id", required=True)
    reconcile.add_argument("--expected-revision", type=int, required=True)
    reconcile.add_argument("--observation", required=True)
    reconcile.set_defaults(handler=command_claim_reconcile, command_name="claim reconcile")
    abandon = claim_commands.add_parser("abandon", help="explicitly abandon an irrecoverable owner after failed recovery")
    abandon.add_argument("--run-id", required=True)
    abandon.add_argument("--assignment-id", required=True)
    abandon.add_argument("--expected-revision", type=int, required=True)
    abandon.add_argument("--owner-run-id", required=True)
    abandon.add_argument("--owner-assignment-id", required=True)
    abandon.add_argument("--owner-expected-revision", type=int, required=True)
    abandon.set_defaults(handler=command_claim_abandon, command_name="claim abandon")

    operation = commands.add_parser("app-operation", help="record and reconcile one ChatGPT task change")
    operation_commands = operation.add_subparsers(dest="operation_command", required=True)
    begin = operation_commands.add_parser("begin", help="authorize one ChatGPT task change")
    begin.add_argument("--run-id", required=True)
    begin.add_argument("--expected-revision", type=int, required=True)
    begin.add_argument("--operation-key", required=True)
    begin.add_argument("--action", choices=sorted(APP_ACTIONS), required=True)
    begin.add_argument("--subject-id", required=True)
    begin.set_defaults(handler=command_app_operation_begin, command_name="app-operation begin")
    op_finish = operation_commands.add_parser("finish", help="record or reconcile the immediate response and independent state inspection")
    op_finish.add_argument("--run-id", required=True)
    op_finish.add_argument("--expected-revision", type=int, required=True)
    op_finish.add_argument("--operation-key", required=True)
    op_finish.add_argument("--observation", required=True)
    op_finish.set_defaults(handler=command_app_operation_finish, command_name="app-operation finish")
    op_list = operation_commands.add_parser("list", help="page through typed ChatGPT task-operation facts")
    op_list.add_argument("--run-id", required=True)
    op_list.add_argument("--after-sequence", type=int, default=0)
    op_list.add_argument("--limit", type=int, default=50)
    op_list.set_defaults(handler=command_app_operation_list, command_name="app-operation list")

    assignment = commands.add_parser("assignment", help="record worker terminal evidence")
    assignment_commands = assignment.add_subparsers(dest="assignment_command", required=True)
    ready = assignment_commands.add_parser("ready", help="record typed root-verified delivery-ready evidence")
    ready.add_argument("--run-id", required=True)
    ready.add_argument("--expected-revision", type=int, required=True)
    ready.add_argument("--observation", required=True)
    ready.add_argument("--peer-input", action="store_true", help="retain the worker and claim while exposing an exact HEAD to dependent peers")
    ready.set_defaults(handler=command_assignment_ready, command_name="assignment ready")
    block = assignment_commands.add_parser("block", help="retain claims after a durable contract change")
    block.add_argument("--run-id", required=True)
    block.add_argument("--expected-revision", type=int, required=True)
    block.add_argument("--assignment-id", required=True)
    block.set_defaults(handler=command_assignment_block, command_name="assignment block")
    capability_block = assignment_commands.add_parser(
        "capability-block",
        help="retain claims when the declared ChatGPT desktop app execution topology is unavailable",
    )
    capability_block.add_argument("--run-id", required=True)
    capability_block.add_argument("--expected-revision", type=int, required=True)
    capability_block.add_argument("--assignment-id", required=True)
    capability_block.set_defaults(
        handler=command_assignment_capability_block,
        command_name="assignment capability-block",
    )
    resume = assignment_commands.add_parser(
        "resume",
        help="resume one recovered blocked assignment in the same root run",
    )
    resume.add_argument("--run-id", required=True)
    resume.add_argument("--expected-revision", type=int, required=True)
    resume.add_argument("--assignment-id", required=True)
    resume.set_defaults(
        handler=command_assignment_resume,
        command_name="assignment resume",
    )
    recover = assignment_commands.add_parser(
        "recover",
        help="record terminal owner-side recovery for a missing post-bootstrap worker",
    )
    recover.add_argument("--run-id", required=True)
    recover.add_argument("--expected-revision", type=int, required=True)
    recover.add_argument("--assignment-id", required=True)
    recover.add_argument("--observation", required=True)
    recover.set_defaults(
        handler=command_assignment_recover,
        command_name="assignment recover",
    )
    abort = assignment_commands.add_parser("abort", help="release one verified pre-bootstrap Feature Spec claim")
    abort.add_argument("--run-id", required=True)
    abort.add_argument("--expected-revision", type=int, required=True)
    abort.add_argument("--assignment-id", required=True)
    abort.set_defaults(handler=command_assignment_abort, command_name="assignment abort")
    return parser


def render(payload: dict[str, Any], command: str, as_json: bool) -> None:
    envelope = {"schema_version": STATE_SCHEMA_VERSION, "ok": True, "command": command, **payload}
    print(canonical_json(envelope) if as_json else json.dumps(envelope, indent=2, sort_keys=True, ensure_ascii=False))


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        render(args.handler(args), args.command_name, args.json)
        return 0
    except StateError as error:
        payload = {"schema_version": STATE_SCHEMA_VERSION, "ok": False, "command": getattr(args, "command_name", "unknown"), "error": {"code": error.code, "message": error.message}}
        if args.json:
            print(canonical_json(payload))
        else:
            print(f"{error.code}: {error.message}", file=sys.stderr)
        return error.exit_code
    except sqlite3.Error as error:
        primary = (getattr(error, "sqlite_errorcode", 0) or 0) & 0xFF
        busy = primary in {sqlite3.SQLITE_BUSY, sqlite3.SQLITE_LOCKED}
        code = "state-busy" if busy else "state-database-error"
        message = f"state database remained busy for {SQLITE_BUSY_TIMEOUT_MS} ms" if busy else str(error)
        payload = {"schema_version": STATE_SCHEMA_VERSION, "ok": False, "command": getattr(args, "command_name", "unknown"), "error": {"code": code, "message": message}}
        if args.json:
            print(canonical_json(payload))
        else:
            print(f"{code}: {message}", file=sys.stderr)
        return 4


if __name__ == "__main__":
    raise SystemExit(main())
