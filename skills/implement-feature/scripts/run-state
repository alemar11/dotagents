        observation_create.add_argument(f"--{option}")
    observation_create.add_argument("--output", required=True)
    observation_create.set_defaults(
        handler=command_app_operation_observation_create,
        command_name="app-operation observation create",
    )
    op_list = operation_commands.add_parser("list", help="page through typed Codex task-operation facts")
