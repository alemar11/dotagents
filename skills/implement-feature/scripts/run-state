        "created_at", "updated_at", "contract_generation", "scope_repair_id",
    ),
    "app_operation_reservations": (
        "run_id", "action", "subject_id", "operation_id", "created_at",
    ),
}


def normalized_schema_objects(
    connection: sqlite3.Connection,
) -> dict[tuple[str, str], str]:
    return {
        (row["type"], row["name"]): " ".join(row["sql"].split())
        for row in connection.execute(
            """SELECT type,name,sql FROM sqlite_master
               WHERE type IN ('table','index','view','trigger')
                 AND name NOT LIKE 'sqlite_%'
                 AND sql IS NOT NULL"""
        )
    }


def expected_schema_objects() -> dict[tuple[str, str], str]:
    expected = sqlite3.connect(":memory:", isolation_level=None)
    try:
        expected.row_factory = sqlite3.Row
        expected.execute("PRAGMA foreign_keys = ON")
        create_schema(expected)
        return normalized_schema_objects(expected)
    finally:
        expected.close()


def ensure_schema(connection: sqlite3.Connection, *, allow_create: bool) -> bool:
    tables = {
        row[0]
        for row in connection.execute(
            "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'"
        )
    }
    if not tables:
        if allow_create:
            create_schema(connection)
            return True
        raise StateError(
            "state-uninitialized",
            f"database schema {DATABASE_SCHEMA_VERSION} has not been initialized",
            3,
        )
    if "runtime_metadata" not in tables:
        raise StateError(
            "unsupported-state-schema",
            "unversioned or pre-lineage state is not supported",
            4,
        )
    validate_schema_shape(connection)
    return False


def validate_schema_shape(connection: sqlite3.Connection) -> None:
    columns = CURRENT_SCHEMA_COLUMNS
    expected = set(columns)
    actual = {
        row[0]
        for row in connection.execute(
            "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'"
        )
    }
    if actual != expected:
        raise StateError(
            "invalid-state-schema",
            f"state tables do not match schema {DATABASE_SCHEMA_VERSION}",
            4,
        )
    for table, expected_columns in columns.items():
        actual_columns = tuple(
            row[1] for row in connection.execute(f"PRAGMA table_info({table})")
        )
        if actual_columns != expected_columns:
            raise StateError(
                "invalid-state-schema",
                f"state table {table} columns do not match schema {DATABASE_SCHEMA_VERSION}",
                4,
            )
    read_runtime_metadata(connection)
    assignment_sql_row = connection.execute(
        "SELECT sql FROM sqlite_master WHERE type='table' AND name='assignments'"
    ).fetchone()
    assignment_sql = assignment_sql_row[0] if assignment_sql_row else ""
    if (
        "'peer-input-ready'" not in assignment_sql
        or "'blocked-app-capability'" not in assignment_sql
        or "'integration-input-ready'" in assignment_sql
        or "'blocked-scope-repair'" not in assignment_sql
    ):
        raise StateError(
            "invalid-state-schema",
            f"state table assignments constraints do not match schema {DATABASE_SCHEMA_VERSION}",
            4,
        )
    if normalized_schema_objects(connection) != expected_schema_objects():
        raise StateError(
            "invalid-state-schema",
            f"state tables, constraints, or indexes do not match schema {DATABASE_SCHEMA_VERSION}",
            4,
        )


def read_runtime_metadata(connection: sqlite3.Connection) -> int:
    try:
        rows = connection.execute(
            "SELECT singleton,schema_version FROM runtime_metadata"
        ).fetchall()
    except sqlite3.Error as error:
        raise StateError("invalid-state-schema", "runtime metadata is unreadable", 4) from error
    if len(rows) != 1 or rows[0]["singleton"] != 1:
        raise StateError(
            "invalid-state-schema",
            "runtime_metadata must contain exactly singleton row 1",
            4,
        )
    version = rows[0]["schema_version"]
    if not isinstance(version, int) or version != DATABASE_SCHEMA_VERSION:
        raise StateError("invalid-state-schema", "runtime metadata values are invalid", 4)
    return version


def create_schema(connection: sqlite3.Connection) -> None:
    statements = [
        f"""CREATE TABLE runtime_metadata (
            singleton INTEGER PRIMARY KEY CHECK (singleton = 1),
            schema_version INTEGER NOT NULL CHECK (schema_version = {DATABASE_SCHEMA_VERSION})
        )""",
        """CREATE TABLE runs (
            run_id TEXT PRIMARY KEY,
            root_task_id TEXT NOT NULL,
            controller_project_id TEXT NOT NULL,
            runtime_contract_version TEXT NOT NULL,
            runtime_cli_version TEXT NOT NULL,
            runtime_artifact_sha256 TEXT NOT NULL,
            status TEXT NOT NULL CHECK(status IN (
                'waiting-for-spec', 'active', 'blocked',
                'pr-ready',
                'preimplementation-aborted', 'abandoned'
            )),
            implementation_started INTEGER NOT NULL DEFAULT 0 CHECK(implementation_started IN (0,1)),
            revision INTEGER NOT NULL,
            created_at TEXT NOT NULL,
            updated_at TEXT NOT NULL,
            finished_at TEXT
        )""",
        """CREATE TABLE run_repositories (
            run_id TEXT NOT NULL REFERENCES runs(run_id) ON DELETE RESTRICT,
            repository_identity TEXT NOT NULL,
            project_id TEXT NOT NULL,
            git_common_dir TEXT NOT NULL,
            git_common_dir_device INTEGER NOT NULL,
            git_common_dir_inode INTEGER NOT NULL,
            PRIMARY KEY(run_id, repository_identity),
            UNIQUE(run_id, project_id),
            UNIQUE(run_id, git_common_dir_device, git_common_dir_inode)
        )""",
        """CREATE TABLE assignments (
            run_id TEXT NOT NULL REFERENCES runs(run_id) ON DELETE RESTRICT,
            assignment_id TEXT NOT NULL,
            source_spec_ref TEXT NOT NULL,
            claim_spec_identity TEXT NOT NULL,
            repository_identity TEXT NOT NULL,
            title TEXT NOT NULL,
            target_branch_name TEXT NOT NULL,
            prerequisite_assignment_ids TEXT NOT NULL,
            state TEXT NOT NULL DEFAULT 'planned' CHECK(state IN (
                'waiting-for-spec', 'planned', 'worker-created', 'active',
                'peer-input-ready', 'pr-ready',
                'blocked-durable-contract', 'blocked-app-capability',
                'blocked-scope-repair',
                'blocked-by-active-spec', 'preimplementation-aborted',
                'abandoned', 'abandoned-recovery-required'
            )),
            blocked_from_state TEXT CHECK(blocked_from_state IN (
                'active', 'peer-input-ready'
            )),
            unchanged_wait_sweeps INTEGER NOT NULL DEFAULT 0,
            waiting_owner_run_id TEXT,
            waiting_owner_assignment_id TEXT,
            waiting_owner_root_task_id TEXT,
            thread_id TEXT,
            checkout_path TEXT,
            git_common_dir TEXT,
            head_sha TEXT,
            base_branch_name TEXT,
            base_sha TEXT,
            worktree_clean INTEGER CHECK(worktree_clean IN (0,1)),
            base_is_ancestor INTEGER CHECK(base_is_ancestor IN (0,1)),
            pr_url TEXT,
            default_branch_name TEXT,
            provider_observation_ref TEXT,
            updated_at TEXT NOT NULL,
            feature_id TEXT,
            contract_generation INTEGER NOT NULL DEFAULT 1
                CHECK(contract_generation >= 1),
            scope_repair_id TEXT,
            scope_repair_readback_ref TEXT,
            PRIMARY KEY(run_id, assignment_id),
            UNIQUE(run_id, source_spec_ref),
            UNIQUE(run_id, repository_identity, target_branch_name),
            FOREIGN KEY(run_id, repository_identity)
                REFERENCES run_repositories(run_id, repository_identity)
                ON DELETE RESTRICT
        )""",
        """CREATE TABLE spec_claims (
            run_id TEXT NOT NULL REFERENCES runs(run_id) ON DELETE RESTRICT,
            assignment_id TEXT NOT NULL,
            repository_identity TEXT NOT NULL,
            claim_spec_identity TEXT NOT NULL,
            target_branch_name TEXT NOT NULL,
            git_common_dir TEXT NOT NULL,
            git_common_dir_device INTEGER NOT NULL,
            git_common_dir_inode INTEGER NOT NULL,
            active INTEGER NOT NULL CHECK(active IN (0,1)),
            acquired_at TEXT,
            released_at TEXT,
            release_reason TEXT,
            recovery_readback_ref TEXT,
            PRIMARY KEY(run_id, assignment_id),
            FOREIGN KEY(run_id, assignment_id)
                REFERENCES assignments(run_id, assignment_id) ON DELETE RESTRICT
        )""",
        "CREATE UNIQUE INDEX one_active_spec_owner ON spec_claims(repository_identity,claim_spec_identity) WHERE active=1",
        "CREATE UNIQUE INDEX one_active_head_branch_owner ON spec_claims(repository_identity,target_branch_name) WHERE active=1",
        """CREATE TABLE app_operations (
            sequence INTEGER PRIMARY KEY AUTOINCREMENT,
            run_id TEXT NOT NULL REFERENCES runs(run_id) ON DELETE RESTRICT,
            operation_id TEXT NOT NULL,
            action TEXT NOT NULL,
            subject_id TEXT NOT NULL,
            assignment_id TEXT,
            status TEXT NOT NULL CHECK(status IN ('pending','unknown','succeeded','failed')),
            launch_count INTEGER NOT NULL CHECK(launch_count >= 1),
            receipt_ref TEXT,
            readback_ref TEXT,
            thread_id TEXT,
            project_id TEXT,
            checkout_path TEXT,
            git_common_dir TEXT,
            observed_title TEXT,
            provider_observation_ref TEXT,
            head_sha TEXT,
            pr_url TEXT,
            observed_state TEXT,
            created_at TEXT NOT NULL,
            updated_at TEXT NOT NULL,
            contract_generation INTEGER,
            scope_repair_id TEXT,
            UNIQUE(run_id, operation_id)
        )""",
        """CREATE TABLE app_operation_reservations (
            run_id TEXT NOT NULL REFERENCES runs(run_id) ON DELETE RESTRICT,
            action TEXT NOT NULL,
            subject_id TEXT NOT NULL,
            operation_id TEXT NOT NULL,
            created_at TEXT NOT NULL,
            PRIMARY KEY(run_id, action, subject_id),
            UNIQUE(run_id, operation_id)
        )""",
        "CREATE UNIQUE INDEX one_worker_thread_identity ON assignments(thread_id) WHERE thread_id IS NOT NULL",
        f"INSERT INTO runtime_metadata(singleton,schema_version) VALUES (1,{DATABASE_SCHEMA_VERSION})",
    ]
    for statement in statements:
        connection.execute(statement)


def read_json_file(path_text: str, label: str) -> dict[str, Any]:
    path = Path(path_text)
    if not path.is_absolute() or path.is_symlink() or not path.is_file():
        raise StateError("invalid-input-path", f"{label} must be an absolute regular non-symlink file")
    if path.stat().st_size > MAX_INPUT_BYTES:
        raise StateError("input-too-large", f"{label} exceeds {MAX_INPUT_BYTES} bytes")
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise StateError("invalid-json", f"cannot read {label}: {error}") from error
    if not isinstance(value, dict):
        raise StateError("invalid-json", f"{label} must contain one object")
    return value


def read_text_file(path_text: str, label: str) -> str:
    path = Path(path_text)
    if not path.is_absolute() or path.is_symlink() or not path.is_file():
        raise StateError(
            "invalid-input-path",
            f"{label} must be an absolute regular non-symlink file",
        )
    if path.stat().st_size > MAX_INPUT_BYTES:
        raise StateError("input-too-large", f"{label} exceeds {MAX_INPUT_BYTES} bytes")
    try:
        return path.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as error:
        raise StateError("invalid-input", f"cannot read {label}: {error}") from error


def exact_keys(value: dict[str, Any], keys: set[str], label: str) -> None:
    if set(value) != keys:
        raise StateError(
            "invalid-input",
            f"{label} keys mismatch; missing={sorted(keys-set(value))}, extra={sorted(set(value)-keys)}",
        )


def markdown_section(
    body: str,
    heading: str,
    *,
    required: bool = True,
) -> list[str]:
    lines = body.splitlines()
    indexes = [index for index, line in enumerate(lines) if line == heading]
    if not indexes:
        if required:
            raise StateError("invalid-feature-spec-set", f"missing {heading}")
        return []
    if len(indexes) != 1:
        raise StateError("invalid-feature-spec-set", f"expected exactly one {heading}")
    start = indexes[0] + 1
    end = next(
        (
            index
            for index in range(start, len(lines))
            if lines[index].startswith("## ")
        ),
        len(lines),
    )
    return lines[start:end]


def metadata_value(lines: list[str], label: str, pattern: re.Pattern[str]) -> str:
    values = [
        match.group(1)
        for line in lines
        if (match := pattern.fullmatch(line))
    ]
    if len(values) != 1:
        raise StateError(
            "invalid-feature-spec-set",
            f"expected exactly one canonical {label} line",
        )
    return values[0]


def parse_feature_spec_set_table(body: str) -> tuple[list[tuple[str, str, str]], str]:
    section = markdown_section(body, "## Feature Spec Set")
    header = "| feature_spec_ref | affected_repository | responsibility |"
    delimiter = "| --- | --- | --- |"
    header_indexes = [
        index for index, line in enumerate(section) if line.strip() == header
    ]
    if len(header_indexes) != 1:
        raise StateError(
            "invalid-feature-spec-set",
            "Feature Spec Set must contain one canonical table header",
        )
    header_index = header_indexes[0]
    if (
        header_index + 1 >= len(section)
        or section[header_index + 1].strip() != delimiter
    ):
        raise StateError(
            "invalid-feature-spec-set",
            "Feature Spec Set must use the canonical delimiter row",
        )
    rows: list[tuple[str, str, str]] = []
    rendered_rows: list[str] = []
    for line in section[header_index + 2 :]:
        if not line.strip():
            break
        if not line.startswith("|") or not line.endswith("|"):
            raise StateError(
                "invalid-feature-spec-set",
                "Feature Spec Set contains a malformed row",
            )
        cells = tuple(cell.strip() for cell in line[1:-1].split("|"))
        if len(cells) != 3 or any(not cell for cell in cells):
            raise StateError(
                "invalid-feature-spec-set",
                "Feature Spec Set rows require three nonempty cells",
            )
        row = (cells[0], cells[1], cells[2])
        rows.append(row)
        rendered_rows.append(f"| {row[0]} | {row[1]} | {row[2]} |")
    if len(rows) < 2:
        raise StateError(
            "invalid-feature-spec-set",
            "a linked Feature Spec Set requires at least two members",
        )
    if rows != sorted(rows, key=lambda row: row[1].encode("utf-8")):
        raise StateError(
            "invalid-feature-spec-set",
            "Feature Spec Set rows must be bytewise ordered by affected_repository",
        )
    refs = [row[0] for row in rows]
    repositories = [row[1] for row in rows]
    if len(refs) != len(set(refs)) or len(repositories) != len(set(repositories)):
        raise StateError(
            "invalid-feature-spec-set",
            "Feature Spec Set refs and repositories must be unique",
        )
    if any(ref.startswith("proposed-spec:") for ref in refs):
        raise StateError(
            "invalid-feature-spec-set",
            "applied Feature Spec Set rows cannot contain proposed refs",
        )
    canonical = "\n".join((header, delimiter, *rendered_rows))
    return rows, canonical


def parse_member_contract(body: str) -> dict[str, Any]:
    planning = markdown_section(body, "## Planning Identity")
    feature_id = metadata_value(
        planning,
        "Feature ID",
        re.compile(r"^- Feature ID: `([^`]+)`\.$"),
    )
    if FEATURE_ID_RE.fullmatch(feature_id) is None:
        raise StateError(
            "invalid-feature-spec-set",
            "Feature ID must be one canonical lowercase UUID",
        )
    repository_key = metadata_value(
        planning,
        "Repository key",
        re.compile(r"^- Repository key: `([^`]+)`\.$"),
    )
    if (
        REPOSITORY_KEY_RE.fullmatch(repository_key) is None
        or len(repository_key) > 48
    ):
        raise StateError(
            "invalid-feature-spec-set",
            "Repository key must be lower-kebab and at most 48 characters",
        )
    criteria: list[str] = []
    criterion_pattern = re.compile(
        r"^- \[[ xX]\] `([^`]+)`\s+\S.*$"
    )
    checklist_pattern = re.compile(r"^- \[[ xX]\](?:\s|$)")
    for line in markdown_section(body, "## Acceptance Criteria"):
        if checklist_pattern.match(line) is None:
            continue
        match = criterion_pattern.fullmatch(line)
        if match is None:
            raise StateError(
                "invalid-feature-spec-set",
                "every linked acceptance checklist item requires the canonical "
                "backticked criterion ID prefix and nonempty outcome",
            )
        criterion_id = match.group(1)
        if CRITERION_ID_RE.fullmatch(criterion_id) is None:
            raise StateError(
                "invalid-feature-spec-set",
                f"invalid linked acceptance criterion ID: {criterion_id}",
            )
        criteria.append(criterion_id)
    if not criteria:
        raise StateError(
            "invalid-feature-spec-set",
            "each linked member requires at least one identified acceptance criterion",
        )
    proofs: list[str] = []
    proof_pattern = re.compile(r"^- Proof ID: `([^`]+)`\.$")
    integration_heading = "## Integration Execution Contract"
    integration_present = integration_heading in body.splitlines()
    for line in markdown_section(
        body,
        integration_heading,
        required=False,
    ):
        match = proof_pattern.fullmatch(line)
        if line.startswith("- Proof ID:") and match is None:
            raise StateError(
                "invalid-feature-spec-set",
                "each Proof ID line must use the canonical backticked form",
            )
        if match is None:
            continue
        proof_id = match.group(1)
        if PROOF_ID_RE.fullmatch(proof_id) is None:
            raise StateError(
                "invalid-feature-spec-set",
                f"invalid combined proof ID: {proof_id}",
            )
        proofs.append(proof_id)
    if integration_present and not proofs:
        raise StateError(
            "invalid-feature-spec-set",
            "an Integration Execution Contract requires at least one canonical Proof ID",
        )
    owned_ids = criteria + proofs
    if len(owned_ids) != len(set(owned_ids)):
        raise StateError(
            "invalid-feature-spec-set",
            "criterion and proof IDs must be unique inside a member",
        )
    if any(not value.startswith(f"{repository_key}:") for value in owned_ids):
        raise StateError(
            "invalid-feature-spec-set",
            "criterion and proof IDs must use the member repository key",
        )
    rows, canonical_table = parse_feature_spec_set_table(body)
    return {
        "feature_id": feature_id,
        "repository_key": repository_key,
        "owned_ids": owned_ids,
        "rows": rows,
        "canonical_table": canonical_table,
    }


def linked_source_projection(
    source_spec_ref: str,
    affected_repository: str,
    *,
    error_code: str,
) -> None:
    github_match = (
        GITHUB_SPEC_REF_RE.fullmatch(source_spec_ref)
        or GITHUB_SPEC_URL_RE.fullmatch(source_spec_ref)
    )
    if github_match is None:
        raise StateError(
            error_code,
            "a linked source ref must be a canonical GitHub issue ref or URL",
        )
    owner, repository, _ = github_match.groups()
    if affected_repository != f"github:{owner}/{repository}":
        raise StateError(
            error_code,
            "a linked GitHub source ref must belong to affected_repository",
        )
    return None


def validate_feature_spec_set_input(raw: dict[str, Any]) -> dict[str, Any]:
    exact_keys(
        raw,
        {"schema", "schema_version", "members"},
        "Feature Spec Set input",
    )
    require_protocol(raw, "feature_spec_set_input", "Feature Spec Set input")
    raw_members = raw["members"]
    if not isinstance(raw_members, list) or len(raw_members) < 2:
        raise StateError(
            "invalid-feature-spec-set",
            "Feature Spec Set input requires at least two members",
        )
    members: list[dict[str, Any]] = []
    for index, item in enumerate(raw_members):
        if not isinstance(item, dict):
            raise StateError(
                "invalid-input",
                f"members[{index}] must be an object",
            )
        exact_keys(
            item,
            {"source_spec_ref", "affected_repository", "body_file"},
            f"members[{index}]",
        )
        source_spec_ref = string(
            item["source_spec_ref"],
            f"members[{index}].source_spec_ref",
            4096,
        )
        if source_spec_ref.startswith("proposed-spec:"):
            raise StateError(
                "invalid-feature-spec-set",
                "applied member input cannot use a proposed source ref",
            )
        affected_repository = string(
            item["affected_repository"],
            f"members[{index}].affected_repository",
            8192,
        )
        body_file = string(
            item["body_file"],
            f"members[{index}].body_file",
            8192,
        )
        contract = parse_member_contract(
            read_text_file(body_file, f"members[{index}].body_file")
        )
        linked_source_projection(
            source_spec_ref,
            affected_repository,
            error_code="invalid-feature-spec-set",
        )
        members.append(
            {
                "source_spec_ref": source_spec_ref,
                "affected_repository": affected_repository,
                **contract,
            }
        )
    feature_ids = {member["feature_id"] for member in members}
    repository_keys = [member["repository_key"] for member in members]
    source_refs = [member["source_spec_ref"] for member in members]
    repositories = [member["affected_repository"] for member in members]
    if len(feature_ids) != 1:
        raise StateError(
            "invalid-feature-spec-set",
            "every linked member must use the same Feature ID",
        )
    if len(repository_keys) != len(set(repository_keys)):
        raise StateError(
            "invalid-feature-spec-set",
            "repository keys must be unique inside the linked set",
        )
    if len(source_refs) != len(set(source_refs)) or len(repositories) != len(
        set(repositories)
    ):
        raise StateError(
            "invalid-feature-spec-set",
            "member refs and affected repositories must be unique",
        )
    canonical_tables = {member["canonical_table"] for member in members}
    if len(canonical_tables) != 1:
        raise StateError(
            "invalid-feature-spec-set",
            "every linked member must carry the exact same normalized Feature Spec Set",
        )
    expected_pairs = set(zip(source_refs, repositories, strict=True))
    table_rows = members[0]["rows"]
    observed_pairs = {(row[0], row[1]) for row in table_rows}
    if observed_pairs != expected_pairs or len(table_rows) != len(members):
        raise StateError(
            "invalid-feature-spec-set",
            "Feature Spec Set rows must exactly match the supplied members",
        )
    member_by_repository = {
        member["affected_repository"]: member for member in members
    }
    all_owned_ids: list[str] = []
    for member in members:
        self_rows = [
            row
            for row in member["rows"]
            if row[1] == member["affected_repository"]
        ]
        if len(self_rows) != 1 or self_rows[0][0] != member["source_spec_ref"]:
            raise StateError(
                "invalid-feature-spec-set",
                "each member requires one matching self row",
            )
        all_owned_ids.extend(member["owned_ids"])
    if len(all_owned_ids) != len(set(all_owned_ids)):
        raise StateError(
            "invalid-feature-spec-set",
            "criterion and proof IDs must be globally unique across the set",
        )
    for source_ref, repository, responsibility in table_rows:
        owner = member_by_repository[repository]
        if owner["source_spec_ref"] != source_ref:
            raise StateError(
                "invalid-feature-spec-set",
                "Feature Spec Set self refs do not match member identities",
            )
        inline_values = INLINE_CODE_RE.findall(responsibility)
        responsibility_ids = [
            value
            for value in inline_values
            if CRITERION_ID_RE.fullmatch(value) is not None
            or PROOF_ID_RE.fullmatch(value) is not None
        ]
        malformed_inline_ids = [
            value
            for value in inline_values
            if OWNED_ID_LIKE_RE.search(value)
            and value not in responsibility_ids
        ]
        prose_without_inline_code = INLINE_CODE_RE.sub("", responsibility)
        if (
            malformed_inline_ids
            or OWNED_ID_LIKE_RE.search(prose_without_inline_code)
            or len(responsibility_ids) != len(set(responsibility_ids))
            or set(responsibility_ids) != set(owner["owned_ids"])
        ):
            raise StateError(
                "invalid-feature-spec-set",
                "each responsibility cell must own exactly that member's criterion "
                "and proof IDs as canonical inline-code tokens",
            )
    feature_id = next(iter(feature_ids))
    manifest_members = [
        {
            "source_spec_ref": member["source_spec_ref"],
            "repository_identity": member["affected_repository"],
            "repository_key": member["repository_key"],
        }
        for member in sorted(
            members,
            key=lambda member: member["affected_repository"].encode("utf-8"),
        )
    ]
    return {
        "feature_id": feature_id,
        "member_count": len(members),
        "members": [
            {
                "source_spec_ref": member["source_spec_ref"],
                "affected_repository": member["affected_repository"],
                "repository_key": member["repository_key"],
                "owned_ids": member["owned_ids"],
            }
            for member in sorted(
                members,
                key=lambda member: member["affected_repository"].encode("utf-8"),
            )
        ],
        "canonical_feature_spec_set": [
            {
                "feature_spec_ref": row[0],
                "affected_repository": row[1],
                "responsibility": row[2],
            }
            for row in table_rows
        ],
        "manifest_feature_set": {
            "feature_id": feature_id,
            "members": manifest_members,
        },
        "writes_performed": False,
    }


def command_feature_spec_set_validate(args: argparse.Namespace) -> dict[str, Any]:
    return validate_feature_spec_set_input(
        read_json_file(args.input, "Feature Spec Set input")
    )


def validate_feature_spec_set_evidence(
    manifest_feature_sets: list[dict[str, Any]],
    input_paths: list[str],
) -> None:
    observed = [
        validate_feature_spec_set_input(
            read_json_file(path, f"Feature Spec Set evidence input {index}")
        )["manifest_feature_set"]
        for index, path in enumerate(input_paths)
    ]
    observed.sort(key=lambda item: item["feature_id"].encode("utf-8"))
    if manifest_feature_sets != observed:
        raise StateError(
            "invalid-feature-spec-set-evidence",
            "run start requires each feature_sets entry to equal the current "
            "read-only validator projection from one supplied evidence input",
        )


def string(value: Any, field: str, maximum: int = 2048) -> str:
    if not isinstance(value, str) or not value.strip() or len(value) > maximum:
        raise StateError("invalid-input", f"{field} must be a nonempty string up to {maximum} characters")
    return value


def token(value: Any, field: str) -> str:
    result = string(value, field, 128)
    if not TOKEN_RE.fullmatch(result):
        raise StateError("invalid-input", f"{field} is not canonical")
    return result


def head(value: Any, field: str) -> str:
    result = string(value, field, 64)
    if not HEAD_RE.fullmatch(result):
        raise StateError("invalid-input", f"{field} must be a lowercase Git SHA")
    return result


def directory(value: Any, field: str) -> str:
    path = Path(string(value, field, 4096))
    if not path.is_absolute() or path.is_symlink() or not path.is_dir():
        raise StateError("invalid-input", f"{field} must be an absolute real directory")
    return str(path.resolve())


def absolute_path(value: Any, field: str) -> str:
    path_text = string(value, field, 4096)
    if "\x00" in path_text:
        raise StateError("invalid-input", f"{field} must not contain NUL bytes")
    path = Path(path_text)
    if not path.is_absolute():
        raise StateError("invalid-input", f"{field} must be an absolute path")
    return os.path.normpath(str(path))


def absent_path(value: Any, field: str) -> str:
    path = Path(absolute_path(value, field))
    try:
        parent = path.parent.resolve()
    except (OSError, RuntimeError, ValueError) as error:
        raise StateError(
            "invalid-input",
            f"{field} parent cannot be resolved",
        ) from error
    return str(parent / path.name)


def branch_name(value: Any) -> str:
    result = string(value, "target_branch_name", 255)
    invalid = (
        result.startswith(("-", "/"))
        or result.endswith(("/", "."))
        or ".." in result
        or "//" in result
        or any(character.isspace() or character in "~^:?*[\\" for character in result)
    )
    if invalid:
        raise StateError("invalid-input", "target_branch_name is not canonical")
    return result


def repository_identity(value: Any, git_common_dir: str) -> str:
    identity = string(value, "repository_identity", 8192)
    if GITHUB_ID_RE.fullmatch(identity) is None:
        raise StateError(
            "invalid-input",
            "repository_identity must be github:owner/repository",
        )
    return identity


def canonical_source_spec_ref(value: Any, identity: str) -> tuple[str, str]:
    source_ref = string(value, "source_spec_ref", 4096)
    github_repository = GITHUB_ID_RE.fullmatch(identity)
    if github_repository is None:
        raise StateError(
            "invalid-input",
            "GitHub source refs require a github:owner/repository identity",
        )
    match = GITHUB_SPEC_REF_RE.fullmatch(source_ref) or GITHUB_SPEC_URL_RE.fullmatch(source_ref)
    if match is None:
        raise StateError(
            "invalid-input",
            "source_spec_ref must be owner/repository#number or its canonical GitHub issue URL",
        )
    owner, repository, number = match.groups()
    if (owner, repository) != github_repository.groups():
        raise StateError("invalid-input", "source_spec_ref belongs to another repository")
    return source_ref, f"github:{owner}/{repository}#{number}"


def validate_manifest(raw: dict[str, Any]) -> tuple[dict[str, Any], list[dict[str, Any]], list[dict[str, Any]]]:
    exact_keys(
        raw,
        {
            "schema",
            "schema_version",
            "runtime_contract_version",
            "run_id",
            "root_task_id",
            "controller_project_id",
            "repositories",
            "assignments",
            "feature_sets",
        },
        "manifest",
    )
    require_protocol(raw, "run_manifest", "manifest")
    if raw["runtime_contract_version"] != RUNTIME_CONTRACT_VERSION:
        raise StateError(
            "runtime-contract-mismatch",
            f"manifest runtime_contract_version must be {RUNTIME_CONTRACT_VERSION}",
        )
    run = {
        "run_id": token(raw["run_id"], "run_id"),
        "root_task_id": string(raw["root_task_id"], "root_task_id", 256),
        "controller_project_id": string(
            raw["controller_project_id"],
            "controller_project_id",
            256,
        ),
        "runtime_contract_version": RUNTIME_CONTRACT_VERSION,
        "runtime_cli_version": CLI_VERSION,
        "runtime_artifact_sha256": current_runtime_sha256(),
    }
    if not isinstance(raw["repositories"], list) or not raw["repositories"]:
        raise StateError("invalid-input", "repositories must be a nonempty list")
    repositories: list[dict[str, Any]] = []
    identities: set[str] = set()
    project_ids: set[str] = set()
    git_common_identities: set[tuple[int, int]] = set()
    for index, item in enumerate(raw["repositories"]):
        if not isinstance(item, dict):
            raise StateError("invalid-input", f"repositories[{index}] must be an object")
        exact_keys(
            item,
            {"repository_identity", "git_common_dir", "project_id"},
            f"repositories[{index}]",
        )
        common_dir = directory(item["git_common_dir"], f"repositories[{index}].git_common_dir")
        identity = repository_identity(item["repository_identity"], common_dir)
        if identity in identities:
            raise StateError("invalid-input", "repository identities must be unique")
        info = Path(common_dir).stat()
        project_id = string(
            item["project_id"],
            f"repositories[{index}].project_id",
            256,
        )
        git_common_identity = (info.st_dev, info.st_ino)
        if project_id in project_ids:
            raise StateError(
                "invalid-input",
                "each affected repository must use a distinct saved project",
            )
        if git_common_identity in git_common_identities:
            raise StateError(
                "invalid-input",
                "Git common-directory identities must be unique",
            )
        repositories.append({
            "repository_identity": identity,
            "project_id": project_id,
            "git_common_dir": common_dir,
            "device": info.st_dev,
            "inode": info.st_ino,
        })
        identities.add(identity)
        project_ids.add(project_id)
        git_common_identities.add(git_common_identity)
    if not isinstance(raw["assignments"], list) or not raw["assignments"]:
        raise StateError("invalid-input", "assignments must be a nonempty list")
    assignments: list[dict[str, Any]] = []
    assignment_ids: set[str] = set()
    claim_spec_identities: set[tuple[str, str]] = set()
    delivery_pairs: set[tuple[str, str]] = set()
    used_identities: set[str] = set()
    keys = {
        "assignment_id", "source_spec_ref", "repository_identity", "title",
        "target_branch_name", "prerequisite_assignment_ids",
    }
    for index, item in enumerate(raw["assignments"]):
        if not isinstance(item, dict):
            raise StateError("invalid-input", f"assignments[{index}] must be an object")
        exact_keys(item, keys, f"assignments[{index}]")
        assignment_id = token(item["assignment_id"], f"assignments[{index}].assignment_id")
        identity = string(item["repository_identity"], f"assignments[{index}].repository_identity", 8192)
        if identity not in identities:
            raise StateError("invalid-input", f"assignments[{index}] uses an undeclared repository")
        source_spec_ref, claim_spec_identity = canonical_source_spec_ref(
            item["source_spec_ref"], identity
        )
        target_branch = branch_name(item["target_branch_name"])
        pair = (identity, target_branch)
        claim_key = (identity, claim_spec_identity)
        if assignment_id in assignment_ids or claim_key in claim_spec_identities or pair in delivery_pairs:
            raise StateError(
                "invalid-input",
                "assignment ids, canonical Feature Specs, and repository/branch pairs must be unique",
            )
        prerequisites = item["prerequisite_assignment_ids"]
        if (
            not isinstance(prerequisites, list)
            or any(not isinstance(value, str) for value in prerequisites)
        ):
            raise StateError(
                "invalid-input", "prerequisite_assignment_ids must be a list of assignment ids"
            )
        normalized_prerequisites = [
            token(value, f"assignments[{index}].prerequisite_assignment_ids")
            for value in prerequisites
        ]
        if len(normalized_prerequisites) != len(set(normalized_prerequisites)):
            raise StateError("invalid-input", "prerequisite assignment ids must be unique")
        assignments.append({
            "assignment_id": assignment_id,
            "source_spec_ref": source_spec_ref,
            "claim_spec_identity": claim_spec_identity,
            "feature_id": None,
            "repository_identity": identity,
            "title": (
                f"{WORKER_TASK_TITLE_PREFIX}"
                f"{feature_spec_title_from_worker_task_title(item['title'], f'assignments[{index}].title')}"
            ),
            "target_branch_name": target_branch,
            "prerequisite_assignment_ids": normalized_prerequisites,
        })
        assignment_ids.add(assignment_id)
        claim_spec_identities.add(claim_key)
        delivery_pairs.add(pair)
        used_identities.add(identity)
    if used_identities != identities:
        raise StateError("invalid-input", "every repository must own an assignment")
    known_assignment_ids = {item["assignment_id"] for item in assignments}
    for assignment in assignments:
        prerequisites = assignment["prerequisite_assignment_ids"]
        if assignment["assignment_id"] in prerequisites or not set(prerequisites).issubset(
            known_assignment_ids
        ):
            raise StateError(
                "invalid-input", "prerequisite_assignment_ids must name other assignments in this run"
            )
    remaining = {item["assignment_id"]: set(item["prerequisite_assignment_ids"]) for item in assignments}
    resolved: set[str] = set()
    while remaining:
        ready = {assignment_id for assignment_id, deps in remaining.items() if deps <= resolved}
        if not ready:
            raise StateError("invalid-input", "assignment prerequisites must be acyclic")
        resolved.update(ready)
        for assignment_id in ready:
            del remaining[assignment_id]
    if not isinstance(raw["feature_sets"], list):
        raise StateError("invalid-input", "feature_sets must be a list")
    assignment_by_member = {
        (item["source_spec_ref"], item["repository_identity"]): item
        for item in assignments
    }
    used_members: set[tuple[str, str]] = set()
    feature_ids: set[str] = set()
    feature_repository_keys: set[tuple[str, str]] = set()
    for set_index, feature_set in enumerate(raw["feature_sets"]):
        if not isinstance(feature_set, dict):
            raise StateError(
                "invalid-input",
                f"feature_sets[{set_index}] must be an object",
            )
        exact_keys(
            feature_set,
            {"feature_id", "members"},
            f"feature_sets[{set_index}]",
        )
        feature_id = string(
            feature_set["feature_id"],
            f"feature_sets[{set_index}].feature_id",
            36,
        )
        if FEATURE_ID_RE.fullmatch(feature_id) is None:
            raise StateError(
                "invalid-input",
                "feature_sets feature_id must be one canonical lowercase UUID",
            )
        if feature_id in feature_ids:
            raise StateError("invalid-input", "feature_ids must be unique in one run")
        feature_ids.add(feature_id)
        members = feature_set["members"]
        if not isinstance(members, list) or len(members) < 2:
            raise StateError(
                "invalid-input",
                "each feature_set requires at least two members",
            )
        set_members: list[tuple[str, str]] = []
        set_repositories: set[str] = set()
        for member_index, member in enumerate(members):
            if not isinstance(member, dict):
                raise StateError(
                    "invalid-input",
                    f"feature_sets[{set_index}].members[{member_index}] must be an object",
                )
            exact_keys(
                member,
                {
                    "source_spec_ref",
                    "repository_identity",
                    "repository_key",
                },
                f"feature_sets[{set_index}].members[{member_index}]",
            )
            repository_key = string(
                member["repository_key"],
                f"feature_sets[{set_index}].members[{member_index}].repository_key",
                48,
            )
            if REPOSITORY_KEY_RE.fullmatch(repository_key) is None:
                raise StateError(
                    "invalid-input",
                    "feature_set repository_key must be lower-kebab and at most "
                    "48 characters",
                )
            feature_repository_key = (feature_id, repository_key)
            if feature_repository_key in feature_repository_keys:
                raise StateError(
                    "invalid-input",
                    "repository keys must be unique inside one feature_set",
                )
            member_key = (
                string(
                    member["source_spec_ref"],
                    f"feature_sets[{set_index}].members[{member_index}].source_spec_ref",
                    4096,
                ),
                string(
                    member["repository_identity"],
                    f"feature_sets[{set_index}].members[{member_index}].repository_identity",
                    8192,
                ),
            )
            if member_key not in assignment_by_member:
                raise StateError(
                    "invalid-input",
                    "feature_set members must exactly match run assignments",
                )
            if member_key in used_members or member_key in set_members:
                raise StateError(
                    "invalid-input",
                    "one assignment may belong to only one feature_set",
                )
            if member_key[1] in set_repositories:
                raise StateError(
                    "invalid-input",
                    "one linked feature may own only one member per repository",
                )
            linked_source_projection(
                member_key[0],
                member_key[1],
                error_code="invalid-input",
            )
            set_members.append(member_key)
            set_repositories.add(member_key[1])
            feature_repository_keys.add(feature_repository_key)
        for member_key in set_members:
            assignment_by_member[member_key]["feature_id"] = feature_id
            used_members.add(member_key)
    return run, repositories, assignments


def get_run(
    connection: sqlite3.Connection,
    run_id: str,
    *,
    require_runtime_match: bool = True,
) -> sqlite3.Row:
    row = connection.execute("SELECT * FROM runs WHERE run_id=?", (run_id,)).fetchone()
    if row is None:
        raise StateError("run-not-found", f"run does not exist: {run_id}", 3)
    if require_runtime_match:
        expected = (
            RUNTIME_CONTRACT_VERSION,
            CLI_VERSION,
            current_runtime_sha256(),
        )
        observed = (
            row["runtime_contract_version"],
            row["runtime_cli_version"],
            row["runtime_artifact_sha256"],
        )
        if observed != expected:
            raise StateError(
                "retained-runtime-required",
                "this run is pinned to another exact run-state artifact; resume it with "
                f"runtime_contract_version={row['runtime_contract_version']}, "
                f"cli_version={row['runtime_cli_version']}, "
                f"sha256={row['runtime_artifact_sha256']}",
                4,
            )
    return row


def get_assignment(connection: sqlite3.Connection, run_id: str, assignment_id: str) -> sqlite3.Row:
    row = connection.execute(
        """SELECT a.*,rr.project_id
           FROM assignments a
           JOIN run_repositories rr
             ON rr.run_id=a.run_id
            AND rr.repository_identity=a.repository_identity
           WHERE a.run_id=? AND a.assignment_id=?""",
        (run_id, assignment_id),
    ).fetchone()
    if row is None:
        raise StateError("assignment-not-found", f"assignment does not exist: {assignment_id}", 3)
    return row


def require_revision(run: sqlite3.Row, expected: int) -> None:
    if run["revision"] != expected:
        raise StateError("revision-conflict", f"expected revision {expected}, current revision is {run['revision']}", 4)


def advance(connection: sqlite3.Connection, run: sqlite3.Row) -> int:
    expected_revision = run["revision"]
    revision = expected_revision + 1
    updated = connection.execute(
        """UPDATE runs SET revision=?,updated_at=?
           WHERE run_id=? AND revision=?""",
        (revision, utc_now(), run["run_id"], expected_revision),
    ).rowcount
    if updated != 1:
        raise StateError(
            "revision-conflict",
            f"run revision changed before guarded update: {run['run_id']}",
            4,
        )
    return revision


def reserve_single_use_operation(
    connection: sqlite3.Connection,
    run_id: str,
    action: str,
    subject_id: str,
    operation_id: str,
    created_at: str,
) -> None:
    connection.execute(
        """INSERT INTO app_operation_reservations(
               run_id,action,subject_id,operation_id,created_at
           ) VALUES (?,?,?,?,?)
           ON CONFLICT(run_id,action,subject_id) DO NOTHING""",
        (run_id, action, subject_id, operation_id, created_at),
    )
    if connection.execute("SELECT changes()").fetchone()[0] == 1:
        return
    existing = connection.execute(
        """SELECT r.operation_id AS reservation_operation_id,
                  o.operation_id,o.action,o.subject_id,o.status
           FROM app_operation_reservations r
             LEFT JOIN app_operations o
             ON o.run_id=r.run_id AND o.operation_id=r.operation_id
           WHERE r.run_id=? AND r.action=? AND r.subject_id=?""",
        (run_id, action, subject_id),
    ).fetchone()
    if (
        existing is None
        or existing["operation_id"] is None
        or existing["action"] != action
        or existing["subject_id"] != subject_id
    ):
        raise StateError(
            "invalid-state-schema",
            "single-use operation reservation does not reference its recorded operation",
            4,
        )
    raise StateError(
        "protected-operation-already-started",
        f"{action} already uses {existing['operation_id']} "
        f"({existing['status']}); reconcile or replay that exact operation",
        4,
    )


def active_spec_owner(
    connection: sqlite3.Connection,
    repository: str,
    claim_spec_identity: str,
) -> dict[str, Any] | None:
    row = connection.execute(
        """SELECT c.repository_identity,c.claim_spec_identity,c.run_id,c.assignment_id,
                  r.root_task_id,a.thread_id,a.state
           FROM spec_claims c
           JOIN runs r ON r.run_id=c.run_id
           JOIN assignments a ON a.run_id=c.run_id AND a.assignment_id=c.assignment_id
           WHERE c.active=1 AND c.repository_identity=? AND c.claim_spec_identity=?""",
        (repository, claim_spec_identity),
    ).fetchone()
    return dict(row) if row else None


def active_assignment_conflict(
    connection: sqlite3.Connection,
    repository: str,
    claim_spec_identity: str,
    target_branch_name: str,
) -> dict[str, Any] | None:
    row = connection.execute(
        """SELECT c.repository_identity,c.claim_spec_identity,c.target_branch_name,
                  c.run_id,c.assignment_id,r.root_task_id,a.thread_id,a.state,
                  CASE WHEN c.claim_spec_identity=? THEN 'feature-spec' ELSE 'head-branch' END AS conflict_kind
           FROM spec_claims c
           JOIN runs r ON r.run_id=c.run_id
           JOIN assignments a ON a.run_id=c.run_id AND a.assignment_id=c.assignment_id
           WHERE c.active=1 AND c.repository_identity=?
             AND (c.claim_spec_identity=? OR c.target_branch_name=?)
           ORDER BY CASE WHEN c.claim_spec_identity=? THEN 0 ELSE 1 END
           LIMIT 1""",
        (
            claim_spec_identity, repository, claim_spec_identity,
            target_branch_name, claim_spec_identity,
        ),
    ).fetchone()
    return dict(row) if row else None


def assignment_claim(connection: sqlite3.Connection, run_id: str, assignment_id: str) -> sqlite3.Row:
    row = connection.execute(
        "SELECT * FROM spec_claims WHERE run_id=? AND assignment_id=?",
        (run_id, assignment_id),
    ).fetchone()
    if row is None:
        raise StateError("claim-not-found", f"assignment has no claim: {assignment_id}", 3)
    return row


def recompute_run_status(connection: sqlite3.Connection, run_id: str) -> str:
    states = [
        row[0]
        for row in connection.execute(
            "SELECT state FROM assignments WHERE run_id=? ORDER BY assignment_id", (run_id,)
        )
    ]
    runnable = {"planned", "worker-created", "active", "peer-input-ready"}
    blockers = {
        "blocked-durable-contract", "blocked-app-capability",
        "blocked-scope-repair",
        "blocked-by-active-spec", "abandoned-recovery-required", "abandoned",
    }
    if any(state in runnable for state in states):
        status = "active"
    elif any(state == "waiting-for-spec" for state in states):
        status = "waiting-for-spec"
    elif any(state in blockers for state in states):
        status = "blocked"
    elif states and all(state == "pr-ready" for state in states):
        status = "active"
    elif states and all(state == "preimplementation-aborted" for state in states):
        status = "active"
    else:
        status = "blocked"
    connection.execute("UPDATE runs SET status=? WHERE run_id=?", (status, run_id))
    return status


def insert_run(
    connection: sqlite3.Connection,
    run: dict[str, str],
    repositories: list[dict[str, Any]],
    assignments: list[dict[str, Any]],
    conflicts: dict[str, dict[str, Any]],
) -> tuple[list[str], list[dict[str, Any]]]:
    now = utc_now()
    acquired = [item["assignment_id"] for item in assignments if item["assignment_id"] not in conflicts]
    status = "active" if acquired else "waiting-for-spec"
    connection.execute(
        """INSERT INTO runs(
               run_id,root_task_id,controller_project_id,runtime_contract_version,
               runtime_cli_version,runtime_artifact_sha256,status,revision,created_at,updated_at
           ) VALUES (?,?,?,?,?,?,?,1,?,?)""",
        (
            run["run_id"],
            run["root_task_id"],
            run["controller_project_id"],
            run["runtime_contract_version"],
            run["runtime_cli_version"],
            run["runtime_artifact_sha256"],
            status,
            now,
            now,
        ),
    )
    repositories_by_identity = {item["repository_identity"]: item for item in repositories}
    for repository in repositories:
        connection.execute(
            """INSERT INTO run_repositories(
                   run_id,repository_identity,project_id,git_common_dir,
                   git_common_dir_device,git_common_dir_inode
               ) VALUES (?,?,?,?,?,?)""",
            (
                run["run_id"],
                repository["repository_identity"],
                repository["project_id"],
                repository["git_common_dir"],
                repository["device"],
                repository["inode"],
            ),
        )
    waiting: list[dict[str, Any]] = []
    for assignment in assignments:
        conflict = conflicts.get(assignment["assignment_id"])
        state = "waiting-for-spec" if conflict else "planned"
        connection.execute(
            """INSERT INTO assignments(
                run_id,assignment_id,source_spec_ref,claim_spec_identity,repository_identity,
                title,target_branch_name,
                prerequisite_assignment_ids,state,waiting_owner_run_id,
                waiting_owner_assignment_id,waiting_owner_root_task_id,updated_at,
                feature_id
            ) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
            (
                run["run_id"], assignment["assignment_id"], assignment["source_spec_ref"],
                assignment["claim_spec_identity"], assignment["repository_identity"],
                assignment["title"], assignment["target_branch_name"],
                canonical_json(assignment["prerequisite_assignment_ids"]), state,
                conflict["run_id"] if conflict else None,
                conflict["assignment_id"] if conflict else None,
                conflict["root_task_id"] if conflict else None, now,
                assignment["feature_id"],
            ),
        )
        repository = repositories_by_identity[assignment["repository_identity"]]
        connection.execute(
            """INSERT INTO spec_claims(
                run_id,assignment_id,repository_identity,claim_spec_identity,target_branch_name,git_common_dir,
                git_common_dir_device,git_common_dir_inode,active,acquired_at
            ) VALUES (?,?,?,?,?,?,?,?,?,?)""",
            (
                run["run_id"], assignment["assignment_id"], assignment["repository_identity"],
                assignment["claim_spec_identity"], assignment["target_branch_name"], repository["git_common_dir"],
                repository["device"], repository["inode"], 0 if conflict else 1,
                None if conflict else now,
            ),
        )
        if conflict:
            waiting.append({"assignment_id": assignment["assignment_id"], "owner": conflict})
    return acquired, waiting


def active_owner_runs(connection: sqlite3.Connection) -> int:
    return int(
        connection.execute(
            "SELECT COUNT(*) FROM runs WHERE status IN ('waiting-for-spec','active','blocked')"
        ).fetchone()[0]
    )


def inspect_state(connection: sqlite3.Connection) -> int:
    tables = {
        row[0]
        for row in connection.execute(
            "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'"
        )
    }
    if not tables:
        raise StateError(
            "state-uninitialized",
            f"database schema {DATABASE_SCHEMA_VERSION} has not been initialized",
            3,
        )
    if "runtime_metadata" not in tables:
        raise StateError(
            "unsupported-state-schema",
            "unversioned state is not supported",
            4,
        )
    validate_schema_shape(connection)
    return active_owner_runs(connection)


def version_capabilities() -> dict[str, Any]:
    return {
        "cli_version": CLI_VERSION,
        "runtime_contract_version": RUNTIME_CONTRACT_VERSION,
        "runtime_artifact_sha256": current_runtime_sha256(),
        "database_schema_version": DATABASE_SCHEMA_VERSION,
        "protocols": {
            name: {
                "schema": protocol["schema"],
                "version": protocol["schema_version"],
            }
            for name, protocol in sorted(PROTOCOLS.items())
        },
    }


def command_capabilities(_: argparse.Namespace) -> dict[str, Any]:
    return version_capabilities()


def command_doctor(_: argparse.Namespace) -> dict[str, Any]:
    path = database_path()
    if not path.exists():
        return {
            "ready": True,
            "state": "uninitialized",
            "database_path": str(path),
            **version_capabilities(),
            "busy_timeout_ms": SQLITE_BUSY_TIMEOUT_MS,
            "active_owner_runs": 0,
            "writes_performed": False,
        }
    validate_database(path)
    connection = open_database(path, write=False)
    try:
        active = inspect_state(connection)
    finally:
        connection.close()
    return {
        "ready": True,
        "state": "initialized",
        "database_path": str(path),
        "observed_database_schema_version": DATABASE_SCHEMA_VERSION,
        **version_capabilities(),
        "busy_timeout_ms": SQLITE_BUSY_TIMEOUT_MS,
        "active_owner_runs": active,
        "writes_performed": False,
    }


def command_state_prepare(args: argparse.Namespace) -> dict[str, Any]:
    path = database_path()
    if not path.exists():
        ensure_private_cache_root()
        try:
            descriptor = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        except FileExistsError:
            pass
        else:
            os.close(descriptor)
    validate_database(path)
    connection = open_database(path, write=True)
    try:
        connection.execute("BEGIN EXCLUSIVE")
        tables = {
            row[0]
            for row in connection.execute(
                "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'"
            )
        }
        if not tables:
            create_schema(connection)
            connection.commit()
            return {
                "ready": True,
                "state": "initialized",
                "database_schema_version": DATABASE_SCHEMA_VERSION,
                "active_owner_runs": 0,
                "writes_performed": True,
            }
        active = inspect_state(connection)
        connection.commit()
        return {
            "ready": True,
            "state": "initialized",
            "database_schema_version": DATABASE_SCHEMA_VERSION,
            "active_owner_runs": active,
            "writes_performed": False,
        }
    except Exception:
        connection.rollback()
        raise
    finally:
        connection.close()


def command_run_start(args: argparse.Namespace) -> dict[str, Any]:
    manifest = read_json_file(args.manifest, "manifest")
    run, repositories, assignments = validate_manifest(manifest)
    validate_feature_spec_set_evidence(
        manifest["feature_sets"],
        args.feature_spec_set_input,
    )
    connection = connect(write=True)
    try:
        if connection.execute("SELECT 1 FROM runs WHERE run_id=?", (run["run_id"],)).fetchone():
            raise StateError("run-already-exists", f"run already exists: {run['run_id']}", 4)
        root_owner = connection.execute(
            """SELECT run_id,status FROM runs
               WHERE root_task_id=? AND status IN ('waiting-for-spec','active','blocked')""",
            (run["root_task_id"],),
        ).fetchone()
        if root_owner:
            raise StateError(
                "root-task-already-active",
                f"root task already owns unfinished run {root_owner['run_id']} ({root_owner['status']})",
                4,
            )
        conflicts: dict[str, dict[str, Any]] = {}
        for assignment in assignments:
            conflict = active_assignment_conflict(
                connection, assignment["repository_identity"], assignment["claim_spec_identity"],
                assignment["target_branch_name"],
            )
            if conflict:
                conflicts[assignment["assignment_id"]] = conflict
        acquired, waiting = insert_run(connection, run, repositories, assignments, conflicts)
        connection.commit()
        return {
            "run_id": run["run_id"], "revision": 1,
            "status": "active" if acquired else "waiting-for-spec",
            "acquired_assignment_ids": acquired,
            "waiting_assignments": waiting,
            "may_create_worker": bool(acquired),
            "max_unchanged_wait_sweeps": MAX_UNCHANGED_WAIT_SWEEPS,
        }
    except Exception:
        connection.rollback()
        raise
    finally:
        connection.close()


def command_run_wait_sweep(args: argparse.Namespace) -> dict[str, Any]:
    run_id = token(args.run_id, "run_id")
    assignment_id = token(args.assignment_id, "assignment_id")
    connection = connect(write=True)
    try:
        run = get_run(connection, run_id)
        require_revision(run, args.expected_revision)
        assignment = get_assignment(connection, run_id, assignment_id)
        if assignment["state"] not in {"waiting-for-spec", "blocked-by-active-spec"}:
            raise StateError("assignment-not-waiting", f"assignment is {assignment['state']}", 4)
        conflict = active_assignment_conflict(
            connection, assignment["repository_identity"], assignment["claim_spec_identity"],
            assignment["target_branch_name"],
        )
        if not conflict:
            now = utc_now()
            connection.execute(
                "UPDATE spec_claims SET active=1,acquired_at=? WHERE run_id=? AND assignment_id=?",
                (now, run_id, assignment_id),
            )
            connection.execute(
                """UPDATE assignments SET state='planned',unchanged_wait_sweeps=0,
                   waiting_owner_run_id=NULL,waiting_owner_assignment_id=NULL,
                   waiting_owner_root_task_id=NULL,updated_at=?
                   WHERE run_id=? AND assignment_id=?""",
                (now, run_id, assignment_id),
            )
            revision = advance(connection, run)
            connection.execute("UPDATE runs SET status='active' WHERE run_id=?", (run_id,))
            connection.commit()
            return {
                "run_id": run_id, "revision": revision, "assignment_id": assignment_id,
                "state": "planned", "claim_acquired": True, "may_create_worker": True,
            }
        unchanged_owner = (
            assignment["waiting_owner_run_id"] == conflict["run_id"]
            and assignment["waiting_owner_assignment_id"] == conflict["assignment_id"]
        )
        sweeps = assignment["unchanged_wait_sweeps"] + 1 if unchanged_owner else 1
        terminal = sweeps >= MAX_UNCHANGED_WAIT_SWEEPS
        state = "blocked-by-active-spec" if terminal else "waiting-for-spec"
        revision = advance(connection, run)
        connection.execute(
            """UPDATE assignments SET state=?,unchanged_wait_sweeps=?,waiting_owner_run_id=?,
               waiting_owner_assignment_id=?,waiting_owner_root_task_id=?,updated_at=?
               WHERE run_id=? AND assignment_id=?""",
            (
                state, sweeps, conflict["run_id"], conflict["assignment_id"],
                conflict["root_task_id"], utc_now(), run_id, assignment_id,
            ),
        )
        status = recompute_run_status(connection, run_id)
        connection.commit()
        return {
            "run_id": run_id, "revision": revision, "assignment_id": assignment_id,
            "state": state, "run_status": status, "claim_acquired": False,
            "may_create_worker": False, "unchanged_wait_sweeps": sweeps,
            "conflicting_owner": conflict,
        }
    except Exception:
        connection.rollback()
        raise
    finally:
        connection.close()


def assignment_projection(
    row: sqlite3.Row,
) -> dict[str, Any]:
    return dict(row)


def command_run_show(args: argparse.Namespace) -> dict[str, Any]:
    connection = connect(write=False)
    try:
        run = get_run(
            connection,
            token(args.run_id, "run_id"),
            require_runtime_match=False,
        )
        repositories = [
            dict(row)
            for row in connection.execute(
                """SELECT repository_identity,project_id,git_common_dir,
                          git_common_dir_device,git_common_dir_inode
                   FROM run_repositories
                   WHERE run_id=?
                   ORDER BY repository_identity""",
                (run["run_id"],),
            )
        ]
        assignments = [
            assignment_projection(row)
            for row in connection.execute(
                """SELECT a.*,rr.project_id
                   FROM assignments a
                   JOIN run_repositories rr
                     ON rr.run_id=a.run_id
                    AND rr.repository_identity=a.repository_identity
                   WHERE a.run_id=?
                   ORDER BY a.assignment_id""",
                (run["run_id"],),
            )
        ]
        claims = [dict(row) for row in connection.execute("SELECT * FROM spec_claims WHERE run_id=? ORDER BY assignment_id", (run["run_id"],))]
        unresolved = [dict(row) for row in connection.execute("SELECT sequence,operation_id,action,subject_id,status,launch_count FROM app_operations WHERE run_id=? AND status IN ('pending','unknown') ORDER BY sequence", (run["run_id"],))]
        result = dict(run)
        result.update({
            "repositories": repositories,
            "assignments": assignments,
            "spec_claims": claims,
            "unresolved_app_operations": unresolved,
        })
        return result
    finally:
        connection.close()


def command_run_list(args: argparse.Namespace) -> dict[str, Any]:
    connection = connect(write=False)
    try:
        if args.status == "all":
            rows = connection.execute("SELECT run_id,root_task_id,controller_project_id,runtime_contract_version,runtime_cli_version,runtime_artifact_sha256,status,revision,created_at,updated_at,finished_at FROM runs ORDER BY created_at DESC")
        else:
            rows = connection.execute("SELECT run_id,root_task_id,controller_project_id,runtime_contract_version,runtime_cli_version,runtime_artifact_sha256,status,revision,created_at,updated_at,finished_at FROM runs WHERE status=? ORDER BY created_at DESC", (args.status,))
        return {"runs": [dict(row) for row in rows]}
    finally:
        connection.close()


def command_claim_find(args: argparse.Namespace) -> dict[str, Any]:
    identity = string(args.repository_identity, "repository_identity", 8192)
    _, claim_spec_identity = canonical_source_spec_ref(
        args.source_spec_ref, identity
    )
    connection = connect(write=False)
    try:
        owner = active_spec_owner(connection, identity, claim_spec_identity)
        return {
            "repository_identity": identity,
            "claim_spec_identity": claim_spec_identity,
            "owner": owner,
        }
    finally:
        connection.close()


def validate_app_begin(connection: sqlite3.Connection, run: sqlite3.Row, action: str, subject_id: str) -> str | None:
    if action not in APP_ACTIONS:
        raise StateError("invalid-app-action", f"unsupported Codex task action: {action}")
    scope_repair_action = action in {
        "create-scope-repair-task",
        "send-scope-revision",
    }
    if run["status"] != "active" and not (
        scope_repair_action and run["status"] == "blocked"
    ):
        raise StateError("run-not-active", f"Codex task changes require active claimed state, found {run['status']}", 4)
    assignment_id: str | None = None
    if action in {
        "create-worker",
        "create-scope-repair-task",
        "send-bootstrap",
        "send-scope-revision",
        "send-worker-message",
        "archive-worker",
    }:
        assignment = get_assignment(connection, run["run_id"], subject_id)
        assignment_id = assignment["assignment_id"]
        claim = assignment_claim(connection, run["run_id"], assignment_id)
        if not claim["active"]:
            raise StateError(
                "assignment-claim-not-active",
                "worker task changes require the assignment's active Feature Spec claim",
                4,
            )
        if action == "create-worker":
            if assignment["state"] != "planned":
                raise StateError("invalid-assignment-transition", "worker creation requires a planned assignment", 4)
        elif action == "create-scope-repair-task":
            if assignment["state"] != "blocked-scope-repair":
                raise StateError(
                    "invalid-assignment-transition",
                    "planner task creation requires a scope-repair-blocked assignment",
                    4,
                )
        elif action == "send-bootstrap":
            if assignment["state"] != "worker-created":
                raise StateError("invalid-assignment-transition", "bootstrap requires a created worker", 4)
            created = connection.execute(
                """SELECT observed_title FROM app_operations
                   WHERE run_id=? AND assignment_id=?
                     AND action='create-worker' AND status='succeeded'""",
                (run["run_id"], assignment_id),
            ).fetchone()
            if created is None or created["observed_title"] != assignment["title"]:
                raise StateError(
                    "worker-title-not-verified",
                    "bootstrap requires atomic worker creation with verified title readback",
                    4,
                )
        elif action == "send-scope-revision":
            if assignment["state"] != "blocked-scope-repair":
                raise StateError(
                    "invalid-assignment-transition",
                    "scope revision requires a scope-repair-blocked assignment",
                    4,
                )
        elif action == "send-worker-message" and assignment["state"] not in {
            "active", "peer-input-ready"
        }:
            raise StateError("invalid-assignment-transition", "worker messages require an active worker", 4)
        elif action == "archive-worker" and assignment["state"] != "worker-created":
            raise StateError("implementation-already-started", "archive is allowed only before this assignment's bootstrap authority", 4)
        if action == "archive-worker":
            bootstrap = connection.execute(
                """SELECT status FROM app_operations
                   WHERE run_id=? AND assignment_id=? AND action='send-bootstrap'
                     AND status IN ('pending','unknown','succeeded')
                   ORDER BY sequence DESC LIMIT 1""",
                (run["run_id"], assignment["assignment_id"]),
            ).fetchone()
            if bootstrap:
                raise StateError(
                    "bootstrap-reconciliation-required",
                    "archive requires proof that bootstrap was never delivered",
                    4,
                )
    elif subject_id != run["root_task_id"]:
        raise StateError("invalid-app-subject", "root Codex action subject must be root_task_id", 4)
    return assignment_id


def validate_scope_repair_observation(
    connection: sqlite3.Connection,
    assignment: sqlite3.Row,
    value: dict[str, Any],
) -> dict[str, Any]:
    exact_keys(
        value,
        {
            "schema",
            "schema_version",
            "run_id",
            "assignment_id",
            "contract_generation",
            "repair_id",
            "repair_outcome",
            "source_spec_ref",
            "implementation_issue_ref",
            "planning_thread_id",
            "planning_result_ref",
            "authoritative_readback_ref",
        },
        "scope repair observation",
    )
    require_protocol(value, "scope_repair_observation", "scope repair observation")
    generation = value["contract_generation"]
    if (
        isinstance(generation, bool)
        or not isinstance(generation, int)
        or generation < 1
    ):
        raise StateError(
            "invalid-scope-repair-observation",
            "contract_generation must be a positive integer",
        )
    normalized = {
        "run_id": token(value["run_id"], "run_id"),
        "assignment_id": token(value["assignment_id"], "assignment_id"),
        "contract_generation": generation,
        "repair_id": token(value["repair_id"], "repair_id"),
        "repair_outcome": string(value["repair_outcome"], "repair_outcome", 32),
        "source_spec_ref": string(value["source_spec_ref"], "source_spec_ref", 4096),
        "implementation_issue_ref": string(
            value["implementation_issue_ref"],
            "implementation_issue_ref",
            4096,
        ),
        "planning_thread_id": string(
            value["planning_thread_id"],
            "planning_thread_id",
            256,
        ),
        "planning_result_ref": string(
            value["planning_result_ref"],
            "planning_result_ref",
            2048,
        ),
        "authoritative_readback_ref": string(
            value["authoritative_readback_ref"],
            "authoritative_readback_ref",
            2048,
        ),
    }
    if normalized["repair_outcome"] not in {"applied", "no-op"}:
        raise StateError(
            "invalid-scope-repair-observation",
            "repair_outcome must be applied or no-op",
        )
    _, implementation_issue_identity = canonical_source_spec_ref(
        normalized["implementation_issue_ref"],
        assignment["repository_identity"],
    )
    if implementation_issue_identity == assignment["claim_spec_identity"]:
        raise StateError(
            "invalid-scope-repair-observation",
            "implementation_issue_ref must identify a child implementation issue",
        )
    if (
        normalized["run_id"] != assignment["run_id"]
        or normalized["assignment_id"] != assignment["assignment_id"]
        or normalized["contract_generation"] != assignment["contract_generation"]
        or normalized["repair_id"] != assignment["scope_repair_id"]
        or normalized["source_spec_ref"] != assignment["source_spec_ref"]
    ):
        raise StateError(
            "scope-repair-observation-drift",
            "scope repair observation does not match the blocked assignment generation",
            4,
        )
    planner = connection.execute(
        """SELECT thread_id FROM app_operations
           WHERE run_id=? AND assignment_id=?
             AND action='create-scope-repair-task'
             AND scope_repair_id=? AND status='succeeded'
           ORDER BY sequence DESC LIMIT 1""",
        (
            assignment["run_id"],
            assignment["assignment_id"],
            assignment["scope_repair_id"],
        ),
    ).fetchone()
    if planner is None or planner["thread_id"] != normalized["planning_thread_id"]:
        raise StateError(
            "scope-repair-planner-not-verified",
            "scope revision requires the successful recorded planner task",
            4,
        )
    return normalized


def command_app_operation_begin(args: argparse.Namespace) -> dict[str, Any]:
    run_id = token(args.run_id, "run_id")
    action = string(args.action, "action", 80)
    subject_id = string(args.subject_id, "subject_id", 256)
    scope_repair_input = args.scope_repair_observation
    if action == "send-scope-revision":
        if scope_repair_input is None:
            raise StateError(
                "invalid-input",
                "send-scope-revision requires --scope-repair-observation",
            )
    elif scope_repair_input is not None:
        raise StateError(
            "invalid-input",
            "--scope-repair-observation is valid only for send-scope-revision",
        )
    connection = connect(write=True)
    try:
        run = get_run(connection, run_id)
        require_revision(run, args.expected_revision)
        assignment_id = validate_app_begin(connection, run, action, subject_id)
        assignment = (
            get_assignment(connection, run_id, assignment_id)
            if assignment_id is not None
            else None
        )
        scope_observed = (
            validate_scope_repair_observation(
                connection,
                assignment,
                read_json_file(
                    scope_repair_input,
                    "scope repair observation",
                ),
            )
            if action == "send-scope-revision" and assignment is not None
            else None
        )
        operation_id = new_operation_id()
        now = utc_now()
        if action in SINGLE_USE_ACTIONS:
            reserve_single_use_operation(
                connection,
                run_id,
                action,
                subject_id,
                operation_id,
                now,
            )
        operation_generation = None
        operation_repair_id = None
        provider_observation_ref = None
        if action == "create-scope-repair-task" and assignment is not None:
            operation_generation = assignment["contract_generation"]
            operation_repair_id = assignment["scope_repair_id"]
        elif action == "send-scope-revision" and scope_observed is not None:
            operation_generation = scope_observed["contract_generation"] + 1
            operation_repair_id = scope_observed["repair_id"]
            connection.execute(
                """UPDATE assignments SET scope_repair_readback_ref=?,updated_at=?
                   WHERE run_id=? AND assignment_id=?""",
                (
                    scope_observed["authoritative_readback_ref"],
                    now,
                    run_id,
                    assignment_id,
                ),
            )
        connection.execute(
            """INSERT INTO app_operations(
                   run_id,operation_id,action,subject_id,assignment_id,status,
                   launch_count,observed_state,provider_observation_ref,
                   created_at,updated_at,contract_generation,scope_repair_id
               ) VALUES (?,?,?,?,?,'pending',1,?,?,?,?,?,?)""",
            (
                run_id,
                operation_id,
                action,
                subject_id,
                assignment_id,
                None,
                provider_observation_ref,
                now,
                now,
                operation_generation,
                operation_repair_id,
            ),
        )
        revision = advance(connection, run)
        connection.commit()
        result = {
            "run_id": run_id,
            "revision": revision,
            "operation_id": operation_id,
            "status": "pending",
            "launch_count": 1,
            "launch_authorized": True,
        }
        if action == "send-bootstrap":
            result["bootstrap_id"] = bootstrap_id_for(operation_id)
        elif action == "create-scope-repair-task":
            result["repair_id"] = operation_repair_id
            result["contract_generation"] = operation_generation
            result["expected_title"] = scope_repair_task_title(assignment["title"])
        elif action == "send-scope-revision":
            result["repair_id"] = operation_repair_id
            result["contract_generation"] = operation_generation
            result["scope_revision_id"] = scope_revision_id_for(
                operation_id,
                operation_generation,
            )
        return result
    except Exception:
        connection.rollback()
        raise
    finally:
        connection.close()


def validate_operation_observation(operation: sqlite3.Row, value: dict[str, Any]) -> dict[str, Any]:
    if not APP_OPERATION_COMMON_FIELDS.issubset(value):
        raise StateError(
            "invalid-input",
            "Codex operation observation is missing fields: "
            f"{sorted(APP_OPERATION_COMMON_FIELDS - set(value))}",
        )
    require_protocol(
        value,
        "app_operation_observation",
        "Codex operation observation",
    )
    if value["operation_id"] != operation["operation_id"]:
        raise StateError(
            "operation-id-conflict",
            "observation operation_id differs from the recorded logical operation",
            4,
        )
    if (
        isinstance(value["launch_count"], bool)
        or not isinstance(value["launch_count"], int)
        or value["launch_count"] < 1
    ):
        raise StateError(
            "invalid-operation-observation",
            "launch_count must be a positive integer",
        )
    if value["launch_count"] != operation["launch_count"]:
        raise StateError(
            "stale-operation-launch",
            f"observation launch_count {value['launch_count']} does not match "
            f"current launch_count {operation['launch_count']}",
            4,
        )
    if value["status"] not in {"unknown", "succeeded", "failed"}:
        raise StateError(
            "invalid-operation-observation",
            "observation status must be unknown, succeeded, or failed",
        )
    expected_extra = APP_OPERATION_FIELDS_BY_ACTION[operation["action"]]
    actual_extra = set(value) - APP_OPERATION_COMMON_FIELDS
    if value["status"] == "succeeded":
        exact_keys(
            value,
            APP_OPERATION_COMMON_FIELDS
            | APP_OPERATION_RECONCILIATION_FIELDS
            | expected_extra,
            "Codex operation observation",
        )
    elif not actual_extra.issubset(
        APP_OPERATION_RECONCILIATION_FIELDS | expected_extra
    ):
        raise StateError(
            "invalid-input",
            "Codex operation observation has unsupported fields: "
            f"{sorted(actual_extra - APP_OPERATION_RECONCILIATION_FIELDS - expected_extra)}",
        )
    if value["status"] == "failed" and "readback_ref" not in value:
        raise StateError(
            "invalid-operation-observation",
            "failed status requires authoritative readback_ref; use unknown until readback exists",
        )
    if operation["action"] == "send-bootstrap" and "bootstrap_id" not in value:
        raise StateError(
            "invalid-operation-observation",
            "send-bootstrap observations must carry the recorded bootstrap_id",
        )
    if operation["action"] == "send-scope-revision" and not {
        "scope_revision_id",
        "contract_generation",
    }.issubset(value):
        raise StateError(
            "invalid-operation-observation",
            "send-scope-revision observations must carry the derived revision identity",
        )
    normalized: dict[str, Any] = {
        "operation_id": operation["operation_id"],
        "launch_count": operation["launch_count"],
        "status": value["status"],
    }
    for field in APP_OPERATION_RECONCILIATION_FIELDS & set(value):
        normalized[field] = string(value[field], field, 2048)
    for field in actual_extra - APP_OPERATION_RECONCILIATION_FIELDS:
        if field == "checkout_path" and operation["action"] == "archive-worker":
            normalized[field] = absent_path(value[field], field)
        elif field in {"checkout_path", "git_common_dir"}:
            normalized[field] = absolute_path(value[field], field)
        elif field == "contract_generation":
            generation = value[field]
            if (
                isinstance(generation, bool)
                or not isinstance(generation, int)
                or generation < 1
            ):
                raise StateError(
                    "invalid-operation-observation",
                    "contract_generation must be a positive integer",
                )
            normalized[field] = generation
        else:
            normalized[field] = string(value[field], field, 4096)
    if operation["action"] == "send-bootstrap" and "bootstrap_id" in normalized:
        if normalized["bootstrap_id"] != bootstrap_id_for(operation["operation_id"]):
            raise StateError(
                "bootstrap-id-drift",
                "bootstrap_id differs from the recorded logical bootstrap",
                4,
            )
    if operation["action"] == "send-scope-revision":
        expected_generation = operation["contract_generation"]
        if (
            normalized.get("contract_generation") != expected_generation
            or normalized.get("scope_revision_id")
            != scope_revision_id_for(operation["operation_id"], expected_generation)
        ):
            raise StateError(
                "scope-revision-id-drift",
                "scope revision identity differs from the recorded operation generation",
                4,
            )
    return normalized


def operation_observation_payload(
    operation: sqlite3.Row,
    *,
    launch_count: int,
    status: str,
    values: dict[str, Any],
) -> dict[str, Any]:
    if operation["action"] == "send-bootstrap":
        values = {**values, "bootstrap_id": bootstrap_id_for(operation["operation_id"])}
    elif operation["action"] == "send-scope-revision":
        values = {
            **values,
            "scope_revision_id": scope_revision_id_for(
                operation["operation_id"],
                operation["contract_generation"],
            ),
            "contract_generation": operation["contract_generation"],
        }
    payload: dict[str, Any] = {
        **protocol_fields("app_operation_observation"),
        "operation_id": operation["operation_id"],
        "launch_count": launch_count,
        "status": status,
    }
    payload.update({key: value for key, value in values.items() if value is not None})
    validate_operation_observation(operation, payload)
    return payload


def operation_observation_descriptor(action: str, status: str) -> dict[str, Any]:
    action = string(action, "action", 80)
    if action not in APP_ACTIONS:
        raise StateError("invalid-app-action", f"unsupported Codex task action: {action}")
    if status not in {"unknown", "succeeded", "failed"}:
        raise StateError("invalid-input", "status must be unknown, succeeded, or failed")
    required_fields = {"launch_count"}
    if status == "succeeded":
        required_fields.update(APP_OPERATION_RECONCILIATION_FIELDS)
        required_fields.update(APP_OPERATION_FIELDS_BY_ACTION[action])
    elif status == "failed":
        required_fields.add("readback_ref")
    constants = {
        **protocol_fields("app_operation_observation"),
        "operation_id": "generated-by-app-operation-begin",
        "status": status,
    }
    if action == "send-bootstrap":
        required_fields.discard("bootstrap_id")
        constants["bootstrap_id"] = "derived-from-operation-id"
    elif action == "send-scope-revision":
        required_fields.discard("scope_revision_id")
        required_fields.discard("contract_generation")
        constants["scope_revision_id"] = "derived-from-operation-id-and-generation"
        constants["contract_generation"] = "derived-from-blocked-assignment"
    possible_fields = (
        APP_OPERATION_RECONCILIATION_FIELDS
        | APP_OPERATION_FIELDS_BY_ACTION[action]
    ) - set(constants)
    required = sorted(required_fields)
    optional = sorted(possible_fields - required_fields)
    field_constraints: dict[str, dict[str, list[str]]] = {}
    if status == "succeeded" and action == "create-worker":
        field_constraints["observed_state"] = {
            "allowed_values": ["active", "idle"],
        }
    elif status == "succeeded" and action == "create-scope-repair-task":
        field_constraints["observed_state"] = {
            "allowed_values": ["active", "idle"],
        }
    elif status == "succeeded" and action == "archive-worker":
        field_constraints["observed_state"] = {
            "allowed_values": ["archived", "completed"],
        }
    return {
        "observation_kind": "app-operation",
        "action": action,
        "status": status,
        "constants": constants,
        "required_fields": required,
        "optional_fields": optional,
        "field_constraints": field_constraints,
        "additional_fields": False,
    }


def command_app_operation_observation_template(args: argparse.Namespace) -> dict[str, Any]:
    return operation_observation_descriptor(args.action, args.status)


def atomic_write_json(path_text: str, value: dict[str, Any]) -> str:
    path = Path(path_text)
    if not path.is_absolute() or path.is_symlink() or not path.parent.is_dir():
        raise StateError(
            "invalid-output-path",
            "output must be an absolute new file in an existing directory",
        )
    try:
        descriptor, temporary = tempfile.mkstemp(
            prefix=f".{path.name}.",
            suffix=".tmp",
            dir=path.parent,
            text=True,
        )
    except OSError as error:
        raise StateError(
            "output-write-failed",
            f"cannot create output beside {path}",
            4,
        ) from error
    try:
        try:
            os.fchmod(descriptor, 0o600)
            handle = os.fdopen(descriptor, "w", encoding="utf-8")
            descriptor = -1
            with handle:
                handle.write(canonical_json(value))
                handle.write("\n")
                handle.flush()
                os.fsync(handle.fileno())
            os.link(temporary, path)
        except FileExistsError as error:
            raise StateError(
                "output-already-exists",
                f"output already exists: {path}",
                4,
            ) from error
        except OSError as error:
            raise StateError(
                "output-write-failed",
                f"cannot write output: {path}",
                4,
            ) from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
    return str(path)


def operation_observation_values(args: argparse.Namespace) -> dict[str, Any]:
    return {
        field: getattr(args, field, None)
        for field in (
            "receipt_ref",
            "readback_ref",
            "thread_id",
            "project_id",
            "checkout_path",
            "git_common_dir",
            "observed_title",
            "observed_state",
        )
    }


def command_app_operation_observation_create(args: argparse.Namespace) -> dict[str, Any]:
    run_id = token(args.run_id, "run_id")
    operation_id = token(args.operation_id, "operation_id")
    connection = connect(write=False)
    try:
        run = get_run(connection, run_id)
        require_revision(run, args.expected_revision)
        operation = connection.execute(
            "SELECT * FROM app_operations WHERE run_id=? AND operation_id=?",
            (run_id, operation_id),
        ).fetchone()
        if operation is None:
            raise StateError("operation-not-found", f"operation does not exist: {operation_id}", 3)
        payload = operation_observation_payload(
            operation,
            launch_count=args.launch_count,
            status=args.status,
            values=operation_observation_values(args),
        )
    finally:
        connection.close()
    output = atomic_write_json(args.output, payload)
    return {
        "observation_kind": "app-operation",
        "operation_id": operation_id,
        "action": operation["action"],
        "status": args.status,
        "output": output,
        "artifact_written": True,
        "state_writes_performed": False,
    }


def apply_succeeded_app_effect(connection: sqlite3.Connection, run: sqlite3.Row, operation: sqlite3.Row, observed: dict[str, Any]) -> None:
    action = operation["action"]
    now = utc_now()
    if action == "create-worker":
        assignment = get_assignment(connection, run["run_id"], operation["assignment_id"])
        claim = assignment_claim(connection, run["run_id"], assignment["assignment_id"])
        checkout_path = directory(observed["checkout_path"], "checkout_path")
        git_common_dir = directory(observed["git_common_dir"], "git_common_dir")
        common = Path(git_common_dir).stat()
        if (common.st_dev, common.st_ino) != (claim["git_common_dir_device"], claim["git_common_dir_inode"]):
            raise StateError("worker-repository-drift", "worker Git common-directory identity differs from the claimed repository", 4)
        if (
            observed["project_id"] != assignment["project_id"]
            or observed["observed_state"] not in {"active", "idle"}
        ):
            raise StateError("worker-project-drift", "worker project or state differs from the assignment", 4)
        collision = connection.execute(
            """SELECT a.run_id,a.assignment_id FROM assignments a
               JOIN runs r ON r.run_id=a.run_id
               WHERE r.status IN ('active','blocked')
                 AND (a.thread_id=? OR a.checkout_path=?)
                 AND NOT (a.run_id=? AND a.assignment_id=?)
               LIMIT 1""",
            (
                observed["thread_id"], checkout_path, run["run_id"],
                assignment["assignment_id"],
            ),
        ).fetchone()
        if collision:
            raise StateError(
                "worker-identity-conflict",
                f"worker or checkout is already bound to {collision['run_id']}/{collision['assignment_id']}",
                4,
            )
        updated = connection.execute(
            """UPDATE assignments SET state='worker-created',thread_id=?,checkout_path=?,git_common_dir=?,updated_at=?
               WHERE run_id=? AND assignment_id=? AND state='planned'""",
            (
                observed["thread_id"],
                checkout_path,
                git_common_dir,
                now,
                run["run_id"],
                assignment["assignment_id"],
            ),
        ).rowcount
        if updated != 1:
            raise StateError(
                "assignment-state-conflict",
                "worker creation state changed before guarded update",
                4,
            )
    elif action == "create-scope-repair-task":
        assignment = get_assignment(
            connection,
            run["run_id"],
            operation["assignment_id"],
        )
        if (
            assignment["state"] != "blocked-scope-repair"
            or operation["scope_repair_id"] != assignment["scope_repair_id"]
            or operation["contract_generation"] != assignment["contract_generation"]
            or observed["project_id"] != assignment["project_id"]
            or observed["observed_state"] not in {"active", "idle"}
            or observed["observed_title"]
            != scope_repair_task_title(assignment["title"])
        ):
            raise StateError(
                "scope-repair-planner-drift",
                "planner task readback differs from the blocked assignment",
                4,
            )
        collision = connection.execute(
            """SELECT run_id,assignment_id FROM assignments
               WHERE thread_id=? LIMIT 1""",
            (observed["thread_id"],),
        ).fetchone()
        if collision is None:
            collision = connection.execute(
                """SELECT run_id,assignment_id FROM app_operations
                   WHERE action='create-scope-repair-task'
                     AND status='succeeded' AND thread_id=?
                     AND operation_id<>?
                   LIMIT 1""",
                (observed["thread_id"], operation["operation_id"]),
            ).fetchone()
        if collision:
            raise StateError(
                "scope-repair-planner-identity-conflict",
                "planner task is already bound to another runtime subject",
                4,
            )
    elif action == "set-root-title":
        assignment_count = connection.execute(
            "SELECT COUNT(*) FROM assignments WHERE run_id=?",
            (run["run_id"],),
        ).fetchone()[0]
        if observed["observed_title"] != root_task_title(assignment_count):
            raise StateError("root-title-drift", "root title readback differs from the immutable run title", 4)
    elif action == "send-bootstrap":
        assignment = get_assignment(connection, run["run_id"], operation["assignment_id"])
        if observed["thread_id"] != assignment["thread_id"]:
            raise StateError("worker-identity-drift", "bootstrap receipt belongs to another worker", 4)
        created = connection.execute(
            """SELECT observed_title FROM app_operations
               WHERE run_id=? AND assignment_id=?
                 AND action='create-worker' AND status='succeeded'""",
            (run["run_id"], assignment["assignment_id"]),
        ).fetchone()
        if created is None or created["observed_title"] != assignment["title"]:
            raise StateError(
                "worker-title-not-verified",
                "bootstrap requires atomic worker creation with verified title readback",
                4,
            )
        updated = connection.execute(
            """UPDATE assignments SET state='active',updated_at=?
               WHERE run_id=? AND assignment_id=? AND state='worker-created'""",
            (now, run["run_id"], assignment["assignment_id"]),
        ).rowcount
        if updated != 1:
            raise StateError(
                "assignment-state-conflict",
                "bootstrap state changed before guarded update",
                4,
            )
        connection.execute("UPDATE runs SET implementation_started=1 WHERE run_id=?", (run["run_id"],))
    elif action == "send-scope-revision":
        assignment = get_assignment(
            connection,
            run["run_id"],
            operation["assignment_id"],
        )
        if observed["thread_id"] != assignment["thread_id"]:
            raise StateError(
                "worker-identity-drift",
                "scope revision receipt belongs to another worker",
                4,
            )
        if (
            assignment["state"] != "blocked-scope-repair"
            or operation["scope_repair_id"] != assignment["scope_repair_id"]
            or operation["contract_generation"]
            != assignment["contract_generation"] + 1
            or observed["contract_generation"] != operation["contract_generation"]
            or observed["scope_revision_id"]
            != scope_revision_id_for(
                operation["operation_id"],
                operation["contract_generation"],
            )
        ):
            raise StateError(
                "scope-revision-drift",
                "scope revision does not match the blocked assignment generation",
                4,
            )
        restored = assignment["blocked_from_state"]
        if restored not in {"active", "peer-input-ready"}:
            raise StateError(
                "invalid-state-schema",
                "scope-repair-blocked assignment has no valid resume state",
                4,
            )
        if assignment["scope_repair_readback_ref"] is None:
            raise StateError(
                "scope-repair-readback-missing",
                "scope revision requires the authoritative planning readback",
                4,
            )
        updated = connection.execute(
            """UPDATE assignments
               SET state=?,blocked_from_state=NULL,
                   contract_generation=?,scope_repair_id=NULL,updated_at=?
               WHERE run_id=? AND assignment_id=? AND state='blocked-scope-repair'""",
            (
                restored,
                operation["contract_generation"],
                now,
                run["run_id"],
                assignment["assignment_id"],
            ),
        ).rowcount
        if updated != 1:
            raise StateError(
                "assignment-state-conflict",
                "scope-repair state changed before guarded update",
                4,
            )
        connection.execute(
            """UPDATE spec_claims SET recovery_readback_ref=?
               WHERE run_id=? AND assignment_id=?""",
            (
                assignment["scope_repair_readback_ref"],
                run["run_id"],
                assignment["assignment_id"],
            ),
        )
        recompute_run_status(connection, run["run_id"])
    elif action == "send-worker-message":
        assignment = get_assignment(connection, run["run_id"], operation["assignment_id"])
        if observed["thread_id"] != assignment["thread_id"]:
            raise StateError("worker-identity-drift", "message receipt belongs to another worker", 4)
    elif action == "archive-worker":
        assignment = get_assignment(connection, run["run_id"], operation["assignment_id"])
        if (
            observed["thread_id"] != assignment["thread_id"]
            or observed["observed_state"] not in {"archived", "completed"}
        ):
            raise StateError("worker-identity-drift", "archive readback is not terminal for the exact worker", 4)
        if observed["checkout_path"] != assignment["checkout_path"]:
            raise StateError(
                "worker-checkout-drift",
                "archive checkout readback differs from the recorded worker",
                4,
            )
        try:
            os.lstat(observed["checkout_path"])
        except OSError as error:
            if error.errno not in {errno.ENOENT, errno.ENOTDIR}:
                raise StateError(
                    "worker-checkout-inspection-failed",
                    "archive could not prove that the managed checkout is absent",
                    4,
                ) from error
        else:
            raise StateError(
                "worker-checkout-still-present",
                "archive requires authoritative proof that the managed checkout is absent",
                4,
            )
        updated = connection.execute(
            """UPDATE assignments SET state='preimplementation-aborted',updated_at=?
               WHERE run_id=? AND assignment_id=? AND state='worker-created'""",
            (now, run["run_id"], assignment["assignment_id"]),
        ).rowcount
        if updated != 1:
            raise StateError(
                "assignment-state-conflict",
                "archive state changed before guarded update",
                4,
            )


def app_operation_replay_authorized(
    action: str,
    status: str,
    readback_ref: str | None,
) -> bool:
    if not readback_ref or action not in PROTECTED_REPLAY_ACTIONS:
        return False
    if action in {"send-bootstrap", "send-scope-revision"}:
        return status in {"unknown", "failed"}
    return status == "failed"


def app_operation_effect_warning(
    connection: sqlite3.Connection,
    run: sqlite3.Row,
    operation: sqlite3.Row,
    observed: dict[str, Any],
) -> str | None:
    if operation["action"] != "create-worker" or observed["status"] != "succeeded":
        return None
    assignment = get_assignment(
        connection,
        run["run_id"],
        operation["assignment_id"],
    )
    if observed.get("observed_title") != assignment["title"]:
        return "worker-title-drift"
    return None


def command_app_operation_finish(args: argparse.Namespace) -> dict[str, Any]:
    run_id = token(args.run_id, "run_id")
    operation_id = token(args.operation_id, "operation_id")
    connection = connect(write=True)
    try:
        run = get_run(connection, run_id)
        operation = connection.execute(
            "SELECT * FROM app_operations WHERE run_id=? AND operation_id=?",
            (run_id, operation_id),
        ).fetchone()
        if operation is None:
            raise StateError("operation-not-found", f"operation does not exist: {operation_id}", 3)
        observed = validate_operation_observation(operation, read_json_file(args.observation, "Codex operation observation"))
        stored_values = {
            field: operation[field]
            for field in (
                "receipt_ref",
                "readback_ref",
                "thread_id",
                "project_id",
                "checkout_path",
                "git_common_dir",
                "observed_title",
                "provider_observation_ref",
                "head_sha",
                "pr_url",
                "observed_state",
            )
            if operation[field] is not None
            and not (
                operation["action"] == "send-bootstrap"
                and field == "observed_state"
            )
        }
        if operation["action"] == "send-bootstrap":
            stored_values["bootstrap_id"] = bootstrap_id_for(operation_id)
        elif operation["action"] == "send-scope-revision":
            stored_values["scope_revision_id"] = scope_revision_id_for(
                operation_id,
                operation["contract_generation"],
            )
            stored_values["contract_generation"] = operation["contract_generation"]
        stored_observation = {
            "operation_id": operation_id,
            "launch_count": operation["launch_count"],
            "status": operation["status"],
            **stored_values,
        }
        terminal_or_reconciled = operation["status"] in {
            "unknown",
            "succeeded",
            "failed",
        }
        if terminal_or_reconciled:
            if observed == stored_observation:
                effect_warning = app_operation_effect_warning(
                    connection,
                    run,
                    operation,
                    observed,
                )
                connection.rollback()
                result = {
                    "run_id": run_id,
                    "revision": run["revision"],
                    "operation_id": operation_id,
                    "status": operation["status"],
                    "launch_count": operation["launch_count"],
                    "already_applied": True,
                    "replay_authorized": app_operation_replay_authorized(
                        operation["action"],
                        operation["status"],
                        operation["readback_ref"],
                    ),
                }
                if effect_warning:
                    result["effect_warning"] = effect_warning
                    result["cleanup_required"] = "archive-worker"
                return result
        require_revision(run, args.expected_revision)
        if terminal_or_reconciled:
            if operation["status"] in {"succeeded", "failed"}:
                raise StateError(
                    "operation-observation-conflict",
                    f"operation is already {operation['status']} with different evidence",
                    4,
                )
            for field, stored_value in stored_values.items():
                if observed.get(field) != stored_value:
                    raise StateError(
                        "operation-observation-conflict",
                        "reconciliation updates may add evidence but cannot "
                        f"remove or replace {field}",
                        4,
                    )
        if observed["status"] == "succeeded":
            apply_succeeded_app_effect(connection, run, operation, observed)
        effect_warning = app_operation_effect_warning(
            connection,
            run,
            operation,
            observed,
        )
        values = {field: observed.get(field) for field in (
            "receipt_ref", "readback_ref", "thread_id", "project_id", "checkout_path",
            "git_common_dir", "observed_title", "provider_observation_ref", "head_sha", "pr_url", "observed_state"
        )}
        updated = connection.execute(
            """UPDATE app_operations SET status=?,receipt_ref=?,readback_ref=?,thread_id=?,project_id=?,
               checkout_path=?,git_common_dir=?,observed_title=?,provider_observation_ref=?,head_sha=?,pr_url=?,
               observed_state=?,updated_at=?
               WHERE run_id=? AND operation_id=? AND status=? AND launch_count=?""",
            (
                observed["status"],
                *(values[field] for field in values),
                utc_now(),
                run_id,
                operation_id,
                operation["status"],
                operation["launch_count"],
            ),
        ).rowcount
        if updated != 1:
            raise StateError(
                "operation-state-conflict",
                "app operation changed before guarded observation update",
                4,
            )
        revision = advance(connection, run)
        connection.commit()
        result = {
            "run_id": run_id,
            "revision": revision,
            "operation_id": operation_id,
            "status": observed["status"],
            "launch_count": operation["launch_count"],
            "already_applied": False,
            "replay_authorized": app_operation_replay_authorized(
                operation["action"],
                observed["status"],
                observed.get("readback_ref"),
            ),
        }
        if effect_warning:
            result["effect_warning"] = effect_warning
            result["cleanup_required"] = "archive-worker"
        return result
    except Exception:
        connection.rollback()
        raise
    finally:
        connection.close()


def command_app_operation_replay(args: argparse.Namespace) -> dict[str, Any]:
    run_id = token(args.run_id, "run_id")
    operation_id = token(args.operation_id, "operation_id")
    connection = connect(write=True)
    try:
        run = get_run(connection, run_id)
        require_revision(run, args.expected_revision)
        operation = connection.execute(
            "SELECT * FROM app_operations WHERE run_id=? AND operation_id=?",
            (run_id, operation_id),
        ).fetchone()
        if operation is None:
            raise StateError("operation-not-found", f"operation does not exist: {operation_id}", 3)
        action = operation["action"]
        if action not in PROTECTED_REPLAY_ACTIONS:
            raise StateError(
                "operation-replay-unsupported",
                f"{action} does not support logical-operation replay",
                4,
            )
        if not app_operation_replay_authorized(
            action,
            operation["status"],
            operation["readback_ref"],
        ):
            required_status = (
                "unknown or failed"
                if action in {"send-bootstrap", "send-scope-revision"}
                else "failed"
            )
            raise StateError(
                "operation-reconciliation-required",
                f"{action} replay requires {required_status} status with "
                f"authoritative readback_ref, found {operation['status']}",
                4,
            )
        replay_assignment_id = validate_app_begin(
            connection,
            run,
            action,
            operation["subject_id"],
        )
        if replay_assignment_id != operation["assignment_id"]:
            raise StateError(
                "invalid-state-schema",
                "replay subject no longer resolves to the recorded assignment",
                4,
            )
        updated = connection.execute(
            """UPDATE app_operations
               SET status='pending',launch_count=launch_count+1,receipt_ref=NULL,
                   readback_ref=NULL,thread_id=NULL,project_id=NULL,checkout_path=NULL,
                   git_common_dir=NULL,observed_title=NULL,provider_observation_ref=NULL,
                   head_sha=NULL,pr_url=NULL,observed_state=NULL,
                   updated_at=?
               WHERE run_id=? AND operation_id=? AND status=? AND launch_count=?""",
            (
                utc_now(),
                run_id,
                operation_id,
                operation["status"],
                operation["launch_count"],
            ),
        ).rowcount
        if updated != 1:
            raise StateError(
                "operation-state-conflict",
                "app operation changed before guarded replay update",
                4,
            )
        revision = advance(connection, run)
        connection.commit()
        result = {
            "run_id": run_id,
            "revision": revision,
            "operation_id": operation_id,
            "action": action,
            "status": "pending",
            "launch_count": operation["launch_count"] + 1,
            "launch_authorized": True,
        }
        if action == "send-bootstrap":
            result["bootstrap_id"] = bootstrap_id_for(operation_id)
        elif action == "create-scope-repair-task":
            result["repair_id"] = operation["scope_repair_id"]
            result["contract_generation"] = operation["contract_generation"]
            assignment = get_assignment(
                connection,
                run_id,
                operation["assignment_id"],
            )
            result["expected_title"] = scope_repair_task_title(assignment["title"])
        elif action == "send-scope-revision":
            result["repair_id"] = operation["scope_repair_id"]
            result["contract_generation"] = operation["contract_generation"]
            result["scope_revision_id"] = scope_revision_id_for(
                operation_id,
                operation["contract_generation"],
            )
        return result
    except Exception:
        connection.rollback()
        raise
    finally:
        connection.close()


def app_operation_projection(
    connection: sqlite3.Connection,
    row: sqlite3.Row,
) -> dict[str, Any]:
    value = dict(row)
    if value["action"] == "send-bootstrap":
        value["bootstrap_id"] = bootstrap_id_for(value["operation_id"])
    elif value["action"] == "create-scope-repair-task":
        assignment = get_assignment(
            connection,
            value["run_id"],
            value["assignment_id"],
        )
        value["expected_title"] = scope_repair_task_title(assignment["title"])
    elif value["action"] == "send-scope-revision":
        value["scope_revision_id"] = scope_revision_id_for(
            value["operation_id"],
            value["contract_generation"],
        )
    return value


def command_app_operation_list(args: argparse.Namespace) -> dict[str, Any]:
    if not 1 <= args.limit <= 200:
        raise StateError("invalid-input", "limit must be between 1 and 200")
    connection = connect(write=False)
    try:
        get_run(connection, token(args.run_id, "run_id"))
        rows = list(connection.execute("SELECT * FROM app_operations WHERE run_id=? AND sequence>? ORDER BY sequence LIMIT ?", (args.run_id, args.after_sequence, args.limit + 1)))
        visible = rows[:args.limit]
        return {
            "operations": [app_operation_projection(connection, row) for row in visible],
            "has_more": len(rows) > args.limit,
            "next_after_sequence": visible[-1]["sequence"] if visible else args.after_sequence,
        }
    finally:
        connection.close()


def ready_status() -> str:
    return "pr-ready-for-merge"


def validate_ready_observation_shape(value: dict[str, Any]) -> None:
    expected_keys = READY_COMMON_FIELDS | READY_GITHUB_FIELDS
    exact_keys(value, expected_keys, "delivery-ready observation")
    require_protocol(
        value,
        "delivery_ready_observation",
        "delivery-ready observation",
    )
    expected_status = ready_status()
    if value["status"] != expected_status:
        raise StateError(
            "invalid-ready-observation",
            "ready observation status must be pr-ready-for-merge",
        )
    if value["readiness_mode"] not in {"terminal", "peer-input"}:
        raise StateError(
            "invalid-ready-observation",
            "readiness_mode must be terminal or peer-input",
        )


def parse_prerequisite_heads(values: list[str]) -> dict[str, str]:
    result: dict[str, str] = {}
    for value in values:
        assignment_id, separator, sha = value.partition("=")
        if not separator:
            raise StateError(
                "invalid-input",
                "prerequisite-head must use ASSIGNMENT_ID=GIT_SHA",
            )
        assignment_id = token(assignment_id, "prerequisite_head.assignment_id")
        if assignment_id in result:
            raise StateError(
                "invalid-input",
                f"duplicate prerequisite-head for {assignment_id}",
            )
        result[assignment_id] = head(sha, f"prerequisite_heads.{assignment_id}")
    return result


def ready_observation_descriptor(
    review_profile: str,
    readiness_mode: str,
) -> dict[str, Any]:
    status = ready_status()
    if review_profile not in {"standard", "high-risk"}:
        raise StateError(
            "invalid-ready-observation",
            "review_profile must be standard or high-risk",
        )
    if readiness_mode not in {"terminal", "peer-input"}:
        raise StateError(
            "invalid-ready-observation",
            "readiness_mode must be terminal or peer-input",
        )
    constants: dict[str, Any] = {
        **protocol_fields("delivery_ready_observation"),
        "status": status,
        "review_profile": review_profile,
        "readiness_mode": readiness_mode,
    }
    required = set(READY_COMMON_FIELDS)
    required.update(READY_GITHUB_FIELDS)
    required -= set(constants)
    return {
        "observation_kind": "delivery-ready",
        "review_profile": review_profile,
        "readiness_mode": readiness_mode,
        "constants": constants,
        "required_fields": sorted(required),
        "optional_fields": [],
        "additional_fields": False,
    }


def command_assignment_ready_observation_template(
    args: argparse.Namespace,
) -> dict[str, Any]:
    return ready_observation_descriptor(
        args.review_profile,
        args.readiness_mode,
    )


def ready_observation_payload(
    args: argparse.Namespace,
    assignment: sqlite3.Row,
) -> dict[str, Any]:
    review_profile = string(args.review_profile, "review_profile", 32)
    if review_profile not in {"standard", "high-risk"}:
        raise StateError(
            "invalid-ready-observation",
            "review_profile must be standard or high-risk",
        )
    codex_review_head_sha = args.codex_review_head_sha
    if codex_review_head_sha is None:
        raise StateError(
            "invalid-ready-observation",
            "native Codex review requires codex_review_head_sha",
        )
    payload: dict[str, Any] = {
        **protocol_fields("delivery_ready_observation"),
        "assignment_id": assignment["assignment_id"],
        "thread_id": args.thread_id,
        "repository_identity": args.repository_identity,
        "readiness_mode": args.readiness_mode,
        "head_sha": args.head_sha,
        "head_branch_name": args.head_branch_name,
        "base_branch_name": args.base_branch_name,
        "base_sha": args.base_sha,
        "checkout_path": args.checkout_path,
        "worktree_clean": args.worktree_clean,
        "base_is_ancestor": args.base_is_ancestor,
        "validation_head_sha": args.validation_head_sha,
        "review_head_sha": args.review_head_sha,
        "review_candidate_head_sha": args.review_candidate_head_sha,
        "review_profile": review_profile,
        "codex_review_head_sha": codex_review_head_sha,
        "tracker_readback_ref": args.tracker_readback_ref,
        "prerequisite_heads": parse_prerequisite_heads(args.prerequisite_head),
        "status": ready_status(),
    }
    github_values = {
        "default_branch_name": args.default_branch_name,
        "pr_url": args.pr_url,
        "provider_observation_ref": args.provider_observation_ref,
    }
    payload.update(github_values)
    validate_ready_observation_shape(payload)
    return payload


def validate_ready_evidence(
    connection: sqlite3.Connection,
    run_id: str,
    assignment: sqlite3.Row,
    value: dict[str, Any],
) -> dict[str, Any]:
    assignment_id = assignment["assignment_id"]
    validate_ready_observation_shape(value)
    readiness_mode = value["readiness_mode"]
    peer_input = readiness_mode == "peer-input"
    if (
        assignment["state"] not in {"active", "peer-input-ready"}
        or value["thread_id"] != assignment["thread_id"]
    ):
        raise StateError(
            "invalid-assignment-transition",
            "ready evidence must belong to the active worker",
            4,
        )
    if peer_input:
        dependents = [
            row["prerequisite_assignment_ids"]
            for row in connection.execute(
                """SELECT prerequisite_assignment_ids FROM assignments
                   WHERE run_id=? AND assignment_id<>?""",
                (run_id, assignment_id),
            )
        ]
        if not any(assignment_id in json.loads(item) for item in dependents):
            raise StateError(
                "not-a-peer-prerequisite",
                "peer input readiness requires a dependent assignment",
                4,
            )
    if value["repository_identity"] != assignment["repository_identity"]:
        raise StateError(
            "repository-identity-drift",
            "ready evidence belongs to another repository",
            4,
        )
    if directory(value["checkout_path"], "checkout_path") != assignment["checkout_path"]:
        raise StateError(
            "worker-checkout-drift",
            "ready evidence belongs to another checkout",
            4,
        )
    observed_head = head(value["head_sha"], "head_sha")
    if value["head_branch_name"] != assignment["target_branch_name"]:
        raise StateError(
            "target-branch-drift",
            "head branch differs from the assignment",
            4,
        )
    base_branch = branch_name(value["base_branch_name"])
    base_sha = head(value["base_sha"], "base_sha")
    if value["worktree_clean"] is not True or value["base_is_ancestor"] is not True:
        raise StateError(
            "invalid-ready-observation",
            "delivery readiness requires a clean worktree and proven base ancestry",
        )
    for field in ("validation_head_sha", "review_head_sha"):
        if head(value[field], field) != observed_head:
            raise StateError(
                "stale-ready-evidence",
                f"{field} does not bind current HEAD",
                4,
            )
    review_profile = value["review_profile"]
    if review_profile not in {"standard", "high-risk"}:
        raise StateError(
            "invalid-ready-observation",
            "review_profile must be standard or high-risk",
        )
    codex_review_head = value["codex_review_head_sha"]
    head(value["review_candidate_head_sha"], "review_candidate_head_sha")
    if head(codex_review_head, "codex_review_head_sha") != observed_head:
        raise StateError(
            "stale-ready-evidence",
            "codex_review_head_sha does not bind current HEAD",
            4,
        )
    string(value["tracker_readback_ref"], "tracker_readback_ref", 2048)
    prerequisite_ids = json.loads(assignment["prerequisite_assignment_ids"])
    prerequisite_heads = value["prerequisite_heads"]
    if (
        not isinstance(prerequisite_heads, dict)
        or set(prerequisite_heads) != set(prerequisite_ids)
    ):
        raise StateError(
            "invalid-ready-observation",
            "prerequisite_heads must exactly match assignment prerequisites",
        )
    current_heads = {
        row["assignment_id"]: row["head_sha"]
        for row in connection.execute(
            "SELECT assignment_id,head_sha FROM assignments WHERE run_id=?",
            (run_id,),
        )
        if row["assignment_id"] in prerequisite_ids
    }
    normalized_heads = {
        prerequisite: head(
            prerequisite_heads[prerequisite],
            f"prerequisite_heads.{prerequisite}",
        )
        for prerequisite in prerequisite_ids
    }
    if normalized_heads != current_heads:
        raise StateError(
            "prerequisite-head-drift",
            "combined proof does not match the current prerequisite HEAD vector",
            4,
        )
    pr_url = None
    default_branch = None
    provider_observation_ref = None
    default_branch = branch_name(value["default_branch_name"])
    if base_branch != default_branch:
        raise StateError(
            "pull-request-base-drift",
            "PR base differs from the provider-observed default branch",
            4,
        )
    pull = GITHUB_PULL_RE.fullmatch(string(value["pr_url"], "pr_url", 2048))
    if pull is None:
        raise StateError(
            "invalid-ready-observation",
            "pr_url must be a canonical GitHub pull request URL",
        )
    github_identity = GITHUB_ID_RE.fullmatch(assignment["repository_identity"])
    if (
        github_identity is None
        or (pull.group(1), pull.group(2)) != github_identity.groups()
    ):
        raise StateError(
            "pull-request-repository-drift",
            "PR belongs to another repository",
            4,
        )
    pr_url = value["pr_url"]
    provider_observation_ref = string(
        value["provider_observation_ref"],
        "provider_observation_ref",
        2048,
    )
    terminal_state = "pr-ready"
    unresolved = connection.execute(
        """SELECT COUNT(*) FROM app_operations
           WHERE run_id=? AND assignment_id=? AND status IN ('pending','unknown')""",
        (run_id, assignment_id),
    ).fetchone()[0]
    if unresolved:
        raise StateError(
            "unresolved-app-operation",
            "reconcile assignment task changes before ready",
            4,
        )
    return {
        "readiness_mode": readiness_mode,
        "observed_head": observed_head,
        "base_branch": base_branch,
        "base_sha": base_sha,
        "pr_url": pr_url,
        "default_branch": default_branch,
        "provider_observation_ref": provider_observation_ref,
        "terminal_state": terminal_state,
    }


def command_assignment_ready_observation_create(
    args: argparse.Namespace,
) -> dict[str, Any]:
    run_id = token(args.run_id, "run_id")
    assignment_id = token(args.assignment_id, "assignment_id")
    connection = connect(write=False)
    try:
        run = get_run(connection, run_id)
        require_revision(run, args.expected_revision)
        if run["status"] != "active":
            raise StateError("run-not-active", f"run is {run['status']}", 4)
        assignment = get_assignment(connection, run_id, assignment_id)
        payload = ready_observation_payload(args, assignment)
        validate_ready_evidence(
            connection,
            run_id,
            assignment,
            payload,
        )
    finally:
        connection.close()
    output = atomic_write_json(args.output, payload)
    return {
        "observation_kind": "delivery-ready",
        "assignment_id": assignment_id,
        "readiness_mode": payload["readiness_mode"],
        "review_profile": args.review_profile,
        "output": output,
        "artifact_written": True,
        "state_writes_performed": False,
    }


def command_assignment_ready(args: argparse.Namespace) -> dict[str, Any]:
    value = read_json_file(args.observation, "delivery-ready observation")
    validate_ready_observation_shape(value)
    run_id = token(args.run_id, "run_id")
    assignment_id = token(value["assignment_id"], "assignment_id")
    connection = connect(write=True)
    try:
        run = get_run(connection, run_id)
        require_revision(run, args.expected_revision)
        if run["status"] != "active":
            raise StateError("run-not-active", f"run is {run['status']}", 4)
        assignment = get_assignment(connection, run_id, assignment_id)
        evidence = validate_ready_evidence(
            connection,
            run_id,
            assignment,
            value,
        )
        persisted_state = (
            "peer-input-ready"
            if evidence["readiness_mode"] == "peer-input"
            else evidence["terminal_state"]
        )
        updated = connection.execute(
            """UPDATE assignments SET state=?,head_sha=?,base_branch_name=?,base_sha=?,
               worktree_clean=1,base_is_ancestor=1,pr_url=?,default_branch_name=?,
               provider_observation_ref=?,updated_at=?
               WHERE run_id=? AND assignment_id=?
                 AND state IN ('active','peer-input-ready')""",
            (
                persisted_state,
                evidence["observed_head"],
                evidence["base_branch"],
                evidence["base_sha"],
                evidence["pr_url"],
                evidence["default_branch"],
                evidence["provider_observation_ref"],
                utc_now(),
                run_id,
                assignment_id,
            ),
        ).rowcount
        if updated != 1:
            raise StateError(
                "assignment-state-conflict",
                "assignment state changed before guarded ready update",
                4,
            )
        claim_released = False
        if evidence["readiness_mode"] == "terminal":
            now = utc_now()
            updated = connection.execute(
                """UPDATE spec_claims SET active=0,released_at=?,release_reason=?
                   WHERE run_id=? AND assignment_id=? AND active=1""",
                (now, evidence["terminal_state"], run_id, assignment_id),
            ).rowcount
            if updated != 1:
                raise StateError(
                    "assignment-claim-not-active",
                    "ready assignment has no active claim",
                    4,
                )
            claim_released = True
        recompute_run_status(connection, run_id)
        revision = advance(connection, run)
        connection.commit()
        return {
            "run_id": run_id,
            "revision": revision,
            "assignment_id": assignment_id,
            "state": persisted_state,
            "readiness_mode": evidence["readiness_mode"],
            "claim_released": claim_released,
        }
    except Exception:
        connection.rollback()
        raise
    finally:
        connection.close()


def command_assignment_block(args: argparse.Namespace) -> dict[str, Any]:
    run_id = token(args.run_id, "run_id")
    assignment_id = token(args.assignment_id, "assignment_id")
    connection = connect(write=True)
    try:
        run = get_run(connection, run_id)
        require_revision(run, args.expected_revision)
        assignment = get_assignment(connection, run_id, assignment_id)
        if assignment["state"] not in {"active", "peer-input-ready"}:
            raise StateError(
                "invalid-assignment-transition",
                "durable-contract blocking requires an active or peer-input-ready post-bootstrap worker",
                4,
            )
        updated = connection.execute(
            """UPDATE assignments
               SET state='blocked-durable-contract',blocked_from_state=?,updated_at=?
               WHERE run_id=? AND assignment_id=?
                 AND state IN ('active','peer-input-ready')""",
            (assignment["state"], utc_now(), run_id, assignment_id),
        ).rowcount
        if updated != 1:
            raise StateError(
                "assignment-state-conflict",
                "assignment state changed before guarded durable-contract block",
                4,
            )
        connection.execute(
            """UPDATE spec_claims SET recovery_readback_ref=NULL
               WHERE run_id=? AND assignment_id=?""",
            (run_id, assignment_id),
        )
        run_status = recompute_run_status(connection, run_id)
        revision = advance(connection, run)
        connection.commit()
        return {
            "run_id": run_id, "revision": revision, "assignment_id": assignment_id,
            "state": "blocked-durable-contract", "run_status": run_status,
            "claim_retained": True,
        }
    except Exception:
        connection.rollback()
        raise
    finally:
        connection.close()


