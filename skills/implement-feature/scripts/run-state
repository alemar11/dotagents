    )
    ready_create = ready_observation_commands.add_parser(
        "create",
        help="build one strict delivery-ready file without mutating run state",
    )
    ready_create.add_argument("--run-id", required=True)
    ready_create.add_argument("--expected-revision", type=int, required=True)
    ready_create.add_argument("--assignment-id", required=True)
    ready_create.add_argument("--thread-id", required=True)
    ready_create.add_argument("--repository-identity", required=True)
    ready_create.add_argument("--head-sha", required=True)
    ready_create.add_argument("--head-branch-name", required=True)
    ready_create.add_argument("--base-branch-name", required=True)
    ready_create.add_argument("--base-sha", required=True)
    ready_create.add_argument("--checkout-path", required=True)
    ready_create.add_argument("--worktree-clean", action="store_true", required=True)
    ready_create.add_argument("--base-is-ancestor", action="store_true", required=True)
    ready_create.add_argument("--validation-head-sha", required=True)
    ready_create.add_argument("--review-head-sha", required=True)
    ready_create.add_argument("--review-candidate-head-sha", required=True)
    ready_create.add_argument(
        "--review-profile",
        choices=("standard", "high-risk"),
        required=True,
    )
    ready_create.add_argument(
        "--readiness-mode",
        choices=("terminal", "peer-input"),
        required=True,
    )
    ready_create.add_argument("--codex-review-head-sha", required=True)
    ready_create.add_argument("--tracker-readback-ref", required=True)
    ready_create.add_argument(
