#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any


CLI_VERSION = "1.0.0"


class VerifyError(Exception):
    def __init__(self, code: str, message: str) -> None:
        super().__init__(message)
        self.code = code
        self.message = message


def run_git(checkout: Path, *arguments: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        ["git", "-C", str(checkout), *arguments],
        capture_output=True,
        text=True,
        check=False,
    )
    if check and result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or "git command failed"
        raise VerifyError("git-command-failed", detail)
    return result


def canonical_checkout(raw: str, label: str) -> Path:
    checkout = Path(raw).expanduser().resolve()
    if not checkout.is_dir():
        raise VerifyError("invalid-checkout", f"{label} is not a directory: {checkout}")
    if run_git(checkout, "rev-parse", "--is-inside-work-tree").stdout.strip() != "true":
        raise VerifyError("invalid-checkout", f"{label} is not a Git worktree: {checkout}")
    return checkout


def exact_sha(checkout: Path, revision: str, label: str) -> str:
    result = run_git(checkout, "rev-parse", "--verify", f"{revision}^{{commit}}")
    sha = result.stdout.strip()
    if len(sha) not in {40, 64}:
        raise VerifyError("invalid-git-head", f"{label} did not resolve to a full commit SHA")
    return sha


def require_clean(checkout: Path, label: str) -> None:
    status = run_git(checkout, "status", "--porcelain", "--untracked-files=all").stdout
    if status:
        raise VerifyError("dirty-worktree", f"{label} is not clean")


def review_candidate(args: argparse.Namespace) -> dict[str, Any]:
    checkout = canonical_checkout(args.checkout, "managed checkout")
    branch = run_git(checkout, "branch", "--show-current").stdout.strip()
    if branch != args.branch:
        raise VerifyError(
            "review-branch-mismatch",
            f"expected {args.branch}, observed {branch or 'detached HEAD'}",
        )

    require_clean(checkout, "managed checkout")
    base_sha = exact_sha(checkout, args.base_sha, "base SHA")
    head_sha = exact_sha(checkout, "HEAD", "candidate HEAD")
    ancestry = run_git(
        checkout,
        "merge-base",
        "--is-ancestor",
        base_sha,
        head_sha,
        check=False,
    )
    if ancestry.returncode != 0:
        raise VerifyError(
            "invalid-ancestry",
            "declared base SHA is not an ancestor of the candidate HEAD",
        )

    return {
        "checkout": str(checkout),
        "branch": branch,
        "base_sha": base_sha,
        "head_sha": head_sha,
        "clean": True,
        "ancestry_verified": True,
    }


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(description="Read-only terminal verification for implement-feature deliveries.")
    root.add_argument("--version", action="version", version=CLI_VERSION)
    root.add_argument("--json", action="store_true", help="emit a stable JSON result")
    commands = root.add_subparsers(dest="command", required=True)
    commands.add_parser("doctor", help="check local runtime dependencies")
    candidate = commands.add_parser(
        "review-candidate",
        help="read one authoritative clean branch candidate for review handoff",
    )
    candidate.add_argument("--checkout", required=True)
    candidate.add_argument("--branch", required=True)
    candidate.add_argument("--base-sha", required=True)
    return root


def emit(payload: dict[str, Any], as_json: bool) -> None:
    if as_json:
        print(json.dumps(payload, sort_keys=True, separators=(",", ":")))
    elif payload["ok"]:
        print(f"{payload['command']}: ok")
    else:
        print(f"{payload['error']['code']}: {payload['error']['message']}", file=sys.stderr)


def main() -> int:
    args = parser().parse_args()
    try:
        if args.command == "doctor":
            git = shutil.which("git")
            if git is None:
                raise VerifyError("missing-git", "git is not available on PATH")
            data: dict[str, Any] = {"git": git, "python": sys.executable}
        elif args.command == "review-candidate":
            data = review_candidate(args)
        else:
            raise VerifyError("unsupported-command", f"unsupported command: {args.command}")
        emit({"ok": True, "version": CLI_VERSION, "command": args.command, "data": data}, args.json)
        return 0
    except (OSError, UnicodeError, VerifyError) as error:
        failure = error if isinstance(error, VerifyError) else VerifyError("verification-io-error", str(error))
        emit(
            {
                "ok": False,
                "version": CLI_VERSION,
                "command": args.command,
                "error": {"code": failure.code, "message": failure.message},
            },
            args.json,
        )
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
