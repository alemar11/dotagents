class CacheError(Exception):
    def __init__(self, code: str, message: str, exit_code: int, details: Any = None):
        super().__init__(message)
        self.code = code
        self.message = message
        self.exit_code = exit_code
        self.details = details or {}


def cache_root() -> Path:
    return Path.home() / ".cache/dotagents/skills/implement-feature"


def claim_root() -> Path:
    return cache_root() / "claims"


def ledger_root() -> Path:
    return cache_root() / "ledgers"


def archive_root() -> Path:
    return ledger_root() / "archive"


def utc_now() -> datetime:
    return datetime.now(timezone.utc)


def format_timestamp(value: datetime) -> str:
    return value.astimezone(timezone.utc).isoformat().replace("+00:00", "Z")


def compact_timestamp(value: datetime) -> str:
    return value.astimezone(timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")


def parse_timestamp(value: Any, field: str) -> datetime:
    if not isinstance(value, str) or not value.endswith("Z"):
        raise CacheError("integrity-failure", f"{field} is not a UTC timestamp", 5)
    try:
        parsed = datetime.fromisoformat(value[:-1] + "+00:00")
    except ValueError as exc:
        raise CacheError("integrity-failure", f"{field} is invalid", 5) from exc
    return parsed.astimezone(timezone.utc)


def check_id(value: Any, field: str) -> str:
    if (
        not isinstance(value, str)
        or len(value) > 128
        or not ID_RE.fullmatch(value)
    ):
        raise CacheError("invalid-input", f"{field} is not canonical: {value}", 2)
    return value


def check_lower_kebab(value: Any, field: str) -> str:
    if not isinstance(value, str) or not LOWER_KEBAB_RE.fullmatch(value):
        raise CacheError("invalid-input", f"{field} is not lower-kebab: {value}", 2)
    return value


def nonempty(value: Any, field: str) -> str:
    if not isinstance(value, str) or not value.strip():
        raise CacheError("invalid-input", f"{field} is required", 2)
    result = value.strip()
    if len(result) > MAX_TEXT_LENGTH:
        raise CacheError("invalid-input", f"{field} exceeds the bounded length", 2)
    return result


def canonical_github_repository(
    value: Any,
    field: str,
    *,
    error_code: str = "invalid-input",
    exit_code: int = 2,
) -> str:
    if not isinstance(value, str) or not value.strip():
        raise CacheError(error_code, f"{field} is required", exit_code)
    repository = value.strip()
    repository_name = repository.partition("/")[2]
    if (
        len(repository) > MAX_TEXT_LENGTH
        or not GITHUB_REPOSITORY_RE.fullmatch(repository)
        or repository_name in {".", ".."}
    ):
        raise CacheError(error_code, f"{field} is not canonical owner/repository", exit_code)
    return repository


def canonical_github_pr_url(
    value: Any,
    github_repository: str,
    pr_number: int,
    field: str,
    *,
    error_code: str = "invalid-input",
    exit_code: int = 2,
) -> str:
    if not isinstance(value, str) or not value.strip():
        raise CacheError(error_code, f"{field} is required", exit_code)
    url = value.strip()
    if len(url) > MAX_TEXT_LENGTH:
        raise CacheError(error_code, f"{field} exceeds the bounded length", exit_code)
    expected = f"https://github.com/{github_repository}/pull/{pr_number}"
    if url != expected:
        raise CacheError(error_code, f"{field} is not the canonical GitHub PR URL", exit_code)
    return url


def canonical_allowed_path(value: Any, field: str) -> str:
    raw = nonempty(value, field)
    if "\\" in raw or raw.startswith("/"):
        raise CacheError("invalid-input", f"{field} must be repository-relative", 2)
    segments = raw.split("/")
    if any(segment == ".." for segment in segments):
        raise CacheError("invalid-input", f"{field} must not traverse parents", 2)
    normalized = posixpath.normpath(raw)
    if normalized.startswith("../") or normalized == ".." or normalized.startswith("/"):
        raise CacheError("invalid-input", f"{field} is outside the repository", 2)
    return normalized


def ensure_safe_cache_chain(target: Path, field: str) -> None:
    home = Path.home().expanduser()
    try:
        relative = target.relative_to(home)
    except ValueError as exc:
        raise CacheError("state-conflict", f"{field} is outside the user cache", 4) from exc
    current = home
    for part in relative.parts:
        current = current / part
        if current.is_symlink() or (current.exists() and not current.is_dir()):
            raise CacheError("state-conflict", f"unsafe {field}: {current}", 4)


def exact_object(value: Any, required: set[str], field: str) -> dict[str, Any]:
    if not isinstance(value, dict) or set(value) != required:
        missing = sorted(required - set(value)) if isinstance(value, dict) else sorted(required)
        unknown = sorted(set(value) - required) if isinstance(value, dict) else []
        raise CacheError(
            "invalid-input",
            f"{field} schema is invalid",
            2,
            {"missing": missing, "unknown": unknown},
        )
    return value


def canonical_fingerprint(value: Any, field: str) -> str:
    if not isinstance(value, str) or not FINGERPRINT_RE.fullmatch(value):
        raise CacheError("invalid-input", f"{field} is not a SHA-256 fingerprint", 2)
    return value


def canonical_absolute_path(value: Any, field: str) -> str:
    raw = nonempty(value, field)
    path = Path(raw).expanduser()
    if not path.is_absolute():
        raise CacheError("invalid-input", f"{field} must be absolute", 2)
    return str(path.resolve(strict=False))


def stable_json_bytes(value: Any) -> bytes:
    return (json.dumps(value, indent=2, sort_keys=True) + "\n").encode()


def request_fingerprint(value: Any) -> str:
    encoded = json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(encoded).hexdigest()


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def sync_directory(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def write_json_durable(path: Path, value: dict[str, Any]) -> None:
    with path.open("x") as handle:
        handle.write(json.dumps(value, indent=2, sort_keys=True) + "\n")
        handle.flush()
        os.fsync(handle.fileno())
    sync_directory(path.parent)


def replace_json_durable(path: Path, value: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.parent / f".tmp-{path.name}-{secrets.token_hex(16)}"
    try:
        with temporary.open("xb") as handle:
            handle.write(stable_json_bytes(value))
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        sync_directory(path.parent)
    finally:
        if temporary.exists() and temporary.is_file() and not temporary.is_symlink():
            temporary.unlink()


@contextlib.contextmanager
def locked_claim_store(*, create: bool, exclusive: bool) -> Iterator[Path | None]:
    root = claim_root()
    ensure_safe_cache_chain(root, "claim-store path")
    root_preexisted = root.exists()
    if not root_preexisted and not create:
        yield None
        return
    if create:
        root.mkdir(parents=True, exist_ok=True)
    lock_path = root / ".lock"
    if lock_path.exists() and (lock_path.is_symlink() or not lock_path.is_file()):
        raise CacheError("state-conflict", f"unsafe claim-store lock: {lock_path}", 4)
    if exclusive and root_preexisted and not lock_path.exists():
        raise CacheError("state-conflict", f"claim-store lock is missing: {lock_path}", 4)
    mode = "a+" if create and not root_preexisted else "r"
    try:
        lock = lock_path.open(mode)
    except FileNotFoundError:
        if exclusive:
            raise CacheError("state-conflict", f"claim-store lock is missing: {lock_path}", 4)
        yield root
        return
    with lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH)
        try:
            yield root
        finally:
            fcntl.flock(lock.fileno(), fcntl.LOCK_UN)


def extract_ledger_refs(value: Any) -> set[str]:
    refs: set[str] = set()
    if isinstance(value, dict):
        for key, item in value.items():
            if key == "ledger_ref" and isinstance(item, str):
                refs.add(str(Path(item).expanduser().resolve(strict=False)))
            else:
                refs.update(extract_ledger_refs(item))
    elif isinstance(value, list):
        for item in value:
            refs.update(extract_ledger_refs(item))
    return refs


def claim_fingerprint(value: dict[str, Any]) -> str:
    keys = [
        "root_id",
        "acquisition_nonce",
        "repositories",
        "repository_checkouts",
        "sources",
        "ledger_ref",
    ]
    payload = {key: value[key] for key in keys}
    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(encoded).hexdigest()


def claim_artifact_error(
    path: Path, value: dict[str, Any], *, validate_takeover: bool = True
) -> str | None:
    if path.suffix == ".json":
        schema = value.get("schema_version")
        required = {
            "schema_version",
            "root_id",
            "acquisition_nonce",
            "repositories",
            "repository_checkouts",
            "sources",
            "ledger_ref",
            "opened_at",
            "heartbeat_at",
            "takeover_evidence",
            "replaced_root_ids",
            "fingerprint",
        }
        if schema != CLAIM_SCHEMA_VERSION or set(value) != required:
            return f"unsupported claim schema: {path}"
        root_id = value.get("root_id")
        if (
            not isinstance(root_id, str)
            or not ID_RE.fullmatch(root_id)
            or path.name != f"{root_id}.json"
        ):
            return f"claim identity mismatch: {path}"
        try:
            expected = claim_fingerprint(value)
        except (KeyError, TypeError, ValueError):
            return f"claim fingerprint input mismatch: {path}"
        if value.get("fingerprint") != expected:
            return f"claim fingerprint mismatch: {path}"
        if validate_takeover:
            try:
                takeover_adoptions(value)
            except CacheError:
                return f"claim takeover evidence mismatch: {path}"
        return None

    required = {
        "schema_version",
        "transaction_id",
        "candidate_claim",
        "replaced_claims",
        "prepared_at",
        "fingerprint",
    }
    candidate = value.get("candidate_claim")
    replaced = value.get("replaced_claims")
    if (
        value.get("schema_version") != TAKEOVER_SCHEMA_VERSION
        or set(value) != required
        or not isinstance(value.get("transaction_id"), str)
        or not TRANSACTION_ID_RE.fullmatch(value["transaction_id"])
        or not isinstance(candidate, dict)
        or not isinstance(replaced, list)
        or not replaced
        or any(not isinstance(item, dict) for item in replaced)
    ):
        return f"unsupported takeover schema: {path}"
    root_id = candidate.get("root_id")
    if (
        not isinstance(root_id, str)
        or not ID_RE.fullmatch(root_id)
        or path.name != f"{root_id}.takeover"
    ):
        return f"takeover identity mismatch: {path}"
    payload = {key: item for key, item in value.items() if key != "fingerprint"}
    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
    if value.get("fingerprint") != hashlib.sha256(encoded).hexdigest():
        return f"takeover fingerprint mismatch: {path}"
    candidate_error = claim_artifact_error(path.with_suffix(".json"), candidate)
    if candidate_error:
        return f"takeover candidate mismatch: {path}"
    for item in replaced:
        item_root = item.get("root_id")
        if not isinstance(item_root, str) or not ID_RE.fullmatch(item_root):
            return f"takeover snapshot identity mismatch: {path}"
        snapshot_error = claim_artifact_error(
            path.parent / f"{item_root}.json", item, validate_takeover=False
        )
        if snapshot_error:
            return f"takeover snapshot mismatch: {path}"
    return None


def validate_release_receipt(path: Path) -> dict[str, Any]:
    if path.is_symlink() or not path.is_file():
        raise CacheError("state-conflict", f"unsafe release receipt: {path}", 4)
    try:
        value = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise CacheError("state-conflict", f"invalid release receipt: {path}", 4) from exc
    required = {
        "schema_version",
        "root_id",
        "claim_fingerprint",
        "ledger_ref",
        "ledger_sha256",
        "ledger_size_bytes",
        "release_reason",
        "evidence_ref",
        "released_at",
        "fingerprint",
    }
    if not isinstance(value, dict) or set(value) != required:
        raise CacheError("state-conflict", f"release receipt schema mismatch: {path}", 4)
    root_id = value.get("root_id")
    claim_fingerprint = value.get("claim_fingerprint")
    ledger_ref = value.get("ledger_ref")
    payload = {key: item for key, item in value.items() if key != "fingerprint"}
    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
    if (
        value.get("schema_version") != RELEASE_RECEIPT_SCHEMA_VERSION
        or not isinstance(root_id, str)
        or not ID_RE.fullmatch(root_id)
        or not isinstance(claim_fingerprint, str)
        or not FINGERPRINT_RE.fullmatch(claim_fingerprint)
        or path.name != f"{root_id}--{claim_fingerprint}.json"
        or not isinstance(ledger_ref, str)
        or not Path(ledger_ref).is_absolute()
        or value.get("release_reason") not in RELEASE_REASONS
        or not isinstance(value.get("evidence_ref"), str)
        or not value["evidence_ref"].strip()
        or parse_timestamp(value.get("released_at"), "released_at") is None
        or value.get("fingerprint") != hashlib.sha256(encoded).hexdigest()
    ):
        raise CacheError("state-conflict", f"release receipt value mismatch: {path}", 4)
    has_snapshot = (
        isinstance(value.get("ledger_sha256"), str)
        and bool(FINGERPRINT_RE.fullmatch(value["ledger_sha256"]))
        and isinstance(value.get("ledger_size_bytes"), int)
        and value["ledger_size_bytes"] >= 0
    )
    if not has_snapshot:
        raise CacheError("state-conflict", f"release receipt ledger mismatch: {path}", 4)
    canonical_ledger = canonical_claim_ledger(ledger_ref)
    return {**value, "path": str(path), "ledger_ref": str(canonical_ledger)}


def inspect_claim_artifacts(root: Path | None) -> dict[str, Any]:
    result: dict[str, Any] = {
        "safe": True,
        "ledger_refs": set(),
        "ownership_root_ids": set(),
        "claim_files": [],
        "takeover_files": [],
        "release_receipts": [],
        "warnings": [],
    }
    if root is None or not root.exists():
        return result
    lock_path = root / ".lock"
    if lock_path.is_symlink() or not lock_path.is_file():
        result["safe"] = False
        result["warnings"].append(f"claim-store lock missing or unsafe: {lock_path}")
    for path in sorted(root.iterdir()):
        if path.name == ".lock":
            continue
        if path.name == "releases":
            if path.is_symlink() or not path.is_dir():
                result["safe"] = False
                result["warnings"].append(f"unsafe release receipt root: {path}")
                continue
            for receipt_path in sorted(path.iterdir()):
                try:
                    result["release_receipts"].append(
                        validate_release_receipt(receipt_path)
                    )
                except CacheError as exc:
                    result["safe"] = False
                    result["warnings"].append(exc.message)
            continue
        if path.is_symlink() or not path.is_file():
            result["safe"] = False
            result["warnings"].append(f"unknown claim-store artifact: {path}")
            continue
        if path.suffix not in {".json", ".takeover"}:
            result["safe"] = False
            result["warnings"].append(f"unknown claim-store file: {path}")
            continue
        try:
            value = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError):
            result["safe"] = False
            result["warnings"].append(f"unreadable claim-store file: {path}")
            continue
        if not isinstance(value, dict):
            result["safe"] = False
            result["warnings"].append(f"invalid claim-store file: {path}")
            continue
        artifact_error = claim_artifact_error(path, value)
        if artifact_error:
            result["safe"] = False
            result["warnings"].append(artifact_error)
            continue
        result["ledger_refs"].update(extract_ledger_refs(value))
        if path.suffix == ".json":
            result["ownership_root_ids"].add(value["root_id"])
        else:
            result["ownership_root_ids"].add(value["candidate_claim"]["root_id"])
            result["ownership_root_ids"].update(
                item["root_id"] for item in value["replaced_claims"]
            )
        key = "takeover_files" if path.suffix == ".takeover" else "claim_files"
        result[key].append(str(path))
    return result


def canonical_claim_ledger(value: str) -> Path:
    path = Path(value).expanduser()
    if not path.is_absolute():
        raise CacheError("invalid-input", "ledger must be an absolute path", 2)
    if path.is_symlink():
        raise CacheError("invalid-input", f"ledger must not be a symlink: {path}", 2)
    ensure_safe_cache_chain(ledger_root(), "ledger root")
    canonical = Path(os.path.abspath(os.fspath(path)))
    root = Path(os.path.abspath(os.fspath(ledger_root())))
    if canonical.parent != root or canonical.suffix != ".json":
        raise CacheError(
            "invalid-input",
            "ledger must be a direct child of the active ledger root",
            2,
            {"ledger": str(canonical), "ledger_root": str(root)},
        )
    check_id(canonical.stem, "portfolio_key")
    return canonical


def canonical_active_ledger(value: str) -> Path:
    path = canonical_claim_ledger(value)
    if path.suffix != ".json":
        raise CacheError(
            "unsupported-active-ledger",
            "active Markdown ledgers are unsupported; create a new JSON run state",
            2,
            {"ledger": str(path)},
        )
    return path


def read_json_file(value: str, field: str) -> Any:
    raw = nonempty(value, field)
    path = Path(raw).expanduser()
    if not path.is_absolute():
        raise CacheError("invalid-input", f"{field} must be an absolute path", 2)
    if path.is_symlink() or not path.is_file():
        raise CacheError("invalid-input", f"{field} is not a safe regular file: {path}", 2)
    if path.stat().st_size > MAX_PACKET_BYTES:
        raise CacheError("invalid-input", f"{field} exceeds the packet size limit", 2)
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise CacheError("invalid-input", f"{field} is not valid JSON: {path}", 2) from exc


def active_claim(root: Path | None, root_id: str, fingerprint: str, ledger: Path) -> dict[str, Any]:
    if root is None:
        raise CacheError("state-conflict", f"active claim is missing: {root_id}", 4)
    path = root / f"{root_id}.json"
    if path.is_symlink() or not path.is_file():
        raise CacheError("state-conflict", f"active claim is missing: {root_id}", 4)
    try:
        claim = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise CacheError("state-conflict", f"active claim is unreadable: {root_id}", 4) from exc
    if not isinstance(claim, dict) or claim_artifact_error(path, claim):
        raise CacheError("state-conflict", f"active claim is invalid: {root_id}", 4)
    if claim["fingerprint"] != fingerprint:
        raise CacheError("state-conflict", "active claim fingerprint changed", 4)
    if claim["ledger_ref"] != str(ledger):
        raise CacheError("state-conflict", "active claim ledger reference changed", 4)
    return claim


def takeover_adoptions(claim: dict[str, Any]) -> dict[str, dict[str, Any]]:
    """Return the candidate claim's immutable per-source takeover evidence."""
    evidence = claim.get("takeover_evidence")
    replaced_root_ids = claim.get("replaced_root_ids")
    candidate_sources = claim.get("sources")
    if (
        not isinstance(replaced_root_ids, list)
        or any(not isinstance(item, str) or not ID_RE.fullmatch(item) for item in replaced_root_ids)
        or replaced_root_ids != sorted(set(replaced_root_ids))
        or not isinstance(candidate_sources, list)
        or not candidate_sources
        or any(not isinstance(item, str) or not item.strip() for item in candidate_sources)
        or len(candidate_sources) != len(set(candidate_sources))
    ):
        raise CacheError("state-conflict", "candidate takeover root set is invalid", 4)
    if evidence == "none":
        if replaced_root_ids:
            raise CacheError("state-conflict", "candidate takeover evidence is inconsistent", 4)
        return {}
    evidence_required = {
        "stale_claim_takeover_permission",
        "takeover_reason",
        "evidence",
        "transaction_id",
        "replaced_claims",
        "evidence_fingerprint",
    }
    if not isinstance(evidence, dict) or set(evidence) != evidence_required:
        raise CacheError("state-conflict", "candidate takeover evidence is invalid", 4)
    evidence_payload = {
        key: value for key, value in evidence.items() if key != "evidence_fingerprint"
    }
    if (
        evidence["stale_claim_takeover_permission"] != TAKEOVER_PERMISSION
        or evidence["takeover_reason"] not in TAKEOVER_REASONS
        or not isinstance(evidence["evidence"], str)
        or not evidence["evidence"].strip()
        or not isinstance(evidence["transaction_id"], str)
        or not TRANSACTION_ID_RE.fullmatch(evidence["transaction_id"])
        or not isinstance(evidence["replaced_claims"], list)
        or not evidence["replaced_claims"]
        or evidence["evidence_fingerprint"] != request_fingerprint(evidence_payload)
    ):
        raise CacheError("state-conflict", "candidate takeover evidence is invalid", 4)
    result: dict[str, dict[str, Any]] = {}
    observed_roots: list[str] = []
    observed_task_refs: set[str] = set()
    observed_checkouts: set[tuple[str, str]] = set()
    for replaced in evidence["replaced_claims"]:
        if not isinstance(replaced, dict) or set(replaced) != {
            "claim_snapshot",
            "task_termination_evidence",
            "task_adoption",
        }:
            raise CacheError("state-conflict", "candidate takeover adoption is invalid", 4)
        snapshot = replaced.get("claim_snapshot")
        adoption = replaced.get("task_adoption")
        if not isinstance(snapshot, dict) or not isinstance(adoption, dict):
            raise CacheError("state-conflict", "candidate takeover adoption is invalid", 4)
        snapshot_root = snapshot.get("root_id")
        if not isinstance(snapshot_root, str) or not ID_RE.fullmatch(snapshot_root):
            raise CacheError("state-conflict", "candidate takeover snapshot is invalid", 4)
        if claim_artifact_error(
            claim_root() / f"{snapshot_root}.json",
            snapshot,
            validate_takeover=False,
        ):
            raise CacheError("state-conflict", "candidate takeover snapshot is invalid", 4)
        try:
            if str(canonical_claim_ledger(snapshot["ledger_ref"])) != snapshot["ledger_ref"]:
                raise CacheError("state-conflict", "candidate takeover snapshot is invalid", 4)
        except CacheError as exc:
            raise CacheError("state-conflict", "candidate takeover snapshot is invalid", 4) from exc
        adoption_required = {
            "root_id",
            "claim_fingerprint",
            "task_termination_evidence",
            "specs",
        }
        if set(adoption) != adoption_required:
            raise CacheError("state-conflict", "candidate takeover adoption is invalid", 4)
        if adoption.get("root_id") != snapshot.get("root_id") or adoption.get(
            "claim_fingerprint"
        ) != snapshot.get("fingerprint"):
            raise CacheError("state-conflict", "candidate takeover adoption identity changed", 4)
        termination_raw = adoption.get("task_termination_evidence")
        termination = termination_raw.strip() if isinstance(termination_raw, str) else None
        if (
            termination is None
            or not termination
            or replaced.get("task_termination_evidence") != termination
        ):
            raise CacheError("state-conflict", "candidate takeover termination changed", 4)
        specs = adoption.get("specs")
        if not isinstance(specs, list) or not specs:
            raise CacheError("state-conflict", "candidate takeover adoption specs are invalid", 4)
        snapshot_sources = snapshot.get("sources")
        snapshot_repositories = snapshot.get("repositories")
        if (
            not isinstance(snapshot_sources, list)
            or not snapshot_sources
            or any(not isinstance(item, str) or not item.strip() for item in snapshot_sources)
            or len(snapshot_sources) != len(set(snapshot_sources))
            or not isinstance(snapshot_repositories, list)
            or not snapshot_repositories
            or any(not isinstance(item, str) or not item.strip() for item in snapshot_repositories)
            or len(snapshot_repositories) != len(set(snapshot_repositories))
        ):
            raise CacheError("state-conflict", "candidate takeover snapshot is invalid", 4)
        observed_sources: set[str] = set()
        for spec in specs:
            spec_required = {
                "source_spec_ref",
                "task_state",
                "task_ref",
                "task_model",
                "task_thinking",
                "thinking_reason",
                "goal_evidence_ref",
                "managed_checkouts",
                "evidence_ref",
            }
            if not isinstance(spec, dict) or set(spec) != spec_required:
                raise CacheError("state-conflict", "candidate takeover adoption spec is invalid", 4)
            source_value = spec.get("source_spec_ref")
            source_ref = source_value.strip() if isinstance(source_value, str) else None
            if (
                source_ref is None
                or not source_ref
                or source_ref in observed_sources
                or source_ref in result
            ):
                raise CacheError("state-conflict", "candidate takeover adoption source is invalid", 4)
            observed_sources.add(source_ref)
            task_state = spec.get("task_state")
            thinking_value = spec.get("thinking_reason")
            thinking_reason = thinking_value.strip() if isinstance(thinking_value, str) else None
            evidence_value = spec.get("evidence_ref")
            evidence_ref = evidence_value.strip() if isinstance(evidence_value, str) else None
            if (
                task_state not in {"recorded", "no-task"}
                or spec.get("task_model") != "gpt-5.6-sol"
                or spec.get("task_thinking") not in {"medium", "high", "xhigh"}
                or not thinking_reason
                or thinking_reason == "none"
                or not evidence_ref
                or not isinstance(spec.get("managed_checkouts"), list)
            ):
                raise CacheError("state-conflict", "candidate takeover adoption spec is invalid", 4)
            checkouts = spec["managed_checkouts"]
            task_ref = spec.get("task_ref")
            goal_ref = spec.get("goal_evidence_ref")
            normalized_checkouts: list[dict[str, str]] = []
            if task_state == "no-task":
                if (
                    task_ref != "none"
                    or goal_ref != "none"
                    or checkouts
                ):
                    raise CacheError("state-conflict", "candidate no-task adoption is invalid", 4)
            else:
                task_ref = task_ref.strip() if isinstance(task_ref, str) else None
                goal_ref = goal_ref.strip() if isinstance(goal_ref, str) else None
                if (
                    not task_ref
                    or task_ref == "none"
                    or task_ref in observed_task_refs
                    or not goal_ref
                    or goal_ref == "none"
                    or not checkouts
                ):
                    raise CacheError("state-conflict", "candidate recorded adoption is invalid", 4)
                observed_task_refs.add(task_ref)
                local_checkouts: set[tuple[str, str]] = set()
                for checkout in checkouts:
                    checkout_required = {
                        "repository",
                        "checkout",
                        "target_branch_name",
                        "git_top_level",
                        "baseline_revision",
                        "isolation_evidence_ref",
                    }
                    if not isinstance(checkout, dict) or set(checkout) != checkout_required:
                        raise CacheError("state-conflict", "candidate adopted checkout is invalid", 4)
                    repository_value = checkout.get("repository")
                    repository = (
                        repository_value.strip()
                        if isinstance(repository_value, str)
                        else None
                    )
                    try:
                        checkout_path = canonical_absolute_path(
                            checkout.get("checkout"), "takeover.checkout"
                        )
                        git_top_level = canonical_absolute_path(
                            checkout.get("git_top_level"), "takeover.git_top_level"
                        )
                    except CacheError as exc:
                        raise CacheError("state-conflict", "candidate adopted checkout is invalid", 4) from exc
                    branch_value = checkout.get("target_branch_name")
                    target_branch = (
                        branch_value.strip() if isinstance(branch_value, str) else None
                    )
                    revision_value = checkout.get("baseline_revision")
                    baseline_revision = (
                        revision_value.strip() if isinstance(revision_value, str) else None
                    )
                    isolation_value = checkout.get("isolation_evidence_ref")
                    isolation_evidence_ref = (
                        isolation_value.strip()
                        if isinstance(isolation_value, str)
                        else None
                    )
                    checkout_key = (repository, checkout_path)
                    if (
                        repository not in snapshot_repositories
                        or checkout_key in local_checkouts
                        or checkout_key in observed_checkouts
                        or not target_branch
                        or baseline_revision is None
                        or not REVISION_RE.fullmatch(baseline_revision)
                        or not isolation_evidence_ref
                    ):
                        raise CacheError("state-conflict", "candidate adopted checkout is invalid", 4)
                    local_checkouts.add(checkout_key)
                    observed_checkouts.add(checkout_key)
                    normalized_checkouts.append(
                        {
                            "repository": repository,
                            "checkout": checkout_path,
                            "target_branch_name": target_branch,
                            "git_top_level": git_top_level,
                            "baseline_revision": baseline_revision,
                            "isolation_evidence_ref": isolation_evidence_ref,
                        }
                    )
            result[source_ref] = {
                "origin_root_id": snapshot["root_id"],
                "origin_claim_fingerprint": snapshot["fingerprint"],
                "task_state": task_state,
                "task_ref": task_ref,
                "task_model": spec.get("task_model"),
                "task_thinking": spec.get("task_thinking"),
                "thinking_reason": thinking_reason,
                "goal_evidence_ref": goal_ref,
                "managed_checkouts": normalized_checkouts,
                "evidence_ref": evidence_ref,
                "task_termination_evidence": termination,
            }
        if observed_sources != set(snapshot_sources):
            raise CacheError("state-conflict", "candidate takeover adoption source set changed", 4)
        observed_roots.append(snapshot_root)
    if sorted(observed_roots) != replaced_root_ids or len(observed_roots) != len(set(observed_roots)):
        raise CacheError("state-conflict", "candidate takeover root set changed", 4)
    if set(result) != set(candidate_sources):
        raise CacheError(
            "state-conflict",
            "candidate takeover adoption does not cover the live claim",
            4,
        )
    return result


def validate_registration(value: Any, claim: dict[str, Any], ledger: Path) -> dict[str, Any]:
    required = {
        "schema_version",
        "root_task_ref",
        "root_checkout",
        "objective",
        "objective_fingerprint",
        "permission_evidence_ref",
        "repositories",
        "repository_checkouts",
        "sources",
    }
    registration = exact_object(value, required, "registration")
    if registration["schema_version"] != REGISTRATION_SCHEMA_VERSION:
        raise CacheError("invalid-input", "registration schema is unsupported", 2)
    root_task_ref = nonempty(registration["root_task_ref"], "registration.root_task_ref")
    root_checkout = canonical_absolute_path(registration["root_checkout"], "registration.root_checkout")
    objective = nonempty(registration["objective"], "registration.objective")
    objective_fingerprint = canonical_fingerprint(
        registration["objective_fingerprint"], "registration.objective_fingerprint"
    )
    if hashlib.sha256(objective.encode()).hexdigest() != objective_fingerprint:
        raise CacheError("invalid-input", "objective fingerprint does not match", 2)
    permission = nonempty(
        registration["permission_evidence_ref"], "registration.permission_evidence_ref"
    )
    repositories = registration["repositories"]
    checkouts = registration["repository_checkouts"]
    if repositories != claim["repositories"] or checkouts != claim["repository_checkouts"]:
        raise CacheError("state-conflict", "registration repository claim does not match", 4)
    if (
        not isinstance(repositories, list)
        or not repositories
        or len(repositories) > MAX_PORTFOLIO_REPOSITORIES
        or len(repositories) != len(set(repositories))
    ):
        raise CacheError("invalid-input", "registration.repositories is invalid", 2)
    if (
        not isinstance(registration["sources"], list)
        or not registration["sources"]
        or len(registration["sources"]) > MAX_SOURCES
    ):
        raise CacheError("invalid-input", "registration.sources is invalid", 2)
    adoptions = takeover_adoptions(claim)
    source_required = {
        "task_key",
        "source_id",
        "source_spec_ref",
        "feature_spec_title",
        "feature_slug",
        "source_state",
        "source_fingerprint",
        "planned_done_ref",
        "tracker_backend",
        "tracker_repository",
        "deliveries",
        "dependency_ids",
        "requires_domain_closeout",
        "task_model",
        "task_thinking",
        "thinking_reason",
        "task_goal_objective_fingerprint",
    }
    normalized_sources: list[dict[str, Any]] = []
    task_keys: set[str] = set()
    source_ids: set[str] = set()
    for index, raw in enumerate(registration["sources"]):
        field = f"registration.sources[{index}]"
        item = exact_object(raw, source_required, field)
        task_key = check_lower_kebab(item["task_key"], f"{field}.task_key")
        source_id = nonempty(item["source_id"], f"{field}.source_id")
        source_ref = nonempty(item["source_spec_ref"], f"{field}.source_spec_ref")
        if task_key in task_keys or source_id in source_ids:
            raise CacheError("invalid-input", f"{field} duplicates an identity", 2)
        task_keys.add(task_key)
        source_ids.add(source_id)
        if item["source_state"] != "ready-for-agent":
            raise CacheError("invalid-input", f"{field}.source_state must be ready-for-agent", 2)
        tracker = item["tracker_backend"]
        if tracker not in TRACKER_BACKENDS:
            raise CacheError("invalid-input", f"{field}.tracker_backend is invalid", 2)
        fingerprint = canonical_fingerprint(item["source_fingerprint"], f"{field}.source_fingerprint")
        deliveries_raw = item["deliveries"]
        if (
            not isinstance(deliveries_raw, list)
            or not deliveries_raw
            or len(deliveries_raw) > MAX_REPOSITORIES_PER_TASK
        ):
            raise CacheError("invalid-input", f"{field}.deliveries is invalid", 2)
        delivery_required = {
            "delivery_key",
            "repository",
            "target_branch",
            "allowed_paths",
        }
        deliveries: list[dict[str, Any]] = []
        delivery_keys: set[str] = set()
        delivery_repositories: set[str] = set()
        for delivery_index, delivery_raw in enumerate(deliveries_raw):
            delivery_field = f"{field}.deliveries[{delivery_index}]"
            delivery = exact_object(delivery_raw, delivery_required, delivery_field)
            delivery_key = check_lower_kebab(
                delivery["delivery_key"], f"{delivery_field}.delivery_key"
            )
            repository = nonempty(
                delivery["repository"], f"{delivery_field}.repository"
            )
            if repository not in claim["repositories"]:
                raise CacheError(
                    "state-conflict",
                    f"{delivery_field}.repository is outside the claim",
                    4,
                )
            if delivery_key in delivery_keys or repository in delivery_repositories:
                raise CacheError("invalid-input", f"{delivery_field} duplicates a delivery", 2)
            delivery_keys.add(delivery_key)
            delivery_repositories.add(repository)
            allowed_raw = delivery["allowed_paths"]
            if (
                not isinstance(allowed_raw, list)
                or not allowed_raw
                or len(allowed_raw) > MAX_ALLOWED_PATHS_PER_REPOSITORY
            ):
                raise CacheError(
                    "invalid-input", f"{delivery_field}.allowed_paths is invalid", 2
                )
            allowed_paths = [
                canonical_allowed_path(
                    path, f"{delivery_field}.allowed_paths[{path_index}]"
                )
                for path_index, path in enumerate(allowed_raw)
            ]
            if len(allowed_paths) != len(set(allowed_paths)):
                raise CacheError(
                    "invalid-input",
                    f"{delivery_field}.allowed_paths contains normalized duplicates",
                    2,
                )
            deliveries.append(
                {
                    "delivery_key": delivery_key,
                    "repository": repository,
                    "target_branch": nonempty(
                        delivery["target_branch"], f"{delivery_field}.target_branch"
                    ),
                    "allowed_paths": allowed_paths,
                }
            )
        tracker_repository = nonempty(
            item["tracker_repository"], f"{field}.tracker_repository"
        )
        if tracker_repository not in delivery_repositories:
            raise CacheError(
                "invalid-input", f"{field}.tracker_repository has no delivery", 2
            )
        if not isinstance(item["dependency_ids"], list):
            raise CacheError("invalid-input", f"{field}.dependency_ids is invalid", 2)
        dependencies = [
            check_lower_kebab(dep, f"{field}.dependency_ids")
            for dep in item["dependency_ids"]
        ]
        if len(dependencies) != len(set(dependencies)) or task_key in dependencies:
            raise CacheError("invalid-input", f"{field}.dependency_ids is invalid", 2)
        if not isinstance(item["requires_domain_closeout"], bool):
            raise CacheError("invalid-input", f"{field}.requires_domain_closeout is invalid", 2)
        task_model = nonempty(item["task_model"], f"{field}.task_model")
        if task_model != "gpt-5.6-sol":
            raise CacheError("invalid-input", f"{field}.task_model is invalid", 2)
        task_thinking = item["task_thinking"]
        if task_thinking not in {"medium", "high", "xhigh"}:
            raise CacheError("invalid-input", f"{field}.task_thinking is invalid", 2)
        thinking_reason = nonempty(item["thinking_reason"], f"{field}.thinking_reason")
        task_goal_fingerprint = canonical_fingerprint(
            item["task_goal_objective_fingerprint"],
            f"{field}.task_goal_objective_fingerprint",
        )
        # Takeover adoption keys come from the replaced claim's canonical
        # source set. The authored source_spec_ref may legitimately differ (or
        # even be shared), so consume each embedded adoption by source_id.
        adoption = adoptions.pop(source_id, None)
        if adoption is None:
            adoption = {
                "origin_root_id": claim["root_id"],
                "origin_claim_fingerprint": claim["fingerprint"],
                "task_state": "no-task",
                "task_ref": "none",
                "task_model": task_model,
                "task_thinking": task_thinking,
                "thinking_reason": thinking_reason,
                "goal_evidence_ref": "none",
                "managed_checkouts": [],
                "evidence_ref": "claim-acquisition://no-prior-task",
                "task_termination_evidence": "none",
            }
        if adoption["task_state"] not in {"recorded", "no-task"}:
            raise CacheError("state-conflict", f"{field} takeover task state is invalid", 4)
        check_id(adoption["origin_root_id"], f"{field}.adoption.origin_root_id")
        canonical_fingerprint(
            adoption["origin_claim_fingerprint"],
            f"{field}.adoption.origin_claim_fingerprint",
        )
        nonempty(adoption["evidence_ref"], f"{field}.adoption.evidence_ref")
        if (
            adoption["task_model"] != task_model
            or adoption["task_thinking"] != task_thinking
            or adoption["thinking_reason"] != thinking_reason
        ):
            raise CacheError(
                "state-conflict", f"{field} conflicts with embedded task adoption", 4
            )
        if adoption["task_state"] == "no-task":
            if (
                adoption["task_ref"] != "none"
                or adoption["goal_evidence_ref"] != "none"
                or adoption["managed_checkouts"] != []
            ):
                raise CacheError(
                    "state-conflict", f"{field} embedded no-task adoption is inconsistent", 4
                )
        else:
            if adoption["task_ref"] == root_task_ref:
                raise CacheError(
                    "state-conflict", f"{field} adopted task collides with the root task", 4
                )
            nonempty(adoption["task_ref"], f"{field}.adoption.task_ref")
            nonempty(adoption["goal_evidence_ref"], f"{field}.adoption.goal_evidence_ref")
            adopted = adoption["managed_checkouts"]
            if not isinstance(adopted, list) or not adopted:
                raise CacheError("state-conflict", f"{field} adopted checkout map is invalid", 4)
            adopted_by_repository = {
                checkout.get("repository"): checkout for checkout in adopted
                if isinstance(checkout, dict)
            }
            if set(adopted_by_repository) != delivery_repositories:
                raise CacheError(
                    "state-conflict",
                    f"{field} delivery scope conflicts with embedded task adoption",
                    4,
                )
            for delivery in deliveries:
                adopted_checkout = adopted_by_repository[delivery["repository"]]
                if adopted_checkout.get("target_branch_name") != delivery["target_branch"]:
                    raise CacheError(
                        "state-conflict",
                        f"{field} target branch conflicts with embedded task adoption",
                        4,
                    )
        normalized_sources.append(
            {
                "task_key": task_key,
                "source_id": source_id,
                "source_spec_ref": source_ref,
                "feature_spec_title": nonempty(
                    item["feature_spec_title"], f"{field}.feature_spec_title"
                ),
                "feature_slug": check_lower_kebab(
                    item["feature_slug"], f"{field}.feature_slug"
                ),
                "source_state": item["source_state"],
                "source_fingerprint": fingerprint,
                "planned_done_ref": nonempty(item["planned_done_ref"], f"{field}.planned_done_ref"),
                "tracker_backend": tracker,
                "tracker_repository": tracker_repository,
                "deliveries": sorted(deliveries, key=lambda value: value["delivery_key"]),
                "dependency_ids": dependencies,
                "requires_domain_closeout": item["requires_domain_closeout"],
                "task_model": task_model,
                "task_thinking": task_thinking,
                "thinking_reason": thinking_reason,
                "task_goal_objective_fingerprint": task_goal_fingerprint,
                "adoption": adoption,
            }
        )
    if adoptions:
        raise CacheError(
            "state-conflict",
            "registration did not consume every takeover adoption exactly once",
            4,
            {"source_ids": sorted(adoptions)},
        )
    if sorted(source_ids) != sorted(claim["sources"]):
        raise CacheError("state-conflict", "registration source claim does not match", 4)
    for item in normalized_sources:
        unknown = set(item["dependency_ids"]) - task_keys
        if unknown:
            raise CacheError("invalid-input", "registration dependency is unknown", 2, {"ids": sorted(unknown)})
    visiting: set[str] = set()
    visited: set[str] = set()
    graph = {item["task_key"]: item["dependency_ids"] for item in normalized_sources}

    def visit(task_key: str) -> None:
        if task_key in visiting:
            raise CacheError("invalid-input", "registration dependencies contain a cycle", 2)
        if task_key in visited:
            return
        visiting.add(task_key)
        for dependency in graph[task_key]:
            visit(dependency)
        visiting.remove(task_key)
        visited.add(task_key)

    for task_key in graph:
        visit(task_key)
    registered_repositories = {
        delivery["repository"]
        for source in normalized_sources
        for delivery in source["deliveries"]
    }
    if registered_repositories != set(repositories):
        raise CacheError(
            "state-conflict",
            "registration deliveries must cover the live claim repository scope",
            4,
            {
                "expected": sorted(repositories),
                "actual": sorted(registered_repositories),
            },
        )
    if ledger.stem != check_id(ledger.stem, "portfolio_key"):
        raise CacheError("invalid-input", "ledger portfolio key is invalid", 2)
    return {
        "root_task_ref": root_task_ref,
        "root_checkout": root_checkout,
        "objective": objective,
        "objective_fingerprint": objective_fingerprint,
        "permission_evidence_ref": permission,
        "repositories": repositories,
        "repository_checkouts": checkouts,
        "sources": normalized_sources,
    }


def state_payload_fingerprint(state: dict[str, Any]) -> str:
    payload = copy.deepcopy(state)
    payload.pop("content_fingerprint", None)
    return request_fingerprint(payload)


def seal_state_fingerprint(state: dict[str, Any]) -> None:
    state["content_fingerprint"] = state_payload_fingerprint(state)


def validate_state(state: Any, ledger: Path) -> dict[str, Any]:
    required = {
        "schema_version",
        "generation",
        "content_fingerprint",
        "created_at",
        "updated_at",
        "portfolio",
        "claim",
        "authorization",
        "goal",
        "sources",
        "tasks",
        "reviews",
        "gates",
        "handoffs",
        "operations",
        "closeout",
    }
    try:
        value = exact_object(state, required, "run_state")
        if len(stable_json_bytes(value)) > MAX_PACKET_BYTES:
            raise CacheError("integrity-failure", "run-state exceeds the state size bound", 5)
        if value["schema_version"] != LEDGER_SCHEMA_VERSION:
            raise CacheError("integrity-failure", "run-state schema is unsupported", 5)
        if not isinstance(value["generation"], int) or value["generation"] < 1:
            raise CacheError("integrity-failure", "run-state generation is invalid", 5)
        canonical_fingerprint(value["content_fingerprint"], "run_state.content_fingerprint")
        parse_timestamp(value["created_at"], "created_at")
        parse_timestamp(value["updated_at"], "updated_at")
        exact_object(
            value["portfolio"],
            {
                "key",
                "root_id",
                "root_task_ref",
                "root_task_title",
                "root_task_title_evidence_ref",
                "root_checkout",
                "objective",
                "objective_fingerprint",
                "repositories",
                "repository_checkouts",
            },
            "run_state.portfolio",
        )
        if value["portfolio"]["key"] != ledger.stem:
            raise CacheError("integrity-failure", "run-state path identity mismatch", 5)
        exact_object(value["claim"], {"fingerprint"}, "run_state.claim")
        exact_object(
            value["authorization"],
            {"visible_app_task_permission", "evidence_ref"},
            "run_state.authorization",
        )
        exact_object(
            value["goal"],
            {
                "state",
                "evidence_ref",
                "completion_evidence_ref",
            },
            "run_state.goal",
        )
        if value["goal"]["state"] not in {"pending", "active", "complete"}:
            raise CacheError("integrity-failure", "run-state Goal state is invalid", 5)
        for field in ("sources", "tasks", "reviews", "gates", "handoffs", "operations"):
            if not isinstance(value[field], list):
                raise CacheError("integrity-failure", f"run-state {field} is invalid", 5)
        limits = {
            "sources": MAX_SOURCES,
            "tasks": MAX_SOURCES,
            "reviews": MAX_REVIEWS,
            "gates": MAX_GATES,
            "handoffs": MAX_HANDOFFS,
            "operations": MAX_OPERATIONS,
        }
        for field, limit in limits.items():
            if len(value[field]) > limit:
                raise CacheError("integrity-failure", f"run-state {field} exceeds its bound", 5)
        exact_object(
            value["closeout"],
            {
                "portfolio_terminal_verification_fingerprint",
                "portfolio_terminal_evidence_ref",
                "post_terminal_drift",
            },
            "run_state.closeout",
        )
        source_keys = {
            "task_key",
            "source_id",
            "source_spec_ref",
            "current_ref",
            "planned_done_ref",
            "state",
            "fingerprint",
            "tracker_backend",
            "tracker_repository",
            "move_evidence_ref",
            "move_revision_set_key",
            "dirty_delivery_key",
            "dirty_after_revision_key",
        }
        task_keys = {
            "task_key",
            "source_id",
            "source_spec_ref",
            "feature_spec_title",
            "feature_slug",
            "dependency_ids",
            "requires_domain_closeout",
            "adoption",
            "task_ref",
            "managed_checkouts_evidence_ref",
            "model",
            "reasoning_effort",
            "thinking_reason",
            "task_title",
            "task_title_evidence_ref",
            "goal_objective_fingerprint",
            "goal_state",
            "goal_evidence_ref",
            "goal_completion_evidence_ref",
            "state",
            "outcome",
            "attention_reason",
            "summary_ref",
            "deliveries",
            "seal",
            "post_terminal_drift",
        }
        for index, item in enumerate(value["sources"]):
            exact_object(item, source_keys, f"run_state.sources[{index}]")
            check_lower_kebab(item["task_key"], f"run_state.sources[{index}].task_key")
            nonempty(item["source_id"], f"run_state.sources[{index}].source_id")
            nonempty(item["source_spec_ref"], f"run_state.sources[{index}].source_spec_ref")
            nonempty(item["current_ref"], f"run_state.sources[{index}].current_ref")
            nonempty(item["planned_done_ref"], f"run_state.sources[{index}].planned_done_ref")
            canonical_fingerprint(item["fingerprint"], f"run_state.sources[{index}].fingerprint")
            if item["state"] not in SOURCE_STATES or item["tracker_backend"] not in TRACKER_BACKENDS:
                raise CacheError("integrity-failure", "run-state source state is invalid", 5)
        for index, item in enumerate(value["tasks"]):
            exact_object(item, task_keys, f"run_state.tasks[{index}]")
            check_lower_kebab(item["task_key"], f"run_state.tasks[{index}].task_key")
            if item["state"] not in TASK_STATES:
                raise CacheError("integrity-failure", "run-state task state is invalid", 5)
            if item["goal_state"] not in {"pending", "active", "complete"}:
                raise CacheError("integrity-failure", "run-state task Goal state is invalid", 5)
            if item["task_ref"] is not None:
                nonempty(item["task_ref"], f"run_state.tasks[{index}].task_ref")
            exact_object(
                item["adoption"],
                {
                    "origin_root_id",
                    "origin_claim_fingerprint",
                    "task_state",
                    "task_ref",
                    "task_model",
                    "task_thinking",
                    "thinking_reason",
                    "goal_evidence_ref",
                    "managed_checkouts",
                    "evidence_ref",
                    "task_termination_evidence",
                },
                f"run_state.tasks[{index}].adoption",
            )
            if (
                not isinstance(item["deliveries"], list)
                or not item["deliveries"]
                or len(item["deliveries"]) > MAX_REPOSITORIES_PER_TASK
            ):
                raise CacheError("integrity-failure", "run-state deliveries are invalid", 5)
            delivery_keys: set[str] = set()
            repositories: set[str] = set()
            for delivery_index, delivery in enumerate(item["deliveries"]):
                delivery_field = f"run_state.tasks[{index}].deliveries[{delivery_index}]"
                exact_object(
                    delivery,
                    {
                        "delivery_key",
                        "repository",
                        "target_branch",
                        "allowed_paths",
                        "managed_checkout",
                        "revision",
                        "pr",
                        "committed",
                        "published",
                        "observation_evidence_ref",
                        "tracker_dirty_after_revision_key",
                    },
                    delivery_field,
                )
                if delivery["delivery_key"] in delivery_keys or delivery["repository"] in repositories:
                    raise CacheError("integrity-failure", "run-state delivery identity is duplicated", 5)
                check_lower_kebab(delivery["delivery_key"], f"{delivery_field}.delivery_key")
                nonempty(delivery["repository"], f"{delivery_field}.repository")
                nonempty(delivery["target_branch"], f"{delivery_field}.target_branch")
                delivery_keys.add(delivery["delivery_key"])
                repositories.add(delivery["repository"])
                if (
                    not isinstance(delivery["allowed_paths"], list)
                    or not delivery["allowed_paths"]
                    or len(delivery["allowed_paths"]) > MAX_ALLOWED_PATHS_PER_REPOSITORY
                ):
                    raise CacheError("integrity-failure", "run-state allowed paths are invalid", 5)
                normalized_paths = [
                    canonical_allowed_path(path, f"{delivery_field}.allowed_paths")
                    for path in delivery["allowed_paths"]
                ]
                if normalized_paths != delivery["allowed_paths"] or len(normalized_paths) != len(set(normalized_paths)):
                    raise CacheError("integrity-failure", "run-state allowed paths are not canonical", 5)
                if delivery["managed_checkout"] is not None:
                    exact_object(
                        delivery["managed_checkout"],
                        {
                            "checkout",
                            "git_top_level",
                            "baseline_revision",
                            "isolation_evidence_ref",
                        },
                        f"{delivery_field}.managed_checkout",
                    )
                    canonical_absolute_path(
                        delivery["managed_checkout"]["checkout"],
                        f"{delivery_field}.managed_checkout.checkout",
                    )
                if delivery["revision"] is not None:
                    exact_object(
                        delivery["revision"],
                        {
                            "head_sha",
                            "base_ref",
                            "merge_base_sha",
                            "repository",
                            "github_repository",
                            "pr_number",
                            "pr_url",
                            "revision_key",
                            "evidence_ref",
                            "observed_at",
                        },
                        f"{delivery_field}.revision",
                    )
                    revision = delivery["revision"]
                    if (
                        not isinstance(revision["pr_number"], int)
                        or isinstance(revision["pr_number"], bool)
                        or revision["pr_number"] < 1
                    ):
                        raise CacheError("integrity-failure", "run-state revision PR number is invalid", 5)
                    github_repository = canonical_github_repository(
                        revision["github_repository"],
                        f"{delivery_field}.revision.github_repository",
                        error_code="integrity-failure",
                        exit_code=5,
                    )
                    canonical_github_pr_url(
                        revision["pr_url"],
                        github_repository,
                        revision["pr_number"],
                        f"{delivery_field}.revision.pr_url",
                        error_code="integrity-failure",
                        exit_code=5,
                    )
                    if revision["repository"] != delivery["repository"] or revision["revision_key"] != revision_key(
                        revision["repository"],
                        revision["pr_number"],
                        revision["pr_url"],
                        revision["head_sha"],
                        revision["base_ref"],
                        revision["merge_base_sha"],
                    ):
                        raise CacheError("integrity-failure", "run-state revision identity is invalid", 5)
                if delivery["pr"] is not None:
                    if validate_pr(delivery["pr"], delivery, f"{delivery_field}.pr") != delivery["pr"]:
                        raise CacheError("integrity-failure", "run-state pull request is not canonical", 5)
                if not isinstance(delivery["committed"], bool) or not isinstance(delivery["published"], bool):
                    raise CacheError("integrity-failure", "run-state delivery publication state is invalid", 5)
            if item["seal"] is not None:
                exact_object(
                    item["seal"],
                    {"revision_set_key", "seal_fingerprint", "evidence_ref", "sealed_at"},
                    f"run_state.tasks[{index}].seal",
                )
            if item["post_terminal_drift"] is not None:
                exact_object(
                    item["post_terminal_drift"],
                    {
                        "delivery_key",
                        "seal_fingerprint",
                        "drift_fingerprint",
                        "reason",
                        "evidence_ref",
                        "recorded_at",
                    },
                    f"run_state.tasks[{index}].post_terminal_drift",
                )
        seen_task_refs: set[str] = {value["portfolio"]["root_task_ref"]}
        seen_checkouts: set[tuple[str, str]] = set()
        for task in value["tasks"]:
            if task["task_ref"] is not None:
                if task["task_ref"] in seen_task_refs:
                    raise CacheError("integrity-failure", "run-state task ref is duplicated", 5)
                seen_task_refs.add(task["task_ref"])
            for delivery in task["deliveries"]:
                checkout = delivery["managed_checkout"]
                if checkout is None:
                    continue
                key = (delivery["repository"], checkout["checkout"])
                if key in seen_checkouts:
                    raise CacheError("integrity-failure", "run-state managed checkout is duplicated", 5)
                seen_checkouts.add(key)
        for index, item in enumerate(value["reviews"]):
            exact_object(
                item,
                {
                    "task_key",
                    "delivery_key",
                    "revision_key",
                    "github_repository",
                    "pr_number",
                    "pr_url",
                    "request_ref",
                    "wait_started_at",
                    "wait_deadline",
                    "wait_invoked_at",
                    "provider_timeout",
                    "wait_state",
                    "observations",
                },
                f"run_state.reviews[{index}]",
            )
            if not isinstance(item["observations"], list):
                raise CacheError("integrity-failure", "run-state review observations are invalid", 5)
            check_lower_kebab(item["task_key"], f"run_state.reviews[{index}].task_key")
            check_lower_kebab(item["delivery_key"], f"run_state.reviews[{index}].delivery_key")
            canonical_fingerprint(item["revision_key"], f"run_state.reviews[{index}].revision_key")
            if (
                not isinstance(item["pr_number"], int)
                or isinstance(item["pr_number"], bool)
                or item["pr_number"] < 1
            ):
                raise CacheError("integrity-failure", "run-state review PR number is invalid", 5)
            review_github_repository = canonical_github_repository(
                item["github_repository"],
                f"run_state.reviews[{index}].github_repository",
                error_code="integrity-failure",
                exit_code=5,
            )
            canonical_github_pr_url(
                item["pr_url"],
                review_github_repository,
                item["pr_number"],
                f"run_state.reviews[{index}].pr_url",
                error_code="integrity-failure",
                exit_code=5,
            )
            wait_started_at = parse_timestamp(item["wait_started_at"], "wait_started_at")
            wait_deadline = parse_timestamp(item["wait_deadline"], "wait_deadline")
            if wait_deadline != wait_started_at + timedelta(seconds=REVIEW_WAIT_SECONDS):
                raise CacheError(
                    "integrity-failure",
                    "run-state review deadline is not exactly 45 minutes",
                    5,
                )
            wait_invoked_at = item["wait_invoked_at"]
            provider_timeout = item["provider_timeout"]
            invoked_at = None
            if (wait_invoked_at is None) != (provider_timeout is None):
                raise CacheError("integrity-failure", "run-state review invocation is incomplete", 5)
            if wait_invoked_at is not None:
                invoked_at = parse_timestamp(wait_invoked_at, "wait_invoked_at")
                if (
                    invoked_at < wait_started_at
                    or not isinstance(provider_timeout, int)
                    or isinstance(provider_timeout, bool)
                    or provider_timeout < 0
                    or provider_timeout
                    != max(0, int((wait_deadline - invoked_at).total_seconds()))
                ):
                    raise CacheError("integrity-failure", "run-state review timeout is invalid", 5)
            if len(item["observations"]) > MAX_REVIEW_OBSERVATIONS:
                raise CacheError("integrity-failure", "run-state review observations exceed their bound", 5)
            if item["observations"] and invoked_at is None:
                raise CacheError(
                    "integrity-failure",
                    "run-state review observation precedes provider invocation",
                    5,
                )
            if item["wait_state"] not in REVIEW_WAIT_STATES:
                raise CacheError("integrity-failure", "run-state review wait state is invalid", 5)
            for observation in item["observations"]:
                exact_object(
                    observation,
                    {
                        "provider_state",
                        "observation_fingerprint",
                        "disposition",
                        "evidence_ref",
                        "warning_ref",
                        "warning_posted_at",
                        "warning_fingerprint",
                        "observed_at",
                    },
                    "run_state.review.observation",
                )
                observation_at = parse_timestamp(
                    observation["observed_at"], "observed_at"
                )
                if observation_at < invoked_at:
                    raise CacheError(
                        "integrity-failure",
                        "run-state review observation predates provider invocation",
                        5,
                    )
                validate_review_outcome(
                    observation["provider_state"],
                    observation["disposition"],
                    observation["warning_ref"],
                    observation["warning_posted_at"],
                    observation["warning_fingerprint"],
                    item,
                    observation_at,
                    wait_deadline,
                    "integrity-failure",
                    5,
                )
            if (item["wait_state"] == "complete") != bool(item["observations"]):
                raise CacheError("integrity-failure", "run-state review completion state is invalid", 5)
        for index, item in enumerate(value["gates"]):
            exact_object(
                item,
                {"task_key", "delivery_key", "gate", "state", "binding_key", "evidence_ref", "observed_at"},
                f"run_state.gates[{index}]",
            )
            if item["gate"] not in STATIC_GATES | REVISION_GATES or item["state"] not in GATE_STATES:
                raise CacheError("integrity-failure", "run-state gate state is invalid", 5)
            if item["gate"] in TASK_STATIC_GATES:
                valid_binding = item["delivery_key"] is None and item["binding_key"] is None
            elif item["gate"] in DELIVERY_STATIC_GATES:
                valid_binding = item["delivery_key"] is not None and item["binding_key"] is None
            elif item["gate"] in TASK_REVISION_SET_GATES:
                valid_binding = item["delivery_key"] is None and isinstance(item["binding_key"], str) and bool(FINGERPRINT_RE.fullmatch(item["binding_key"]))
            else:
                valid_binding = item["delivery_key"] is not None and isinstance(item["binding_key"], str) and bool(FINGERPRINT_RE.fullmatch(item["binding_key"]))
            if not valid_binding:
                raise CacheError("integrity-failure", "run-state gate binding is invalid", 5)
        for index, item in enumerate(value["handoffs"]):
            exact_object(
                item,
                {
                    "task_key",
                    "delivery_key",
                    "revision_key",
                    "seal_fingerprint",
                    "handoff_kind",
                    "authority",
                    "evidence_ref",
                    "next_action",
                    "deadline",
                    "recorded_at",
                },
                f"run_state.handoffs[{index}]",
            )
            if item["handoff_kind"] != "pull-request-ready":
                raise CacheError("integrity-failure", "run-state handoff kind is invalid", 5)
            if item["authority"] != "external-merge-required":
                raise CacheError("integrity-failure", "run-state handoff authority is invalid", 5)
        for index, item in enumerate(value["operations"]):
            exact_object(
                item,
                {"operation_id", "request_fingerprint", "event_types", "generation", "applied_at"},
                f"run_state.operations[{index}]",
            )
            check_operation_id(item["operation_id"])
            canonical_fingerprint(item["request_fingerprint"], "request_fingerprint")
        if state_payload_fingerprint(value) != value["content_fingerprint"]:
            raise CacheError("integrity-failure", "run-state fingerprint mismatch", 5)
        return value
    except CacheError as exc:
        if exc.code == "integrity-failure":
            raise
        raise CacheError("integrity-failure", exc.message, 5, exc.details) from exc


def load_state(ledger: Path) -> dict[str, Any]:
    if not ledger.exists():
        raise CacheError("not-found", f"run state not found: {ledger}", 3)
    if ledger.is_symlink() or not ledger.is_file():
        raise CacheError("invalid-input", f"run state is not a safe regular file: {ledger}", 2)
    if ledger.stat().st_size > MAX_PACKET_BYTES:
        raise CacheError("integrity-failure", f"run state exceeds the size bound: {ledger}", 5)
    try:
        raw = json.loads(ledger.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise CacheError("integrity-failure", f"run state is unreadable: {ledger}", 5) from exc
    return validate_state(raw, ledger)


def task_by_key(state: dict[str, Any], task_key: str) -> dict[str, Any]:
    matches = [task for task in state["tasks"] if task["task_key"] == task_key]
    if len(matches) != 1:
        raise CacheError("invalid-input", f"unknown task_key: {task_key}", 2)
    return matches[0]


def delivery_by_key(task: dict[str, Any], delivery_key: str) -> dict[str, Any]:
    matches = [item for item in task["deliveries"] if item["delivery_key"] == delivery_key]
    if len(matches) != 1:
        raise CacheError("invalid-input", f"unknown delivery_key: {delivery_key}", 2)
    return matches[0]


def current_revision_set_key(task: dict[str, Any]) -> str | None:
    if any(delivery["revision"] is None for delivery in task["deliveries"]):
        return None
    return request_fingerprint(
        [
            {
                "delivery_key": delivery["delivery_key"],
                "revision_key": delivery["revision"]["revision_key"],
            }
            for delivery in sorted(task["deliveries"], key=lambda item: item["delivery_key"])
        ]
    )


def gate_binding(
    task: dict[str, Any], gate: str, delivery: dict[str, Any] | None
) -> tuple[str | None, str | None]:
    if gate in TASK_STATIC_GATES:
        if delivery is not None:
            raise CacheError("invalid-input", f"{gate} is task-scoped", 2)
        return None, None
    if gate in DELIVERY_STATIC_GATES:
        if delivery is None:
            raise CacheError("invalid-input", f"{gate} is delivery-scoped", 2)
        return delivery["delivery_key"], None
    if gate in TASK_REVISION_SET_GATES:
        if delivery is not None:
            raise CacheError("invalid-input", f"{gate} is revision-set-scoped", 2)
        revision_set = current_revision_set_key(task)
        if revision_set is None:
            raise CacheError("state-conflict", f"{gate} requires a complete revision set", 4)
        return None, revision_set
    if gate in DELIVERY_REVISION_GATES:
        if delivery is None or delivery["revision"] is None:
            raise CacheError("state-conflict", f"{gate} requires a delivery revision", 4)
        return delivery["delivery_key"], delivery["revision"]["revision_key"]
    raise CacheError("invalid-input", f"unknown gate: {gate}", 2)


def current_gate(
    state: dict[str, Any],
    task: dict[str, Any],
    gate: str,
    delivery: dict[str, Any] | None = None,
) -> dict[str, Any] | None:
    try:
        delivery_key, binding_key = gate_binding(task, gate, delivery)
    except CacheError as exc:
        if exc.code == "state-conflict":
            return None
        raise
    matches = [
        item
        for item in state["gates"]
        if item["task_key"] == task["task_key"]
        and item["delivery_key"] == delivery_key
        and item["gate"] == gate
        and item["binding_key"] == binding_key
    ]
    return matches[-1] if matches else None


def current_review(
    state: dict[str, Any], task: dict[str, Any], delivery: dict[str, Any]
) -> dict[str, Any] | None:
    revision = delivery["revision"]
    if revision is None:
        return None
    matches = [
        item
        for item in state["reviews"]
        if item["task_key"] == task["task_key"]
        and item["delivery_key"] == delivery["delivery_key"]
        and item["revision_key"] == revision["revision_key"]
    ]
    return matches[-1] if matches else None


def review_timeout_warning_body(review: dict[str, Any]) -> str:
    return (
        "Implement Feature continued because Codex review remained pending for "
        "the full 45-minute wait.\n\n"
        f"Pull request: {review['pr_url']}\n"
        f"Review request: {review['request_ref']}\n"
        f"Revision: {review['revision_key']}\n\n"
        "This is not a clean review verdict. A later merge workflow must re-check "
        "this pull request for late Codex findings before merge."
    )


def review_timeout_warning_fingerprint(review: dict[str, Any]) -> str:
    return hashlib.sha256(review_timeout_warning_body(review).encode()).hexdigest()


def validate_review_outcome(
    provider: Any,
    disposition: Any,
    warning_ref: Any,
    warning_posted_at: Any,
    warning_fingerprint: Any,
    review: dict[str, Any],
    observed_at: datetime,
    deadline: datetime,
    error_code: str,
    exit_code: int,
) -> None:
    valid_pairs = {
        ("clean", "accepted"),
        ("findings", "fix-required"),
        ("failed", "blocked"),
        ("waiting", "timeout-accepted"),
    }
    if provider not in REVIEW_PROVIDER_STATES or disposition not in REVIEW_DISPOSITIONS:
        raise CacheError(error_code, "review observation state is invalid", exit_code)
    if (provider, disposition) not in valid_pairs:
        raise CacheError(error_code, "review provider state and disposition do not match", exit_code)
    if provider == "waiting":
        if observed_at < deadline:
            raise CacheError(error_code, "pending review cannot be accepted before its deadline", exit_code)
        if (
            not isinstance(warning_ref, str)
            or not warning_ref.strip()
            or len(warning_ref.strip()) > MAX_TEXT_LENGTH
        ):
            raise CacheError(error_code, "warning_ref is required", exit_code)
        comment_prefix = f"{review['pr_url']}#issuecomment-"
        comment_id = warning_ref.removeprefix(comment_prefix)
        if (
            not warning_ref.startswith(comment_prefix)
            or not comment_id.isdigit()
            or int(comment_id) < 1
        ):
            raise CacheError(
                error_code,
                "warning_ref must identify a comment on the exact pull request",
                exit_code,
            )
        if warning_ref == review["request_ref"]:
            raise CacheError(
                error_code,
                "warning_ref cannot reuse the review request reference",
                exit_code,
            )
        posted_at = parse_timestamp(warning_posted_at, "warning_posted_at")
        if posted_at < deadline or posted_at > observed_at:
            raise CacheError(
                error_code,
                "warning_posted_at must be between the review deadline and observation",
                exit_code,
            )
        fingerprint = canonical_fingerprint(
            warning_fingerprint, "warning_fingerprint"
        )
        if fingerprint != review_timeout_warning_fingerprint(review):
            raise CacheError(
                error_code,
                "warning_fingerprint does not match the required timeout warning",
                exit_code,
            )
    elif any(
        value is not None
        for value in (warning_ref, warning_posted_at, warning_fingerprint)
    ):
        raise CacheError(
            error_code,
            "warning evidence is only valid for an accepted review timeout",
            exit_code,
        )


def review_is_accepted(review: dict[str, Any] | None) -> bool:
    if review is None or review["wait_state"] != "complete" or not review["observations"]:
        return False
    observation = review["observations"][-1]
    return (
        observation["provider_state"] == "clean"
        and observation["disposition"] == "accepted"
    ) or (
        observation["provider_state"] == "waiting"
        and observation["disposition"] == "timeout-accepted"
        and observation["warning_ref"] is not None
    )


def review_warnings(state: dict[str, Any]) -> list[dict[str, Any]]:
    warnings: list[dict[str, Any]] = []
    total = 0
    omitted = 0
    for task in state["tasks"]:
        for delivery in task["deliveries"]:
            review = current_review(state, task, delivery)
            if review is None or not review["observations"]:
                continue
            observation = review["observations"][-1]
            if observation["disposition"] != "timeout-accepted":
                continue
            total += 1
            warning = {
                "code": "codex-review-timeout-accepted",
                "task_key": review["task_key"],
                "delivery_key": review["delivery_key"],
                "revision_key": review["revision_key"],
                "pr_url": review["pr_url"],
                "warning_ref": observation["warning_ref"],
            }
            candidate_size = len(
                json.dumps(
                    [*warnings, warning],
                    sort_keys=True,
                    separators=(",", ":"),
                ).encode()
            )
            if candidate_size <= MAX_PROJECTED_REVIEW_WARNING_BYTES - 256:
                warnings.append(warning)
            else:
                omitted += 1
    if omitted:
        warnings.append(
            {
                "code": "codex-review-timeout-accepted",
                "summary": "additional-warnings-omitted",
                "omitted_count": omitted,
                "total_count": total,
            }
        )
    return warnings


def task_dispatch_ready(state: dict[str, Any], task: dict[str, Any]) -> bool:
    if (
        state["portfolio"]["root_task_title_evidence_ref"] is None
        or state["goal"]["state"] != "active"
    ):
        return False
    dependency = current_gate(state, task, "dependency-integration")
    if not dependency or dependency["state"] != "passed":
        return False
    return all(
        (gate := current_gate(state, task, "pr-preflight", delivery))
        and gate["state"] == "passed"
        for delivery in task["deliveries"]
    )


def paths_overlap(left: dict[str, Any], right: dict[str, Any]) -> bool:
    for left_delivery in left["deliveries"]:
        for right_delivery in right["deliveries"]:
            if left_delivery["repository"] != right_delivery["repository"]:
                continue
            for left_path in left_delivery["allowed_paths"]:
                for right_path in right_delivery["allowed_paths"]:
                    if any(character in left_path + right_path for character in "*?["):
                        return True
                    if (
                        left_path == "."
                        or right_path == "."
                        or left_path == right_path
                        or left_path.startswith(right_path + "/")
                        or right_path.startswith(left_path + "/")
                    ):
                        return True
    return False


def delivery_proof_blockers(
    state: dict[str, Any], task: dict[str, Any], delivery: dict[str, Any]
) -> list[str]:
    blockers: list[str] = []
    if delivery["managed_checkout"] is None:
        blockers.append("missing-managed-checkout")
    if delivery["revision"] is None:
        blockers.append("missing-current-revision")
    static = current_gate(state, task, "pr-preflight", delivery)
    if not static or static["state"] != "passed":
        blockers.append("gate:pr-preflight")
    for gate in sorted(DELIVERY_REVISION_GATES):
        evidence = current_gate(state, task, gate, delivery)
        if not evidence or evidence["state"] != "passed":
            blockers.append(f"gate:{gate}")
    review = current_review(state, task, delivery)
    if not review or not review["observations"]:
        blockers.append("missing-current-review")
    elif not review_is_accepted(review):
        blockers.append("review-not-accepted")
    revision = delivery["revision"]
    pr = delivery["pr"]
    if pr is None:
        blockers.append("missing-pull-request")
    elif (
        pr["state"] != "open"
        or pr["is_draft"]
        or not pr["mergeable"]
        or pr["merge_state"] != "clean"
        or revision is None
        or pr["repository"] != revision["repository"]
        or pr["github_repository"] != revision["github_repository"]
        or pr["number"] != revision["pr_number"]
        or pr["url"] != revision["pr_url"]
        or pr["head_sha"] != revision["head_sha"]
        or pr["base_ref"] != revision["base_ref"]
        or pr["merge_base_sha"] != revision["merge_base_sha"]
    ):
        blockers.append("pull-request-not-ready")
    if not delivery["committed"] or not delivery["published"]:
        blockers.append("delivery-not-published")
    if delivery["tracker_dirty_after_revision_key"] is not None:
        blockers.append("tracker-delivery-dirty")
    return blockers


def task_proof_blockers(state: dict[str, Any], task: dict[str, Any]) -> list[str]:
    blockers: list[str] = []
    if task["task_title"] is None or task["task_title_evidence_ref"] is None:
        blockers.append("missing-task-title-evidence")
    if task["task_ref"] is None or task["managed_checkouts_evidence_ref"] is None:
        blockers.append("missing-managed-checkout-map")
    dependency = current_gate(state, task, "dependency-integration")
    if not dependency or dependency["state"] != "passed":
        blockers.append("gate:dependency-integration")
    revision_set = current_revision_set_key(task)
    if revision_set is None:
        blockers.append("missing-current-revision-set")
    for gate in sorted(TASK_REVISION_SET_GATES):
        if gate == "domain-closeout" and not task["requires_domain_closeout"]:
            continue
        evidence = current_gate(state, task, gate)
        if not evidence or evidence["state"] != "passed":
            blockers.append(f"gate:{gate}")
    for delivery in task["deliveries"]:
        blockers.extend(
            f"{delivery['delivery_key']}:{blocker}"
            for blocker in delivery_proof_blockers(state, task, delivery)
        )
    source = next(item for item in state["sources"] if item["task_key"] == task["task_key"])
    if source["tracker_backend"] == "local" and source["state"] != "done":
        blockers.append("local-source-not-done")
    if source["tracker_backend"] == "github":
        tracker_delivery = next(
            item for item in task["deliveries"] if item["repository"] == source["tracker_repository"]
        )
        if tracker_delivery["pr"] is None or source["source_spec_ref"] not in tracker_delivery["pr"]["closing_refs"]:
            blockers.append("github-source-not-closing")
    return blockers


def seal_candidate_fingerprint(state: dict[str, Any], task: dict[str, Any]) -> str | None:
    if task_proof_blockers(state, task):
        return None
    revision_set = current_revision_set_key(task)
    return request_fingerprint(
        {
            "task_key": task["task_key"],
            "revision_set_key": revision_set,
            "source": next(item for item in state["sources"] if item["task_key"] == task["task_key"]),
            "deliveries": [
                {
                    "delivery_key": item["delivery_key"],
                    "revision": item["revision"],
                    "pr": item["pr"],
                    "committed": item["committed"],
                    "published": item["published"],
                }
                for item in task["deliveries"]
            ],
            "gates": [
                item for item in state["gates"] if item["task_key"] == task["task_key"]
            ],
            "reviews": [
                item for item in state["reviews"] if item["task_key"] == task["task_key"]
            ],
        }
    )


def terminal_handoff(state: dict[str, Any], task: dict[str, Any]) -> dict[str, Any] | None:
    seal = task["seal"]
    if seal is None:
        return None
    matches = [
        item for item in state["handoffs"]
        if item["task_key"] == task["task_key"]
        and item["handoff_kind"] == "pull-request-ready"
        and item["seal_fingerprint"] == seal["seal_fingerprint"]
    ]
    return matches[-1] if matches else None


def portfolio_verification_candidate(state: dict[str, Any]) -> str | None:
    if any(
        task["state"] != "merge-ready"
        or task["goal_state"] != "complete"
        or task["post_terminal_drift"] is not None
        or terminal_handoff(state, task) is None
        for task in state["tasks"]
    ):
        return None
    return request_fingerprint(
        [
            {
                "task_key": task["task_key"],
                "seal_fingerprint": task["seal"]["seal_fingerprint"],
                "goal_completion_evidence_ref": task["goal_completion_evidence_ref"],
                "handoff": terminal_handoff(state, task),
            }
            for task in sorted(state["tasks"], key=lambda item: item["task_key"])
        ]
    )


def task_terminal_blockers(
    state: dict[str, Any], task: dict[str, Any], *, require_task_state: bool
) -> list[str]:
    blockers = task_proof_blockers(state, task)
    if task["seal"] is None:
        blockers.append("task-not-sealed")
    if task["goal_state"] != "complete" or task["goal_completion_evidence_ref"] is None:
        blockers.append("task-goal-not-complete")
    if terminal_handoff(state, task) is None:
        blockers.append("missing-terminal-handoff")
    if task["post_terminal_drift"] is not None:
        blockers.append("post-terminal-drift")
    if require_task_state and task["state"] != "merge-ready":
        blockers.append("task-not-merge-ready")
    return blockers


def terminal_projection(state: dict[str, Any]) -> dict[str, Any]:
    tasks: list[dict[str, Any]] = []
    blockers: list[str] = []
    warnings = review_warnings(state)
    for task in state["tasks"]:
        proof_blockers = task_proof_blockers(state, task)
        task_blockers = task_terminal_blockers(state, task, require_task_state=True)
        tasks.append(
            {
                "task_key": task["task_key"],
                "state": task["state"],
                "revision_set_key": current_revision_set_key(task),
                "seal_candidate_fingerprint": seal_candidate_fingerprint(state, task),
                "sealed": task["seal"] is not None,
                "proof_ready": not proof_blockers,
                "blockers": task_blockers,
            }
        )
        blockers.extend(f"{task['task_key']}:{item}" for item in task_blockers)
    verification_candidate = portfolio_verification_candidate(state)
    verified = (
        verification_candidate is not None
        and state["closeout"]["portfolio_terminal_verification_fingerprint"]
        == verification_candidate
    )
    drifted = state["closeout"]["post_terminal_drift"] is not None
    archive_ready = verified and state["goal"]["state"] == "complete" and not drifted
    if not verified:
        blockers.append("portfolio-terminal-not-verified")
    if state["goal"]["state"] != "complete":
        blockers.append("portfolio-goal-not-complete")
    if drifted:
        blockers.append("post-terminal-drift")
    phase = (
        "drifted" if drifted else
        "archive-ready" if archive_ready else
        "portfolio-goal-ready" if verified else
        "portfolio-verification-ready" if verification_candidate is not None else
        "running"
    )
    return {
        "eligible": archive_ready,
        "archive_ready": archive_ready,
        "phase": phase,
        "blockers": sorted(set(blockers)),
        "portfolio_verification_candidate": verification_candidate,
        "portfolio_verified": verified,
        "warnings": warnings,
        "tasks": tasks,
    }


def project_state(state: dict[str, Any], projection: str) -> dict[str, Any]:
    if projection not in PROJECTIONS:
        raise CacheError("invalid-input", f"unknown projection: {projection}", 2)
    terminal = terminal_projection(state)
    base: dict[str, Any] = {
        "projection": projection,
        "generation": state["generation"],
        "content_fingerprint": state["content_fingerprint"],
        "portfolio_key": state["portfolio"]["key"],
        "root_id": state["portfolio"]["root_id"],
        "root_task_title": state["portfolio"]["root_task_title"],
        "root_task_title_evidence_ref": state["portfolio"]["root_task_title_evidence_ref"],
        "goal": copy.deepcopy(state["goal"]),
        "warnings": copy.deepcopy(terminal["warnings"]),
        "phase": terminal["phase"],
    }
    if projection == "terminal":
        return {**base, **terminal}
    if projection == "dispatch":
        active = [
            task for task in state["tasks"]
            if task["task_ref"] is not None and task["state"] not in {"merge-ready", "failed"}
        ]
        capacity = max(0, 3 - len(active))
        selected: list[dict[str, Any]] = []
        for candidate in sorted(
            (task for task in state["tasks"] if task["state"] == "pending" and task_dispatch_ready(state, task)),
            key=lambda task: task["source_id"],
        ):
            if len(selected) >= capacity:
                break
            if any(paths_overlap(candidate, other) for other in [*active, *selected]):
                continue
            selected.append(candidate)
        return {
            **base,
            "ready_task_keys": [task["task_key"] for task in selected],
            "available_capacity": capacity,
        }
    tasks: list[dict[str, Any]] = []
    for task in state["tasks"]:
        gate_summary: dict[str, str] = {}
        for gate in sorted(TASK_STATIC_GATES | TASK_REVISION_SET_GATES):
            evidence = current_gate(state, task, gate)
            if evidence:
                gate_summary[gate] = evidence["state"]
        deliveries = []
        for delivery in task["deliveries"]:
            delivery_gates: dict[str, str] = {}
            for gate in sorted(DELIVERY_STATIC_GATES | DELIVERY_REVISION_GATES):
                evidence = current_gate(state, task, gate, delivery)
                if evidence:
                    delivery_gates[gate] = evidence["state"]
            revision = delivery["revision"]
            deliveries.append(
                {
                    "delivery_key": delivery["delivery_key"],
                    "repository": delivery["repository"],
                    "revision_key": revision["revision_key"] if revision else None,
                    "pr": copy.deepcopy(delivery["pr"]),
                    "gates": delivery_gates,
                    "tracker_dirty": delivery["tracker_dirty_after_revision_key"] is not None,
                }
            )
        tasks.append(
            {
                "task_key": task["task_key"],
                "task_ref": task["task_ref"],
                "task_title": task["task_title"],
                "state": task["state"],
                "goal_state": task["goal_state"],
                "revision_set_key": current_revision_set_key(task),
                "gates": gate_summary,
                "deliveries": deliveries,
                "terminal_blockers": task_terminal_blockers(state, task, require_task_state=False),
            }
        )
    base.update(
        {
            "tasks": tasks,
            "terminal_eligible": terminal["eligible"],
        }
    )
    if projection == "recovery":
        base["sources"] = [
            {
                "task_key": item["task_key"],
                "current_ref": item["current_ref"],
                "state": item["state"],
                "fingerprint": item["fingerprint"],
            }
            for item in state["sources"]
        ]
        base["handoffs"] = copy.deepcopy(state["handoffs"])
        base["adoptions"] = [
            {"task_key": task["task_key"], **copy.deepcopy(task["adoption"])}
            for task in state["tasks"]
        ]
    return base


def render_markdown(state: dict[str, Any]) -> str:
    terminal = terminal_projection(state)
    lines = [
        "# Implement Feature Terminal Run State",
        "",
        f"- Portfolio: `{state['portfolio']['key']}`",
        f"- Root: `{state['portfolio']['root_id']}`",
        f"- Root task: {state['portfolio']['root_task_title']}",
        f"- Objective: {state['portfolio']['objective']}",
        f"- Generation: `{state['generation']}`",
        f"- Goal: `{state['goal']['state']}`",
        f"- Terminal eligible: `{'yes' if terminal['eligible'] else 'no'}`",
        "",
        "## Feature Spec Tasks",
        "",
        "| task | source | state | revisions | pull requests |",
        "| --- | --- | --- | --- | --- |",
    ]
    for task in sorted(state["tasks"], key=lambda item: item["task_key"]):
        revisions = ", ".join(
            delivery["revision"]["revision_key"] if delivery["revision"] else "none"
            for delivery in task["deliveries"]
        )
        prs = ", ".join(
            delivery["pr"]["url"] if delivery["pr"] else "none"
            for delivery in task["deliveries"]
        )
        lines.append(
            f"| `{task['task_key']}` | {task['source_spec_ref']} | `{task['state']}` | `{revisions}` | {prs} |"
        )
    lines.extend(["", "## Current Gate Evidence", "", "| task | gate | state | evidence |", "| --- | --- | --- | --- |"])
    for task in sorted(state["tasks"], key=lambda item: item["task_key"]):
        for gate in sorted(TASK_STATIC_GATES | TASK_REVISION_SET_GATES):
            item = current_gate(state, task, gate)
            if item:
                lines.append(
                    f"| `{task['task_key']}` | `{gate}` | `{item['state']}` | {item['evidence_ref']} |"
                )
        for delivery in task["deliveries"]:
            for gate in sorted(DELIVERY_STATIC_GATES | DELIVERY_REVISION_GATES):
                item = current_gate(state, task, gate, delivery)
                if item:
                    lines.append(
                        f"| `{task['task_key']}:{delivery['delivery_key']}` | `{gate}` | `{item['state']}` | {item['evidence_ref']} |"
                    )
    lines.extend(["", "## Review Warnings", ""])
    warnings = review_warnings(state)
    if warnings:
        for item in warnings:
            if item.get("summary") == "additional-warnings-omitted":
                lines.append(
                    f"- {item['omitted_count']} additional timeout warnings omitted "
                    f"from this bounded view ({item['total_count']} total); full "
                    "evidence remains in the JSON archive."
                )
            else:
                lines.append(
                    f"- `{item['task_key']}:{item['delivery_key']}` timed out: "
                    f"{item['warning_ref']}"
                )
    else:
        lines.append("- None")
    lines.extend(["", "## External Handoffs", ""])
    if state["handoffs"]:
        for item in state["handoffs"]:
            lines.append(
                f"- `{item['task_key']}` `{item['handoff_kind']}`: {item['evidence_ref']} — {item['next_action']}"
            )
    else:
        lines.append("- None")
    lines.append("")
    return "\n".join(lines)


def new_state(
    *,
    ledger: Path,
    root_id: str,
    claim: dict[str, Any],
    registration: dict[str, Any],
    operation_id: str,
) -> dict[str, Any]:
    now = format_timestamp(utc_now())
    sources = []
    tasks = []
    for item in registration["sources"]:
        sources.append(
            {
                "task_key": item["task_key"],
                "source_id": item["source_id"],
                "source_spec_ref": item["source_spec_ref"],
                "current_ref": item["source_spec_ref"],
                "planned_done_ref": item["planned_done_ref"],
                "state": item["source_state"],
                "fingerprint": item["source_fingerprint"],
                "tracker_backend": item["tracker_backend"],
                "tracker_repository": item["tracker_repository"],
                "move_evidence_ref": None,
                "move_revision_set_key": None,
                "dirty_delivery_key": None,
                "dirty_after_revision_key": None,
            }
        )
        adoption = copy.deepcopy(item["adoption"])
        adopted_checkouts: dict[str, dict[str, Any]] = {}
        if adoption["task_state"] == "recorded":
            adoption_task = {"deliveries": item["deliveries"]}
            for checkout_index, checkout in enumerate(adoption["managed_checkouts"]):
                repository = nonempty(checkout.get("repository"), "adoption.repository")
                delivery = next(
                    delivery
                    for delivery in item["deliveries"]
                    if delivery["repository"] == repository
                )
                _, verified_checkout = validate_managed_checkout(
                    {
                        "delivery_key": delivery["delivery_key"],
                        "repository": repository,
                        "target_branch": checkout.get("target_branch_name"),
                        "checkout": checkout.get("checkout"),
                        "git_top_level": checkout.get("git_top_level"),
                        "baseline_revision": checkout.get("baseline_revision"),
                        "isolation_evidence_ref": checkout.get(
                            "isolation_evidence_ref"
                        ),
                    },
                    task=adoption_task,
                    field=f"adoption.managed_checkouts[{checkout_index}]",
                )
                adopted_checkouts[repository] = verified_checkout
        deliveries = [
            {
                **delivery,
                "managed_checkout": copy.deepcopy(
                    adopted_checkouts.get(delivery["repository"])
                ),
                "revision": None,
                "pr": None,
                "committed": False,
                "published": False,
                "observation_evidence_ref": None,
                "tracker_dirty_after_revision_key": None,
            }
            for delivery in item["deliveries"]
        ]
        tasks.append(
            {
                "task_key": item["task_key"],
                "source_id": item["source_id"],
                "source_spec_ref": item["source_spec_ref"],
                "feature_spec_title": item["feature_spec_title"],
                "feature_slug": item["feature_slug"],
                "dependency_ids": item["dependency_ids"],
                "requires_domain_closeout": item["requires_domain_closeout"],
                "adoption": adoption,
                "task_ref": (
                    nonempty(adoption["task_ref"], "adoption.task_ref")
                    if adoption["task_state"] == "recorded"
                    else None
                ),
                "managed_checkouts_evidence_ref": (
                    nonempty(adoption["evidence_ref"], "adoption.evidence_ref")
                    if adoption["task_state"] == "recorded"
                    else None
                ),
                "model": item["task_model"],
                "reasoning_effort": item["task_thinking"],
                "thinking_reason": item["thinking_reason"],
                "task_title": None,
                "task_title_evidence_ref": None,
                "goal_objective_fingerprint": item[
                    "task_goal_objective_fingerprint"
                ],
                "goal_state": "pending",
                "goal_evidence_ref": (
                    nonempty(adoption["goal_evidence_ref"], "adoption.goal_evidence_ref")
                    if adoption["task_state"] == "recorded"
                    else None
                ),
                "goal_completion_evidence_ref": None,
                "state": "created" if adoption["task_state"] == "recorded" else "pending",
                "outcome": None,
                "attention_reason": None,
                "summary_ref": None,
                "deliveries": deliveries,
                "seal": None,
                "post_terminal_drift": None,
            }
        )
        if adoption["task_state"] == "recorded":
            tasks[-1]["goal_state"] = "active"
    title = ROOT_TITLES["single" if len(tasks) == 1 else "multiple"]
    registration_fingerprint = request_fingerprint(registration)
    state = {
        "schema_version": LEDGER_SCHEMA_VERSION,
        "generation": 1,
        "content_fingerprint": "0" * 64,
        "created_at": now,
        "updated_at": now,
        "portfolio": {
            "key": ledger.stem,
            "root_id": root_id,
            "root_task_ref": registration["root_task_ref"],
            "root_task_title": title,
            "root_task_title_evidence_ref": None,
            "root_checkout": registration["root_checkout"],
            "objective": registration["objective"],
            "objective_fingerprint": registration["objective_fingerprint"],
            "repositories": registration["repositories"],
            "repository_checkouts": registration["repository_checkouts"],
        },
        "claim": {"fingerprint": claim["fingerprint"]},
        "authorization": {
            "visible_app_task_permission": "granted-by-authorized-user",
            "evidence_ref": registration["permission_evidence_ref"],
        },
        "goal": {
            "state": "pending",
            "evidence_ref": None,
            "completion_evidence_ref": None,
        },
        "sources": sources,
        "tasks": tasks,
        "reviews": [],
        "gates": [],
        "handoffs": [],
        "operations": [
            {
                "operation_id": operation_id,
                "request_fingerprint": registration_fingerprint,
                "event_types": ["registration"],
                "generation": 1,
                "applied_at": now,
            }
        ],
        "closeout": {
            "portfolio_terminal_verification_fingerprint": None,
            "portfolio_terminal_evidence_ref": None,
            "post_terminal_drift": None,
        },
    }
    seal_state_fingerprint(state)
    validate_state(state, ledger)
    return state


def check_operation_id(value: Any) -> str:
    if not isinstance(value, str) or not TRANSACTION_ID_RE.fullmatch(value):
        raise CacheError("invalid-input", "operation_id must be 32 lowercase hex characters", 2)
    return value


def revision_key(
    repository: str,
    pr_number: int,
    pr_url: str,
    head_sha: str,
    base_ref: str,
    merge_base_sha: str,
) -> str:
    return request_fingerprint(
        {
            "repository": repository,
            "pr_number": pr_number,
            "pr_url": pr_url,
            "head_sha": head_sha,
            "base_ref": base_ref,
            "merge_base_sha": merge_base_sha,
        }
    )


def validate_pr(value: Any, task: dict[str, Any], field: str) -> dict[str, Any] | None:
    if value is None:
        return None
    pr = exact_object(
        value,
        {
            "repository",
            "github_repository",
            "number",
            "url",
            "state",
            "is_draft",
            "head_sha",
            "base_ref",
            "merge_base_sha",
            "mergeable",
            "merge_state",
            "closing_refs",
        },
        field,
    )
    if nonempty(pr["repository"], f"{field}.repository") != task["repository"]:
        raise CacheError("invalid-input", f"{field}.repository does not match the task", 2)
    if (
        not isinstance(pr["number"], int)
        or isinstance(pr["number"], bool)
        or pr["number"] < 1
    ):
        raise CacheError("invalid-input", f"{field}.number is invalid", 2)
    github_repository = canonical_github_repository(
        pr["github_repository"], f"{field}.github_repository"
    )
    url = canonical_github_pr_url(
        pr["url"], github_repository, pr["number"], f"{field}.url"
    )
    if pr["state"] not in {"open", "closed"} or not isinstance(pr["is_draft"], bool):
        raise CacheError("invalid-input", f"{field} lifecycle is invalid", 2)
    head_sha = nonempty(pr["head_sha"], f"{field}.head_sha")
    base_ref = nonempty(pr["base_ref"], f"{field}.base_ref")
    merge_base_sha = nonempty(pr["merge_base_sha"], f"{field}.merge_base_sha")
    if not isinstance(pr["mergeable"], bool) or pr["merge_state"] not in {
        "clean",
        "blocked",
        "dirty",
        "behind",
        "unknown",
    }:
        raise CacheError("invalid-input", f"{field} merge state is invalid", 2)
    if not isinstance(pr["closing_refs"], list):
        raise CacheError("invalid-input", f"{field}.closing_refs is invalid", 2)
    closing_refs = [nonempty(item, f"{field}.closing_refs") for item in pr["closing_refs"]]
    if len(closing_refs) != len(set(closing_refs)):
        raise CacheError("invalid-input", f"{field}.closing_refs contains duplicates", 2)
    return {
        "repository": task["repository"],
        "github_repository": github_repository,
        "number": pr["number"],
        "url": url,
        "state": pr["state"],
        "is_draft": pr["is_draft"],
        "head_sha": head_sha,
        "base_ref": base_ref,
        "merge_base_sha": merge_base_sha,
        "mergeable": pr["mergeable"],
        "merge_state": pr["merge_state"],
        "closing_refs": closing_refs,
    }


def validate_managed_checkout(
    raw: Any,
    *,
    task: dict[str, Any],
    field: str,
) -> tuple[dict[str, Any], dict[str, Any]]:
    item = exact_object(
        raw,
        {
            "delivery_key",
            "repository",
            "target_branch",
            "checkout",
            "git_top_level",
            "baseline_revision",
            "isolation_evidence_ref",
        },
        field,
    )
    delivery_key = check_lower_kebab(item["delivery_key"], f"{field}.delivery_key")
    delivery = delivery_by_key(task, delivery_key)
    repository = nonempty(item["repository"], f"{field}.repository")
    target_branch = nonempty(item["target_branch"], f"{field}.target_branch")
    if repository != delivery["repository"] or target_branch != delivery["target_branch"]:
        raise CacheError("state-conflict", f"{field} delivery identity changed", 4)
    checkout = canonical_absolute_path(item["checkout"], f"{field}.checkout")
    git_top_level = canonical_absolute_path(item["git_top_level"], f"{field}.git_top_level")
    checkout_path = Path(checkout)
    if checkout_path.is_symlink() or not checkout_path.is_dir():
        raise CacheError("invalid-input", f"{field}.checkout is not a safe directory", 2)
    commands = {
        "git_top_level": ["git", "-C", checkout, "rev-parse", "--show-toplevel"],
        "repository": ["git", "-C", checkout, "rev-parse", "--path-format=absolute", "--git-common-dir"],
        "target_branch": ["git", "-C", checkout, "branch", "--show-current"],
    }
    observed: dict[str, str] = {}
    for key, command in commands.items():
        result = subprocess.run(command, text=True, capture_output=True)
        if result.returncode:
            raise CacheError("invalid-input", f"{field} is not a managed Git checkout", 2)
        observed[key] = result.stdout.strip()
    observed["git_top_level"] = str(Path(observed["git_top_level"]).resolve())
    observed["repository"] = str(Path(observed["repository"]).resolve())
    if (
        observed["git_top_level"] != git_top_level
        or observed["repository"] != str(Path(repository).resolve())
        or observed["target_branch"] != target_branch
    ):
        raise CacheError("state-conflict", f"{field} Git checkout evidence changed", 4)
    baseline = nonempty(item["baseline_revision"], f"{field}.baseline_revision")
    baseline_check = subprocess.run(
        ["git", "-C", checkout, "cat-file", "-e", f"{baseline}^{{commit}}"],
        text=True,
        capture_output=True,
    )
    if baseline_check.returncode:
        raise CacheError("invalid-input", f"{field}.baseline_revision is not a commit", 2)
    return delivery, {
        "checkout": checkout,
        "git_top_level": git_top_level,
        "baseline_revision": baseline,
        "isolation_evidence_ref": nonempty(
            item["isolation_evidence_ref"], f"{field}.isolation_evidence_ref"
        ),
    }


def source_move_blockers(
    state: dict[str, Any], task: dict[str, Any]
) -> list[str]:
    blockers: list[str] = []
    dependency = current_gate(state, task, "dependency-integration")
    if not dependency or dependency["state"] != "passed":
        blockers.append("gate:dependency-integration")
    for gate in sorted(TASK_REVISION_SET_GATES):
        if gate == "domain-closeout" and not task["requires_domain_closeout"]:
            continue
        evidence = current_gate(state, task, gate)
        if not evidence or evidence["state"] != "passed":
            blockers.append(f"gate:{gate}")
    for delivery in task["deliveries"]:
        preflight = current_gate(state, task, "pr-preflight", delivery)
        if not preflight or preflight["state"] != "passed":
            blockers.append(f"{delivery['delivery_key']}:gate:pr-preflight")
        for gate in sorted(DELIVERY_REVISION_GATES - {"tracker-closeout", "mergeability"}):
            evidence = current_gate(state, task, gate, delivery)
            if not evidence or evidence["state"] != "passed":
                blockers.append(f"{delivery['delivery_key']}:gate:{gate}")
        review = current_review(state, task, delivery)
        if not review_is_accepted(review):
            blockers.append(f"{delivery['delivery_key']}:review-not-accepted")
    return blockers


def apply_event(state: dict[str, Any], raw: Any, now: datetime) -> bool:
    if not isinstance(raw, dict) or raw.get("type") not in EVENT_TYPES:
        raise CacheError("invalid-input", "event type is missing or unsupported", 2)
    event_type = raw["type"]
    observed_at = format_timestamp(now)

    if event_type == "root-title-observed":
        event = exact_object(raw, {"type", "title", "evidence_ref"}, event_type)
        if event["title"] != state["portfolio"]["root_task_title"]:
            raise CacheError("invalid-input", "observed root title does not match derived title", 2)
        evidence = nonempty(event["evidence_ref"], "evidence_ref")
        if state["portfolio"]["root_task_title_evidence_ref"] == evidence:
            return False
        state["portfolio"]["root_task_title_evidence_ref"] = evidence
        return True

    if event_type == "portfolio-goal-activated":
        event = exact_object(raw, {"type", "goal_evidence_ref", "objective_fingerprint"}, event_type)
        if event["objective_fingerprint"] != state["portfolio"]["objective_fingerprint"]:
            raise CacheError("invalid-input", "Goal objective fingerprint does not match", 2)
        if state["portfolio"]["root_task_title_evidence_ref"] is None:
            raise CacheError("state-conflict", "Goal cannot activate before root title evidence", 4)
        evidence = nonempty(event["goal_evidence_ref"], "goal_evidence_ref")
        if state["goal"]["state"] == "active" and state["goal"]["evidence_ref"] == evidence:
            return False
        if state["goal"]["state"] != "pending":
            raise CacheError("state-conflict", "portfolio Goal activation is out of order", 4)
        state["goal"].update(
            {
                "state": "active",
                "evidence_ref": evidence,
                "completion_evidence_ref": None,
            }
        )
        return True

    if event_type == "portfolio-terminal-verified":
        event = exact_object(raw, {"type", "verification_fingerprint", "evidence_ref"}, event_type)
        if state["goal"]["state"] != "active":
            raise CacheError("state-conflict", "portfolio verification requires an active root Goal", 4)
        candidate = portfolio_verification_candidate(state)
        fingerprint = canonical_fingerprint(event["verification_fingerprint"], "verification_fingerprint")
        if candidate is None or fingerprint != candidate:
            raise CacheError("state-conflict", "portfolio terminal verification is stale", 4)
        evidence = nonempty(event["evidence_ref"], "evidence_ref")
        if (
            state["closeout"]["portfolio_terminal_verification_fingerprint"] == fingerprint
            and state["closeout"]["portfolio_terminal_evidence_ref"] == evidence
        ):
            return False
        if state["closeout"]["portfolio_terminal_verification_fingerprint"] is not None:
            raise CacheError("state-conflict", "portfolio terminal verification changed", 4)
        state["closeout"]["portfolio_terminal_verification_fingerprint"] = fingerprint
        state["closeout"]["portfolio_terminal_evidence_ref"] = evidence
        return True

    if event_type == "portfolio-goal-completed":
        event = exact_object(
            raw,
            {"type", "goal_evidence_ref", "completion_evidence_ref", "verification_fingerprint"},
            event_type,
        )
        verification = canonical_fingerprint(event["verification_fingerprint"], "verification_fingerprint")
        if (
            state["closeout"]["portfolio_terminal_verification_fingerprint"] != verification
            or portfolio_verification_candidate(state) != verification
        ):
            raise CacheError("state-conflict", "portfolio Goal completion lacks current verification", 4)
        if state["goal"]["state"] == "complete":
            if (
                state["goal"]["evidence_ref"] == event["goal_evidence_ref"]
                and state["goal"]["completion_evidence_ref"] == event["completion_evidence_ref"]
            ):
                return False
            raise CacheError("state-conflict", "portfolio Goal completion evidence changed", 4)
        if state["goal"]["state"] != "active" or state["goal"]["evidence_ref"] != event["goal_evidence_ref"]:
            raise CacheError("state-conflict", "portfolio Goal completion is out of order", 4)
        state["goal"]["state"] = "complete"
        state["goal"]["completion_evidence_ref"] = nonempty(
            event["completion_evidence_ref"], "completion_evidence_ref"
        )
        return True

    task_key = check_lower_kebab(raw.get("task_key"), "task_key")
    task = task_by_key(state, task_key)

    if task["seal"] is not None and event_type not in {
        "task-goal-completed",
        "terminal-handoff-recorded",
        "post-terminal-drift-recorded",
    }:
        raise CacheError("state-conflict", "sealed task state is immutable", 4)

    if event_type == "managed-checkouts-observed":
        event = exact_object(raw, {"type", "task_key", "task_ref", "managed_checkouts", "evidence_ref"}, event_type)
        task_ref = nonempty(event["task_ref"], "task_ref")
        if task_ref == state["portfolio"]["root_task_ref"]:
            raise CacheError("state-conflict", "worker task_ref collides with the root task", 4)
        if any(other is not task and other["task_ref"] == task_ref for other in state["tasks"]):
            raise CacheError("state-conflict", "task_ref is already owned by another task", 4)
        raw_checkouts = event["managed_checkouts"]
        if not isinstance(raw_checkouts, list) or len(raw_checkouts) != len(task["deliveries"]):
            raise CacheError("invalid-input", "managed checkout map must be complete", 2)
        normalized: dict[str, dict[str, Any]] = {}
        for index, raw_checkout in enumerate(raw_checkouts):
            delivery, checkout = validate_managed_checkout(
                raw_checkout, task=task, field=f"managed_checkouts[{index}]"
            )
            if delivery["delivery_key"] in normalized:
                raise CacheError("invalid-input", "managed checkout map duplicates a delivery", 2)
            normalized[delivery["delivery_key"]] = checkout
        if set(normalized) != {item["delivery_key"] for item in task["deliveries"]}:
            raise CacheError("invalid-input", "managed checkout map must cover every delivery", 2)
        global_keys = {
            (delivery["repository"], delivery["managed_checkout"]["checkout"])
            for other in state["tasks"] if other is not task
            for delivery in other["deliveries"] if delivery["managed_checkout"] is not None
        }
        candidate_keys = {
            (delivery["repository"], normalized[delivery["delivery_key"]]["checkout"])
            for delivery in task["deliveries"]
        }
        if len(candidate_keys) != len(task["deliveries"]) or candidate_keys & global_keys:
            raise CacheError("state-conflict", "managed checkout is already owned", 4)
        evidence = nonempty(event["evidence_ref"], "evidence_ref")
        if task["task_ref"] is not None:
            if (
                task["task_ref"] == task_ref
                and task["managed_checkouts_evidence_ref"] == evidence
                and all(
                    delivery["managed_checkout"] == normalized[delivery["delivery_key"]]
                    for delivery in task["deliveries"]
                )
            ):
                return False
            raise CacheError("state-conflict", "managed checkout identity is immutable", 4)
        task["task_ref"] = task_ref
        task["managed_checkouts_evidence_ref"] = evidence
        for delivery in task["deliveries"]:
            delivery["managed_checkout"] = normalized[delivery["delivery_key"]]
        return True

    if event_type == "task-observed":
        event = exact_object(
            raw,
            {
                "type", "task_key", "model", "reasoning_effort", "thinking_reason",
                "task_title", "task_title_evidence_ref", "goal_objective_fingerprint",
                "goal_state", "goal_evidence_ref", "state", "outcome",
                "attention_reason", "summary_ref",
            },
            event_type,
        )
        if task["task_ref"] is None or task["managed_checkouts_evidence_ref"] is None:
            raise CacheError("state-conflict", "task cannot be observed before its complete checkout map", 4)
        if (
            event["model"] != task["model"]
            or event["reasoning_effort"] != task["reasoning_effort"]
            or nonempty(event["thinking_reason"], "thinking_reason") != task["thinking_reason"]
        ):
            raise CacheError("state-conflict", "task execution profile changed", 4)
        title = nonempty(event["task_title"], "task_title")
        title_evidence = event["task_title_evidence_ref"]
        if title_evidence is not None:
            title_evidence = nonempty(title_evidence, "task_title_evidence_ref")
        if task["task_title"] is not None and task["task_title"] != title:
            raise CacheError("state-conflict", "task title changed", 4)
        if event["goal_objective_fingerprint"] != task["goal_objective_fingerprint"]:
            raise CacheError("state-conflict", "task Goal objective fingerprint changed", 4)
        goal_state = event["goal_state"]
        if goal_state not in {"pending", "active"}:
            raise CacheError("invalid-input", "task-observed cannot complete or pause a Goal", 2)
        if task["goal_state"] == "pending" and goal_state == "active":
            goal_evidence = nonempty(event["goal_evidence_ref"], "goal_evidence_ref")
        elif task["goal_state"] == goal_state:
            goal_evidence = event["goal_evidence_ref"]
            if goal_evidence is not None:
                goal_evidence = nonempty(goal_evidence, "goal_evidence_ref")
        else:
            raise CacheError("state-conflict", "task Goal transition is out of order", 4)
        if (
            task["goal_evidence_ref"] is not None
            and goal_evidence != task["goal_evidence_ref"]
        ):
            raise CacheError("state-conflict", "task Goal evidence changed", 4)
        state_value = event["state"]
        if state_value in {"merge-ready", "terminal-sealed"}:
            raise CacheError("invalid-input", "task-observed cannot perform managed transitions", 2)
        if state_value not in TASK_STATES or state_value not in TASK_TRANSITIONS[task["state"]]:
            raise CacheError("state-conflict", f"invalid task transition: {task['state']} -> {state_value}", 4)
        if state_value in ACTIVE_TASK_STATES and (title_evidence is None or goal_state != "active"):
            raise CacheError("state-conflict", "task cannot run before title and Goal evidence", 4)
        if state_value in ACTIVE_TASK_STATES and state["goal"]["state"] != "active":
            raise CacheError("state-conflict", "task cannot run before the root Goal is active", 4)
        candidate = {
            "task_title": title,
            "task_title_evidence_ref": title_evidence,
            "goal_state": goal_state,
            "goal_evidence_ref": goal_evidence,
            "state": state_value,
            "outcome": nonempty(event["outcome"], "outcome") if event["outcome"] is not None else None,
            "attention_reason": nonempty(event["attention_reason"], "attention_reason") if event["attention_reason"] is not None else None,
            "summary_ref": nonempty(event["summary_ref"], "summary_ref") if event["summary_ref"] is not None else None,
        }
        changed = any(task[field] != value for field, value in candidate.items())
        task.update(candidate)
        return changed

    if event_type in {
        "revision-observed", "delivery-observed", "review-wait-started",
        "review-wait-invoked", "review-observed",
    }:
        delivery_key = check_lower_kebab(raw.get("delivery_key"), "delivery_key")
        delivery = delivery_by_key(task, delivery_key)
    else:
        delivery = None

    if event_type == "revision-observed":
        event = exact_object(
            raw,
            {
                "type", "task_key", "delivery_key", "head_sha", "base_ref",
                "merge_base_sha", "repository", "github_repository",
                "pr_number", "pr_url", "evidence_ref",
            },
            event_type,
        )
        assert delivery is not None
        if state["goal"]["state"] != "active" or task["goal_state"] != "active":
            raise CacheError("state-conflict", "revision observation requires active Goals", 4)
        repository = nonempty(event["repository"], "repository")
        if repository != delivery["repository"]:
            raise CacheError("invalid-input", "revision repository does not match delivery", 2)
        if (
            not isinstance(event["pr_number"], int)
            or isinstance(event["pr_number"], bool)
            or event["pr_number"] < 1
        ):
            raise CacheError("invalid-input", "revision pr_number is invalid", 2)
        github_repository = canonical_github_repository(
            event["github_repository"], "github_repository"
        )
        pr_url = canonical_github_pr_url(
            event["pr_url"], github_repository, event["pr_number"], "pr_url"
        )
        if delivery["pr"] is not None and any(
            delivery["pr"][field] != expected
            for field, expected in (
                ("repository", repository),
                ("github_repository", github_repository),
                ("number", event["pr_number"]),
                ("url", pr_url),
            )
        ):
            raise CacheError("state-conflict", "revision PR identity changed", 4)
        head = nonempty(event["head_sha"], "head_sha")
        base = nonempty(event["base_ref"], "base_ref")
        merge_base = nonempty(event["merge_base_sha"], "merge_base_sha")
        candidate = {
            "repository": repository,
            "github_repository": github_repository,
            "pr_number": event["pr_number"],
            "pr_url": pr_url,
            "head_sha": head,
            "base_ref": base,
            "merge_base_sha": merge_base,
            "revision_key": revision_key(repository, event["pr_number"], pr_url, head, base, merge_base),
            "evidence_ref": nonempty(event["evidence_ref"], "evidence_ref"),
            "observed_at": observed_at,
        }
        current = delivery["revision"]
        if current and all(current[field] == candidate[field] for field in candidate if field != "observed_at"):
            return False
        delivery["revision"] = candidate
        delivery["committed"] = False
        delivery["published"] = False
        delivery["observation_evidence_ref"] = None
        return True

    if event_type == "delivery-observed":
        event = exact_object(
            raw,
            {"type", "task_key", "delivery_key", "revision_key", "pr", "committed", "published", "evidence_ref"},
            event_type,
        )
        assert delivery is not None
        if state["goal"]["state"] != "active" or task["goal_state"] != "active":
            raise CacheError("state-conflict", "delivery observation requires active Goals", 4)
        revision = delivery["revision"]
        if revision is None or event["revision_key"] != revision["revision_key"]:
            raise CacheError("state-conflict", "delivery observation revision is stale", 4)
        if not isinstance(event["committed"], bool) or not isinstance(event["published"], bool):
            raise CacheError("invalid-input", "delivery publication state is invalid", 2)
        if event["published"] and not event["committed"]:
            raise CacheError("invalid-input", "published delivery must be committed", 2)
        pr = validate_pr(event["pr"], delivery, "pr")
        if pr is None:
            raise CacheError("invalid-input", "delivery observation requires a pull request", 2)
        if (
            pr["repository"] != revision["repository"]
            or pr["github_repository"] != revision["github_repository"]
            or pr["number"] != revision["pr_number"]
            or pr["url"] != revision["pr_url"]
            or pr["head_sha"] != revision["head_sha"]
            or pr["base_ref"] != revision["base_ref"]
            or pr["merge_base_sha"] != revision["merge_base_sha"]
        ):
            raise CacheError("state-conflict", "delivery PR tuple differs from current revision", 4)
        evidence = nonempty(event["evidence_ref"], "evidence_ref")
        candidate = (pr, event["committed"], event["published"], evidence)
        current = (
            delivery["pr"], delivery["committed"], delivery["published"], delivery["observation_evidence_ref"]
        )
        if current == candidate:
            return False
        delivery["pr"] = pr
        delivery["committed"] = event["committed"]
        delivery["published"] = event["published"]
        delivery["observation_evidence_ref"] = evidence
        dirty = delivery["tracker_dirty_after_revision_key"]
        if dirty is not None and revision["revision_key"] != dirty and event["committed"] and event["published"]:
            delivery["tracker_dirty_after_revision_key"] = None
            source = next(item for item in state["sources"] if item["task_key"] == task_key)
            source["dirty_delivery_key"] = None
            source["dirty_after_revision_key"] = None
        return True

    if event_type == "source-moved":
        event = exact_object(
            raw,
            {
                "type", "task_key", "from_ref", "to_ref", "source_fingerprint",
                "tracker_repository", "revision_set_key", "evidence_ref",
            },
            event_type,
        )
        source = next(item for item in state["sources"] if item["task_key"] == task_key)
        if source["tracker_backend"] != "local":
            raise CacheError("invalid-input", "source-moved is only valid for local trackers", 2)
        if state["goal"]["state"] != "active" or task["goal_state"] != "active":
            raise CacheError("state-conflict", "source move requires active root and worker Goals", 4)
        if event["tracker_repository"] != source["tracker_repository"]:
            raise CacheError("state-conflict", "source tracker repository changed", 4)
        if source["state"] == "done":
            if (
                event["from_ref"] == source["source_spec_ref"]
                and event["to_ref"] == source["planned_done_ref"]
                and event["source_fingerprint"] == source["fingerprint"]
                and event["revision_set_key"] == source["move_revision_set_key"]
            ):
                return False
            raise CacheError("state-conflict", "source move evidence changed", 4)
        revision_set = current_revision_set_key(task)
        if revision_set is None or event["revision_set_key"] != revision_set:
            raise CacheError("state-conflict", "source move revision set is stale", 4)
        blockers = source_move_blockers(state, task)
        if blockers:
            raise CacheError("state-conflict", "source cannot move before current proof", 4, {"blockers": blockers})
        if event["from_ref"] != source["current_ref"] or event["to_ref"] != source["planned_done_ref"]:
            raise CacheError("state-conflict", "source move refs changed", 4)
        if event["source_fingerprint"] != source["fingerprint"]:
            raise CacheError("state-conflict", "source fingerprint changed during move", 4)
        tracker_delivery = next(
            item for item in task["deliveries"] if item["repository"] == source["tracker_repository"]
        )
        if tracker_delivery["revision"] is None:
            raise CacheError("state-conflict", "tracker delivery has no revision", 4)
        dirty_revision = tracker_delivery["revision"]["revision_key"]
        source.update(
            {
                "current_ref": source["planned_done_ref"],
                "state": "done",
                "move_evidence_ref": nonempty(event["evidence_ref"], "evidence_ref"),
                "move_revision_set_key": revision_set,
                "dirty_delivery_key": tracker_delivery["delivery_key"],
                "dirty_after_revision_key": dirty_revision,
            }
        )
        tracker_delivery["tracker_dirty_after_revision_key"] = dirty_revision
        return True

    if event_type == "review-wait-started":
        event = exact_object(raw, {"type", "task_key", "delivery_key", "revision_key", "request_ref"}, event_type)
        assert delivery is not None
        revision = delivery["revision"]
        if revision is None or event["revision_key"] != revision["revision_key"]:
            raise CacheError("state-conflict", "review request revision is stale", 4)
        request_ref = nonempty(event["request_ref"], "request_ref")
        existing = current_review(state, task, delivery)
        if existing:
            if existing["request_ref"] == request_ref:
                return False
            raise CacheError("state-conflict", "current delivery revision already has a review request", 4)
        if len(state["reviews"]) >= MAX_REVIEWS:
            raise CacheError("state-conflict", "review history bound reached", 4)
        state["reviews"].append(
            {
                "task_key": task_key,
                "delivery_key": delivery["delivery_key"],
                "revision_key": revision["revision_key"],
                "github_repository": revision["github_repository"],
                "pr_number": revision["pr_number"],
                "pr_url": revision["pr_url"],
                "request_ref": request_ref,
                "wait_started_at": observed_at,
                "wait_deadline": format_timestamp(
                    now + timedelta(seconds=REVIEW_WAIT_SECONDS)
                ),
                "wait_invoked_at": None,
                "provider_timeout": None,
                "wait_state": "active-wait",
                "observations": [],
            }
        )
        return True

    if event_type in {"review-wait-invoked", "review-observed"}:
        assert delivery is not None
        review = current_review(state, task, delivery)
        if review is None:
            raise CacheError("state-conflict", f"{event_type} requires a current review request", 4)

    if event_type == "review-wait-invoked":
        event = exact_object(
            raw,
            {"type", "task_key", "delivery_key", "revision_key", "request_ref", "wait_invoked_at", "provider_timeout"},
            event_type,
        )
        assert review is not None
        if event["revision_key"] != review["revision_key"] or event["request_ref"] != review["request_ref"]:
            raise CacheError("state-conflict", "review waiter identity changed", 4)
        invoked = parse_timestamp(event["wait_invoked_at"], "wait_invoked_at")
        started = parse_timestamp(review["wait_started_at"], "wait_started_at")
        deadline = parse_timestamp(review["wait_deadline"], "wait_deadline")
        if invoked < started or invoked > now:
            raise CacheError("invalid-input", "review waiter invocation time is invalid", 2)
        remaining = max(0, int((deadline - invoked).total_seconds()))
        provider_timeout = event["provider_timeout"]
        if (
            not isinstance(provider_timeout, int)
            or isinstance(provider_timeout, bool)
            or provider_timeout < 0
            or provider_timeout != remaining
        ):
            raise CacheError("invalid-input", "provider_timeout is not the exact remaining deadline", 2)
        if review["wait_invoked_at"] is not None:
            if review["wait_invoked_at"] == event["wait_invoked_at"] and review["provider_timeout"] == remaining:
                return False
            raise CacheError("state-conflict", "review waiter already launched", 4)
        review["wait_invoked_at"] = event["wait_invoked_at"]
        review["provider_timeout"] = remaining
        return True

    if event_type == "review-observed":
        event = exact_object(
            raw,
            {
                "type", "task_key", "delivery_key", "revision_key", "request_ref",
                "provider_state", "observation_fingerprint", "disposition",
                "evidence_ref", "warning_ref", "warning_posted_at",
                "warning_fingerprint",
            },
            event_type,
        )
        assert review is not None
        if event["revision_key"] != review["revision_key"] or event["request_ref"] != review["request_ref"]:
            raise CacheError("state-conflict", "review observation identity changed", 4)
        if review["wait_invoked_at"] is None:
            raise CacheError("state-conflict", "review observation precedes waiter launch", 4)
        if now < parse_timestamp(review["wait_invoked_at"], "wait_invoked_at"):
            raise CacheError(
                "invalid-input",
                "review observation predates provider invocation",
                2,
            )
        provider = event["provider_state"]
        disposition = event["disposition"]
        warning_ref = (
            nonempty(event["warning_ref"], "warning_ref")
            if event["warning_ref"] is not None
            else None
        )
        warning_posted_at = event["warning_posted_at"]
        warning_fingerprint = event["warning_fingerprint"]
        validate_review_outcome(
            provider,
            disposition,
            warning_ref,
            warning_posted_at,
            warning_fingerprint,
            review,
            now,
            parse_timestamp(review["wait_deadline"], "wait_deadline"),
            "invalid-input",
            2,
        )
        fingerprint = canonical_fingerprint(event["observation_fingerprint"], "observation_fingerprint")
        evidence_ref = nonempty(event["evidence_ref"], "evidence_ref")
        observation = {
            "provider_state": provider,
            "observation_fingerprint": fingerprint,
            "disposition": disposition,
            "evidence_ref": evidence_ref,
            "warning_ref": warning_ref,
            "warning_posted_at": warning_posted_at,
            "warning_fingerprint": warning_fingerprint,
        }
        if review["observations"]:
            prior = review["observations"][-1]
            if {key: prior[key] for key in observation} == observation:
                return False
            raise CacheError("state-conflict", "review already has an observation", 4)
        if review["wait_state"] != "active-wait":
            raise CacheError("state-conflict", "review observation is already complete", 4)
        if len(review["observations"]) >= MAX_REVIEW_OBSERVATIONS:
            raise CacheError("state-conflict", "review observation bound reached", 4)
        review["observations"].append({**observation, "observed_at": observed_at})
        review["wait_state"] = "complete"
        return True

    if event_type == "gate-observed":
        event = exact_object(
            raw,
            {"type", "task_key", "delivery_key", "gate", "state", "binding_key", "evidence_ref"},
            event_type,
        )
        gate = event["gate"]
        if gate not in STATIC_GATES | REVISION_GATES or event["state"] not in GATE_STATES:
            raise CacheError("invalid-input", "gate observation is invalid", 2)
        if gate in REVISION_GATES and (
            state["goal"]["state"] != "active" or task["goal_state"] != "active"
        ):
            raise CacheError("state-conflict", "revision-bound gate requires active Goals", 4)
        scoped_delivery = None
        if event["delivery_key"] is not None:
            scoped_delivery = delivery_by_key(task, check_lower_kebab(event["delivery_key"], "delivery_key"))
        expected_delivery, expected_binding = gate_binding(task, gate, scoped_delivery)
        if event["delivery_key"] != expected_delivery or event["binding_key"] != expected_binding:
            raise CacheError("state-conflict", "gate observation binding is stale", 4)
        if gate == "domain-closeout" and not task["requires_domain_closeout"]:
            raise CacheError("invalid-input", "domain-closeout is not required for this task", 2)
        if (
            gate == "codex-review"
            and event["state"] == "passed"
            and not review_is_accepted(current_review(state, task, scoped_delivery))
        ):
            raise CacheError(
                "state-conflict",
                "codex-review gate requires a clean review or an evidenced accepted timeout",
                4,
            )
        evidence = nonempty(event["evidence_ref"], "evidence_ref")
        candidate = {
            "task_key": task_key,
            "delivery_key": expected_delivery,
            "gate": gate,
            "state": event["state"],
            "binding_key": expected_binding,
            "evidence_ref": evidence,
            "observed_at": observed_at,
        }
        existing = [
            item for item in state["gates"]
            if item["task_key"] == task_key
            and item["delivery_key"] == expected_delivery
            and item["gate"] == gate
            and item["binding_key"] == expected_binding
        ]
        if existing:
            current = existing[-1]
            if all(current[field] == candidate[field] for field in ("state", "binding_key", "evidence_ref")):
                return False
            current.update(candidate)
        else:
            if len(state["gates"]) >= MAX_GATES:
                raise CacheError("state-conflict", "gate history bound reached", 4)
            state["gates"].append(candidate)
        return True

    if event_type == "task-terminal-sealed":
        event = exact_object(
            raw,
            {"type", "task_key", "revision_set_key", "seal_fingerprint", "evidence_ref"},
            event_type,
        )
        if task["goal_state"] != "active":
            raise CacheError("state-conflict", "task must have an active Goal before sealing", 4)
        if state["goal"]["state"] != "active":
            raise CacheError("state-conflict", "root Goal must be active before sealing", 4)
        revision_set = current_revision_set_key(task)
        candidate = seal_candidate_fingerprint(state, task)
        fingerprint = canonical_fingerprint(event["seal_fingerprint"], "seal_fingerprint")
        if revision_set is None or event["revision_set_key"] != revision_set or candidate != fingerprint:
            raise CacheError("state-conflict", "task terminal seal proof is stale", 4)
        task["seal"] = {
            "revision_set_key": revision_set,
            "seal_fingerprint": fingerprint,
            "evidence_ref": nonempty(event["evidence_ref"], "evidence_ref"),
            "sealed_at": observed_at,
        }
        task["state"] = "terminal-sealed"
        return True

    if event_type == "task-goal-completed":
        event = exact_object(
            raw,
            {"type", "task_key", "seal_fingerprint", "goal_evidence_ref", "completion_evidence_ref"},
            event_type,
        )
        seal = task["seal"]
        if seal is None or event["seal_fingerprint"] != seal["seal_fingerprint"]:
            raise CacheError("state-conflict", "task Goal completion seal is stale", 4)
        if task["goal_state"] == "complete":
            if (
                task["goal_evidence_ref"] == event["goal_evidence_ref"]
                and task["goal_completion_evidence_ref"] == event["completion_evidence_ref"]
            ):
                return False
            raise CacheError("state-conflict", "task Goal completion evidence changed", 4)
        if task["goal_state"] != "active" or task["goal_evidence_ref"] != event["goal_evidence_ref"]:
            raise CacheError("state-conflict", "task Goal completion is out of order", 4)
        task["goal_state"] = "complete"
        task["goal_completion_evidence_ref"] = nonempty(
            event["completion_evidence_ref"], "completion_evidence_ref"
        )
        task["state"] = "merge-ready"
        task["outcome"] = "pull-request-ready-for-merge-but-not-merged"
        return True

    if event_type == "terminal-handoff-recorded":
        event = exact_object(
            raw,
            {"type", "task_key", "seal_fingerprint", "handoff_kind", "authority", "evidence_ref", "next_action"},
            event_type,
        )
        seal = task["seal"]
        if (
            task["state"] != "merge-ready"
            or task["goal_state"] != "complete"
            or seal is None
            or task["post_terminal_drift"] is not None
        ):
            raise CacheError(
                "state-conflict",
                "terminal handoff requires a completed task Goal without post-terminal drift",
                4,
            )
        if event["seal_fingerprint"] != seal["seal_fingerprint"]:
            raise CacheError("state-conflict", "terminal handoff seal is stale", 4)
        if event["handoff_kind"] != "pull-request-ready":
            raise CacheError("invalid-input", "terminal handoff kind is invalid", 2)
        if event["authority"] != "external-merge-required":
            raise CacheError("invalid-input", "terminal handoff authority is invalid", 2)
        candidate = {
            "task_key": task_key,
            "delivery_key": None,
            "revision_key": None,
            "seal_fingerprint": seal["seal_fingerprint"],
            "handoff_kind": "pull-request-ready",
            "authority": "external-merge-required",
            "evidence_ref": nonempty(event["evidence_ref"], "evidence_ref"),
            "next_action": nonempty(event["next_action"], "next_action"),
            "deadline": None,
            "recorded_at": observed_at,
        }
        if terminal_handoff(state, task):
            current = terminal_handoff(state, task)
            if current and all(current[field] == candidate[field] for field in ("seal_fingerprint", "evidence_ref", "next_action")):
                return False
            raise CacheError("state-conflict", "terminal handoff evidence changed", 4)
        if len(state["handoffs"]) >= MAX_HANDOFFS:
            raise CacheError("state-conflict", "handoff history bound reached", 4)
        state["handoffs"].append(candidate)
        return True

    if event_type == "post-terminal-drift-recorded":
        event = exact_object(
            raw,
            {
                "type", "task_key", "delivery_key", "seal_fingerprint",
                "drift_fingerprint", "reason", "evidence_ref",
            },
            event_type,
        )
        seal = task["seal"]
        if seal is None or event["seal_fingerprint"] != seal["seal_fingerprint"]:
            raise CacheError("state-conflict", "post-terminal drift requires a sealed task", 4)
        delivery_key = check_lower_kebab(event["delivery_key"], "delivery_key")
        delivery_by_key(task, delivery_key)
        drift = {
            "delivery_key": delivery_key,
            "seal_fingerprint": seal["seal_fingerprint"],
            "drift_fingerprint": canonical_fingerprint(event["drift_fingerprint"], "drift_fingerprint"),
            "reason": nonempty(event["reason"], "reason"),
            "evidence_ref": nonempty(event["evidence_ref"], "evidence_ref"),
            "recorded_at": observed_at,
        }
        if task["post_terminal_drift"] is not None:
            if all(task["post_terminal_drift"][field] == drift[field] for field in drift if field != "recorded_at"):
                return False
            raise CacheError("state-conflict", "post-terminal drift evidence changed", 4)
        task["post_terminal_drift"] = drift
        state["closeout"]["post_terminal_drift"] = {
            "task_key": task_key,
            **drift,
        }
        return True

    raise CacheError("invalid-input", f"unsupported event type: {event_type}", 2)


def create_ledger(args: argparse.Namespace) -> dict[str, Any]:
    ledger = canonical_active_ledger(args.ledger)
    root_id = check_id(args.root_id, "root_id")
    expected_fingerprint = canonical_fingerprint(
        args.expected_claim_fingerprint, "expected_claim_fingerprint"
    )
    operation_id = check_operation_id(args.operation_id)
    packet = read_json_file(args.registration_file, "registration_file")
    mutation_state = "created"
    with locked_claim_store(create=True, exclusive=True) as claims:
        claim = active_claim(claims, root_id, expected_fingerprint, ledger)
        registration = validate_registration(packet, claim, ledger)
        legacy = ledger.with_suffix(".md")
        if legacy.exists():
            raise CacheError(
                "unsupported-active-ledger",
                "active Markdown ledger blocks the hard-cut JSON identity",
                2,
                {"ledger": str(legacy)},
            )
        if ledger.exists():
            state = load_state(ledger)
            expected_request = request_fingerprint(registration)
            matches = [
                item for item in state["operations"] if item["operation_id"] == operation_id
            ]
            if (
                state["portfolio"]["root_id"] != root_id
                or state["claim"]["fingerprint"] != expected_fingerprint
                or len(matches) != 1
                or matches[0]["request_fingerprint"] != expected_request
                or matches[0]["event_types"] != ["registration"]
            ):
                raise CacheError("state-conflict", f"run state already exists: {ledger}", 4)
            mutation_state = "already-created"
        else:
            state = new_state(
                ledger=ledger,
                root_id=root_id,
                claim=claim,
                registration=registration,
                operation_id=operation_id,
            )
            ledger.parent.mkdir(parents=True, exist_ok=True)
            write_json_durable(ledger, state)
    return {
        "ok": True,
        "command": "ledger.create",
        "version": __version__,
        "mutation_state": mutation_state,
        **project_state(state, "status"),
    }


def apply_ledger(args: argparse.Namespace) -> dict[str, Any]:
    ledger = canonical_active_ledger(args.ledger)
    root_id = check_id(args.root_id, "root_id")
    expected_fingerprint = canonical_fingerprint(
        args.expected_claim_fingerprint, "expected_claim_fingerprint"
    )
    operation_id = check_operation_id(args.operation_id)
    if args.expected_generation < 1:
        raise CacheError("invalid-input", "expected_generation must be positive", 2)
    events = read_json_file(args.events_file, "events_file")
    if not isinstance(events, list) or not events or len(events) > MAX_EVENTS_PER_BATCH:
        raise CacheError("invalid-input", "events_file must contain a nonempty JSON array", 2)
    event_types = []
    for event in events:
        if not isinstance(event, dict) or event.get("type") not in EVENT_TYPES:
            raise CacheError("invalid-input", "events_file contains an unsupported event", 2)
        event_types.append(event["type"])
    fingerprint = request_fingerprint(events)
    with locked_claim_store(create=False, exclusive=True) as claims:
        claim = active_claim(claims, root_id, expected_fingerprint, ledger)
        state = load_state(ledger)
        if (
            state["portfolio"]["root_id"] != root_id
            or state["portfolio"]["repositories"] != claim["repositories"]
            or state["portfolio"]["repository_checkouts"]
            != claim["repository_checkouts"]
            or sorted(item["source_id"] for item in state["sources"])
            != sorted(claim["sources"])
        ):
            raise CacheError(
                "state-conflict", "run-state ownership scope differs from the active claim", 4
            )
        prior = [item for item in state["operations"] if item["operation_id"] == operation_id]
        if prior:
            if prior[0]["request_fingerprint"] != fingerprint:
                raise CacheError("state-conflict", "operation_id was reused with different events", 4)
            return {
                "ok": True,
                "command": "ledger.apply",
                "version": __version__,
                "mutation_state": "already-applied",
                **project_state(state, "status"),
            }
        if state["generation"] != args.expected_generation:
            raise CacheError(
                "state-conflict",
                "expected_generation is stale",
                4,
                {"expected": args.expected_generation, "actual": state["generation"]},
            )
        if len(state["operations"]) >= MAX_OPERATIONS:
            raise CacheError("state-conflict", "operation history bound reached", 4)
        if state["claim"]["fingerprint"] != expected_fingerprint:
            raise CacheError("state-conflict", "run-state claim binding is stale", 4)
        candidate = copy.deepcopy(state)
        now = utc_now()
        changed = False
        for event in events:
            changed = apply_event(candidate, event, now) or changed
        if not changed:
            return {
                "ok": True,
                "command": "ledger.apply",
                "version": __version__,
                "mutation_state": "unchanged",
                **project_state(state, "status"),
            }
        candidate["generation"] = state["generation"] + 1
        candidate["updated_at"] = format_timestamp(now)
        candidate["operations"].append(
            {
                "operation_id": operation_id,
                "request_fingerprint": fingerprint,
                "event_types": event_types,
                "generation": candidate["generation"],
                "applied_at": candidate["updated_at"],
            }
        )
        seal_state_fingerprint(candidate)
        validate_state(candidate, ledger)
        replace_json_durable(ledger, candidate)
    return {
        "ok": True,
        "command": "ledger.apply",
        "version": __version__,
        "mutation_state": "applied",
        "applied_event_types": event_types,
        **project_state(candidate, "status"),
    }


def read_ledger(args: argparse.Namespace) -> dict[str, Any]:
    ledger = canonical_active_ledger(args.ledger)
    state = load_state(ledger)
    return {
        "ok": True,
        "command": "ledger.read",
        "version": __version__,
        **project_state(state, args.projection),
    }


def metadata_for(
    *,
    ledger: Path,
    state_hash: str,
    state_size_bytes: int,
    markdown_hash: str,
    markdown_size_bytes: int,
    archived_at: datetime,
    evidence_ref: str,
    root_id: str,
) -> dict[str, Any]:
    archive_id = f"{compact_timestamp(archived_at)}--{ledger.stem}--{state_hash[:12]}"
    return {
        "schema_version": WRITE_METADATA_SCHEMA_VERSION,
        "archive_id": archive_id,
        "archive_reason": "terminal",
        "archive_group": None,
        "archived_at": format_timestamp(archived_at),
        "portfolio_key": ledger.stem,
        "original_ledger_ref": str(ledger),
        "state_sha256": state_hash,
        "state_size_bytes": state_size_bytes,
        "markdown_sha256": markdown_hash,
        "markdown_size_bytes": markdown_size_bytes,
        "evidence_ref": evidence_ref,
        "root_id": root_id,
        "tool_version": __version__,
    }


def archive_parent(metadata: dict[str, Any]) -> Path:
    if metadata["archive_reason"] == "legacy-cutover":
        return archive_root() / metadata["archive_group"]
    archived_at = parse_timestamp(metadata["archived_at"], "archived_at")
    return archive_root() / archived_at.strftime("%Y") / archived_at.strftime("%m")


def validate_metadata(value: Any, entry: Path) -> dict[str, Any]:
    legacy_required = {
        "schema_version",
        "archive_id",
        "archive_reason",
        "archive_group",
        "archived_at",
        "portfolio_key",
        "original_ledger_ref",
        "ledger_sha256",
        "size_bytes",
        "evidence_ref",
        "root_id",
        "tool_version",
    }
    current_required = {
        "schema_version",
        "archive_id",
        "archive_reason",
        "archive_group",
        "archived_at",
        "portfolio_key",
        "original_ledger_ref",
        "state_sha256",
        "state_size_bytes",
        "markdown_sha256",
        "markdown_size_bytes",
        "evidence_ref",
        "root_id",
        "tool_version",
    }
    if not isinstance(value, dict) or value.get("schema_version") not in READ_METADATA_SCHEMA_VERSIONS:
        raise CacheError("integrity-failure", f"unsupported archive metadata: {entry}", 5)
    required = legacy_required if value["schema_version"] == "1.0.0" else current_required
    if set(value) != required:
        raise CacheError("integrity-failure", f"archive metadata schema mismatch: {entry}", 5)
    check_id(value["archive_id"], "archive_id")
    check_id(value["portfolio_key"], "portfolio_key")
    if value["archive_id"] != entry.name:
        raise CacheError("integrity-failure", f"archive identity mismatch: {entry}", 5)
    if value["archive_reason"] not in READ_ARCHIVE_REASONS:
        raise CacheError("integrity-failure", f"archive reason mismatch: {entry}", 5)
    if value["archive_reason"] == "legacy-cutover":
        if value["schema_version"] != "1.0.0":
            raise CacheError("integrity-failure", f"current archive cannot be legacy: {entry}", 5)
        check_id(value["archive_group"], "archive_group")
        if value["archive_group"] != RETAINED_LEGACY_GROUP:
            raise CacheError("integrity-failure", f"legacy archive group mismatch: {entry}", 5)
        if value["root_id"] is not None:
            raise CacheError("integrity-failure", f"legacy archive root mismatch: {entry}", 5)
    else:
        if value["archive_group"] is not None:
            raise CacheError("integrity-failure", f"terminal archive group mismatch: {entry}", 5)
        check_id(value["root_id"], "root_id")
    parse_timestamp(value["archived_at"], "archived_at")
    checksum_fields = (
        (("ledger_sha256", "size_bytes"),)
        if value["schema_version"] == "1.0.0"
        else (
            ("state_sha256", "state_size_bytes"),
            ("markdown_sha256", "markdown_size_bytes"),
        )
    )
    for checksum_field, size_field in checksum_fields:
        if not isinstance(value[checksum_field], str) or not FINGERPRINT_RE.fullmatch(
            value[checksum_field]
        ):
            raise CacheError("integrity-failure", f"archive checksum mismatch: {entry}", 5)
        if not isinstance(value[size_field], int) or value[size_field] < 0:
            raise CacheError("integrity-failure", f"archive size mismatch: {entry}", 5)
    nonempty(value["evidence_ref"], "evidence_ref")
    original = Path(value["original_ledger_ref"])
    expected_suffix = ".md" if value["schema_version"] == "1.0.0" else ".json"
    if (
        not original.is_absolute()
        or original.resolve(strict=False).parent != ledger_root().resolve(strict=False)
        or original.suffix != expected_suffix
    ):
        raise CacheError("integrity-failure", f"archive source mismatch: {entry}", 5)
    return value


def validate_archive_entry(entry: Path, *, verify_hash: bool) -> dict[str, Any]:
    if entry.is_symlink() or not entry.is_dir():
        raise CacheError("integrity-failure", f"archive entry is not a directory: {entry}", 5)
    children = {path.name: path for path in entry.iterdir()}
    if "metadata.json" not in children:
        raise CacheError("integrity-failure", f"archive metadata is missing: {entry}", 5)
    if any(path.is_symlink() or not path.is_file() for path in children.values()):
        raise CacheError("integrity-failure", f"archive entry contains unsafe files: {entry}", 5)
    try:
        value = json.loads(children["metadata.json"].read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise CacheError("integrity-failure", f"archive metadata is unreadable: {entry}", 5) from exc
    metadata = validate_metadata(value, entry)
    expected_children = (
        {"ledger.md", "metadata.json"}
        if metadata["schema_version"] == "1.0.0"
        else {"ledger.json", "ledger.md", "metadata.json"}
    )
    if set(children) != expected_children:
        raise CacheError("integrity-failure", f"archive entry has unexpected files: {entry}", 5)
    if any(path.is_symlink() or not path.is_file() for path in children.values()):
        raise CacheError("integrity-failure", f"archive entry contains unsafe files: {entry}", 5)
    if archive_parent(metadata).resolve(strict=False) != entry.parent.resolve(strict=False):
        raise CacheError("integrity-failure", f"archive parent mismatch: {entry}", 5)
    if metadata["schema_version"] == "1.0.0":
        if children["ledger.md"].stat().st_size != metadata["size_bytes"]:
            raise CacheError("integrity-failure", f"archive byte count mismatch: {entry}", 5)
        if verify_hash and sha256_file(children["ledger.md"]) != metadata["ledger_sha256"]:
            raise CacheError("integrity-failure", f"archive checksum mismatch: {entry}", 5)
        return {**metadata, "entry_path": str(entry), "ledger_path": str(children["ledger.md"])}
    if (
        children["ledger.json"].stat().st_size != metadata["state_size_bytes"]
        or children["ledger.md"].stat().st_size != metadata["markdown_size_bytes"]
    ):
        raise CacheError("integrity-failure", f"archive byte count mismatch: {entry}", 5)
    if verify_hash and (
        sha256_file(children["ledger.json"]) != metadata["state_sha256"]
        or sha256_file(children["ledger.md"]) != metadata["markdown_sha256"]
    ):
        raise CacheError("integrity-failure", f"archive checksum mismatch: {entry}", 5)
    return {
        **metadata,
        "entry_path": str(entry),
        "state_path": str(children["ledger.json"]),
        "ledger_path": str(children["ledger.md"]),
    }


def archive_entry_dirs() -> tuple[list[Path], list[dict[str, str]], list[str]]:
    root = archive_root()
    ensure_safe_cache_chain(root, "archive root")
    if not root.exists():
        return [], [], []
    entries: list[Path] = []
    invalid: list[dict[str, str]] = []
    warnings: list[str] = []

    def reject(path: Path, message: str) -> None:
        invalid.append({"entry_path": str(path), "error": message})

    def collect_entries(container: Path, label: str) -> None:
        children = sorted(container.iterdir())
        if not children:
            reject(container, f"orphaned {label} container")
            return
        for child in children:
            if child.is_symlink() or not child.is_dir():
                reject(child, f"unexpected artifact in {label} container")
            else:
                entries.append(child)

    if root.is_symlink() or not root.is_dir():
        reject(root, "archive root is not a safe directory")
        return [], invalid, warnings
    for top in sorted(root.iterdir()):
        if top.name == ".trash" or top.name.startswith(".tmp-"):
            if top.is_symlink() or not top.is_dir():
                reject(top, "archive internal state is unsafe")
            continue
        if top.is_symlink() or not top.is_dir():
            reject(top, "unexpected archive-root artifact")
            continue
        if top.name == RETAINED_LEGACY_GROUP:
            collect_entries(top, "legacy archive group")
            continue
        if not re.fullmatch(r"\d{4}", top.name):
            reject(top, "unrecognized archive container")
            continue
        months = sorted(top.iterdir())
        if not months:
            reject(top, "orphaned terminal archive year")
            continue
        for month in months:
            if (
                month.is_symlink()
                or not month.is_dir()
                or not re.fullmatch(r"0[1-9]|1[0-2]", month.name)
            ):
                reject(month, "invalid terminal archive month")
                continue
            collect_entries(month, "terminal archive month")
    return sorted(set(entries)), invalid, warnings


def scan_archives(*, verify_hash: bool) -> dict[str, Any]:
    entries, invalid, warnings = archive_entry_dirs()
    valid: list[dict[str, Any]] = []
    for entry in entries:
        try:
            valid.append(validate_archive_entry(entry, verify_hash=verify_hash))
        except CacheError as exc:
            invalid.append({"entry_path": str(entry), "error": exc.message})
    root = archive_root()
    temporary: list[str] = []
    trash: list[str] = []
    if root.exists():
        temporary = [str(path) for path in sorted(root.glob(".tmp-*"))]
        trash_root = root / ".trash"
        if trash_root.is_dir():
            trash = [str(path) for path in sorted(trash_root.iterdir())]
    return {
        "valid": sorted(valid, key=lambda item: item["archive_id"]),
        "invalid": invalid,
        "temporary": temporary,
        "trash": trash,
        "warnings": warnings,
    }


def find_completed_archive(
    ledger: Path,
    *,
    archive_reason: str,
    archive_group: str | None,
    evidence_ref: str,
    root_id: str | None,
) -> dict[str, Any] | None:
    matches = [
        entry
        for entry in scan_archives(verify_hash=True)["valid"]
        if entry["original_ledger_ref"] == str(ledger)
        and entry["archive_reason"] == archive_reason
        and entry["archive_group"] == archive_group
        and entry["evidence_ref"] == evidence_ref
        and entry["root_id"] == root_id
    ]
    if len(matches) > 1:
        raise CacheError("state-conflict", f"multiple matching archives exist: {ledger}", 4)
    return matches[0] if matches else None


def stage_ledger(source: Path, destination: Path) -> None:
    with source.open("rb") as input_handle, destination.open("xb") as output_handle:
        shutil.copyfileobj(input_handle, output_handle)
        output_handle.flush()
        os.fsync(output_handle.fileno())


def stage_bytes(value: bytes, destination: Path) -> None:
    with destination.open("xb") as handle:
        handle.write(value)
        handle.flush()
        os.fsync(handle.fileno())


def terminal_release_receipt(
    claim_state: dict[str, Any],
    *,
    ledger: Path,
    root_id: str,
    evidence_ref: str,
    ledger_hash: str,
    size_bytes: int,
    required: bool,
    expected_claim_fingerprint: str | None = None,
) -> Path | None:
    matches = [
        item
        for item in claim_state["release_receipts"]
        if item["root_id"] == root_id
        and item["ledger_ref"] == str(ledger)
        and item["release_reason"] == "terminal"
        and item["evidence_ref"] == evidence_ref
    ]
    if len(matches) > 1:
        raise CacheError("state-conflict", f"multiple terminal release receipts: {ledger}", 4)
    if not matches:
        if required:
            raise CacheError(
                "state-conflict",
                f"terminal release receipt is required: {ledger}",
                4,
            )
        return None
    receipt = matches[0]
    if (
        (
            expected_claim_fingerprint is not None
            and receipt["claim_fingerprint"] != expected_claim_fingerprint
        )
        or
        receipt["ledger_sha256"] != ledger_hash
        or receipt["ledger_size_bytes"] != size_bytes
    ):
        raise CacheError(
            "state-conflict",
            f"terminal release receipt does not match ledger content: {ledger}",
            4,
        )
    return Path(receipt["path"])


def remove_empty_parents(path: Path, stop: Path) -> None:
    current = path
    while current != stop and current.is_dir():
        try:
            current.rmdir()
        except OSError:
            return
        current = current.parent


def archive_ledgers(args: argparse.Namespace) -> dict[str, Any]:
    evidence_ref = nonempty(args.evidence_ref, "evidence_ref")
    root_id = check_id(args.root_id, "root_id")
    ledger_value = args.ledger[0] if isinstance(args.ledger, list) else args.ledger
    ledger = canonical_active_ledger(ledger_value)
    ensure_safe_cache_chain(archive_root(), "archive root")
    completed: dict[str, Any] | None = None
    receipt_path: Path | None = None
    with locked_claim_store(create=True, exclusive=True) as claims:
        claim_state = inspect_claim_artifacts(claims)
        if not claim_state["safe"]:
            raise CacheError(
                "state-conflict",
                "claim store is not safe for ledger archival",
                4,
                {"warnings": claim_state["warnings"]},
            )
        if root_id in claim_state["ownership_root_ids"]:
            raise CacheError(
                "state-conflict",
                f"terminal root still has active claim ownership: {root_id}",
                4,
            )
        existing = find_completed_archive(
            ledger,
            archive_reason="terminal",
            archive_group=None,
            evidence_ref=evidence_ref,
            root_id=root_id,
        )
        if not ledger.exists():
            if not existing or existing["schema_version"] != WRITE_METADATA_SCHEMA_VERSION:
                raise CacheError("not-found", f"run state not found: {ledger}", 3)
            try:
                archived_state = validate_state(
                    json.loads(Path(existing["state_path"]).read_text()), ledger
                )
            except (OSError, json.JSONDecodeError) as exc:
                raise CacheError(
                    "integrity-failure", "archived terminal state is unreadable", 5
                ) from exc
            receipt_path = terminal_release_receipt(
                claim_state,
                ledger=ledger,
                root_id=root_id,
                evidence_ref=evidence_ref,
                ledger_hash=existing["state_sha256"],
                size_bytes=existing["state_size_bytes"],
                required=False,
                expected_claim_fingerprint=archived_state["claim"]["fingerprint"],
            )
            completed = existing
        else:
            if ledger.is_symlink() or not ledger.is_file():
                raise CacheError("invalid-input", f"run state is not a safe file: {ledger}", 2)
            if str(ledger) in claim_state["ledger_refs"]:
                raise CacheError(
                    "state-conflict", f"run state is referenced by active claim state: {ledger}", 4
                )
            state = load_state(ledger)
            terminal = terminal_projection(state)
            if not terminal["eligible"]:
                raise CacheError(
                    "state-conflict",
                    "run state is not terminal",
                    4,
                    {"blockers": terminal["blockers"]},
                )
            state_hash = sha256_file(ledger)
            state_size = ledger.stat().st_size
            receipt_path = terminal_release_receipt(
                claim_state,
                ledger=ledger,
                root_id=root_id,
                evidence_ref=evidence_ref,
                ledger_hash=state_hash,
                size_bytes=state_size,
                required=True,
                expected_claim_fingerprint=state["claim"]["fingerprint"],
            )
            markdown = render_markdown(state).encode()
            markdown_hash = hashlib.sha256(markdown).hexdigest()
            if existing:
                if (
                    existing.get("state_sha256") != state_hash
                    or existing.get("state_size_bytes") != state_size
                    or existing.get("markdown_sha256") != markdown_hash
                    or existing.get("markdown_size_bytes") != len(markdown)
                ):
                    raise CacheError(
                        "state-conflict", f"completed archive conflicts with run state: {ledger}", 4
                    )
                completed = existing
            else:
                metadata = metadata_for(
                    ledger=ledger,
                    state_hash=state_hash,
                    state_size_bytes=state_size,
                    markdown_hash=markdown_hash,
                    markdown_size_bytes=len(markdown),
                    archived_at=utc_now(),
                    evidence_ref=evidence_ref,
                    root_id=root_id,
                )
                final = archive_parent(metadata) / metadata["archive_id"]
                archive_root().mkdir(parents=True, exist_ok=True)
                ensure_safe_cache_chain(final.parent, "archive destination")
                temporary = archive_root() / f".tmp-{secrets.token_hex(16)}"
                stage = temporary / metadata["archive_id"]
                try:
                    stage.mkdir(parents=True)
                    stage_ledger(ledger, stage / "ledger.json")
                    stage_bytes(markdown, stage / "ledger.md")
                    write_json_durable(stage / "metadata.json", metadata)
                    sync_directory(stage)
                    final.parent.mkdir(parents=True, exist_ok=True)
                    os.replace(stage, final)
                    sync_directory(final.parent)
                    completed = validate_archive_entry(final, verify_hash=True)
                finally:
                    if stage.exists() and stage.is_dir():
                        for name in ("ledger.json", "ledger.md", "metadata.json"):
                            path = stage / name
                            if path.is_file() and not path.is_symlink():
                                path.unlink()
                        try:
                            stage.rmdir()
                        except OSError:
                            pass
                    if temporary.exists() and temporary.is_dir():
                        try:
                            temporary.rmdir()
                        except OSError:
                            pass
            ledger.unlink()
            sync_directory(ledger.parent)
        if receipt_path is not None and receipt_path.exists():
            receipt_path.unlink()
            sync_directory(receipt_path.parent)
        releases = claim_root() / "releases"
        if releases.is_dir():
            try:
                releases.rmdir()
                sync_directory(claim_root())
            except OSError:
                pass

    assert completed is not None
    return {
        "ok": True,
        "command": "ledger.archive",
        "version": __version__,
        "archive_reason": "terminal",
        "archive_group": None,
        "archives": [completed],
    }


def list_archives() -> dict[str, Any]:
    scan = scan_archives(verify_hash=False)
    return {
        "ok": True,
        "command": "archive.list",
        "version": __version__,
        "archives": scan["valid"],
        "invalid": scan["invalid"],
        "temporary": scan["temporary"],
        "trash": scan["trash"],
        "warnings": scan["warnings"],
    }


def verify_archives(args: argparse.Namespace) -> dict[str, Any]:
    scan = scan_archives(verify_hash=True)
    archives = scan["valid"]
    if args.archive_id:
        archive_id = check_id(args.archive_id, "archive_id")
        archives = [item for item in archives if item["archive_id"] == archive_id]
        if not archives:
            raise CacheError("not-found", f"archive not found: {archive_id}", 3)
    if scan["invalid"]:
        raise CacheError(
            "integrity-failure",
            "one or more archives failed verification",
            5,
            {"invalid": scan["invalid"]},
        )
    return {
        "ok": True,
        "command": "archive.verify",
        "version": __version__,
        "archives": archives,
    }


def validate_trash_entry(
    entry: Path, *, claim_refs: set[str], cutoff: datetime
) -> dict[str, Any]:
    if entry.is_symlink() or not entry.is_dir():
        raise CacheError("integrity-failure", f"unsafe trash entry: {entry}", 5)
    children = {path.name: path for path in entry.iterdir()}
    if "metadata.json" not in children or any(
        path.is_symlink() or not path.is_file() for path in children.values()
    ):
        raise CacheError("integrity-failure", f"unexpected trash entry: {entry}", 5)
    try:
        value = json.loads(children["metadata.json"].read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise CacheError("integrity-failure", f"trash metadata is unreadable: {entry}", 5) from exc
    if not isinstance(value, dict) or not isinstance(value.get("archive_id"), str):
        raise CacheError("integrity-failure", f"trash metadata schema mismatch: {entry}", 5)
    prefix = f"{value['archive_id']}--"
    token = entry.name[len(prefix) :] if entry.name.startswith(prefix) else ""
    if not re.fullmatch(r"[0-9a-f]{16}", token):
        raise CacheError("integrity-failure", f"trash identity mismatch: {entry}", 5)
    metadata = validate_metadata(value, entry.parent / value["archive_id"])
    expected_children = (
        {"ledger.md", "metadata.json"}
        if metadata["schema_version"] == "1.0.0"
        else {"ledger.json", "ledger.md", "metadata.json"}
    )
    if set(children) != expected_children:
        raise CacheError("integrity-failure", f"unexpected trash entry: {entry}", 5)
    if metadata["schema_version"] == "1.0.0":
        if (
            children["ledger.md"].stat().st_size != metadata["size_bytes"]
            or sha256_file(children["ledger.md"]) != metadata["ledger_sha256"]
        ):
            raise CacheError("integrity-failure", f"trash checksum mismatch: {entry}", 5)
    elif (
        children["ledger.json"].stat().st_size != metadata["state_size_bytes"]
        or children["ledger.md"].stat().st_size != metadata["markdown_size_bytes"]
        or sha256_file(children["ledger.json"]) != metadata["state_sha256"]
        or sha256_file(children["ledger.md"]) != metadata["markdown_sha256"]
    ):
        raise CacheError("integrity-failure", f"trash checksum mismatch: {entry}", 5)
    if parse_timestamp(metadata["archived_at"], "archived_at") > cutoff:
        raise CacheError("integrity-failure", f"trash retention age mismatch: {entry}", 5)
    payload_refs = {metadata["original_ledger_ref"], str(children["ledger.md"])}
    if "ledger.json" in children:
        payload_refs.add(str(children["ledger.json"]))
    if payload_refs & claim_refs:
        raise CacheError("state-conflict", f"trash entry is referenced by claim state: {entry}", 4)
    return metadata


def cleanup_trash(
    trash_root: Path,
    warnings: list[str],
    *,
    claim_refs: set[str],
    cutoff: datetime,
) -> int:
    reclaimed = 0
    if not trash_root.exists():
        return reclaimed
    if trash_root.is_symlink() or not trash_root.is_dir():
        warnings.append(f"unsafe trash root preserved: {trash_root}")
        return reclaimed
    for entry in sorted(trash_root.iterdir()):
        try:
            validate_trash_entry(entry, claim_refs=claim_refs, cutoff=cutoff)
        except CacheError as exc:
            warnings.append(f"trash entry preserved: {exc.message}")
            continue
        children = {path.name: path for path in entry.iterdir()}
        reclaimed += sum(path.stat().st_size for path in children.values())
        for path in children.values():
            path.unlink()
        entry.rmdir()
    try:
        trash_root.rmdir()
    except OSError:
        pass
    return reclaimed


def prune_archives(args: argparse.Namespace) -> dict[str, Any]:
    if args.older_than_days < 1:
        raise CacheError("invalid-input", "older-than-days must be positive", 2)
    apply = bool(args.apply)
    now = utc_now()
    cutoff = now - timedelta(days=args.older_than_days)
    warnings: list[str] = []
    deleted: list[dict[str, Any]] = []
    protected: list[dict[str, Any]] = []
    eligible: list[dict[str, Any]] = []
    reclaimed = 0

    with locked_claim_store(create=apply, exclusive=apply) as claims:
        claim_state = inspect_claim_artifacts(claims)
        warnings.extend(claim_state["warnings"])
        scan = scan_archives(verify_hash=True)
        warnings.extend(scan["warnings"])
        protected.extend(scan["invalid"])
        protected.extend({"entry_path": path, "error": "temporary archive"} for path in scan["temporary"])
        protected.extend({"entry_path": path, "error": "interrupted trash"} for path in scan["trash"])
        for entry in scan["valid"]:
            archived_at = parse_timestamp(entry["archived_at"], "archived_at")
            if archived_at > cutoff:
                continue
            if not claim_state["safe"]:
                protected.append({"archive_id": entry["archive_id"], "error": "claim state unreadable"})
                continue
            entry_refs = {entry["original_ledger_ref"], entry["ledger_path"]}
            if entry.get("state_path"):
                entry_refs.add(entry["state_path"])
            if entry_refs & claim_state["ledger_refs"]:
                protected.append({"archive_id": entry["archive_id"], "error": "referenced by claim state"})
                continue
            eligible.append(entry)

        if apply:
            trash_root = archive_root() / ".trash"
            if claim_state["safe"]:
                reclaimed += cleanup_trash(
                    trash_root,
                    warnings,
                    claim_refs=claim_state["ledger_refs"],
                    cutoff=cutoff,
                )
            for entry in eligible:
                source = Path(entry["entry_path"])
                try:
                    current = validate_archive_entry(source, verify_hash=True)
                    if parse_timestamp(current["archived_at"], "archived_at") > cutoff:
                        protected.append({"archive_id": entry["archive_id"], "error": "age changed"})
                        continue
                    trash_root.mkdir(parents=True, exist_ok=True)
                    destination = trash_root / f"{entry['archive_id']}--{secrets.token_hex(8)}"
                    os.replace(source, destination)
                    sync_directory(source.parent)
                    sync_directory(trash_root)
                    reclaimed += cleanup_trash(
                        trash_root,
                        warnings,
                        claim_refs=claim_state["ledger_refs"],
                        cutoff=cutoff,
                    )
                    if destination.exists():
                        protected.append(
                            {
                                "archive_id": entry["archive_id"],
                                "error": "interrupted trash preserved",
                            }
                        )
                    else:
                        deleted.append(entry)
                    remove_empty_parents(source.parent, archive_root())
                except (CacheError, OSError) as exc:
                    warnings.append(f"archive prune failed for {entry['archive_id']}: {exc}")

    return {
        "ok": True,
        "command": "archive.prune",
        "version": __version__,
        "mutation_mode": "apply" if apply else "dry-run",
        "older_than_days": args.older_than_days,
        "cutoff": format_timestamp(cutoff),
        "eligible": [item["archive_id"] for item in eligible],
        "deleted": [item["archive_id"] for item in deleted],
        "protected": protected,
        "reclaimed_bytes": reclaimed,
        "warnings": warnings,
    }


def doctor() -> dict[str, Any]:
    with locked_claim_store(create=False, exclusive=False) as claims:
        claim_state = inspect_claim_artifacts(claims)
        scan = scan_archives(verify_hash=True)
    active_ledgers: list[dict[str, Any]] = []
    unsupported_active_ledgers: list[str] = []
    invalid_active_ledgers: list[dict[str, str]] = []
    root = ledger_root()
    if root.is_dir():
        for path in sorted(root.glob("*.json")):
            try:
                state = load_state(path)
                active_ledgers.append(
                    {
                        "path": str(path),
                        "size_bytes": path.stat().st_size,
                        "generation": state["generation"],
                        "content_fingerprint": state["content_fingerprint"],
                    }
                )
            except CacheError as exc:
                invalid_active_ledgers.append({"path": str(path), "error": exc.message})
        for path in sorted(root.glob("*.md")):
            if path.is_file() and not path.is_symlink():
                unsupported_active_ledgers.append(str(path))
    archive_bytes = sum(
        item["size_bytes"]
        if item["schema_version"] == "1.0.0"
        else item["state_size_bytes"] + item["markdown_size_bytes"]
        for item in scan["valid"]
    )
    archive_times = [parse_timestamp(item["archived_at"], "archived_at") for item in scan["valid"]]
    total_bytes = archive_bytes + sum(item["size_bytes"] for item in active_ledgers)
    warnings = [*claim_state["warnings"], *scan["warnings"]]
    if unsupported_active_ledgers:
        warnings.append("one or more unsupported active Markdown ledgers exist")
    if invalid_active_ledgers:
        warnings.append("one or more active JSON run states are invalid")
    if scan["invalid"]:
        warnings.append("one or more archive entries are invalid")
    if scan["temporary"]:
        warnings.append("one or more interrupted archive stages exist")
    if scan["trash"]:
        warnings.append("one or more interrupted prune entries exist")
    threshold_warning = total_bytes >= SIZE_WARNING_BYTES or len(scan["valid"]) >= COUNT_WARNING_ENTRIES
    if threshold_warning:
        warnings.append("cache retention threshold exceeded")
    oldest = min(archive_times) if archive_times else None
    return {
        "ok": not scan["invalid"]
        and not scan["temporary"]
        and not scan["trash"]
        and not unsupported_active_ledgers
        and not invalid_active_ledgers
        and claim_state["safe"],
        "command": "doctor",
        "version": __version__,
        "offline": True,
        "cache_root": str(cache_root()),
        "claim_root": str(claim_root()),
        "ledger_root": str(ledger_root()),
        "archive_root": str(archive_root()),
        "active_ledgers": active_ledgers,
        "unsupported_active_ledgers": unsupported_active_ledgers,
        "invalid_active_ledgers": invalid_active_ledgers,
        "archive_count": len(scan["valid"]),
        "archive_bytes": archive_bytes,
        "total_bytes": total_bytes,
        "oldest_archived_at": format_timestamp(oldest) if oldest else None,
        "next_expiry_at": (
            format_timestamp(oldest + timedelta(days=DEFAULT_RETENTION_DAYS)) if oldest else None
        ),
        "claim_files": claim_state["claim_files"],
        "takeover_files": claim_state["takeover_files"],
        "release_receipts": claim_state["release_receipts"],
        "invalid": scan["invalid"],
        "temporary": scan["temporary"],
        "trash": scan["trash"],
        "thresholds": {
            "size_warning_bytes": SIZE_WARNING_BYTES,
            "count_warning_entries": COUNT_WARNING_ENTRIES,
            "warning": threshold_warning,
        },
        "warnings": warnings,
    }


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Own typed Implement Feature run state and cold archives."
    )
    parser.add_argument("--version", action="version", version=__version__)
    parser.add_argument("--json", action="store_true")
    nouns = parser.add_subparsers(dest="noun", required=True)
    nouns.add_parser("doctor", help="Inspect cache readiness and integrity without writing state.")

    ledger = nouns.add_parser("ledger", help="Manage active typed run state.")
    ledger_verbs = ledger.add_subparsers(dest="verb", required=True)
    create = ledger_verbs.add_parser("create", help="Create strict generation-one run state.")
    create.add_argument("--ledger", required=True)
    create.add_argument("--root-id", required=True)
    create.add_argument("--expected-claim-fingerprint", required=True)
    create.add_argument("--operation-id", required=True)
    create.add_argument("--registration-file", required=True)
    apply = ledger_verbs.add_parser("apply", help="Atomically apply a typed event batch.")
    apply.add_argument("--ledger", required=True)
    apply.add_argument("--root-id", required=True)
    apply.add_argument("--expected-claim-fingerprint", required=True)
    apply.add_argument("--expected-generation", type=int, required=True)
    apply.add_argument("--operation-id", required=True)
    apply.add_argument("--events-file", required=True)
    read = ledger_verbs.add_parser("read", help="Read one bounded derived projection.")
    read.add_argument("--ledger", required=True)
    read.add_argument("--projection", choices=sorted(PROJECTIONS), required=True)
    archive = ledger_verbs.add_parser("archive", help="Archive terminal typed run state.")
    archive.add_argument("--ledger", required=True)
    archive.add_argument("--evidence-ref", required=True)
    archive.add_argument("--root-id", required=True)

    archive_noun = nouns.add_parser("archive", help="Inspect, verify, or prune archived ledgers.")
    archive_verbs = archive_noun.add_subparsers(dest="verb", required=True)
    archive_verbs.add_parser("list", help="List archive entries without verifying checksums.")
    verify = archive_verbs.add_parser("verify", help="Verify archive metadata and checksums.")
    verify.add_argument("--archive-id")
    prune = archive_verbs.add_parser("prune", help="Preview or delete archives older than a TTL.")
    prune.add_argument("--older-than-days", type=int, default=DEFAULT_RETENTION_DAYS)
    prune.add_argument("--apply", action="store_true")
    return parser


def dispatch(args: argparse.Namespace) -> dict[str, Any]:
    if args.noun == "doctor":
        return doctor()
    if args.noun == "ledger":
        if args.verb == "create":
            return create_ledger(args)
        if args.verb == "apply":
            return apply_ledger(args)
        if args.verb == "read":
            return read_ledger(args)
        return archive_ledgers(args)
    if args.verb == "list":
        return list_archives()
    if args.verb == "verify":
        return verify_archives(args)
    return prune_archives(args)


def emit(value: dict[str, Any], as_json: bool) -> None:
    rendered = json.dumps(value, sort_keys=as_json, indent=None if as_json else 2)
    if len(rendered.encode()) > MAX_OUTPUT_BYTES:
        raise CacheError("state-conflict", "command output exceeds the bounded projection size", 4)
    print(rendered)


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    try:
        emit(dispatch(args), args.json)
        return 0
    except CacheError as exc:
        emit(
            {"ok": False, "error": {"code": exc.code, "message": exc.message, "details": exc.details}},
            getattr(args, "json", False),
        )
        return exc.exit_code
    except OSError as exc:
        emit(
            {
                "ok": False,
                "error": {"code": "io-error", "message": str(exc), "details": {}},
            },
            getattr(args, "json", False),
        )
        return 6


if __name__ == "__main__":
    raise SystemExit(main())
