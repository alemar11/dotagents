#!/usr/bin/env python3
"""Prepare and execute deterministic Implement Feature command manifests."""

from __future__ import annotations

import argparse
import ctypes
import fcntl
import hashlib
import json
import os
import platform
import re
import secrets
import selectors
import shutil
import signal
import subprocess
import sys
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any, Callable


__version__ = "4.0.0"
SCHEMA_VERSION = "4.0.0"
MAX_PACKET_BYTES = 1024 * 1024
MAX_OUTPUT_BYTES = 128 * 1024
COMMAND_ID_RE = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
HEX64_RE = re.compile(r"^[0-9a-f]{64}$")
HEX40_RE = re.compile(r"^[0-9a-f]{40}$")
SHELL_OPERATORS = {"|", "||", "&", "&&", ";", "<", ">", ">>", "2>", "2>>"}
SHELL_WRAPPERS = {"sh", "bash", "zsh", "dash", "ksh", "fish", "cmd", "powershell", "pwsh"}
OPERATIONS = {"delivery-preflight", "baseline-validation", "validation", "autoreview"}
BASELINE_ADAPTERS = {"clean-exit-v1", "prettier-check-v1"}
BASELINE_POLICIES = {"clean-required", "unchanged-outside-scope-allowed"}
CONTROL_TIMEOUT_SECONDS = 30
TERMINAL_STATUSES = {
    "passed", "failed", "timed-out", "cancelled", "output-limit",
    "interrupted", "cleanup-failed", "reused",
}
EXECUTION_POLICIES = {
    "delivery-preflight": {
        "timeout_seconds": 30 * 60,
        "heartbeat_seconds": 15,
        "term_grace_seconds": 10,
        "cleanup_seconds": 30,
        "stdout_limit_bytes": 8 * 1024 * 1024,
        "stderr_limit_bytes": 8 * 1024 * 1024,
    },
    "baseline-validation": {
        "timeout_seconds": 60 * 60,
        "heartbeat_seconds": 15,
        "term_grace_seconds": 10,
        "cleanup_seconds": 30,
        "stdout_limit_bytes": 8 * 1024 * 1024,
        "stderr_limit_bytes": 8 * 1024 * 1024,
    },
    "validation": {
        "timeout_seconds": 60 * 60,
        "heartbeat_seconds": 15,
        "term_grace_seconds": 10,
        "cleanup_seconds": 30,
        "stdout_limit_bytes": 8 * 1024 * 1024,
        "stderr_limit_bytes": 8 * 1024 * 1024,
    },
    "autoreview": {
        "timeout_seconds": 60 * 60,
        "heartbeat_seconds": 15,
        "term_grace_seconds": 10,
        "cleanup_seconds": 30,
        "stdout_limit_bytes": 8 * 1024 * 1024,
        "stderr_limit_bytes": 8 * 1024 * 1024,
    },
}
_BOOT_IDENTITY: str | None = None


class ManifestError(Exception):
    def __init__(self, code: str, message: str, recovery: str, exit_code: int = 2):
        super().__init__(message)
        self.code = code
        self.message = message
        self.recovery = recovery
        self.exit_code = exit_code


def canonical_bytes(value: Any) -> bytes:
    try:
        return json.dumps(
            value,
            sort_keys=True,
            separators=(",", ":"),
            ensure_ascii=True,
            allow_nan=False,
        ).encode("ascii")
    except (TypeError, ValueError) as exc:
        raise ManifestError("invalid-input", "value is not canonical JSON", "regenerate-from-template") from exc


def digest(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def fingerprint(value: Any) -> str:
    return digest(canonical_bytes(value))


def exact_object(value: Any, fields: set[str], label: str) -> dict[str, Any]:
    if not isinstance(value, dict) or set(value) != fields:
        raise ManifestError(
            "invalid-input",
            f"{label} must contain exactly: {', '.join(sorted(fields))}",
            "regenerate-from-template",
        )
    return value


def nonempty(value: Any, label: str) -> str:
    if not isinstance(value, str) or not value.strip():
        raise ManifestError("invalid-input", f"{label} must be nonempty", "regenerate-from-template")
    return value.strip()


def absolute_path(value: Any, label: str, *, existing: bool = False) -> Path:
    path = Path(nonempty(value, label))
    if not path.is_absolute():
        raise ManifestError("invalid-input", f"{label} must be absolute", "regenerate-from-template")
    if path.is_symlink():
        raise ManifestError("invalid-input", f"{label} must not be a symlink", "use-regular-path")
    if existing and not path.is_file():
        raise ManifestError("invalid-input", f"{label} must be an existing regular file", "restore-input")
    return path


def read_json(path_value: str, label: str) -> dict[str, Any]:
    path = absolute_path(path_value, label, existing=True)
    if path.stat().st_size > MAX_PACKET_BYTES:
        raise ManifestError("invalid-input", f"{label} exceeds 1 MiB", "reduce-input")
    try:
        value = json.loads(path.read_text())
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise ManifestError("invalid-input", f"{label} is unreadable JSON", "regenerate-from-template") from exc
    if not isinstance(value, dict):
        raise ManifestError("invalid-input", f"{label} must contain one JSON object", "regenerate-from-template")
    return value


def write_json(path_value: str, value: dict[str, Any]) -> Path:
    path = absolute_path(path_value, "output")
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.{secrets.token_hex(4)}.tmp")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        os.write(descriptor, canonical_bytes(value) + b"\n")
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    os.replace(temporary, path)
    directory = os.open(path.parent, os.O_RDONLY)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)
    return path


def manifest_fingerprint(value: dict[str, Any]) -> str:
    return fingerprint({key: item for key, item in value.items() if key != "manifest_sha256"})


def validate_file_record(record: Any, label: str, *, tool: bool) -> dict[str, Any]:
    fields = {"source_kind", "source_ref", "resolved_path", "real_path", "size_bytes", "sha256"}
    if tool:
        fields |= {"tool_id", "version"}
    value = exact_object(record, fields, label)
    if value["source_kind"] not in {"configured-install", "repository-file", "path-command", "skill-shipped", "generated-packet", "command-output"}:
        raise ManifestError("manifest-schema-invalid", f"{label} source kind is invalid", "prepare-command-again")
    nonempty(value["source_ref"], f"{label} source_ref")
    resolved = absolute_path(value["resolved_path"], f"{label} resolved_path")
    real = absolute_path(value["real_path"], f"{label} real_path")
    if resolved.resolve() != real:
        raise ManifestError("manifest-schema-invalid", f"{label} real path is invalid", "prepare-command-again")
    if not isinstance(value["size_bytes"], int) or isinstance(value["size_bytes"], bool) or value["size_bytes"] < 0:
        raise ManifestError("manifest-schema-invalid", f"{label} size is invalid", "prepare-command-again")
    if not isinstance(value["sha256"], str) or not HEX64_RE.fullmatch(value["sha256"]):
        raise ManifestError("manifest-schema-invalid", f"{label} digest is invalid", "prepare-command-again")
    if tool:
        nonempty(value["tool_id"], f"{label} tool_id")
        if value["version"] is not None and not isinstance(value["version"], str):
            raise ManifestError("manifest-schema-invalid", f"{label} version is invalid", "prepare-command-again")
    return value


def validate_manifest(value: dict[str, Any]) -> dict[str, Any]:
    fields = {
        "schema_version", "command_id", "operation", "owner", "cwd", "argv",
        "expected_exit_codes", "dependencies", "tools", "write_set", "outputs",
        "bundle_sha256", "baseline", "execution_policy", "argv_fingerprint",
        "gate_fingerprint", "manifest_sha256",
    }
    exact_object(value, fields, "command manifest")
    if value["schema_version"] != SCHEMA_VERSION or value["operation"] not in OPERATIONS:
        raise ManifestError("manifest-schema-invalid", "command manifest schema is unsupported", "prepare-command-again")
    if manifest_fingerprint(value) != value["manifest_sha256"]:
        raise ManifestError("manifest-hash-mismatch", "command manifest hash does not match", "prepare-command-again")
    if not isinstance(value["command_id"], str) or not COMMAND_ID_RE.fullmatch(value["command_id"]):
        raise ManifestError("manifest-schema-invalid", "command manifest id is invalid", "prepare-command-again")
    if value["owner"] not in {"root", "worker"}:
        raise ManifestError("manifest-schema-invalid", "command manifest owner is invalid", "prepare-command-again")
    policy = exact_object(
        value["execution_policy"],
        {
            "timeout_seconds", "heartbeat_seconds", "term_grace_seconds",
            "cleanup_seconds", "stdout_limit_bytes", "stderr_limit_bytes",
        },
        "command execution_policy",
    )
    if policy != EXECUTION_POLICIES[value["operation"]]:
        raise ManifestError(
            "manifest-schema-invalid",
            "command execution policy is not the fixed operation policy",
            "prepare-command-again",
        )
    absolute_path(value["cwd"], "command manifest cwd")
    validate_literal_argv(value["argv"])
    if value["argv_fingerprint"] != fingerprint({"cwd": value["cwd"], "argv": value["argv"]}):
        raise ManifestError("manifest-hash-mismatch", "command argv fingerprint does not match", "prepare-command-again")
    if not isinstance(value["bundle_sha256"], str) or not HEX64_RE.fullmatch(value["bundle_sha256"]):
        raise ManifestError("manifest-schema-invalid", "command bundle fingerprint is invalid", "prepare-command-again")
    if value["gate_fingerprint"] != gate_fingerprint(value):
        raise ManifestError("manifest-schema-invalid", "command gate fingerprint is invalid", "prepare-command-again")
    exits = value["expected_exit_codes"]
    if (
        not isinstance(exits, list)
        or not exits
        or any(not isinstance(code, int) or isinstance(code, bool) or code < 0 or code > 255 for code in exits)
        or exits != sorted(set(exits))
    ):
        raise ManifestError("manifest-schema-invalid", "expected exit codes are invalid", "prepare-command-again")
    tool_ids: set[str] = set()
    for collection, is_tool in ((value["dependencies"], False), (value["tools"], True)):
        if not isinstance(collection, list):
            raise ManifestError("manifest-schema-invalid", "pinned files are invalid", "prepare-command-again")
        for index, record in enumerate(collection):
            validated = validate_file_record(record, f"pinned file {index}", tool=is_tool)
            if is_tool and validated["tool_id"] in tool_ids:
                raise ManifestError("manifest-schema-invalid", "tool ids must be unique", "prepare-command-again")
            if is_tool:
                tool_ids.add(validated["tool_id"])
    write_set = exact_object(value["write_set"], {"mode", "allowed_paths", "expected_paths"}, "command write_set")
    if write_set["mode"] not in {"none", "declared"}:
        raise ManifestError("manifest-schema-invalid", "command write policy is invalid", "prepare-command-again")
    allowed = validate_relative_paths(write_set["allowed_paths"], "command write_set.allowed_paths")
    expected = validate_relative_paths(write_set["expected_paths"], "command write_set.expected_paths")
    if allowed != write_set["allowed_paths"] or expected != write_set["expected_paths"]:
        raise ManifestError("manifest-schema-invalid", "command write paths are not canonical", "prepare-command-again")
    if write_set["mode"] == "none" and (allowed or expected):
        raise ManifestError("manifest-schema-invalid", "no-write commands cannot declare paths", "prepare-command-again")
    if not set(expected).issubset(allowed):
        raise ManifestError("manifest-schema-invalid", "expected write paths must be allowed", "prepare-command-again")
    if not isinstance(value["outputs"], list):
        raise ManifestError("manifest-schema-invalid", "command outputs are invalid", "prepare-command-again")
    if any(not isinstance(output, str) for output in value["outputs"]):
        raise ManifestError("manifest-schema-invalid", "command outputs must be path strings", "prepare-command-again")
    if len(value["outputs"]) != len(set(value["outputs"])):
        raise ManifestError("manifest-schema-invalid", "command outputs must be unique", "prepare-command-again")
    for index, output in enumerate(value["outputs"]):
        absolute_path(output, f"command outputs[{index}]")
    baseline = value["baseline"]
    if value["operation"] == "baseline-validation":
        baseline = exact_object(
            baseline,
            {
                "adapter", "policy", "execution_scope_fingerprint",
                "authored_argv_fingerprint", "checkout_identity",
            },
            "command baseline",
        )
        if baseline["adapter"] not in BASELINE_ADAPTERS or baseline["policy"] not in BASELINE_POLICIES:
            raise ManifestError("manifest-schema-invalid", "baseline adapter or policy is invalid", "prepare-command-again")
        for name in ("execution_scope_fingerprint", "authored_argv_fingerprint"):
            if not isinstance(baseline[name], str) or not HEX64_RE.fullmatch(baseline[name]):
                raise ManifestError("manifest-schema-invalid", f"baseline {name} is invalid", "prepare-command-again")
        validate_checkout_identity(baseline["checkout_identity"], "command baseline checkout")
        if value["write_set"] != {"mode": "none", "allowed_paths": [], "expected_paths": []}:
            raise ManifestError("manifest-schema-invalid", "baseline validation must be read-only", "prepare-command-again")
    elif baseline is not None:
        raise ManifestError("manifest-schema-invalid", "non-baseline command has baseline state", "prepare-command-again")
    return value


def gate_fingerprint(value: dict[str, Any]) -> str:
    return fingerprint(
        {
            "command_id": value["command_id"],
            "operation": value["operation"],
            "owner": value["owner"],
            "cwd": value["cwd"],
            "argv": value["argv"],
            "expected_exit_codes": value["expected_exit_codes"],
            "dependencies": value["dependencies"],
            "tools": value["tools"],
            "write_set": value["write_set"],
            "outputs": value["outputs"],
            "bundle_sha256": value["bundle_sha256"],
            "baseline": value["baseline"],
            "execution_policy": value["execution_policy"],
        }
    )


def validate_bundle(value: dict[str, Any]) -> dict[str, Any]:
    exact_object(
        value,
        {"schema_version", "root_task_ref", "bundle_recipe", "entries", "bundle_sha256", "manifest_sha256"},
        "bundle manifest",
    )
    if value["schema_version"] != SCHEMA_VERSION or value["bundle_recipe"] != "sha256-frame-v1":
        raise ManifestError("manifest-schema-invalid", "bundle manifest schema is unsupported", "prepare-bundle-again")
    if manifest_fingerprint(value) != value["manifest_sha256"]:
        raise ManifestError("bundle-hash-mismatch", "bundle manifest hash does not match", "prepare-bundle-again")
    nonempty(value["root_task_ref"], "bundle root_task_ref")
    if not isinstance(value["entries"], list) or not value["entries"]:
        raise ManifestError("manifest-schema-invalid", "bundle entries are invalid", "prepare-bundle-again")
    rows: list[dict[str, Any]] = []
    for index, raw in enumerate(value["entries"]):
        row = exact_object(
            raw,
            {"entry_id", "kind", "source_ref", "byte_length", "content_sha256", "snapshot_path"},
            f"bundle entries[{index}]",
        )
        path = absolute_path(row["snapshot_path"], f"bundle entries[{index}].snapshot_path", existing=True)
        data = path.read_bytes()
        if len(data) != row["byte_length"] or digest(data) != row["content_sha256"]:
            raise ManifestError("manifest-stale", f"bundle source changed: {path}", "prepare-bundle-again", 3)
        rows.append({key: row[key] for key in ("entry_id", "kind", "source_ref", "byte_length", "content_sha256")})
    if rows != sorted(rows, key=lambda row: row["entry_id"]):
        raise ManifestError("manifest-schema-invalid", "bundle entries are not canonically sorted", "prepare-bundle-again")
    payload = b"implement-feature-bundle\0sha256-frame-v1\0" + len(rows).to_bytes(8, "big")
    for row in rows:
        frame = canonical_bytes(row)
        payload += len(frame).to_bytes(8, "big") + frame
    if digest(payload) != value["bundle_sha256"]:
        raise ManifestError("bundle-hash-mismatch", "bundle aggregate hash does not match", "prepare-bundle-again")
    return value


def file_record(path: Path, *, source_kind: str, source_ref: str) -> dict[str, Any]:
    if path.is_symlink() or not path.is_file():
        raise ManifestError("tool-missing", f"required file is unavailable: {path}", "restore-pinned-tool", 3)
    data = path.read_bytes()
    return {
        "source_kind": source_kind,
        "source_ref": source_ref,
        "resolved_path": str(path),
        "real_path": str(path.resolve()),
        "size_bytes": len(data),
        "sha256": digest(data),
    }


def command_version(path: Path) -> str | None:
    try:
        result = subprocess.run(
            [str(path), "--version"],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=3,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    rendered = (result.stdout or result.stderr).strip()
    return rendered[:4096] or None


def resolve_executable(token: str, cwd: Path) -> tuple[Path, str, str]:
    raw = Path(token)
    if raw.is_absolute():
        path = raw
        source_kind = "configured-install"
        source_ref = str(raw)
    elif "/" in token:
        path = (cwd / raw).resolve()
        source_kind = "repository-file"
        source_ref = str(raw)
    else:
        resolved = shutil.which(token)
        if not resolved:
            raise ManifestError("tool-missing", f"required command is unavailable: {token}", "install-or-restore-pinned-tool", 3)
        path = Path(resolved)
        source_kind = "path-command"
        source_ref = token
    if path.is_symlink():
        path = path.resolve()
    if not path.is_file() or not os.access(path, os.X_OK):
        raise ManifestError("tool-missing", f"required command is not executable: {path}", "restore-pinned-tool", 3)
    return path, source_kind, source_ref


def tool_record(tool_id: str, path: Path, source_kind: str, source_ref: str) -> dict[str, Any]:
    record = file_record(path, source_kind=source_kind, source_ref=source_ref)
    return {"tool_id": tool_id, **record, "version": command_version(path)}


def dependency_record(path: Path, cwd: Path | None) -> dict[str, Any]:
    if cwd is not None:
        try:
            relative = path.relative_to(cwd)
        except ValueError:
            pass
        else:
            return file_record(path, source_kind="repository-file", source_ref=relative.as_posix())
    return file_record(path, source_kind="configured-install", source_ref=str(path))


def validate_literal_argv(value: Any) -> list[str]:
    if not isinstance(value, list) or not value:
        raise ManifestError("command-argv-invalid", "argv must be a nonempty literal string array", "use-literal-argv")
    argv: list[str] = []
    for index, token in enumerate(value):
        if not isinstance(token, str) or not token:
            raise ManifestError("command-argv-invalid", f"argv[{index}] must be a nonempty string", "use-literal-argv")
        argv.append(token)
    for token in argv:
        if (
            token in SHELL_OPERATORS
            or "$" in token
            or "`" in token
            or any(char in token for char in ("|", ";", "<", ">"))
        ):
            raise ManifestError("command-argv-invalid", "argv contains shell syntax", "use-literal-argv")
    if any(re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*=.*", token) for token in argv):
        raise ManifestError("command-argv-invalid", "argv cannot contain an environment assignment", "use-literal-argv")
    if Path(argv[0]).name.lower() in SHELL_WRAPPERS:
        raise ManifestError("command-argv-invalid", "shell wrappers are forbidden", "invoke-the-tool-directly")
    return argv


def validate_relative_paths(value: Any, label: str) -> list[str]:
    if not isinstance(value, list):
        raise ManifestError("invalid-input", f"{label} must be an array", "regenerate-from-template")
    result: list[str] = []
    for index, item in enumerate(value):
        if not isinstance(item, str) or not item or Path(item).is_absolute() or ".." in Path(item).parts or "\\" in item:
            raise ManifestError("invalid-input", f"{label}[{index}] is not repository-relative", "regenerate-from-template")
        normalized = Path(item).as_posix()
        if normalized in result:
            raise ManifestError("invalid-input", f"{label} contains duplicate paths", "regenerate-from-template")
        result.append(normalized)
    return sorted(result)


def git_output(cwd: Path, git_path: str, *args: str) -> bytes:
    try:
        result = subprocess.run(
            [git_path, "-C", str(cwd), *args],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=CONTROL_TIMEOUT_SECONDS,
            check=False,
        )
    except subprocess.TimeoutExpired as exc:
        raise ManifestError(
            "control-command-timeout",
            f"managed checkout observation timed out: {' '.join(args)}",
            "owner-required",
            4,
        ) from exc
    if result.returncode:
        raise ManifestError(
            "command-cwd-invalid",
            f"managed checkout observation failed: {' '.join(args)}",
            "restore-managed-checkout",
            3,
        )
    return result.stdout


def checkout_identity(cwd: Path, git_path: str, *, require_clean: bool) -> dict[str, Any]:
    top = Path(os.fsdecode(git_output(cwd, git_path, "rev-parse", "--show-toplevel")).strip()).resolve()
    if top != cwd.resolve():
        raise ManifestError("command-cwd-invalid", "cwd is not the managed checkout root", "restore-managed-checkout", 3)
    head = os.fsdecode(git_output(cwd, git_path, "rev-parse", "HEAD")).strip()
    tree = os.fsdecode(git_output(cwd, git_path, "rev-parse", "HEAD^{tree}")).strip()
    branch = os.fsdecode(git_output(cwd, git_path, "branch", "--show-current")).strip()
    status = git_output(cwd, git_path, "status", "--porcelain=v2", "--untracked-files=all", "-z")
    if not HEX40_RE.fullmatch(head) or not HEX40_RE.fullmatch(tree) or not branch:
        raise ManifestError("command-cwd-invalid", "managed checkout identity is incomplete", "restore-managed-checkout", 3)
    if require_clean and status:
        raise ManifestError("baseline-checkout-dirty", "baseline checkout must have no Git-visible changes", "planning-required", 4)
    return {
        "checkout": str(cwd.resolve()),
        "branch": branch,
        "head_sha": head,
        "tree_sha": tree,
        "status_sha256": digest(status),
        "status_clean": not status,
    }


def validate_checkout_identity(value: Any, label: str) -> dict[str, Any]:
    item = exact_object(
        value,
        {"checkout", "branch", "head_sha", "tree_sha", "status_sha256", "status_clean"},
        label,
    )
    absolute_path(item["checkout"], f"{label}.checkout")
    nonempty(item["branch"], f"{label}.branch")
    for name in ("head_sha", "tree_sha"):
        if not isinstance(item[name], str) or not HEX40_RE.fullmatch(item[name]):
            raise ManifestError("manifest-schema-invalid", f"{label}.{name} is invalid", "prepare-command-again")
    if not isinstance(item["status_sha256"], str) or not HEX64_RE.fullmatch(item["status_sha256"]):
        raise ManifestError("manifest-schema-invalid", f"{label}.status_sha256 is invalid", "prepare-command-again")
    if not isinstance(item["status_clean"], bool):
        raise ManifestError("manifest-schema-invalid", f"{label}.status_clean is invalid", "prepare-command-again")
    return item


def baseline_projection(argv: list[str]) -> tuple[list[str], str, str]:
    names = [Path(token).name.lower() for token in argv]
    prettier_index = next((index for index, name in enumerate(names) if name in {"prettier", "prettier.cjs"}), None)
    if prettier_index is not None:
        if "--write" in argv and "--check" in argv:
            raise ManifestError("baseline-command-unsafe", "prettier command mixes write and check modes", "planning-required", 4)
        projected = ["--check" if token == "--write" else token for token in argv]
        if "--check" not in projected:
            projected.append("--check")
        return projected, "prettier-check-v1", "unchanged-outside-scope-allowed"
    first = names[0]
    safe = (
        first in {"pytest", "cargo", "go", "npm", "pnpm", "yarn"}
        or (first.startswith("python") and len(argv) >= 3 and argv[1] == "-m" and argv[2] in {"pytest", "unittest"})
    )
    if safe:
        return argv, "clean-exit-v1", "clean-required"
    raise ManifestError(
        "baseline-command-unsafe",
        "validation command has no proven read-only baseline projection",
        "planning-required",
        4,
    )


def diagnostic_path(cwd: Path, raw: str) -> str:
    candidate = raw.strip()
    if not candidate or Path(candidate).is_absolute() or "\\" in candidate or ".." in Path(candidate).parts:
        raise ManifestError("baseline-diagnostic-ambiguous", "baseline diagnostic path is not canonical", "planning-required", 4)
    normalized = Path(candidate).as_posix()
    path = cwd / normalized
    if path.is_symlink() or not path.is_file() or path.resolve().parent != cwd.resolve() and cwd.resolve() not in path.resolve().parents:
        raise ManifestError("baseline-diagnostic-ambiguous", "baseline diagnostic path is outside the checkout", "planning-required", 4)
    return normalized


def prettier_diagnostics(cwd: Path, stdout: bytes, stderr: bytes, exit_code: int) -> list[dict[str, str]]:
    if exit_code == 0:
        return []
    if exit_code != 1:
        raise ManifestError("baseline-command-failed", "prettier baseline command failed unexpectedly", "blocked", 4)
    paths: list[str] = []
    for line in (stdout + b"\n" + stderr).decode("utf-8", errors="replace").splitlines():
        if line.startswith("[warn] "):
            value = line[7:].strip()
            if value and not value.startswith(("Code style issues", "Forgot to run Prettier")):
                paths.append(diagnostic_path(cwd, value))
    paths = sorted(set(paths))
    if not paths:
        raise ManifestError("baseline-diagnostic-ambiguous", "prettier debt has no canonical path set", "planning-required", 4)
    return [
        {
            "path": path,
            "diagnostic_fingerprint": fingerprint({"adapter": "prettier-check-v1", "path": path}),
            "content_sha256": digest((cwd / path).read_bytes()),
        }
        for path in paths
    ]


def bundle_template() -> dict[str, Any]:
    return {
        "schema_version": SCHEMA_VERSION,
        "template": True,
        "root_task_ref": "REPLACE_ME",
        "entries": [
            {
                "entry_id": "replace-me",
                "kind": "feature-spec",
                "source_ref": "REPLACE_ME",
                "snapshot_path": "/absolute/path/to/snapshot",
            }
        ],
    }


def prepare_bundle(request: dict[str, Any]) -> dict[str, Any]:
    exact_object(request, {"schema_version", "template", "root_task_ref", "entries"}, "bundle request")
    if request["schema_version"] != SCHEMA_VERSION or request["template"] is not False:
        raise ManifestError("invalid-input", "bundle request is an unprepared template or unsupported schema", "fill-template")
    root_task_ref = nonempty(request["root_task_ref"], "root_task_ref")
    entries = request["entries"]
    if not isinstance(entries, list) or not entries:
        raise ManifestError("invalid-input", "entries must be nonempty", "fill-template")
    prepared: list[dict[str, Any]] = []
    seen: set[str] = set()
    identity_rows: list[dict[str, Any]] = []
    for index, raw in enumerate(entries):
        item = exact_object(raw, {"entry_id", "kind", "source_ref", "snapshot_path"}, f"entries[{index}]")
        entry_id = nonempty(item["entry_id"], f"entries[{index}].entry_id")
        if not COMMAND_ID_RE.fullmatch(entry_id) or entry_id in seen:
            raise ManifestError("invalid-input", f"entries[{index}].entry_id is invalid or duplicate", "fill-template")
        seen.add(entry_id)
        path = absolute_path(item["snapshot_path"], f"entries[{index}].snapshot_path", existing=True)
        data = path.read_bytes()
        identity = {
            "entry_id": entry_id,
            "kind": nonempty(item["kind"], f"entries[{index}].kind"),
            "source_ref": nonempty(item["source_ref"], f"entries[{index}].source_ref"),
            "byte_length": len(data),
            "content_sha256": digest(data),
        }
        identity_rows.append(identity)
        prepared.append({**identity, "snapshot_path": str(path)})
    prepared.sort(key=lambda row: row["entry_id"])
    identity_rows.sort(key=lambda row: row["entry_id"])
    payload = b"implement-feature-bundle\0sha256-frame-v1\0" + len(identity_rows).to_bytes(8, "big")
    for row in identity_rows:
        frame = canonical_bytes(row)
        payload += len(frame).to_bytes(8, "big") + frame
    manifest: dict[str, Any] = {
        "schema_version": SCHEMA_VERSION,
        "root_task_ref": root_task_ref,
        "bundle_recipe": "sha256-frame-v1",
        "entries": prepared,
        "bundle_sha256": digest(payload),
    }
    manifest["manifest_sha256"] = manifest_fingerprint(manifest)
    return manifest


def command_template(operation: str) -> dict[str, Any]:
    base: dict[str, Any] = {
        "schema_version": SCHEMA_VERSION,
        "template": True,
        "command_id": "replace-me",
        "operation": operation,
        "owner": "worker" if operation in {"baseline-validation", "validation", "autoreview"} else "root",
        "cwd": "/absolute/repository/checkout" if operation != "delivery-preflight" else None,
        "parameters": {},
        "dependency_files": [],
        "write_set": {"mode": "none", "allowed_paths": [], "expected_paths": []},
        "expected_exit_codes": [0],
    }
    if operation == "delivery-preflight":
        base["parameters"] = {"input": "/absolute/path/to/delivery-preflight.json"}
    elif operation == "baseline-validation":
        base["parameters"] = {
            "argv": ["prettier", "--check", "."],
            "execution_scope_fingerprint": "0" * 64,
        }
    elif operation == "validation":
        base["parameters"] = {"argv": ["python3", "-m", "unittest"]}
    else:
        base["parameters"] = {
            "reservation_file": "/absolute/path/to/autoreview-next.json",
            "attempt_file": "/absolute/path/to/autoreview-attempt.jsonl",
            "candidate_output": "/absolute/path/to/autoreview-candidate.json",
            "operation_output": "/absolute/path/to/autoreview-operation.json",
            "dry_run": False,
        }
    return base


def prepare_command(request: dict[str, Any], bundle: dict[str, Any]) -> dict[str, Any]:
    fields = {
        "schema_version", "template", "command_id", "operation", "owner", "cwd",
        "parameters", "dependency_files", "write_set", "expected_exit_codes",
    }
    exact_object(request, fields, "command request")
    if request["schema_version"] != SCHEMA_VERSION or request["template"] is not False:
        raise ManifestError("invalid-input", "command request is an unprepared template or unsupported schema", "fill-template")
    bundle = validate_bundle(bundle)
    operation = request["operation"]
    if operation not in OPERATIONS:
        raise ManifestError("invalid-input", "operation is unsupported", "choose-supported-operation")
    command_id = nonempty(request["command_id"], "command_id")
    if not COMMAND_ID_RE.fullmatch(command_id):
        raise ManifestError("invalid-input", "command_id must be lower-kebab", "fill-template")
    owner = request["owner"]
    if owner not in {"root", "worker"}:
        raise ManifestError("invalid-input", "owner must be root or worker", "fill-template")
    expected = request["expected_exit_codes"]
    if not isinstance(expected, list) or not expected or any(not isinstance(item, int) or isinstance(item, bool) or item < 0 or item > 255 for item in expected):
        raise ManifestError("invalid-input", "expected_exit_codes is invalid", "fill-template")
    expected = sorted(set(expected))
    dependency_files = request["dependency_files"]
    if not isinstance(dependency_files, list):
        raise ManifestError("invalid-input", "dependency_files must be an array", "fill-template")
    dependency_paths = [
        absolute_path(value, f"dependency_files[{index}]", existing=True)
        for index, value in enumerate(dependency_files)
    ]
    dependencies: list[dict[str, Any]] = []
    write_request = exact_object(request["write_set"], {"mode", "allowed_paths", "expected_paths"}, "write_set")
    if write_request["mode"] not in {"none", "declared"}:
        raise ManifestError("invalid-input", "write_set.mode must be none or declared", "fill-template")
    allowed = validate_relative_paths(write_request["allowed_paths"], "write_set.allowed_paths")
    expected_paths = validate_relative_paths(write_request["expected_paths"], "write_set.expected_paths")
    if write_request["mode"] == "none" and (allowed or expected_paths):
        raise ManifestError("invalid-input", "none write set cannot declare paths", "fill-template")
    if any(not any(path == allowed_path or path.startswith(allowed_path.rstrip("/") + "/") for allowed_path in allowed) for path in expected_paths):
        raise ManifestError("invalid-input", "expected paths must be allowed", "fill-template")
    params = request["parameters"]
    outputs: list[str] = []
    tools: list[dict[str, Any]] = []
    baseline: dict[str, Any] | None = None
    if operation == "delivery-preflight":
        exact_object(params, {"input"}, "parameters")
        helper = Path(__file__).resolve().with_name("delivery-preflight")
        cwd = Path(__file__).resolve().parents[1]
        input_path = absolute_path(params["input"], "parameters.input", existing=True)
        argv = [str(helper), "--json", "inspect", "--input", str(input_path)]
        tools.append(tool_record("delivery-preflight", helper, "skill-shipped", "implement-feature:scripts/delivery-preflight"))
        gh, kind, ref = resolve_executable("gh", cwd)
        tools.append(tool_record("gh", gh, kind, ref))
        git, git_kind, git_ref = resolve_executable("git", cwd)
        tools.append(tool_record("git", git, git_kind, git_ref))
        dependencies.append(file_record(input_path, source_kind="generated-packet", source_ref="delivery-preflight-input"))
        if request["cwd"] is not None or owner != "root" or write_request["mode"] != "none":
            raise ManifestError("invalid-input", "delivery-preflight derives root ownership, cwd, and no-write policy", "regenerate-from-template")
    else:
        cwd = absolute_path(request["cwd"], "cwd")
        if not cwd.is_dir():
            raise ManifestError("command-cwd-invalid", "cwd must be an existing directory", "restore-managed-checkout")
        if owner != "worker":
            raise ManifestError("invalid-input", f"{operation} must be worker-owned", "regenerate-from-template")
        if operation in {"baseline-validation", "validation"}:
            if operation == "baseline-validation":
                exact_object(params, {"argv", "execution_scope_fingerprint"}, "parameters")
                scope_fingerprint = params["execution_scope_fingerprint"]
                if not isinstance(scope_fingerprint, str) or not HEX64_RE.fullmatch(scope_fingerprint):
                    raise ManifestError("invalid-input", "execution_scope_fingerprint is invalid", "fill-template")
            else:
                exact_object(params, {"argv"}, "parameters")
                scope_fingerprint = None
            authored_argv = validate_literal_argv(params["argv"])
            argv = list(authored_argv)
            if operation == "baseline-validation":
                if expected != [0] or write_request["mode"] != "none":
                    raise ManifestError("invalid-input", "baseline validation derives exits and no-write policy", "regenerate-from-template")
                argv, adapter, policy = baseline_projection(argv)
            executable, kind, ref = resolve_executable(argv[0], cwd)
            argv[0] = str(executable)
            tools.append(tool_record("validation-command", executable, kind, ref))
            git, git_kind, git_ref = resolve_executable("git", cwd)
            tools.append(tool_record("git", git, git_kind, git_ref))
            if operation == "baseline-validation":
                expected = [0, 1] if adapter == "prettier-check-v1" else list(range(0, 256))
                baseline = {
                    "adapter": adapter,
                    "policy": policy,
                    "execution_scope_fingerprint": scope_fingerprint,
                    "authored_argv_fingerprint": fingerprint({"cwd": str(cwd), "argv": authored_argv}),
                    "checkout_identity": checkout_identity(cwd, str(git), require_clean=True),
                }
        else:
            exact_object(
                params,
                {"reservation_file", "attempt_file", "candidate_output", "operation_output", "dry_run"},
                "parameters",
            )
            if not isinstance(params["dry_run"], bool):
                raise ManifestError("invalid-input", "AutoReview dry_run must be boolean", "regenerate-from-template")
            helper = Path(__file__).resolve().parents[2] / "autoreview/scripts/autoreview"
            codex, codex_kind, codex_ref = resolve_executable("codex", cwd)
            git, git_kind, git_ref = resolve_executable("git", cwd)
            tools.extend(
                [
                    tool_record("autoreview", helper, "skill-shipped", "autoreview:scripts/autoreview"),
                    tool_record("codex", codex, codex_kind, codex_ref),
                    tool_record("git", git, git_kind, git_ref),
                ]
            )
            reservation = absolute_path(params["reservation_file"], "parameters.reservation_file", existing=True)
            attempt = absolute_path(params["attempt_file"], "parameters.attempt_file")
            candidate = absolute_path(params["candidate_output"], "parameters.candidate_output")
            operation_output = absolute_path(params["operation_output"], "parameters.operation_output")
            dependencies.append(file_record(reservation, source_kind="generated-packet", source_ref="autoreview-reservation"))
            outputs.extend([str(attempt), str(candidate), str(operation_output)])
            argv = [
                str(helper), "--json", "--codex-bin", str(codex),
                "--reservation-file", str(reservation), "--attempt-file", str(attempt),
                "--candidate-output", str(candidate), "--operation-output", str(operation_output),
            ]
            if params["dry_run"]:
                argv.append("--dry-run")
            if write_request["mode"] != "none":
                raise ManifestError("invalid-input", "AutoReview repository write policy must be none", "regenerate-from-template")
    dependencies.extend(dependency_record(path, cwd) for path in dependency_paths)
    write_set = {"mode": write_request["mode"], "allowed_paths": allowed, "expected_paths": expected_paths}
    manifest: dict[str, Any] = {
        "schema_version": SCHEMA_VERSION,
        "command_id": command_id,
        "operation": operation,
        "owner": owner,
        "cwd": str(cwd),
        "argv": argv,
        "expected_exit_codes": expected,
        "dependencies": sorted(dependencies, key=lambda row: row["resolved_path"]),
        "tools": sorted(tools, key=lambda row: row["tool_id"]),
        "write_set": write_set,
        "outputs": sorted(outputs),
        "bundle_sha256": bundle["bundle_sha256"],
        "baseline": baseline,
        "execution_policy": dict(EXECUTION_POLICIES[operation]),
    }
    manifest["argv_fingerprint"] = fingerprint({"cwd": manifest["cwd"], "argv": argv})
    manifest["gate_fingerprint"] = gate_fingerprint(manifest)
    manifest["manifest_sha256"] = manifest_fingerprint(manifest)
    return manifest


def verify_file_record(record: dict[str, Any], *, tool: bool) -> None:
    path = Path(record["resolved_path"])
    if path.is_symlink() or not path.is_file():
        code = "tool-missing" if tool else "manifest-stale"
        raise ManifestError(code, f"pinned file is unavailable: {path}", "refresh-tools" if tool else "prepare-command-again", 3)
    if digest(path.read_bytes()) != record["sha256"]:
        code = "tool-digest-mismatch" if tool else "manifest-stale"
        raise ManifestError(code, f"pinned file changed: {path}", "restore-pinned-tool" if tool else "prepare-command-again", 3)
    if tool and record.get("version") != command_version(path):
        raise ManifestError("tool-digest-mismatch", f"pinned tool version changed: {path}", "restore-pinned-tool", 3)


def tracked_snapshot(cwd: Path, git_path: str) -> dict[str, str]:
    try:
        result = subprocess.run(
            [git_path, "-C", str(cwd), "ls-files", "-co", "--exclude-standard", "-z"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=CONTROL_TIMEOUT_SECONDS,
            check=False,
        )
    except subprocess.TimeoutExpired as exc:
        raise ManifestError(
            "control-command-timeout",
            "write observation timed out",
            "owner-required",
            4,
        ) from exc
    if result.returncode != 0:
        raise ManifestError("command-cwd-invalid", "write observation requires a Git checkout", "use-managed-git-checkout", 3)
    snapshot: dict[str, str] = {}
    for raw in result.stdout.split(b"\0"):
        if not raw:
            continue
        rel = os.fsdecode(raw)
        path = cwd / rel
        if path.is_file() and not path.is_symlink():
            snapshot[Path(rel).as_posix()] = digest(path.read_bytes())
    return snapshot


def path_allowed(path: str, allowed: list[str]) -> bool:
    return any(path == item or path.startswith(item.rstrip("/") + "/") for item in allowed)


def utc_timestamp() -> str:
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def parse_timestamp(value: str) -> datetime:
    return datetime.fromisoformat(value.replace("Z", "+00:00"))


def boot_identity() -> str:
    global _BOOT_IDENTITY
    if _BOOT_IDENTITY is not None:
        return _BOOT_IDENTITY
    linux = Path("/proc/sys/kernel/random/boot_id")
    if linux.is_file():
        value = linux.read_text().strip()
        if value:
            _BOOT_IDENTITY = f"linux:{value}"
            return _BOOT_IDENTITY
    try:
        result = subprocess.run(
            ["sysctl", "-n", "kern.boottime"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=3,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        result = None
    if result is not None and result.returncode == 0 and result.stdout.strip():
        _BOOT_IDENTITY = "darwin:" + digest(result.stdout.strip())
        return _BOOT_IDENTITY
    _BOOT_IDENTITY = "unknown:" + digest(str(time.time_ns()).encode())
    return _BOOT_IDENTITY


class ProcBSDInfo(ctypes.Structure):
    _fields_ = [
        ("pbi_flags", ctypes.c_uint32), ("pbi_status", ctypes.c_uint32),
        ("pbi_xstatus", ctypes.c_uint32), ("pbi_pid", ctypes.c_uint32),
        ("pbi_ppid", ctypes.c_uint32), ("pbi_uid", ctypes.c_uint32),
        ("pbi_gid", ctypes.c_uint32), ("pbi_ruid", ctypes.c_uint32),
        ("pbi_rgid", ctypes.c_uint32), ("pbi_svuid", ctypes.c_uint32),
        ("pbi_svgid", ctypes.c_uint32), ("rfu_1", ctypes.c_uint32),
        ("pbi_comm", ctypes.c_char * 16), ("pbi_name", ctypes.c_char * 32),
        ("pbi_nfiles", ctypes.c_uint32), ("pbi_pgid", ctypes.c_uint32),
        ("pbi_pjobc", ctypes.c_uint32), ("e_tdev", ctypes.c_uint32),
        ("e_tpgid", ctypes.c_uint32), ("pbi_nice", ctypes.c_int32),
        ("pbi_start_tvsec", ctypes.c_uint64), ("pbi_start_tvusec", ctypes.c_uint64),
    ]


def platform_process_rows() -> dict[int, tuple[int, int, str]]:
    rows: dict[int, tuple[int, int, str]] = {}
    if platform.system() == "Linux":
        for path in Path("/proc").iterdir():
            if not path.name.isdigit():
                continue
            try:
                raw = (path / "stat").read_text()
                rest = raw[raw.rfind(")") + 2 :].split()
                pid = int(path.name)
                ppid = int(rest[1])
                pgid = int(rest[2])
                start = rest[19]
            except (OSError, ValueError, IndexError):
                continue
            rows[pid] = (ppid, pgid, digest(f"{boot_identity()}:{start}".encode()))
        return rows
    if platform.system() == "Darwin":
        libproc = ctypes.CDLL("/usr/lib/libproc.dylib", use_errno=True)
        libproc.proc_listallpids.argtypes = [ctypes.c_void_p, ctypes.c_int]
        libproc.proc_listallpids.restype = ctypes.c_int
        capacity = max(1024, libproc.proc_listallpids(None, 0) * 2)
        pids = (ctypes.c_int * capacity)()
        count = libproc.proc_listallpids(pids, ctypes.sizeof(pids))
        libproc.proc_pidinfo.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_uint64, ctypes.c_void_p, ctypes.c_int]
        libproc.proc_pidinfo.restype = ctypes.c_int
        for pid in pids[: max(0, count)]:
            if pid <= 0:
                continue
            info = ProcBSDInfo()
            size = libproc.proc_pidinfo(pid, 3, 0, ctypes.byref(info), ctypes.sizeof(info))
            if size != ctypes.sizeof(info):
                continue
            identity = digest(
                f"{boot_identity()}:{info.pbi_start_tvsec}:{info.pbi_start_tvusec}".encode()
            )
            rows[int(pid)] = (int(info.pbi_ppid), int(info.pbi_pgid), identity)
        return rows
    raise ManifestError(
        "process-identity-unverifiable",
        "this platform has no supported process census",
        "owner-required",
        4,
    )


def process_start_identity(pid: int) -> str | None:
    row = platform_process_rows().get(pid)
    return row[2] if row is not None else None


def process_census() -> dict[int, tuple[int, int]]:
    return {pid: (row[0], row[1]) for pid, row in platform_process_rows().items()}


def owned_processes(
    leader_pid: int,
    pgid: int,
    known_identities: dict[int, str],
) -> tuple[list[int], list[int], dict[int, str]]:
    rows = process_census()
    descendants = {leader_pid}
    changed = True
    while changed:
        changed = False
        for pid, (ppid, _) in rows.items():
            if ppid in descendants and pid not in descendants:
                descendants.add(pid)
                changed = True
    group_members = sorted(pid for pid, (_, member_pgid) in rows.items() if member_pgid == pgid)
    escaped = sorted(pid for pid in descendants if pid in rows and rows[pid][1] != pgid)
    identities = dict(known_identities)
    for pid in sorted(descendants | set(group_members)):
        if pid in rows and pid not in identities:
            identity = process_start_identity(pid)
            if identity is not None:
                identities[pid] = identity
    return group_members, escaped, identities


def append_attempt(path: Path, event: dict[str, Any], *, create: bool = False) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    flags = os.O_WRONLY | os.O_APPEND | os.O_CREAT
    if create:
        flags |= os.O_EXCL
    try:
        descriptor = os.open(path, flags, 0o600)
    except FileExistsError as exc:
        raise ManifestError(
            "attempt-already-exists",
            "this command already has a physical attempt",
            "recover-existing-attempt",
            4,
        ) from exc
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        os.write(descriptor, canonical_bytes(event) + b"\n")
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    if create:
        directory = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)


def write_lease(path: Path, value: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.{secrets.token_hex(4)}.tmp")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        os.write(descriptor, canonical_bytes(value) + b"\n")
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    os.replace(temporary, path)
    directory = os.open(path.parent, os.O_RDONLY)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)


def exclusive_output(path: Path):
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags, 0o600)
    except FileExistsError as exc:
        raise ManifestError(
            "attempt-artifact-conflict",
            f"command output artifact already exists: {path}",
            "use-new-receipt-path",
            4,
        ) from exc
    return os.fdopen(descriptor, "wb")


def launch_gated(
    manifest: dict[str, Any],
    environment: dict[str, str],
    stdout_write: int,
    stderr_write: int,
) -> tuple[int, int, int]:
    release_read, release_write = os.pipe()
    pid = os.fork()
    if pid == 0:
        try:
            os.close(release_write)
            os.setsid()
            os.chdir(manifest["cwd"])
            os.dup2(stdout_write, 1)
            os.dup2(stderr_write, 2)
            os.close(stdout_write)
            os.close(stderr_write)
            signal.signal(signal.SIGTERM, signal.SIG_DFL)
            signal.signal(signal.SIGINT, signal.SIG_DFL)
            release = os.read(release_read, 1)
            os.close(release_read)
            if release != b"1":
                os._exit(125)
            os.execve(manifest["argv"][0], manifest["argv"], environment)
        except BaseException:
            os._exit(126)
    os.close(release_read)
    return pid, pid, release_write


def signal_owned_group(
    pgid: int,
    known_identities: dict[int, str],
    signal_number: int,
) -> tuple[list[int], dict[int, str]]:
    members, escaped, identities = owned_processes(pgid, pgid, known_identities)
    try:
        child_state = os.waitid(os.P_PID, pgid, os.WEXITED | os.WNOHANG | os.WNOWAIT)
    except (ChildProcessError, ProcessLookupError, PermissionError):
        child_state = None
    if child_state is not None and members == [pgid] and not escaped:
        return [], identities
    verified = []
    for pid in members:
        expected = identities.get(pid)
        if expected is not None and process_start_identity(pid) == expected:
            verified.append(pid)
    if pgid in members and pgid not in verified:
        try:
            live_child = os.waitid(os.P_PID, pgid, os.WEXITED | os.WNOHANG | os.WNOWAIT)
            if live_child is None and os.getpgid(pgid) == pgid:
                verified.append(pgid)
        except (ChildProcessError, ProcessLookupError, PermissionError):
            pass
    if members and not verified:
        raise ManifestError(
            "process-identity-unverifiable",
            "owned process identities cannot be matched safely",
            "owner-required",
            4,
        )
    if verified:
        try:
            os.killpg(pgid, signal_number)
        except ProcessLookupError:
            pass
    if escaped:
        raise ManifestError("process-group-escaped", "a command descendant escaped its owned process group", "owner-required", 4)
    return members, identities


def terminate_owned_group(
    pgid: int,
    known_identities: dict[int, str],
    policy: dict[str, int],
) -> tuple[dict[str, Any], dict[int, str]]:
    term_at = utc_timestamp()
    try:
        _, identities = signal_owned_group(pgid, known_identities, signal.SIGTERM)
    except ManifestError as exc:
        return {
            "term_sent_at": None,
            "kill_sent_at": None,
            "verified_at": None,
            "remaining_pids": sorted(known_identities),
            "error_code": exc.code,
        }, known_identities
    term_deadline = time.monotonic() + policy["term_grace_seconds"]
    remaining: list[int] = []
    escaped: list[int] = []
    while time.monotonic() < term_deadline:
        remaining, escaped, identities = owned_processes(pgid, pgid, identities)
        if escaped or not remaining:
            break
        time.sleep(0.05)
    kill_at = None
    if remaining and not escaped:
        kill_at = utc_timestamp()
        try:
            _, identities = signal_owned_group(pgid, identities, signal.SIGKILL)
        except ManifestError as exc:
            return {
                "term_sent_at": term_at,
                "kill_sent_at": None,
                "verified_at": None,
                "remaining_pids": remaining,
                "error_code": exc.code,
            }, identities
    cleanup_deadline = time.monotonic() + policy["cleanup_seconds"]
    while time.monotonic() < cleanup_deadline:
        remaining, escaped, identities = owned_processes(pgid, pgid, identities)
        if escaped or not remaining:
            break
        time.sleep(0.05)
    error_code = "process-group-escaped" if escaped else ("cleanup-incomplete" if remaining else None)
    return {
        "term_sent_at": term_at,
        "kill_sent_at": kill_at,
        "verified_at": utc_timestamp() if error_code is None else None,
        "remaining_pids": sorted(set(remaining + escaped)),
        "error_code": error_code,
    }, identities


def run_manifest(
    manifest: dict[str, Any],
    receipt_path: str,
    *,
    phase_hook: Callable[[str, dict[str, Any]], None] | None = None,
) -> tuple[dict[str, Any], int]:
    manifest = validate_manifest(manifest)
    for dependency in manifest["dependencies"]:
        verify_file_record(dependency, tool=False)
    for tool in manifest["tools"]:
        verify_file_record(tool, tool=True)
    cwd = Path(manifest["cwd"])
    if not cwd.is_dir():
        raise ManifestError("command-cwd-invalid", "manifest cwd is unavailable", "restore-managed-checkout", 3)
    git_tools = [tool for tool in manifest["tools"] if tool["tool_id"] == "git"]
    if len(git_tools) != 1:
        raise ManifestError("manifest-schema-invalid", "command manifest requires one pinned git tool", "prepare-command-again")
    git_path = git_tools[0]["resolved_path"]
    before = tracked_snapshot(cwd, git_path)
    baseline_before = None
    if manifest["operation"] == "baseline-validation":
        baseline_before = checkout_identity(cwd, git_path, require_clean=True)
        if baseline_before != manifest["baseline"]["checkout_identity"]:
            raise ManifestError("manifest-stale", "baseline checkout changed before execution", "authorization-stale", 4)
    receipt = absolute_path(receipt_path, "receipt")
    receipt.parent.mkdir(parents=True, exist_ok=True)
    stdout_path = receipt.with_suffix(receipt.suffix + ".stdout")
    stderr_path = receipt.with_suffix(receipt.suffix + ".stderr")
    environment = os.environ.copy()
    pinned_directories = list(dict.fromkeys(str(Path(tool["resolved_path"]).parent) for tool in manifest["tools"]))
    environment["PATH"] = os.pathsep.join(pinned_directories + [environment.get("PATH", "")])
    policy = manifest["execution_policy"]
    attempt_path = receipt.with_suffix(receipt.suffix + ".attempt.jsonl")
    lease_path = receipt.with_suffix(receipt.suffix + ".lease.json")
    cancel_path = receipt.with_suffix(receipt.suffix + ".cancel.json")
    attempt_id = secrets.token_hex(16)
    controller_session_id = secrets.token_hex(16)
    boot_id = boot_identity()
    start_utc = datetime.now(timezone.utc)
    deadline_utc = start_utc + timedelta(seconds=policy["timeout_seconds"])
    start_monotonic = time.monotonic()
    deadline_monotonic = start_monotonic + policy["timeout_seconds"]
    common = {
        "schema_version": SCHEMA_VERSION,
        "attempt_id": attempt_id,
        "manifest_sha256": manifest["manifest_sha256"],
        "command_id": manifest["command_id"],
        "controller_session_id": controller_session_id,
        "boot_identity": boot_id,
    }
    append_attempt(
        attempt_path,
        {
            **common,
            "transition": "prepared",
            "observed_at": utc_timestamp(),
            "started_at": start_utc.isoformat().replace("+00:00", "Z"),
            "deadline_at": deadline_utc.isoformat().replace("+00:00", "Z"),
            "execution_policy": policy,
        },
        create=True,
    )
    output_files = {
        "stdout": exclusive_output(stdout_path),
        "stderr": exclusive_output(stderr_path),
    }
    stdout_read, stdout_write = os.pipe()
    stderr_read, stderr_write = os.pipe()
    os.set_blocking(stdout_read, False)
    os.set_blocking(stderr_read, False)
    pid, pgid, release_write = launch_gated(manifest, environment, stdout_write, stderr_write)
    os.close(stdout_write)
    os.close(stderr_write)
    start_identity = process_start_identity(pid)
    if start_identity is None:
        os.close(release_write)
        raise ManifestError("process-identity-unverifiable", "launcher identity cannot be recorded", "owner-required", 4)
    process = {
        "pid": pid,
        "pgid": pgid,
        "process_start_identity": start_identity,
    }
    append_attempt(
        attempt_path,
        {**common, "transition": "launcher-bound", "observed_at": utc_timestamp(), "process": process},
    )
    try:
        if phase_hook is not None:
            phase_hook("launcher-bound", {**common, "process": process})
        append_attempt(
            attempt_path,
            {**common, "transition": "launch-authorized", "observed_at": utc_timestamp(), "process": process},
        )
        if phase_hook is not None:
            phase_hook("launch-authorized", {**common, "process": process})
    except BaseException:
        os.close(release_write)
        os.close(stdout_read)
        os.close(stderr_read)
        os.waitpid(pid, 0)
        for file in output_files.values():
            file.close()
        append_attempt(
            attempt_path,
            {**common, "transition": "interrupted-before-release", "observed_at": utc_timestamp(), "process": process},
        )
        raise
    os.write(release_write, b"1")
    os.close(release_write)
    append_attempt(
        attempt_path,
        {**common, "transition": "launch-released", "observed_at": utc_timestamp(), "process": process},
    )
    try:
        if phase_hook is not None:
            phase_hook("launch-released", {**common, "process": process})
    except BaseException:
        os.close(stdout_read)
        os.close(stderr_read)
        for file in output_files.values():
            file.close()
        raise

    selector = selectors.DefaultSelector()
    selector.register(stdout_read, selectors.EVENT_READ, ("stdout", stdout_path))
    selector.register(stderr_read, selectors.EVENT_READ, ("stderr", stderr_path))
    streams = {
        "stdout": {"observed_bytes": 0, "stored_bytes": 0, "digest": hashlib.sha256(), "truncated": False},
        "stderr": {"observed_bytes": 0, "stored_bytes": 0, "digest": hashlib.sha256(), "truncated": False},
    }
    known_identities = {pid: start_identity}
    exit_code: int | None = None
    exit_signal: int | None = None
    requested_status: str | None = None
    cleanup = {
        "term_sent_at": None,
        "kill_sent_at": None,
        "verified_at": None,
        "remaining_pids": [],
        "error_code": None,
    }
    last_heartbeat = start_monotonic
    try:
        while True:
            if cancel_path.is_file():
                cancellation = read_json(str(cancel_path), "cancellation authorization")
                exact_object(
                    cancellation,
                    {"schema_version", "attempt_id", "manifest_sha256", "reason", "authorization_fingerprint"},
                    "cancellation authorization",
                )
                if (
                    cancellation["schema_version"] != SCHEMA_VERSION
                    or cancellation["attempt_id"] != attempt_id
                    or cancellation["manifest_sha256"] != manifest["manifest_sha256"]
                    or cancellation["reason"] not in {"root-authorized", "claim-lost", "root-monitor-degraded"}
                    or not isinstance(cancellation["authorization_fingerprint"], str)
                    or not HEX64_RE.fullmatch(cancellation["authorization_fingerprint"])
                ):
                    raise ManifestError("cancellation-unauthorized", "cancellation authorization is invalid", "owner-required", 4)
                requested_status = "cancelled"
                append_attempt(
                    attempt_path,
                    {**common, "transition": "cancellation-committed", "observed_at": utc_timestamp(), "reason": cancellation["reason"], "process": process},
                )
                break
            waited_pid, wait_status = os.waitpid(pid, os.WNOHANG)
            if waited_pid == pid:
                if os.WIFEXITED(wait_status):
                    exit_code = os.WEXITSTATUS(wait_status)
                elif os.WIFSIGNALED(wait_status):
                    exit_signal = os.WTERMSIG(wait_status)
                    exit_code = -exit_signal
                break
            now = time.monotonic()
            if now >= deadline_monotonic:
                requested_status = "timed-out"
                append_attempt(
                    attempt_path,
                    {**common, "transition": "timeout-committed", "observed_at": utc_timestamp(), "process": process},
                )
                break
            for key, _ in selector.select(timeout=0.05):
                stream_name, _ = key.data
                try:
                    chunk = os.read(key.fd, 65536)
                except BlockingIOError:
                    continue
                if not chunk:
                    selector.unregister(key.fd)
                    os.close(key.fd)
                    continue
                row = streams[stream_name]
                row["observed_bytes"] += len(chunk)
                row["digest"].update(chunk)
                limit = policy[f"{stream_name}_limit_bytes"]
                remaining = max(0, limit - row["stored_bytes"])
                if remaining:
                    stored = chunk[:remaining]
                    output_files[stream_name].write(stored)
                    row["stored_bytes"] += len(stored)
                if row["observed_bytes"] > limit:
                    row["truncated"] = True
                    requested_status = "output-limit"
                    append_attempt(
                        attempt_path,
                        {**common, "transition": "output-limit-committed", "observed_at": utc_timestamp(), "stream": stream_name, "process": process},
                    )
                    break
            if requested_status is not None:
                break
            if now - last_heartbeat >= policy["heartbeat_seconds"]:
                members, escaped, known_identities = owned_processes(pid, pgid, known_identities)
                lease = {
                    **common,
                    "state": "running",
                    "heartbeat_at": utc_timestamp(),
                    "started_at": start_utc.isoformat().replace("+00:00", "Z"),
                    "deadline_at": deadline_utc.isoformat().replace("+00:00", "Z"),
                    "process": process,
                    "group_members": members,
                    "escaped_descendants": escaped,
                    "stdout_observed_bytes": streams["stdout"]["observed_bytes"],
                    "stderr_observed_bytes": streams["stderr"]["observed_bytes"],
                }
                write_lease(lease_path, lease)
                if escaped:
                    requested_status = "cleanup-failed"
                    append_attempt(
                        attempt_path,
                        {**common, "transition": "process-group-escape-observed", "observed_at": utc_timestamp(), "escaped_pids": escaped, "process": process},
                    )
                    break
                last_heartbeat = now
        if requested_status is not None:
            cleanup, known_identities = terminate_owned_group(pgid, known_identities, policy)
            if cleanup["error_code"] is not None:
                requested_status = "cleanup-failed"
            try:
                waited_pid, wait_status = os.waitpid(pid, 0)
            except ChildProcessError:
                waited_pid = 0
            if waited_pid == pid:
                if os.WIFEXITED(wait_status):
                    exit_code = os.WEXITSTATUS(wait_status)
                elif os.WIFSIGNALED(wait_status):
                    exit_signal = os.WTERMSIG(wait_status)
                    exit_code = -exit_signal
        drain_deadline = time.monotonic() + 1
        while selector.get_map() and time.monotonic() < drain_deadline:
            events = selector.select(timeout=0.05)
            if not events:
                continue
            for key, _ in events:
                stream_name, _ = key.data
                try:
                    chunk = os.read(key.fd, 65536)
                except BlockingIOError:
                    continue
                if not chunk:
                    selector.unregister(key.fd)
                    os.close(key.fd)
                    continue
                row = streams[stream_name]
                row["observed_bytes"] += len(chunk)
                row["digest"].update(chunk)
                limit = policy[f"{stream_name}_limit_bytes"]
                remaining = max(0, limit - row["stored_bytes"])
                if remaining:
                    stored = chunk[:remaining]
                    output_files[stream_name].write(stored)
                    row["stored_bytes"] += len(stored)
                if row["observed_bytes"] > limit:
                    row["truncated"] = True
                    requested_status = "output-limit"
    finally:
        for file in output_files.values():
            file.flush()
            os.fsync(file.fileno())
            file.close()
        for key in list(selector.get_map().values()):
            try:
                selector.unregister(key.fd)
                os.close(key.fd)
            except OSError:
                pass
        selector.close()
    output_directory = os.open(receipt.parent, os.O_RDONLY)
    try:
        os.fsync(output_directory)
    finally:
        os.close(output_directory)

    for stream_name, row in streams.items():
        row["sha256"] = row.pop("digest").hexdigest()
    status = requested_status or ("passed" if exit_code in manifest["expected_exit_codes"] else "failed")
    after = tracked_snapshot(cwd, git_path)
    changed = sorted(path for path in set(before) | set(after) if before.get(path) != after.get(path))
    unexpected = [path for path in changed if not path_allowed(path, manifest["write_set"]["allowed_paths"])]
    missing = [path for path in manifest["write_set"]["expected_paths"] if not (cwd / path).exists()]
    output_records: list[dict[str, Any]] = []
    missing_outputs: list[str] = []
    for raw in manifest["outputs"]:
        path = Path(raw)
        if path.is_file() and not path.is_symlink():
            output_records.append(file_record(path, source_kind="command-output", source_ref=path.name))
        else:
            missing_outputs.append(raw)
    if status == "passed" and (unexpected or missing or missing_outputs):
        status = "failed"
    baseline_observation = None
    if manifest["operation"] == "baseline-validation":
        baseline_after = checkout_identity(cwd, git_path, require_clean=True)
        if before != after or baseline_before != baseline_after:
            status = "failed"
        adapter = manifest["baseline"]["adapter"]
        if status in {"timed-out", "cancelled", "output-limit", "interrupted", "cleanup-failed"}:
            diagnostics = []
            outcome = "planning-required"
        elif adapter == "prettier-check-v1":
            diagnostics = prettier_diagnostics(cwd, stdout_path.read_bytes(), stderr_path.read_bytes(), exit_code or 0)
            outcome = "clean" if not diagnostics else "unchanged-debt-candidate"
        else:
            diagnostics = []
            outcome = "clean" if exit_code == 0 else "planning-required"
        baseline_observation = {
            "adapter": adapter,
            "policy": manifest["baseline"]["policy"],
            "execution_scope_fingerprint": manifest["baseline"]["execution_scope_fingerprint"],
            "authored_argv_fingerprint": manifest["baseline"]["authored_argv_fingerprint"],
            "argv_fingerprint": manifest["argv_fingerprint"],
            "checkout_identity": baseline_after,
            "tool_identities_fingerprint": fingerprint(manifest["tools"]),
            "result": outcome,
            "diagnostics": diagnostics,
            "diagnostic_set_fingerprint": fingerprint(diagnostics),
        }
    value: dict[str, Any] = {
        "schema_version": SCHEMA_VERSION,
        "manifest_sha256": manifest["manifest_sha256"],
        "command_id": manifest["command_id"],
        "gate_fingerprint": manifest["gate_fingerprint"],
        "status": status,
        "exit_code": exit_code,
        "exit_signal": exit_signal,
        "attempt": {
            "attempt_id": attempt_id,
            "attempt_file": str(attempt_path),
            "lease_file": str(lease_path),
            "controller_session_id": controller_session_id,
            "boot_identity": boot_id,
            "started_at": start_utc.isoformat().replace("+00:00", "Z"),
            "deadline_at": deadline_utc.isoformat().replace("+00:00", "Z"),
            "completed_at": utc_timestamp(),
            "process": process,
            "cleanup": cleanup,
        },
        "output_capture": {
            name: {
                "limit_bytes": policy[f"{name}_limit_bytes"],
                "observed_bytes": row["observed_bytes"],
                "stored_bytes": row["stored_bytes"],
                "observed_sha256": row["sha256"],
                "truncated": row["truncated"],
            }
            for name, row in streams.items()
        },
        "cwd_observed": str(cwd.resolve()),
        "argv_fingerprint": fingerprint({"cwd": str(cwd), "argv": manifest["argv"]}),
        "tools": [{"tool_id": row["tool_id"], "resolved_path": row["resolved_path"], "sha256": row["sha256"], "version": row["version"]} for row in manifest["tools"]],
        "stdout": file_record(stdout_path, source_kind="command-output", source_ref="stdout"),
        "stderr": file_record(stderr_path, source_kind="command-output", source_ref="stderr"),
        "writes": {"changed_paths": changed, "unexpected_paths": unexpected, "missing_expected_paths": missing, "missing_outputs": missing_outputs},
        "outputs": output_records,
        "baseline_observation": baseline_observation,
        "prior_receipt_sha256": None,
    }
    append_attempt(
        attempt_path,
        {
            **common,
            "transition": "terminal-observed",
            "observed_at": utc_timestamp(),
            "status": status,
            "exit_code": exit_code,
            "exit_signal": exit_signal,
            "cleanup": cleanup,
            "output_capture": value["output_capture"],
        },
    )
    write_lease(
        lease_path,
        {
            **common,
            "state": status,
            "heartbeat_at": utc_timestamp(),
            "deadline_at": deadline_utc.isoformat().replace("+00:00", "Z"),
            "process": process,
            "cleanup": cleanup,
        },
    )
    value["receipt_sha256"] = fingerprint(value)
    write_json(receipt_path, value)
    return value, 0 if status == "passed" else 4


def validate_receipt(receipt: dict[str, Any], manifest: dict[str, Any]) -> dict[str, Any]:
    manifest = validate_manifest(manifest)
    fields = {
        "schema_version", "manifest_sha256", "command_id", "gate_fingerprint", "status", "exit_code",
        "exit_signal", "attempt", "output_capture",
        "cwd_observed", "argv_fingerprint", "tools", "stdout", "stderr", "writes", "outputs",
        "baseline_observation", "prior_receipt_sha256", "receipt_sha256",
    }
    exact_object(receipt, fields, "receipt")
    if receipt["schema_version"] != SCHEMA_VERSION or receipt["receipt_sha256"] != fingerprint({key: item for key, item in receipt.items() if key != "receipt_sha256"}):
        raise ManifestError("receipt-invalid", "receipt fingerprint is invalid", "run-command-again")
    if receipt["manifest_sha256"] != manifest["manifest_sha256"] or receipt["command_id"] != manifest["command_id"] or receipt["gate_fingerprint"] != manifest["gate_fingerprint"]:
        raise ManifestError("receipt-invalid", "receipt is bound to another command manifest", "run-command-again")
    if receipt["status"] not in TERMINAL_STATUSES:
        raise ManifestError("receipt-invalid", "receipt status is invalid", "run-command-again")
    if receipt["exit_code"] is not None and (
        not isinstance(receipt["exit_code"], int) or isinstance(receipt["exit_code"], bool)
    ):
        raise ManifestError("receipt-invalid", "receipt exit code is invalid", "run-command-again")
    if receipt["exit_signal"] is not None and (
        not isinstance(receipt["exit_signal"], int) or isinstance(receipt["exit_signal"], bool)
    ):
        raise ManifestError("receipt-invalid", "receipt exit signal is invalid", "run-command-again")
    attempt = exact_object(
        receipt["attempt"],
        {
            "attempt_id", "attempt_file", "lease_file", "controller_session_id",
            "boot_identity", "started_at", "deadline_at", "completed_at", "process", "cleanup",
        },
        "receipt attempt",
    )
    for field in ("attempt_id", "controller_session_id"):
        if not isinstance(attempt[field], str) or not re.fullmatch(r"[0-9a-f]{32}", attempt[field]):
            raise ManifestError("receipt-invalid", f"receipt {field} is invalid", "owner-required")
    for field in ("attempt_file", "lease_file"):
        absolute_path(attempt[field], f"receipt {field}", existing=True)
    nonempty(attempt["boot_identity"], "receipt boot identity")
    for field in ("started_at", "deadline_at", "completed_at"):
        try:
            parse_timestamp(attempt[field])
        except (TypeError, ValueError) as exc:
            raise ManifestError("receipt-invalid", f"receipt {field} is invalid", "owner-required") from exc
    process = exact_object(
        attempt["process"],
        {"pid", "pgid", "process_start_identity"},
        "receipt process",
    )
    if any(not isinstance(process[field], int) or process[field] <= 0 for field in ("pid", "pgid")):
        raise ManifestError("receipt-invalid", "receipt process identity is invalid", "owner-required")
    if not isinstance(process["process_start_identity"], str) or not HEX64_RE.fullmatch(process["process_start_identity"]):
        raise ManifestError("receipt-invalid", "receipt process start identity is invalid", "owner-required")
    cleanup = exact_object(
        attempt["cleanup"],
        {"term_sent_at", "kill_sent_at", "verified_at", "remaining_pids", "error_code"},
        "receipt cleanup",
    )
    if not isinstance(cleanup["remaining_pids"], list) or any(not isinstance(pid, int) or pid <= 0 for pid in cleanup["remaining_pids"]):
        raise ManifestError("receipt-invalid", "receipt cleanup pids are invalid", "owner-required")
    captures = exact_object(receipt["output_capture"], {"stdout", "stderr"}, "receipt output_capture")
    for name in ("stdout", "stderr"):
        capture = exact_object(
            captures[name],
            {"limit_bytes", "observed_bytes", "stored_bytes", "observed_sha256", "truncated"},
            f"receipt output_capture.{name}",
        )
        if capture["limit_bytes"] != manifest["execution_policy"][f"{name}_limit_bytes"]:
            raise ManifestError("receipt-invalid", "receipt output limit differs from manifest", "owner-required")
        if any(not isinstance(capture[field], int) or capture[field] < 0 for field in ("observed_bytes", "stored_bytes")):
            raise ManifestError("receipt-invalid", "receipt output byte counts are invalid", "owner-required")
        if capture["stored_bytes"] > capture["limit_bytes"] or capture["observed_bytes"] < capture["stored_bytes"]:
            raise ManifestError("receipt-invalid", "receipt output byte counts conflict", "owner-required")
        if not isinstance(capture["observed_sha256"], str) or not HEX64_RE.fullmatch(capture["observed_sha256"]):
            raise ManifestError("receipt-invalid", "receipt output digest is invalid", "owner-required")
        if not isinstance(capture["truncated"], bool) or capture["truncated"] != (capture["observed_bytes"] > capture["limit_bytes"]):
            raise ManifestError("receipt-invalid", "receipt output truncation evidence conflicts", "owner-required")
    absolute_path(receipt["cwd_observed"], "receipt cwd")
    if receipt["argv_fingerprint"] != manifest["argv_fingerprint"]:
        raise ManifestError("receipt-invalid", "receipt argv does not match", "run-command-again")
    if receipt["prior_receipt_sha256"] is not None and (
        not isinstance(receipt["prior_receipt_sha256"], str)
        or not HEX64_RE.fullmatch(receipt["prior_receipt_sha256"])
    ):
        raise ManifestError("receipt-invalid", "prior receipt hash is invalid", "run-command-again")
    baseline_observation = receipt["baseline_observation"]
    if manifest["operation"] == "baseline-validation":
        item = exact_object(
            baseline_observation,
            {
                "adapter", "policy", "execution_scope_fingerprint", "authored_argv_fingerprint",
                "argv_fingerprint", "checkout_identity", "tool_identities_fingerprint", "result",
                "diagnostics", "diagnostic_set_fingerprint",
            },
            "receipt baseline observation",
        )
        if item["adapter"] != manifest["baseline"]["adapter"] or item["policy"] != manifest["baseline"]["policy"]:
            raise ManifestError("receipt-invalid", "baseline observation differs from manifest", "run-command-again")
        if item["execution_scope_fingerprint"] != manifest["baseline"]["execution_scope_fingerprint"]:
            raise ManifestError("receipt-invalid", "baseline scope differs from manifest", "run-command-again")
        validate_checkout_identity(item["checkout_identity"], "receipt baseline checkout")
        if item["result"] not in {"clean", "unchanged-debt-candidate", "planning-required"}:
            raise ManifestError("receipt-invalid", "baseline result is invalid", "run-command-again")
        if not isinstance(item["diagnostics"], list) or item["diagnostics"] != sorted(item["diagnostics"], key=lambda row: row.get("path", "")):
            raise ManifestError("receipt-invalid", "baseline diagnostics are not canonical", "run-command-again")
        if item["diagnostic_set_fingerprint"] != fingerprint(item["diagnostics"]):
            raise ManifestError("receipt-invalid", "baseline diagnostic fingerprint changed", "run-command-again")
    elif baseline_observation is not None:
        raise ManifestError("receipt-invalid", "non-baseline receipt has baseline observation", "run-command-again")
    if not isinstance(receipt["tools"], list) or len(receipt["tools"]) != len(manifest["tools"]):
        raise ManifestError("receipt-invalid", "receipt tool observations are invalid", "run-command-again")
    observed_tools = []
    for index, tool in enumerate(receipt["tools"]):
        observed = exact_object(tool, {"tool_id", "resolved_path", "sha256", "version"}, f"receipt tools[{index}]")
        expected = manifest["tools"][index]
        if observed != {key: expected[key] for key in ("tool_id", "resolved_path", "sha256", "version")}:
            raise ManifestError("receipt-invalid", "receipt tool observation does not match", "run-command-again")
        observed_tools.append(observed)
    for dependency in manifest["dependencies"]:
        verify_file_record(dependency, tool=False)
    for tool in manifest["tools"]:
        verify_file_record(tool, tool=True)
    for field in ("stdout", "stderr"):
        validate_file_record(receipt[field], f"receipt {field}", tool=False)
        verify_file_record(receipt[field], tool=False)
    writes = exact_object(
        receipt["writes"],
        {"changed_paths", "unexpected_paths", "missing_expected_paths", "missing_outputs"},
        "receipt writes",
    )
    for field in ("changed_paths", "unexpected_paths", "missing_expected_paths"):
        if validate_relative_paths(writes[field], f"receipt writes.{field}") != writes[field]:
            raise ManifestError("receipt-invalid", f"receipt {field} is not canonical", "run-command-again")
    if not isinstance(writes["missing_outputs"], list) or any(not isinstance(path, str) for path in writes["missing_outputs"]):
        raise ManifestError("receipt-invalid", "receipt missing outputs are invalid", "run-command-again")
    if not isinstance(receipt["outputs"], list):
        raise ManifestError("receipt-invalid", "receipt outputs are invalid", "run-command-again")
    for output in receipt["outputs"]:
        validate_file_record(output, "receipt output", tool=False)
        verify_file_record(output, tool=False)
    return receipt


def refresh_tools(manifest: dict[str, Any]) -> dict[str, Any]:
    refreshed = json.loads(json.dumps(validate_manifest(manifest)))
    replacements: dict[str, str] = {}
    for index, tool in enumerate(refreshed["tools"]):
        if tool["source_kind"] == "path-command":
            path, kind, ref = resolve_executable(tool["source_ref"], Path(refreshed["cwd"]))
        elif tool["source_kind"] == "skill-shipped":
            if tool["source_ref"] == "implement-feature:scripts/delivery-preflight":
                path = Path(__file__).resolve().with_name("delivery-preflight")
            elif tool["source_ref"] == "autoreview:scripts/autoreview":
                path = Path(__file__).resolve().parents[2] / "autoreview/scripts/autoreview"
            else:
                raise ManifestError("tool-source-untrusted", "skill tool source is unknown", "prepare-command-again", 3)
            kind, ref = tool["source_kind"], tool["source_ref"]
        else:
            path, kind, ref = Path(tool["resolved_path"]), tool["source_kind"], tool["source_ref"]
        candidate = tool_record(tool["tool_id"], path, kind, ref)
        if candidate["sha256"] != tool["sha256"] or candidate["version"] != tool["version"] or candidate["source_ref"] != tool["source_ref"]:
            raise ManifestError("unpinned-substitution-rejected", f"tool identity changed: {tool['tool_id']}", "prepare-new-reviewed-run", 3)
        replacements[tool["resolved_path"]] = candidate["resolved_path"]
        refreshed["tools"][index] = candidate
    refreshed["argv"] = [replacements.get(token, token) for token in refreshed["argv"]]
    refreshed["argv_fingerprint"] = fingerprint({"cwd": refreshed["cwd"], "argv": refreshed["argv"]})
    refreshed["gate_fingerprint"] = gate_fingerprint(refreshed)
    refreshed["manifest_sha256"] = manifest_fingerprint(refreshed)
    return refreshed


def reuse_receipt(manifest: dict[str, Any], prior: dict[str, Any]) -> dict[str, Any]:
    if manifest["operation"] == "baseline-validation":
        raise ManifestError("gate-evidence-stale", "baseline receipts are immutable and cannot be recaptured or reused", "authorization-stale", 4)
    validate_receipt(prior, manifest)
    if prior["status"] not in {"passed", "reused"}:
        raise ManifestError("gate-evidence-stale", "prior receipt does not cover this command", "run-command-again")
    value = json.loads(json.dumps(prior))
    value.update(
        {
            "manifest_sha256": manifest["manifest_sha256"],
            "command_id": manifest["command_id"],
            "gate_fingerprint": manifest["gate_fingerprint"],
            "status": "reused",
            "prior_receipt_sha256": prior["receipt_sha256"],
        }
    )
    value["receipt_sha256"] = fingerprint({key: item for key, item in value.items() if key != "receipt_sha256"})
    return value


def read_attempt(path_value: str, manifest: dict[str, Any]) -> list[dict[str, Any]]:
    path = absolute_path(path_value, "attempt file", existing=True)
    if path.stat().st_size > MAX_PACKET_BYTES:
        raise ManifestError("attempt-invalid", "attempt journal exceeds 1 MiB", "owner-required", 4)
    events: list[dict[str, Any]] = []
    try:
        for line in path.read_text().splitlines():
            value = json.loads(line)
            if (
                not isinstance(value, dict)
                or value.get("schema_version") != SCHEMA_VERSION
                or value.get("manifest_sha256") != manifest["manifest_sha256"]
                or value.get("command_id") != manifest["command_id"]
            ):
                raise ManifestError("attempt-invalid", "attempt journal identity is invalid", "owner-required", 4)
            events.append(value)
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise ManifestError("attempt-invalid", "attempt journal is unreadable", "owner-required", 4) from exc
    if not events or events[0].get("transition") != "prepared":
        raise ManifestError("attempt-invalid", "attempt journal lacks its durable reservation", "owner-required", 4)
    attempt_id = events[0].get("attempt_id")
    if any(event.get("attempt_id") != attempt_id for event in events):
        raise ManifestError("attempt-invalid", "attempt journal changes identity", "owner-required", 4)
    return events


def attempt_status(manifest: dict[str, Any], attempt_path: str) -> dict[str, Any]:
    events = read_attempt(attempt_path, validate_manifest(manifest))
    transitions = [event.get("transition") for event in events]
    released = "launch-authorized" in transitions
    terminal = next((event for event in reversed(events) if event.get("transition") == "terminal-observed"), None)
    return {
        "ok": True,
        "command": "command-status",
        "version": __version__,
        "attempt_id": events[0]["attempt_id"],
        "manifest_sha256": manifest["manifest_sha256"],
        "launch_may_have_occurred": released,
        "relaunch_allowed": False,
        "terminal": terminal is not None,
        "status": terminal.get("status") if terminal else "interrupted",
        "last_transition": transitions[-1],
        "attempt_fingerprint": fingerprint(events),
    }


def recover_attempt(manifest: dict[str, Any], attempt_path: str) -> dict[str, Any]:
    manifest = validate_manifest(manifest)
    path = absolute_path(attempt_path, "attempt file", existing=True)
    events = read_attempt(str(path), manifest)
    existing_terminal = next(
        (event for event in reversed(events) if event.get("transition") == "terminal-observed"),
        None,
    )
    if existing_terminal is not None:
        return attempt_status(manifest, str(path))
    process = next(
        (event.get("process") for event in reversed(events) if isinstance(event.get("process"), dict)),
        None,
    )
    prepared = events[0]
    common = {
        "schema_version": SCHEMA_VERSION,
        "attempt_id": prepared["attempt_id"],
        "manifest_sha256": manifest["manifest_sha256"],
        "command_id": manifest["command_id"],
        "controller_session_id": prepared["controller_session_id"],
        "boot_identity": prepared["boot_identity"],
    }
    cleanup = {
        "term_sent_at": None,
        "kill_sent_at": None,
        "verified_at": utc_timestamp(),
        "remaining_pids": [],
        "error_code": None,
    }
    if process is not None:
        cleanup, _ = terminate_owned_group(
            process["pgid"],
            {process["pid"]: process["process_start_identity"]},
            manifest["execution_policy"],
        )
    cancel_path = Path(str(path).removesuffix(".attempt.jsonl") + ".cancel.json")
    if cleanup["error_code"] is not None:
        status = "cleanup-failed"
    elif cancel_path.is_file():
        status = "cancelled"
    else:
        try:
            expired = datetime.now(timezone.utc) >= parse_timestamp(prepared["deadline_at"])
        except (KeyError, TypeError, ValueError):
            expired = False
        status = "timed-out" if expired else "interrupted"
    terminal = {
        **common,
        "transition": "terminal-observed",
        "observed_at": utc_timestamp(),
        "status": status,
        "exit_code": None,
        "exit_signal": None,
        "cleanup": cleanup,
        "output_capture": None,
        "recovered": True,
    }
    append_attempt(path, terminal)
    return {
        "ok": cleanup["error_code"] is None,
        "command": "command-recover",
        "version": __version__,
        "attempt_id": prepared["attempt_id"],
        "status": status,
        "cleanup": cleanup,
        "attempt_fingerprint": fingerprint(events + [terminal]),
        "relaunch_allowed": False,
    }


def authorize_cancellation(
    manifest: dict[str, Any],
    attempt_path: str,
    receipt_path: str,
    ledger_path: str,
    reason: str,
    authorization_fingerprint: str,
) -> dict[str, Any]:
    events = read_attempt(attempt_path, validate_manifest(manifest))
    if reason not in {"root-authorized", "claim-lost", "root-monitor-degraded"}:
        raise ManifestError("cancellation-unauthorized", "cancellation reason is invalid", "owner-required", 4)
    if not HEX64_RE.fullmatch(authorization_fingerprint):
        raise ManifestError("cancellation-unauthorized", "cancellation fingerprint is invalid", "owner-required", 4)
    ledger = read_json(ledger_path, "cancellation ledger")
    if ledger.get("schema_version") != "14.0.0" or ledger.get("content_fingerprint") != authorization_fingerprint:
        raise ManifestError("cancellation-unauthorized", "cancellation ledger identity is stale", "owner-required", 4)
    authorities = [
        command
        for task in ledger.get("tasks", []) if isinstance(task, dict)
        for delivery in task.get("deliveries", []) if isinstance(delivery, dict)
        for command in delivery.get("command_attempts", []) if isinstance(command, dict)
        if command.get("attempt_id") == events[0]["attempt_id"]
        and command.get("manifest_sha256") == manifest["manifest_sha256"]
        and command.get("state") == "cancellation-authorized"
        and command.get("cancellation_reason") == reason
    ]
    if len(authorities) != 1:
        raise ManifestError("cancellation-unauthorized", "ledger does not authorize this cancellation", "owner-required", 4)
    if any(event.get("transition") == "terminal-observed" for event in events):
        raise ManifestError("attempt-terminal", "terminal command cannot be cancelled", "read-terminal-receipt", 4)
    receipt = absolute_path(receipt_path, "receipt")
    cancel_path = receipt.with_suffix(receipt.suffix + ".cancel.json")
    value = {
        "schema_version": SCHEMA_VERSION,
        "attempt_id": events[0]["attempt_id"],
        "manifest_sha256": manifest["manifest_sha256"],
        "reason": reason,
        "authorization_fingerprint": authorization_fingerprint,
    }
    if cancel_path.exists():
        if read_json(str(cancel_path), "cancellation authorization") != value:
            raise ManifestError("cancellation-conflict", "cancellation authorization conflicts", "owner-required", 4)
    else:
        descriptor = os.open(cancel_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        try:
            os.write(descriptor, canonical_bytes(value) + b"\n")
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
    return {
        "ok": True,
        "command": "command-cancel",
        "version": __version__,
        "attempt_id": events[0]["attempt_id"],
        "cancellation_file": str(cancel_path),
        "reason": reason,
    }


def doctor() -> dict[str, Any]:
    return {
        "ok": True,
        "command": "doctor",
        "version": __version__,
        "offline": True,
        "operations": sorted(OPERATIONS),
        "python": sys.executable,
    }


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Prepare and execute deterministic Implement Feature command manifests.")
    parser.add_argument("--version", action="version", version=__version__)
    parser.add_argument("--json", action="store_true")
    nouns = parser.add_subparsers(dest="noun", required=True)
    nouns.add_parser("doctor", help="Check local manifest readiness without writing state.")
    bundle = nouns.add_parser("bundle", help="Template or prepare an immutable source bundle.")
    bundle_verbs = bundle.add_subparsers(dest="verb", required=True)
    bundle_template_parser = bundle_verbs.add_parser("template")
    bundle_template_parser.add_argument("--output", required=True)
    bundle_prepare = bundle_verbs.add_parser("prepare")
    bundle_prepare.add_argument("--input", required=True)
    bundle_prepare.add_argument("--output", required=True)
    command = nouns.add_parser("command", help="Template, prepare, refresh, or run a command manifest.")
    command_verbs = command.add_subparsers(dest="verb", required=True)
    command_template_parser = command_verbs.add_parser("template")
    command_template_parser.add_argument("--operation", choices=sorted(OPERATIONS), required=True)
    command_template_parser.add_argument("--output", required=True)
    command_prepare = command_verbs.add_parser("prepare")
    command_prepare.add_argument("--bundle", required=True)
    command_prepare.add_argument("--input", required=True)
    command_prepare.add_argument("--output", required=True)
    command_refresh = command_verbs.add_parser("refresh-tools")
    command_refresh.add_argument("--manifest", required=True)
    command_refresh.add_argument("--output", required=True)
    command_run = command_verbs.add_parser("run")
    command_run.add_argument("--manifest", required=True)
    command_run.add_argument("--receipt", required=True)
    command_status_parser = command_verbs.add_parser("status")
    command_status_parser.add_argument("--manifest", required=True)
    command_status_parser.add_argument("--attempt", required=True)
    command_recover = command_verbs.add_parser("recover")
    command_recover.add_argument("--manifest", required=True)
    command_recover.add_argument("--attempt", required=True)
    command_cancel = command_verbs.add_parser("cancel")
    command_cancel.add_argument("--manifest", required=True)
    command_cancel.add_argument("--attempt", required=True)
    command_cancel.add_argument("--receipt", required=True)
    command_cancel.add_argument("--ledger", required=True)
    command_cancel.add_argument("--reason", choices=["root-authorized", "claim-lost", "root-monitor-degraded"], required=True)
    command_cancel.add_argument("--authorization-fingerprint", required=True)
    receipt = nouns.add_parser("receipt", help="Verify or reuse a command receipt.")
    receipt_verbs = receipt.add_subparsers(dest="verb", required=True)
    receipt_verify = receipt_verbs.add_parser("verify")
    receipt_verify.add_argument("--manifest", required=True)
    receipt_verify.add_argument("--receipt", required=True)
    receipt_reuse = receipt_verbs.add_parser("reuse")
    receipt_reuse.add_argument("--manifest", required=True)
    receipt_reuse.add_argument("--prior-receipt", required=True)
    receipt_reuse.add_argument("--output", required=True)
    return parser


def emit(value: dict[str, Any], as_json: bool) -> None:
    rendered = canonical_bytes(value).decode("ascii") if as_json else json.dumps(value, indent=2, sort_keys=True)
    if len(rendered.encode()) > MAX_OUTPUT_BYTES:
        raise ManifestError("output-limit", "command output exceeds 128 KiB", "read-output-file", 4)
    print(rendered)


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        if args.noun == "doctor":
            result = doctor()
        elif args.noun == "bundle":
            result = bundle_template() if args.verb == "template" else prepare_bundle(read_json(args.input, "bundle input"))
            write_json(args.output, result)
            result = {"ok": True, "command": f"bundle-{args.verb}", "output": args.output, "manifest_sha256": result.get("manifest_sha256")}
        elif args.noun == "command":
            if args.verb == "template":
                value = command_template(args.operation)
            elif args.verb == "prepare":
                value = prepare_command(read_json(args.input, "command input"), read_json(args.bundle, "bundle manifest"))
            elif args.verb == "refresh-tools":
                value = refresh_tools(validate_manifest(read_json(args.manifest, "command manifest")))
            elif args.verb == "status":
                result = attempt_status(validate_manifest(read_json(args.manifest, "command manifest")), args.attempt)
                emit(result, args.json)
                return 0
            elif args.verb == "recover":
                result = recover_attempt(validate_manifest(read_json(args.manifest, "command manifest")), args.attempt)
                emit(result, args.json)
                return 0 if result["ok"] else 4
            elif args.verb == "cancel":
                result = authorize_cancellation(
                    validate_manifest(read_json(args.manifest, "command manifest")),
                    args.attempt,
                    args.receipt,
                    args.ledger,
                    args.reason,
                    args.authorization_fingerprint,
                )
                emit(result, args.json)
                return 0
            else:
                value, exit_code = run_manifest(validate_manifest(read_json(args.manifest, "command manifest")), args.receipt)
                emit(value, args.json)
                return exit_code
            write_json(args.output, value)
            result = {"ok": True, "command": f"command-{args.verb}", "output": args.output, "manifest_sha256": value.get("manifest_sha256")}
        else:
            manifest = validate_manifest(read_json(args.manifest, "command manifest"))
            if args.verb == "verify":
                value = validate_receipt(read_json(args.receipt, "receipt"), manifest)
                result = {
                    "ok": True,
                    "command": "receipt-verify",
                    "manifest_sha256": manifest["manifest_sha256"],
                    "manifest_bytes_sha256": digest(Path(args.manifest).read_bytes()),
                    "receipt_sha256": value["receipt_sha256"],
                    "receipt_bytes_sha256": digest(Path(args.receipt).read_bytes()),
                    "status": value["status"],
                    "baseline_observation": value["baseline_observation"],
                }
            else:
                value = reuse_receipt(manifest, read_json(args.prior_receipt, "prior receipt"))
                write_json(args.output, value)
                result = {"ok": True, "command": "receipt-reuse", "output": args.output, "receipt_sha256": value["receipt_sha256"]}
        emit(result, args.json)
        return 0
    except ManifestError as exc:
        error = {"ok": False, "error": {"code": exc.code, "message": exc.message, "recovery": exc.recovery}}
        emit(error, True)
        return exc.exit_code


if __name__ == "__main__":
    raise SystemExit(main())
