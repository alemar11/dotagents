#!/usr/bin/env python3
"""Coordinate overlapping active-root claims for Implement Feature runs."""

from __future__ import annotations

import argparse
import contextlib
import errno
import fcntl
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import secrets
import shutil
import stat
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Iterator

__version__ = "15.0.0"
SCHEMA_VERSION = "7.0.0"
TAKEOVER_TRANSACTION_SCHEMA_VERSION = "3.0.0"
RELEASE_RECEIPT_SCHEMA_VERSION = "2.0.0"
RELEASE_REASONS = {"terminal", "preimplementation-abort"}
LEDGER_CACHE_PATH = Path(__file__).resolve().with_name("ledger-cache")
TASK_MODEL_POLICY_PATH = (
    Path(__file__).resolve().parents[1] / "references/task-model-policy.md"
)
ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
FINGERPRINT_RE = re.compile(r"^[0-9a-f]{64}$")
TRANSACTION_ID_RE = re.compile(r"^[0-9a-f]{32}$")
REVISION_RE = re.compile(r"^[0-9a-f]{40,64}$")
GLOBAL_SOURCE_RE = re.compile(r"^[a-z][a-z0-9+.-]*://\S+$")
TAKEOVER_PERMISSION = "granted-by-authorized-user"
TAKEOVER_REASONS = {"verified-stale"}
STALE_AFTER_SECONDS = 300
HEARTBEAT_INTERVAL_SECONDS = 60
MONITOR_DEGRADED_AFTER_SECONDS = 180


class ClaimError(Exception):
    def __init__(self, code: str, message: str, exit_code: int, details: Any = None):
        super().__init__(message)
        self.code = code
        self.message = message
        self.exit_code = exit_code
        self.details = details or {}


CLAIM_STORE_UNAVAILABLE_ERRNOS = {errno.EACCES, errno.EPERM, errno.EROFS}


def unavailable_os_error(exc: BaseException) -> OSError | None:
    current: BaseException | None = exc
    seen: set[int] = set()
    while current is not None and id(current) not in seen:
        seen.add(id(current))
        if isinstance(current, OSError) and current.errno in CLAIM_STORE_UNAVAILABLE_ERRNOS:
            return current
        current = current.__cause__ or current.__context__
    return None


def classify_claim_store_error(exc: BaseException, message: str) -> ClaimError:
    unavailable = unavailable_os_error(exc)
    if unavailable is not None:
        return ClaimError(
            "claim-store-unavailable",
            message,
            4,
            {"errno": unavailable.errno},
        )
    return ClaimError("state-conflict", message, 4)


def normalize_claim_error(exc: ClaimError) -> ClaimError:
    if (
        exc.code in {"state-conflict", "takeover-pending"}
        and unavailable_os_error(exc) is not None
    ):
        return classify_claim_store_error(exc, "claim store is unavailable to this runtime")
    return exc


def claim_root() -> Path:
    return Path.home() / ".cache/dotagents/skills/implement-feature/claims"


def ledger_root() -> Path:
    return claim_root().parent / "ledgers"


def timestamp() -> str:
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def open_regular_read_descriptor(path: Path) -> tuple[int, os.stat_result]:
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    flags |= getattr(os, "O_NONBLOCK", 0)
    descriptor = os.open(path, flags)
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode):
            raise OSError(f"not a regular file: {path}")
    except BaseException:
        os.close(descriptor)
        raise
    return descriptor, metadata


def open_directory_descriptor(path: Path) -> int:
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    flags |= getattr(os, "O_DIRECTORY", 0)
    descriptor = os.open(path, flags)
    try:
        if not stat.S_ISDIR(os.fstat(descriptor).st_mode):
            raise OSError(f"not a directory: {path}")
    except BaseException:
        os.close(descriptor)
        raise
    return descriptor


def stable_file_identity(metadata: os.stat_result) -> tuple[int, ...]:
    return (
        metadata.st_dev,
        metadata.st_ino,
        metadata.st_mode,
        metadata.st_size,
        metadata.st_mtime_ns,
        metadata.st_ctime_ns,
    )


def read_stable_regular_bytes(path: Path) -> bytes:
    descriptor, before = open_regular_read_descriptor(path)
    chunks: list[bytes] = []
    size = 0
    try:
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            chunks.append(chunk)
            size += len(chunk)
        after = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    if stable_file_identity(before) != stable_file_identity(after) or size != after.st_size:
        raise OSError(f"file changed while being read: {path}")
    return b"".join(chunks)


def snapshot_stable_regular_file(path: Path) -> tuple[str, int]:
    descriptor, before = open_regular_read_descriptor(path)
    digest = hashlib.sha256()
    size = 0
    try:
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            digest.update(chunk)
            size += len(chunk)
        after = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    if stable_file_identity(before) != stable_file_identity(after) or size != after.st_size:
        raise OSError(f"file changed while being read: {path}")
    return digest.hexdigest(), size


def check_id(value: str, field: str) -> str:
    if not isinstance(value, str) or not ID_RE.fullmatch(value):
        raise ClaimError("invalid-input", f"{field} is not canonical: {value}", 2)
    return value


def canonical_repositories(values: list[str]) -> tuple[list[str], list[dict[str, str]]]:
    repositories: set[str] = set()
    checkouts: dict[str, str] = {}
    for value in values:
        try:
            path = Path(value).expanduser().resolve(strict=True)
        except FileNotFoundError as exc:
            raise ClaimError("invalid-input", f"repository does not exist: {value}", 2) from exc
        if not path.is_dir():
            raise ClaimError("invalid-input", f"repository is not a directory: {path}", 2)
        result = subprocess.run(
            ["git", "-C", str(path), "rev-parse", "--git-common-dir"],
            text=True,
            capture_output=True,
        )
        if result.returncode or not result.stdout.strip():
            raise ClaimError("invalid-input", f"repository is not a Git checkout: {path}", 2)
        common_dir = Path(result.stdout.strip())
        if not common_dir.is_absolute():
            common_dir = path / common_dir
        identity = str(common_dir.resolve(strict=True))
        repositories.add(identity)
        checkouts[str(path)] = identity
    if not repositories:
        raise ClaimError("invalid-input", "at least one repository is required", 2)
    return sorted(repositories), [
        {"checkout": checkout, "git_common_dir": checkouts[checkout]}
        for checkout in sorted(checkouts)
    ]


def canonical_sources(values: list[str]) -> list[str]:
    sources = sorted({value.strip() for value in values if isinstance(value, str) and value.strip()})
    if not sources:
        raise ClaimError("invalid-input", "at least one source id is required", 2)
    unqualified_local_refs = [
        source
        for source in sources
        if not source.startswith("git:") and not GLOBAL_SOURCE_RE.fullmatch(source)
    ]
    if unqualified_local_refs:
        raise ClaimError(
            "invalid-input",
            "repository-local source refs must be Git-identity-qualified",
            2,
            {"source_ids": unqualified_local_refs},
        )
    return sources


def lexical_absolute(path: Path) -> Path:
    return Path(os.path.abspath(os.fspath(path)))


def path_contract_error(message: str, *, persisted: bool) -> ClaimError:
    return ClaimError(
        "state-conflict" if persisted else "invalid-input",
        message,
        4 if persisted else 2,
    )


def validate_cache_directory_components(
    path: Path, *, field: str, persisted: bool
) -> Path:
    home = lexical_absolute(Path.home())
    candidate = lexical_absolute(path)
    try:
        relative = candidate.relative_to(home)
    except ValueError as exc:
        raise path_contract_error(
            f"{field} is outside the current home directory: {candidate}",
            persisted=persisted,
        ) from exc
    current = home
    for part in relative.parts:
        current /= part
        if current.is_symlink():
            raise path_contract_error(
                f"{field} contains a symlinked cache component: {current}",
                persisted=persisted,
            )
        if current.exists() and not current.is_dir():
            raise path_contract_error(
                f"{field} contains a non-directory cache component: {current}",
                persisted=persisted,
            )
    return candidate


def canonical_ledger_ref(value: str, *, persisted: bool = False) -> str:
    if not isinstance(value, str):
        raise path_contract_error(
            "ledger_ref must be an absolute direct-child JSON path",
            persisted=persisted,
        )
    path = Path(value).expanduser()
    if not path.is_absolute():
        raise path_contract_error(
            "ledger_ref must be an absolute direct-child JSON path",
            persisted=persisted,
        )
    path = lexical_absolute(path)
    root = validate_cache_directory_components(
        ledger_root(), field="ledger_ref", persisted=persisted
    )
    if path.parent != root or path.suffix != ".json" or path.name == ".json":
        raise path_contract_error(
            f"ledger_ref must be a direct-child .json file under {root}",
            persisted=persisted,
        )
    if path.is_symlink():
        raise path_contract_error(
            f"ledger_ref must not be a symlink: {path}", persisted=persisted
        )
    try:
        descriptor, _ = open_regular_read_descriptor(path)
    except FileNotFoundError:
        pass
    except OSError as exc:
        raise path_contract_error(
            f"ledger_ref is not a regular file: {path}", persisted=persisted
        ) from exc
    else:
        os.close(descriptor)
    return str(path)


def fingerprint(value: dict[str, Any]) -> str:
    payload = {
        key: value[key]
        for key in (
            "root_id",
            "acquisition_nonce",
            "repositories",
            "repository_checkouts",
            "sources",
            "ledger_ref",
        )
    }
    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(encoded).hexdigest()


def ownership_scope(value: dict[str, Any]) -> dict[str, Any]:
    return {
        key: value[key]
        for key in (
            "root_id",
            "repositories",
            "repository_checkouts",
            "sources",
            "ledger_ref",
        )
    }


def claim_path(root_id: str) -> Path:
    return claim_root() / f"{check_id(root_id, 'root_id')}.json"


def takeover_transaction_path(root_id: str) -> Path:
    return claim_root() / f"{check_id(root_id, 'root_id')}.takeover"


def release_receipt_path(root: Path, root_id: str, claim_fingerprint: str) -> Path:
    return root / "releases" / f"{check_id(root_id, 'root_id')}--{claim_fingerprint}.json"


@contextlib.contextmanager
def locked_claim_store(*, create: bool, exclusive: bool) -> Iterator[Path | None]:
    root = validate_cache_directory_components(
        claim_root(), field="claim cache", persisted=True
    )
    root_existed = root.exists()
    if not root_existed and not create:
        yield None
        return
    created_root = False
    if not root_existed:
        try:
            root.mkdir(parents=True)
            created_root = True
        except FileExistsError:
            root_existed = True
        except OSError as exc:
            raise classify_claim_store_error(
                exc, f"claim cache cannot be created: {root}"
            ) from exc
        root = validate_cache_directory_components(
            root, field="claim cache", persisted=True
        )
    lock_path = root / ".lock"
    try:
        root_descriptor = open_directory_descriptor(root)
    except OSError as exc:
        if unavailable_os_error(exc) is not None:
            raise classify_claim_store_error(
                exc, f"claim cache cannot be opened: {root}"
            ) from exc
        raise ClaimError("state-conflict", f"unsafe claim cache root: {root}", 4) from exc
    flags = os.O_RDWR | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    if created_root:
        flags |= os.O_CREAT | os.O_EXCL
    try:
        try:
            descriptor = os.open(".lock", flags, 0o600, dir_fd=root_descriptor)
        except FileNotFoundError as exc:
            raise ClaimError(
                "state-conflict", f"claim lock is missing: {lock_path}", 4
            ) from exc
        except OSError as exc:
            if unavailable_os_error(exc) is not None:
                raise classify_claim_store_error(
                    exc, f"claim lock cannot be opened: {lock_path}"
                ) from exc
            raise ClaimError(
                "state-conflict", f"unsafe claim lock: {lock_path}", 4
            ) from exc
        with os.fdopen(descriptor, "r+") as lock:
            if not stat.S_ISREG(os.fstat(lock.fileno()).st_mode):
                raise ClaimError("state-conflict", f"unsafe claim lock: {lock_path}", 4)
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH)
            try:
                yield root
            finally:
                fcntl.flock(lock.fileno(), fcntl.LOCK_UN)
    finally:
        os.close(root_descriptor)


def read_claim_value(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(read_stable_regular_bytes(path))
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise ClaimError("state-conflict", f"invalid claim file: {path}", 4) from exc
    if not isinstance(value, dict):
        raise ClaimError("state-conflict", f"claim schema mismatch: {path}", 4)
    return value


def validate_current_claim(
    value: Any, path: Path, *, validate_takeover: bool = True
) -> dict[str, Any]:
    required = {
        "schema_version",
        "root_id",
        "acquisition_nonce",
        "repositories",
        "repository_checkouts",
        "sources",
        "ledger_ref",
        "opened_at",
        "heartbeat_at",
        "takeover_evidence",
        "replaced_root_ids",
        "fingerprint",
    }
    if not isinstance(value, dict) or set(value) != required:
        raise ClaimError("state-conflict", f"claim schema mismatch: {path}", 4)
    if value["schema_version"] != SCHEMA_VERSION or value["fingerprint"] != fingerprint(value):
        raise ClaimError("state-conflict", f"claim fingerprint mismatch: {path}", 4)
    if canonical_ledger_ref(value["ledger_ref"], persisted=True) != value["ledger_ref"]:
        raise ClaimError("state-conflict", f"claim ledger_ref mismatch: {path}", 4)
    if validate_takeover:
        validate_takeover_evidence(value, path)
    return value


def inspect_claim(path: Path) -> dict[str, Any]:
    value = read_claim_value(path)
    if value.get("schema_version") != SCHEMA_VERSION:
        raise ClaimError("state-conflict", f"unsupported claim schema: {path}", 4)
    return validate_current_claim(value, path)


def load_claims(root: Path | None) -> dict[str, dict[str, Any]]:
    if root is None:
        return {}
    claims: dict[str, dict[str, Any]] = {}
    for path in sorted(root.glob("*.json")):
        claim = inspect_claim(path)
        root_id = check_id(claim["root_id"], "root_id")
        if path.name != f"{root_id}.json" or root_id in claims:
            raise ClaimError("state-conflict", f"claim identity mismatch: {path}", 4)
        claims[root_id] = claim
    return claims


def nonempty_string(value: Any, field: str) -> str:
    if not isinstance(value, str) or not value.strip():
        raise ClaimError("invalid-input", f"{field} must be a non-empty string", 2)
    return value.strip()


def load_task_model_policy() -> dict[str, Any]:
    try:
        text = TASK_MODEL_POLICY_PATH.read_text()
    except OSError as exc:
        raise ClaimError(
            "state-conflict",
            f"task model policy cannot be read: {TASK_MODEL_POLICY_PATH}",
            4,
        ) from exc
    rows: dict[str, list[str]] = {}
    for line in text.splitlines():
        match = re.fullmatch(r"\| `([^`]+)` \| (.+) \|", line)
        if match and match.group(1) in {
            "model",
            "thinking_default",
            "thinking_allowed",
        }:
            rows[match.group(1)] = re.findall(r"`([^`]+)`", match.group(2))
    if (
        len(rows.get("model", [])) != 1
        or len(rows.get("thinking_default", [])) != 1
        or not rows.get("thinking_allowed")
        or len(rows["thinking_allowed"]) != len(set(rows["thinking_allowed"]))
        or rows["thinking_default"][0] not in rows["thinking_allowed"]
    ):
        raise ClaimError("state-conflict", "task model policy is invalid", 4)
    return {
        "path": str(TASK_MODEL_POLICY_PATH),
        "model": rows["model"][0],
        "thinking_default": rows["thinking_default"][0],
        "thinking_allowed": rows["thinking_allowed"],
    }


def canonical_managed_checkout(
    value: Any,
    *,
    allowed_repositories: set[str],
    field: str,
    verify_checkout: bool,
) -> dict[str, str]:
    required = {
        "repository",
        "checkout",
        "target_branch_name",
        "git_top_level",
        "baseline_revision",
        "isolation_evidence_ref",
    }
    if not isinstance(value, dict) or set(value) != required:
        raise ClaimError("invalid-input", f"{field} schema is invalid", 2)
    repository = nonempty_string(value["repository"], f"{field}.repository")
    if repository not in allowed_repositories:
        raise ClaimError(
            "invalid-input",
            f"{field}.repository is outside the replaced claim",
            2,
        )
    checkout_value = nonempty_string(value["checkout"], f"{field}.checkout")
    top_level_value = nonempty_string(value["git_top_level"], f"{field}.git_top_level")
    checkout_path = Path(checkout_value).expanduser()
    top_level_path = Path(top_level_value).expanduser()
    if not checkout_path.is_absolute() or not top_level_path.is_absolute():
        raise ClaimError("invalid-input", f"{field} paths must be absolute", 2)
    try:
        checkout = checkout_path.resolve(strict=verify_checkout)
        top_level = top_level_path.resolve(strict=verify_checkout)
    except FileNotFoundError as exc:
        raise ClaimError("invalid-input", f"{field} checkout is not recoverable", 2) from exc
    branch = nonempty_string(value["target_branch_name"], f"{field}.target_branch_name")
    revision = nonempty_string(value["baseline_revision"], f"{field}.baseline_revision")
    if not REVISION_RE.fullmatch(revision):
        raise ClaimError("invalid-input", f"{field}.baseline_revision is invalid", 2)
    evidence_ref = nonempty_string(
        value["isolation_evidence_ref"], f"{field}.isolation_evidence_ref"
    )
    if verify_checkout:
        common = subprocess.run(
            ["git", "-C", str(checkout), "rev-parse", "--git-common-dir"],
            text=True,
            capture_output=True,
        )
        current_top = subprocess.run(
            ["git", "-C", str(checkout), "rev-parse", "--show-toplevel"],
            text=True,
            capture_output=True,
        )
        branch_check = subprocess.run(
            ["git", "check-ref-format", "--branch", branch],
            text=True,
            capture_output=True,
        )
        current_branch = subprocess.run(
            ["git", "-C", str(checkout), "branch", "--show-current"],
            text=True,
            capture_output=True,
        )
        baseline_check = subprocess.run(
            ["git", "-C", str(checkout), "cat-file", "-e", f"{revision}^{{commit}}"],
            text=True,
            capture_output=True,
        )
        if (
            common.returncode
            or current_top.returncode
            or branch_check.returncode
            or current_branch.returncode
        ):
            raise ClaimError("invalid-input", f"{field} Git evidence is invalid", 2)
        common_path = Path(common.stdout.strip())
        if not common_path.is_absolute():
            common_path = checkout / common_path
        if str(common_path.resolve(strict=True)) != repository:
            raise ClaimError("invalid-input", f"{field} repository identity mismatch", 2)
        if Path(current_top.stdout.strip()).resolve(strict=True) != top_level:
            raise ClaimError("invalid-input", f"{field} top-level mismatch", 2)
        if current_branch.stdout.strip() != branch:
            raise ClaimError("invalid-input", f"{field} target branch mismatch", 2)
        if baseline_check.returncode:
            raise ClaimError("invalid-input", f"{field} baseline revision is not a commit", 2)
    return {
        "repository": repository,
        "checkout": str(checkout),
        "target_branch_name": branch,
        "git_top_level": str(top_level),
        "baseline_revision": revision,
        "isolation_evidence_ref": evidence_ref,
    }


def validate_task_adoption(
    value: Any,
    claim: dict[str, Any],
    *,
    verify_checkouts: bool,
    require_task_profile: bool = True,
) -> dict[str, Any]:
    required = {
        "root_id",
        "claim_fingerprint",
        "task_termination_evidence",
        "execution_recovery_fingerprint",
        "command_cleanup_evidence",
        "specs",
    }
    if not isinstance(value, dict) or set(value) != required:
        raise ClaimError("invalid-input", "task adoption schema is invalid", 2)
    root_id = check_id(value["root_id"], "task_adoption.root_id")
    claim_fingerprint = check_fingerprint(value["claim_fingerprint"])
    if root_id != claim["root_id"] or claim_fingerprint != claim["fingerprint"]:
        raise ClaimError("invalid-input", "task adoption claim identity mismatch", 2)
    termination = nonempty_string(
        value["task_termination_evidence"],
        "task_adoption.task_termination_evidence",
    )
    execution_recovery_fingerprint = check_fingerprint(
        value["execution_recovery_fingerprint"]
    )
    if not isinstance(value["command_cleanup_evidence"], list):
        raise ClaimError("invalid-input", "task adoption command cleanup evidence is invalid", 2)
    command_cleanup_evidence: list[dict[str, Any]] = []
    seen_attempts: set[str] = set()
    for cleanup_index, cleanup in enumerate(value["command_cleanup_evidence"]):
        cleanup_field = f"task_adoption.command_cleanup_evidence[{cleanup_index}]"
        if not isinstance(cleanup, dict) or set(cleanup) != {
            "attempt_id", "state", "cleanup_verified", "evidence_ref"
        }:
            raise ClaimError("invalid-input", f"{cleanup_field} schema is invalid", 2)
        attempt_id = check_id(cleanup["attempt_id"], f"{cleanup_field}.attempt_id")
        if not re.fullmatch(r"[0-9a-f]{32}", attempt_id) or attempt_id in seen_attempts:
            raise ClaimError("invalid-input", f"{cleanup_field}.attempt_id is invalid", 2)
        seen_attempts.add(attempt_id)
        if cleanup["state"] != "terminal" or cleanup["cleanup_verified"] is not True:
            raise ClaimError(
                "state-conflict",
                "takeover refuses a live or cleanup-unverified command attempt",
                4,
            )
        command_cleanup_evidence.append(
            {
                "attempt_id": attempt_id,
                "state": "terminal",
                "cleanup_verified": True,
                "evidence_ref": nonempty_string(cleanup["evidence_ref"], f"{cleanup_field}.evidence_ref"),
            }
        )
    command_cleanup_evidence.sort(key=lambda item: item["attempt_id"])
    if verify_checkouts:
        ledger_path = Path(canonical_ledger_ref(claim["ledger_ref"], persisted=True))
        expected_cleanup: list[dict[str, Any]] = []
        if ledger_path.exists():
            if ledger_path.is_symlink() or not ledger_path.is_file() or ledger_path.stat().st_size > 1024 * 1024:
                raise ClaimError("state-conflict", "takeover ledger is unsafe", 4)
            try:
                ledger = json.loads(ledger_path.read_text())
            except (OSError, json.JSONDecodeError) as exc:
                raise ClaimError("state-conflict", "takeover ledger is unreadable", 4) from exc
            if not isinstance(ledger, dict) or ledger.get("schema_version") != "13.0.0":
                raise ClaimError("state-conflict", "takeover ledger schema is unsupported", 4)
            for task in ledger.get("tasks", []):
                for delivery in task.get("deliveries", []):
                    for attempt in delivery.get("command_attempts", []):
                        if attempt.get("state") != "terminal" or attempt.get("cleanup_verified") is not True:
                            raise ClaimError(
                                "state-conflict",
                                "takeover refuses a live or cleanup-unverified command attempt",
                                4,
                            )
                        expected_cleanup.append(
                            {
                                "attempt_id": attempt["attempt_id"],
                                "state": "terminal",
                                "cleanup_verified": True,
                                "evidence_ref": attempt["evidence_ref"],
                            }
                        )
            expected_cleanup.sort(key=lambda item: item["attempt_id"])
        if command_cleanup_evidence != expected_cleanup:
            raise ClaimError("state-conflict", "task adoption command cleanup coverage is incomplete", 4)
    expected_recovery_fingerprint = hashlib.sha256(
        json.dumps(command_cleanup_evidence, sort_keys=True, separators=(",", ":")).encode()
    ).hexdigest()
    if execution_recovery_fingerprint != expected_recovery_fingerprint:
        raise ClaimError("invalid-input", "task adoption execution recovery fingerprint is invalid", 2)
    if not isinstance(value["specs"], list) or not value["specs"]:
        raise ClaimError("invalid-input", "task adoption specs are required", 2)
    allowed_repositories = set(claim["repositories"])
    task_policy = load_task_model_policy() if require_task_profile else None
    normalized_specs: list[dict[str, Any]] = []
    seen_sources: set[str] = set()
    seen_tasks: set[str] = set()
    for index, spec in enumerate(value["specs"]):
        field = f"task_adoption.specs[{index}]"
        required_spec = {
            "source_spec_ref",
            "task_state",
            "task_ref",
            "task_assignment_fingerprint",
            "managed_checkouts",
            "evidence_ref",
        }
        if require_task_profile:
            required_spec.update(
                {"task_model", "task_thinking", "thinking_reason"}
            )
        if not isinstance(spec, dict) or set(spec) != required_spec:
            raise ClaimError("invalid-input", f"{field} schema is invalid", 2)
        source = nonempty_string(spec["source_spec_ref"], f"{field}.source_spec_ref")
        if source in seen_sources:
            raise ClaimError("invalid-input", f"{field} duplicates a source", 2)
        seen_sources.add(source)
        state = spec["task_state"]
        if state not in {"recorded", "no-task"}:
            raise ClaimError("invalid-input", f"{field}.task_state is invalid", 2)
        evidence_ref = nonempty_string(spec["evidence_ref"], f"{field}.evidence_ref")
        if not isinstance(spec["managed_checkouts"], list):
            raise ClaimError("invalid-input", f"{field}.managed_checkouts is invalid", 2)
        if require_task_profile:
            task_model = nonempty_string(spec["task_model"], f"{field}.task_model")
            task_thinking = nonempty_string(
                spec["task_thinking"], f"{field}.task_thinking"
            )
            thinking_reason = nonempty_string(
                spec["thinking_reason"], f"{field}.thinking_reason"
            )
            if task_model != task_policy["model"]:
                raise ClaimError("invalid-input", f"{field}.task_model is invalid", 2)
            if task_thinking not in task_policy["thinking_allowed"]:
                raise ClaimError("invalid-input", f"{field}.task_thinking is invalid", 2)
            if thinking_reason == "none":
                raise ClaimError("invalid-input", f"{field}.thinking_reason is invalid", 2)
        else:
            task_model = "unrecorded"
            task_thinking = "unrecorded"
            thinking_reason = "unrecorded"
        if state == "no-task":
            if (
                spec["task_ref"] != "none"
                or spec["task_assignment_fingerprint"] != "none"
                or spec["managed_checkouts"]
            ):
                raise ClaimError("invalid-input", f"{field} no-task evidence is inconsistent", 2)
            task_ref = "none"
            assignment_fingerprint = "none"
            checkouts: list[dict[str, str]] = []
        else:
            task_ref = nonempty_string(spec["task_ref"], f"{field}.task_ref")
            assignment_fingerprint = check_fingerprint(
                spec["task_assignment_fingerprint"]
            )
            if task_ref == "none" or not spec["managed_checkouts"]:
                raise ClaimError("invalid-input", f"{field} recorded task evidence is incomplete", 2)
            if task_ref in seen_tasks:
                raise ClaimError("invalid-input", f"{field} duplicates a task ref", 2)
            seen_tasks.add(task_ref)
            checkouts = [
                canonical_managed_checkout(
                    checkout,
                    allowed_repositories=allowed_repositories,
                    field=f"{field}.managed_checkouts[{checkout_index}]",
                    verify_checkout=verify_checkouts,
                )
                for checkout_index, checkout in enumerate(spec["managed_checkouts"])
            ]
            checkout_keys = [(item["repository"], item["checkout"]) for item in checkouts]
            if len(checkout_keys) != len(set(checkout_keys)):
                raise ClaimError("invalid-input", f"{field} duplicates a managed checkout", 2)
        normalized_specs.append(
            {
                "source_spec_ref": source,
                "task_state": state,
                "task_ref": task_ref,
                "task_model": task_model,
                "task_thinking": task_thinking,
                "thinking_reason": thinking_reason,
                "task_assignment_fingerprint": assignment_fingerprint,
                "managed_checkouts": checkouts,
                "evidence_ref": evidence_ref,
            }
        )
    if seen_sources != set(claim["sources"]):
        raise ClaimError(
            "invalid-input",
            "task adoption must cover every replaced source exactly once",
            2,
            {
                "expected": sorted(claim["sources"]),
                "actual": sorted(seen_sources),
            },
        )
    return {
        "root_id": root_id,
        "claim_fingerprint": claim_fingerprint,
        "task_termination_evidence": termination,
        "execution_recovery_fingerprint": execution_recovery_fingerprint,
        "command_cleanup_evidence": command_cleanup_evidence,
        "specs": sorted(normalized_specs, key=lambda item: item["source_spec_ref"]),
    }


def validate_candidate_adoption_uniqueness(adoptions: list[dict[str, Any]]) -> None:
    task_owners: dict[str, dict[str, str]] = {}
    checkout_owners: dict[tuple[str, str], dict[str, str]] = {}
    for adoption in adoptions:
        root_id = adoption["root_id"]
        for spec in adoption["specs"]:
            if spec["task_state"] != "recorded":
                continue
            owner = {
                "root_id": root_id,
                "source_spec_ref": spec["source_spec_ref"],
            }
            task_ref = spec["task_ref"]
            prior_task_owner = task_owners.get(task_ref)
            if prior_task_owner is not None:
                raise ClaimError(
                    "invalid-input",
                    "recorded task ref is owned by multiple takeover Specs",
                    2,
                    {
                        "task_ref": task_ref,
                        "owners": [prior_task_owner, owner],
                    },
                )
            task_owners[task_ref] = owner
            for checkout in spec["managed_checkouts"]:
                checkout_key = (checkout["repository"], checkout["checkout"])
                prior_checkout_owner = checkout_owners.get(checkout_key)
                if prior_checkout_owner is not None:
                    raise ClaimError(
                        "invalid-input",
                        "managed checkout is owned by multiple takeover Specs",
                        2,
                        {
                            "repository": checkout_key[0],
                            "checkout": checkout_key[1],
                            "owners": [prior_checkout_owner, owner],
                        },
                    )
                checkout_owners[checkout_key] = owner


def read_task_adoption_inputs(values: list[str]) -> dict[str, dict[str, Any]]:
    parsed: dict[str, dict[str, Any]] = {}
    for item in values:
        root_id, separator, raw_path = item.partition("=")
        root_id = check_id(root_id, "root_id")
        path = Path(raw_path).expanduser()
        if not separator or root_id in parsed or not path.is_absolute():
            raise ClaimError("invalid-input", f"expected_task_adoption is invalid: {item}", 2)
        try:
            value = json.loads(read_stable_regular_bytes(path))
        except (OSError, UnicodeError, json.JSONDecodeError) as exc:
            raise ClaimError(
                "invalid-input", f"expected_task_adoption cannot be read: {path}", 2
            ) from exc
        if not isinstance(value, dict):
            raise ClaimError("invalid-input", f"expected_task_adoption is invalid: {path}", 2)
        parsed[root_id] = value
    return parsed


def takeover_evidence_fingerprint(value: dict[str, Any]) -> str:
    payload = {key: value[key] for key in value if key != "evidence_fingerprint"}
    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(encoded).hexdigest()


def validate_takeover_evidence(
    value: dict[str, Any],
    path: Path,
) -> None:
    evidence = value["takeover_evidence"]
    replaced = value["replaced_root_ids"]
    if evidence == "none":
        if replaced:
            raise ClaimError("state-conflict", f"takeover evidence mismatch: {path}", 4)
        return
    required = {
        "stale_claim_takeover_permission",
        "takeover_reason",
        "evidence",
        "transaction_id",
        "replaced_claims",
        "evidence_fingerprint",
    }
    if not isinstance(evidence, dict) or set(evidence) != required:
        raise ClaimError("state-conflict", f"takeover evidence schema mismatch: {path}", 4)
    if (
        evidence["stale_claim_takeover_permission"] != TAKEOVER_PERMISSION
        or evidence["takeover_reason"] not in TAKEOVER_REASONS
        or not isinstance(evidence["evidence"], str)
        or not evidence["evidence"].strip()
        or not isinstance(evidence["transaction_id"], str)
        or not TRANSACTION_ID_RE.fullmatch(evidence["transaction_id"])
        or not isinstance(evidence["replaced_claims"], list)
        or not isinstance(evidence["evidence_fingerprint"], str)
        or evidence["evidence_fingerprint"] != takeover_evidence_fingerprint(evidence)
    ):
        raise ClaimError("state-conflict", f"takeover evidence value mismatch: {path}", 4)
    root_ids: list[str] = []
    adoptions: list[dict[str, Any]] = []
    for index, item in enumerate(evidence["replaced_claims"]):
        if not isinstance(item, dict) or set(item) != {
            "claim_snapshot",
            "task_termination_evidence",
            "task_adoption",
        }:
            raise ClaimError("state-conflict", f"takeover snapshot mismatch: {path}", 4)
        snapshot = validate_current_claim(
            item["claim_snapshot"], path, validate_takeover=False
        )
        try:
            adoption = validate_task_adoption(
                item["task_adoption"],
                snapshot,
                verify_checkouts=False,
                require_task_profile=True,
            )
        except ClaimError as exc:
            raise ClaimError("state-conflict", f"takeover adoption mismatch: {path}", 4) from exc
        if item["task_termination_evidence"] != adoption["task_termination_evidence"]:
            raise ClaimError("state-conflict", f"takeover termination mismatch: {path}", 4)
        root_ids.append(snapshot["root_id"])
        adoptions.append(adoption)
    try:
        validate_candidate_adoption_uniqueness(adoptions)
    except ClaimError as exc:
        raise ClaimError("state-conflict", f"takeover adoption mismatch: {path}", 4) from exc
    if sorted(root_ids) != replaced or len(root_ids) != len(set(root_ids)):
        raise ClaimError("state-conflict", f"takeover root snapshot mismatch: {path}", 4)


def takeover_transaction_fingerprint(value: dict[str, Any]) -> str:
    payload = {key: value[key] for key in value if key != "fingerprint"}
    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(encoded).hexdigest()


def build_takeover_transaction(
    candidate: dict[str, Any], replaced_claims: list[dict[str, Any]]
) -> dict[str, Any]:
    value = {
        "schema_version": TAKEOVER_TRANSACTION_SCHEMA_VERSION,
        "transaction_id": candidate["takeover_evidence"]["transaction_id"],
        "candidate_claim": candidate,
        "replaced_claims": replaced_claims,
        "prepared_at": timestamp(),
    }
    value["fingerprint"] = takeover_transaction_fingerprint(value)
    return value


def validate_takeover_transaction(value: Any, path: Path) -> dict[str, Any]:
    required = {
        "schema_version",
        "transaction_id",
        "candidate_claim",
        "replaced_claims",
        "prepared_at",
        "fingerprint",
    }
    if not isinstance(value, dict) or set(value) != required:
        raise ClaimError("state-conflict", f"takeover transaction schema mismatch: {path}", 4)
    if (
        value["schema_version"] != TAKEOVER_TRANSACTION_SCHEMA_VERSION
        or not isinstance(value["transaction_id"], str)
        or not TRANSACTION_ID_RE.fullmatch(value["transaction_id"])
        or not isinstance(value["prepared_at"], str)
        or not valid_timestamp(value["prepared_at"])
        or value["fingerprint"] != takeover_transaction_fingerprint(value)
    ):
        raise ClaimError("state-conflict", f"takeover transaction fingerprint mismatch: {path}", 4)
    candidate = validate_current_claim(value["candidate_claim"], path)
    if path.name != f"{candidate['root_id']}.takeover":
        raise ClaimError("state-conflict", f"takeover transaction identity mismatch: {path}", 4)
    if candidate["takeover_evidence"]["transaction_id"] != value["transaction_id"]:
        raise ClaimError("state-conflict", f"takeover transaction id mismatch: {path}", 4)
    if not isinstance(value["replaced_claims"], list) or not value["replaced_claims"]:
        raise ClaimError("state-conflict", f"takeover transaction snapshots missing: {path}", 4)
    snapshots = [
        validate_current_claim(item, path, validate_takeover=False)
        for item in value["replaced_claims"]
    ]
    root_ids = [item["root_id"] for item in snapshots]
    if sorted(root_ids) != candidate["replaced_root_ids"] or len(root_ids) != len(set(root_ids)):
        raise ClaimError("state-conflict", f"takeover transaction roots mismatch: {path}", 4)
    evidence_snapshots = [
        item["claim_snapshot"]
        for item in candidate["takeover_evidence"]["replaced_claims"]
    ]
    if snapshots != evidence_snapshots:
        raise ClaimError("state-conflict", f"takeover transaction evidence mismatch: {path}", 4)
    candidate_repositories = set(candidate["repositories"])
    candidate_sources = set(candidate["sources"])
    if any(
        set(snapshot["repositories"]) - candidate_repositories
        or set(snapshot["sources"]) - candidate_sources
        for snapshot in snapshots
    ):
        raise ClaimError("state-conflict", f"takeover transaction scope mismatch: {path}", 4)
    return value


def load_takeover_transactions(root: Path | None) -> dict[str, dict[str, Any]]:
    if root is None:
        return {}
    transactions: dict[str, dict[str, Any]] = {}
    for path in sorted(root.glob("*.takeover")):
        try:
            value = json.loads(read_stable_regular_bytes(path))
        except (OSError, UnicodeError, json.JSONDecodeError) as exc:
            raise ClaimError("state-conflict", f"invalid takeover transaction: {path}", 4) from exc
        transaction = validate_takeover_transaction(value, path)
        root_id = transaction["candidate_claim"]["root_id"]
        if root_id in transactions:
            raise ClaimError("state-conflict", f"duplicate takeover transaction: {path}", 4)
        transactions[root_id] = transaction
    return transactions


def sync_directory(path: Path) -> None:
    descriptor = open_directory_descriptor(path)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def write_json_atomic(path: Path, value: dict[str, Any]) -> None:
    directory = open_directory_descriptor(path.parent)
    temporary_name = f".{path.name}.{os.getpid()}.{secrets.token_hex(8)}.tmp"
    payload = (json.dumps(value, indent=2, sort_keys=True) + "\n").encode()
    descriptor: int | None = None
    try:
        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
        flags |= getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
        descriptor = os.open(temporary_name, flags, 0o600, dir_fd=directory)
        with os.fdopen(descriptor, "wb") as handle:
            descriptor = None
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(
            temporary_name,
            path.name,
            src_dir_fd=directory,
            dst_dir_fd=directory,
        )
        os.fsync(directory)
    finally:
        if descriptor is not None:
            os.close(descriptor)
        try:
            os.unlink(temporary_name, dir_fd=directory)
        except FileNotFoundError:
            pass
        os.close(directory)


def unlink_durable(path: Path) -> None:
    directory = open_directory_descriptor(path.parent)
    try:
        os.unlink(path.name, dir_fd=directory)
        os.fsync(directory)
    finally:
        os.close(directory)


def write_claim(path: Path, value: dict[str, Any]) -> None:
    write_json_atomic(path, value)


def write_takeover_transaction(path: Path, value: dict[str, Any]) -> None:
    write_json_atomic(path, value)


def release_receipt_fingerprint(value: dict[str, Any]) -> str:
    payload = {key: value[key] for key in value if key != "fingerprint"}
    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(encoded).hexdigest()


_LEDGER_RUNTIME: Any | None = None


def load_ledger_runtime() -> Any:
    global _LEDGER_RUNTIME
    if _LEDGER_RUNTIME is not None:
        return _LEDGER_RUNTIME
    loader = importlib.machinery.SourceFileLoader(
        "implement_feature_terminal_ledger_runtime", str(LEDGER_CACHE_PATH)
    )
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise ClaimError(
            "state-conflict", "terminal ledger validator is unavailable", 4
        )
    runtime = importlib.util.module_from_spec(spec)
    try:
        loader.exec_module(runtime)
    except Exception as exc:
        raise ClaimError(
            "state-conflict", "terminal ledger validator cannot be loaded", 4
        ) from exc
    _LEDGER_RUNTIME = runtime
    return runtime


def terminal_ledger_snapshot(
    claim: dict[str, Any], ledger: Path, evidence: str, reason: str
) -> tuple[str, int]:
    try:
        payload = read_stable_regular_bytes(ledger)
        value = json.loads(payload)
    except FileNotFoundError:
        raise ClaimError(
            "state-conflict", f"claim ledger is not a safe file: {ledger}", 4
        )
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise ClaimError(
            "state-conflict", f"claim ledger is not valid terminal state: {ledger}", 4
        ) from exc

    runtime = load_ledger_runtime()
    try:
        state = runtime.validate_state(value, ledger)
        terminal = runtime.terminal_projection(state)
    except Exception as exc:
        raise ClaimError(
            "state-conflict", f"claim ledger is not valid terminal state: {ledger}", 4
        ) from exc

    source_ids = sorted(item["source_id"] for item in state["sources"])
    if (
        state["portfolio"]["root_id"] != claim["root_id"]
        or state["portfolio"]["repositories"] != claim["repositories"]
        or state["portfolio"]["repository_checkouts"]
        != claim["repository_checkouts"]
        or source_ids != claim["sources"]
        or state["claim"]["fingerprint"] != claim["fingerprint"]
    ):
        raise ClaimError(
            "state-conflict",
            f"claim ledger ownership does not match the active claim: {ledger}",
            4,
        )
    if reason == "terminal" and state["closeout"]["portfolio_terminal_evidence_ref"] != evidence:
        raise ClaimError(
            "state-conflict",
            f"terminal release evidence does not match the verified ledger: {ledger}",
            4,
            {
                "ledger_ref": str(ledger),
                "expected_evidence_ref": state["closeout"][
                    "portfolio_terminal_evidence_ref"
                ],
            },
        )
    if reason == "terminal" and not terminal["archive_ready"]:
        raise ClaimError(
            "state-conflict",
            f"claim ledger is not archive-ready terminal state: {ledger}",
            4,
            {"ledger_ref": str(ledger), "blockers": terminal["blockers"]},
        )
    if reason == "preimplementation-abort":
        abort = state["closeout"].get("preimplementation_abort")
        if (
            state["goal"]["state"] != "pending"
            or not isinstance(abort, dict)
            or abort.get("evidence_ref") != evidence
            or any(task.get("implementation_baseline") == "accepted" for task in state["tasks"])
            or state["reviews"]
            or state["gates"]
            or state["handoffs"]
        ):
            raise ClaimError("state-conflict", f"claim ledger is not a verified preimplementation abort: {ledger}", 4)
    return hashlib.sha256(payload).hexdigest(), len(payload)


def build_release_receipt(claim: dict[str, Any], *, evidence: str, reason: str) -> dict[str, Any]:
    ledger = Path(canonical_ledger_ref(claim["ledger_ref"], persisted=True))
    ledger_sha256, ledger_size_bytes = terminal_ledger_snapshot(
        claim, ledger, evidence, reason
    )
    value = {
        "schema_version": RELEASE_RECEIPT_SCHEMA_VERSION,
        "root_id": claim["root_id"],
        "claim_fingerprint": claim["fingerprint"],
        "ledger_ref": str(ledger),
        "ledger_sha256": ledger_sha256,
        "ledger_size_bytes": ledger_size_bytes,
        "release_reason": reason,
        "evidence_ref": evidence,
        "released_at": timestamp(),
    }
    value["fingerprint"] = release_receipt_fingerprint(value)
    return value


def validate_release_receipt(value: Any, path: Path) -> dict[str, Any]:
    required = {
        "schema_version",
        "root_id",
        "claim_fingerprint",
        "ledger_ref",
        "ledger_sha256",
        "ledger_size_bytes",
        "release_reason",
        "evidence_ref",
        "released_at",
        "fingerprint",
    }
    if not isinstance(value, dict) or set(value) != required:
        raise ClaimError("state-conflict", f"release receipt schema mismatch: {path}", 4)
    if value["release_reason"] not in RELEASE_REASONS:
        root_id = value.get("root_id")
        raise ClaimError(
            "state-conflict",
            f"unsupported nonterminal release receipt for root {root_id}: {path}",
            4,
            {
                "root_id": root_id,
                "receipt_ref": str(path),
                "release_reason": value["release_reason"],
            },
        )
    root_id = check_id(value["root_id"], "root_id")
    claim_fingerprint = check_fingerprint(value["claim_fingerprint"])
    if (
        value["schema_version"] != RELEASE_RECEIPT_SCHEMA_VERSION
        or path.name != f"{root_id}--{claim_fingerprint}.json"
        or not isinstance(value["evidence_ref"], str)
        or not value["evidence_ref"].strip()
        or not isinstance(value["released_at"], str)
        or not valid_timestamp(value["released_at"])
        or value["fingerprint"] != release_receipt_fingerprint(value)
    ):
        raise ClaimError("state-conflict", f"release receipt value mismatch: {path}", 4)
    if canonical_ledger_ref(value["ledger_ref"], persisted=True) != value["ledger_ref"]:
        raise ClaimError("state-conflict", f"release receipt ledger_ref mismatch: {path}", 4)
    has_snapshot = (
        isinstance(value["ledger_sha256"], str)
        and bool(FINGERPRINT_RE.fullmatch(value["ledger_sha256"]))
        and isinstance(value["ledger_size_bytes"], int)
        and value["ledger_size_bytes"] >= 0
    )
    if not has_snapshot:
        raise ClaimError("state-conflict", f"release receipt ledger mismatch: {path}", 4)
    return value


def read_release_receipt(path: Path) -> dict[str, Any] | None:
    try:
        value = json.loads(read_stable_regular_bytes(path))
    except FileNotFoundError:
        return None
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise ClaimError("state-conflict", f"invalid release receipt: {path}", 4) from exc
    return validate_release_receipt(value, path)


def persist_release_receipt(root: Path, value: dict[str, Any]) -> Path:
    receipt_root = root / "releases"
    if receipt_root.exists() and (receipt_root.is_symlink() or not receipt_root.is_dir()):
        raise ClaimError("state-conflict", f"unsafe release receipt root: {receipt_root}", 4)
    if not receipt_root.exists():
        receipt_root.mkdir()
        sync_directory(root)
    path = release_receipt_path(root, value["root_id"], value["claim_fingerprint"])
    existing = read_release_receipt(path)
    if existing is not None:
        comparable = {
            key: item for key, item in existing.items() if key not in {"released_at", "fingerprint"}
        }
        expected = {
            key: item for key, item in value.items() if key not in {"released_at", "fingerprint"}
        }
        if comparable != expected:
            raise ClaimError("state-conflict", f"release receipt conflicts: {path}", 4)
        return path
    write_json_atomic(path, value)
    return path


def validate_release_receipt_store(root: Path) -> None:
    receipt_root = root / "releases"
    if not receipt_root.exists():
        return
    if receipt_root.is_symlink() or not receipt_root.is_dir():
        raise ClaimError("state-conflict", f"unsafe release receipt root: {receipt_root}", 4)
    for path in sorted(receipt_root.iterdir()):
        read_release_receipt(path)


def delete_replaced_claim(path: Path) -> None:
    unlink_durable(path)


def delete_takeover_transaction(path: Path) -> None:
    unlink_durable(path)


def finalize_takeover_transaction(root: Path, value: dict[str, Any]) -> dict[str, Any]:
    path = root / f"{value['candidate_claim']['root_id']}.takeover"
    transaction = validate_takeover_transaction(value, path)
    candidate = transaction["candidate_claim"]
    snapshots = {
        snapshot["root_id"]: snapshot for snapshot in transaction["replaced_claims"]
    }
    claims = load_claims(root)
    current_candidate = claims.get(candidate["root_id"])
    if current_candidate is not None and current_candidate != candidate:
        raise ClaimError(
            "state-conflict",
            "takeover candidate snapshot mismatch during recovery",
            4,
            {"root_id": candidate["root_id"]},
        )
    existing_replaced: list[str] = []
    for root_id, snapshot in snapshots.items():
        current = claims.get(root_id)
        if current is None:
            continue
        if current != snapshot:
            raise ClaimError(
                "state-conflict",
                "replaced claim changed after takeover preparation",
                4,
                {"root_id": root_id},
            )
        existing_replaced.append(root_id)
    actual_conflicts = overlapping(candidate, claims)
    if actual_conflicts != sorted(existing_replaced):
        raise ClaimError(
            "state-conflict",
            "takeover recovery conflict set mismatch",
            4,
            {"expected": sorted(existing_replaced), "actual": actual_conflicts},
        )
    for root_id in sorted(existing_replaced):
        delete_replaced_claim(root / f"{root_id}.json")
    if current_candidate is None:
        write_claim(root / f"{candidate['root_id']}.json", candidate)
    delete_takeover_transaction(path)
    return candidate


def recover_pending_takeovers(root: Path) -> list[dict[str, Any]]:
    recovered: list[dict[str, Any]] = []
    for transaction in load_takeover_transactions(root).values():
        try:
            recovered.append(finalize_takeover_transaction(root, transaction))
        except OSError as exc:
            raise ClaimError(
                "takeover-pending",
                "prepared takeover could not be finalized; retry claim recover-takeover",
                4,
                {
                    "root_id": transaction["candidate_claim"]["root_id"],
                    "transaction_id": transaction["transaction_id"],
                },
            ) from exc
    return recovered


def build_claim(args: argparse.Namespace, *, takeover_evidence: Any = "none", replaced: list[str] | None = None) -> dict[str, Any]:
    root_id = check_id(args.root_id, "root_id")
    opened_at = timestamp()
    repositories, repository_checkouts = canonical_repositories(args.repository)
    value = {
        "schema_version": SCHEMA_VERSION,
        "root_id": root_id,
        "acquisition_nonce": secrets.token_hex(16),
        "repositories": repositories,
        "repository_checkouts": repository_checkouts,
        "sources": canonical_sources(args.source),
        "ledger_ref": canonical_ledger_ref(args.ledger_ref),
        "opened_at": opened_at,
        "heartbeat_at": opened_at,
        "takeover_evidence": takeover_evidence,
        "replaced_root_ids": sorted(replaced or []),
    }
    value["fingerprint"] = fingerprint(value)
    return value


def overlapping(candidate: dict[str, Any], claims: dict[str, dict[str, Any]]) -> list[str]:
    repositories = set(candidate["repositories"])
    sources = set(candidate["sources"])
    return sorted(
        root_id
        for root_id, claim in claims.items()
        if root_id != candidate["root_id"]
        and (repositories.intersection(claim["repositories"]) or sources.intersection(claim["sources"]))
    )


def acquire(args: argparse.Namespace) -> dict[str, Any]:
    candidate = build_claim(args)
    with locked_claim_store(create=True, exclusive=True) as root:
        assert root is not None
        validate_release_receipt_store(root)
        recover_pending_takeovers(root)
        claims = load_claims(root)
        current = claims.get(candidate["root_id"])
        if current:
            if ownership_scope(current) != ownership_scope(candidate):
                raise ClaimError("state-conflict", "root_id already owns a different claim", 4)
            return {"ok": True, "command": "claim.acquire", "state": "already-owned", "claim": current}
        conflicts = overlapping(candidate, claims)
        if conflicts:
            raise ClaimError("state-conflict", "overlapping active-root claim", 4, {"root_ids": conflicts})
        write_claim(root / f"{candidate['root_id']}.json", candidate)
    return {"ok": True, "command": "claim.acquire", "state": "acquired", "claim": candidate}


def takeover(args: argparse.Namespace) -> dict[str, Any]:
    evidence = args.evidence.strip()
    expected = sorted({check_id(value, "expected_root_id") for value in args.expected_root_id})
    if not evidence or not expected:
        raise ClaimError("invalid-input", "takeover requires evidence and expected_root_id", 2)
    if args.takeover_permission != TAKEOVER_PERMISSION or args.takeover_reason not in TAKEOVER_REASONS:
        raise ClaimError("invalid-input", "takeover authorization contract is invalid", 2)
    expected_fingerprints = keyed_values(
        args.expected_claim_fingerprint,
        "expected_claim_fingerprint",
        lambda value: bool(FINGERPRINT_RE.fullmatch(value)),
    )
    expected_heartbeats = keyed_values(
        args.expected_claim_heartbeat,
        "expected_claim_heartbeat",
        valid_timestamp,
    )
    expected_task_terminations = keyed_values(
        args.expected_task_termination,
        "expected_task_termination",
        lambda value: bool(value.strip()),
    )
    task_adoptions = read_task_adoption_inputs(args.expected_task_adoption)
    if (
        sorted(expected_fingerprints) != expected
        or sorted(expected_heartbeats) != expected
        or sorted(expected_task_terminations) != expected
        or sorted(task_adoptions) != expected
    ):
        raise ClaimError(
            "invalid-input",
            "takeover evidence, task termination, and adoption must identify every expected root exactly once",
            2,
        )
    candidate = build_claim(args, takeover_evidence="pending", replaced=expected)
    with locked_claim_store(create=True, exclusive=True) as root:
        assert root is not None
        validate_release_receipt_store(root)
        recover_pending_takeovers(root)
        claims = load_claims(root)
        conflicts = overlapping(candidate, claims)
        if conflicts != expected:
            raise ClaimError(
                "state-conflict",
                "takeover conflicts do not match expected roots",
                4,
                {"expected": expected, "actual": conflicts},
            )
        candidate_repositories = set(candidate["repositories"])
        candidate_sources = set(candidate["sources"])
        uncovered_scopes = [
            {
                "root_id": root_id,
                "repositories": sorted(
                    set(claims[root_id]["repositories"]) - candidate_repositories
                ),
                "sources": sorted(
                    set(claims[root_id]["sources"]) - candidate_sources
                ),
            }
            for root_id in expected
            if (
                set(claims[root_id]["repositories"]) - candidate_repositories
                or set(claims[root_id]["sources"]) - candidate_sources
            )
        ]
        if uncovered_scopes:
            raise ClaimError(
                "state-conflict",
                "takeover candidate does not cover the complete replaced-root scope",
                4,
                {"uncovered_scopes": uncovered_scopes},
            )
        for root_id in expected:
            claim = claims[root_id]
            if (
                claim["fingerprint"] != expected_fingerprints[root_id]
                or claim["heartbeat_at"] != expected_heartbeats[root_id]
            ):
                raise ClaimError(
                    "state-conflict",
                    "takeover evidence is stale",
                    4,
                    {"root_id": root_id},
                )
        if args.takeover_reason == "verified-stale":
            now = datetime.now(timezone.utc)
            live_roots = [
                root_id
                for root_id in expected
                if (now - parse_timestamp(claims[root_id]["heartbeat_at"])).total_seconds()
                < STALE_AFTER_SECONDS
            ]
            if live_roots:
                raise ClaimError(
                    "state-conflict",
                    "takeover stale threshold is not satisfied",
                    4,
                    {"root_ids": live_roots, "stale_after_seconds": STALE_AFTER_SECONDS},
                )
        if candidate["root_id"] in claims:
            raise ClaimError("state-conflict", "takeover root_id already exists", 4)
        transaction_id = secrets.token_hex(16)
        replaced_evidence: list[dict[str, Any]] = []
        for root_id in expected:
            adoption = validate_task_adoption(
                task_adoptions[root_id], claims[root_id], verify_checkouts=True
            )
            if adoption["task_termination_evidence"] != expected_task_terminations[root_id]:
                raise ClaimError(
                    "invalid-input",
                    "task adoption and termination evidence mismatch",
                    2,
                    {"root_id": root_id},
                )
            replaced_evidence.append(
                {
                    "claim_snapshot": claims[root_id],
                    "task_termination_evidence": expected_task_terminations[root_id],
                    "task_adoption": adoption,
                }
            )
        validate_candidate_adoption_uniqueness(
            [item["task_adoption"] for item in replaced_evidence]
        )
        takeover_evidence = {
            "stale_claim_takeover_permission": args.takeover_permission,
            "takeover_reason": args.takeover_reason,
            "evidence": evidence,
            "transaction_id": transaction_id,
            "replaced_claims": replaced_evidence,
        }
        takeover_evidence["evidence_fingerprint"] = takeover_evidence_fingerprint(
            takeover_evidence
        )
        candidate["takeover_evidence"] = takeover_evidence
        candidate["fingerprint"] = fingerprint(candidate)
        transaction = build_takeover_transaction(
            candidate, [claims[root_id] for root_id in expected]
        )
        transaction_path = root / f"{candidate['root_id']}.takeover"
        try:
            write_takeover_transaction(transaction_path, transaction)
        except OSError as exc:
            pending = transaction_path.is_file()
            raise ClaimError(
                "takeover-pending" if pending else "state-conflict",
                (
                    "takeover preparation may be durable; retry claim recover-takeover"
                    if pending
                    else "takeover preparation failed before prior claims changed"
                ),
                4,
                {"root_id": candidate["root_id"], "transaction_id": transaction_id},
            ) from exc
        try:
            candidate = finalize_takeover_transaction(root, transaction)
        except OSError as exc:
            raise ClaimError(
                "takeover-pending",
                "prepared takeover requires idempotent recovery",
                4,
                {"root_id": candidate["root_id"], "transaction_id": transaction_id},
            ) from exc
    return {
        "ok": True,
        "command": "claim.takeover",
        "state": "acquired",
        "transaction_id": transaction_id,
        "claim": candidate,
    }


def valid_timestamp(value: str) -> bool:
    try:
        parse_timestamp(value)
    except ValueError:
        return False
    return value.endswith("Z")


def parse_timestamp(value: str) -> datetime:
    parsed = datetime.fromisoformat(value.removesuffix("Z") + "+00:00")
    if parsed.tzinfo is None:
        raise ValueError("timestamp must include a timezone")
    return parsed.astimezone(timezone.utc)


def keyed_values(
    values: list[str],
    field: str,
    validator: Any,
) -> dict[str, str]:
    parsed: dict[str, str] = {}
    for item in values:
        root_id, separator, value = item.partition("=")
        root_id = check_id(root_id, "root_id")
        if not separator or root_id in parsed or not validator(value):
            raise ClaimError("invalid-input", f"{field} is invalid: {item}", 2)
        parsed[root_id] = value
    return parsed


def status(args: argparse.Namespace) -> dict[str, Any]:
    with locked_claim_store(create=False, exclusive=False) as root:
        claims = load_claims(root)
        transactions = load_takeover_transactions(root)
    if args.root_id:
        root_id = check_id(args.root_id, "root_id")
        transaction = transactions.get(root_id)
        if transaction:
            return {
                "ok": True,
                "command": "claim.status",
                "state": "takeover-prepared",
                "transaction": transaction,
            }
        replacing_transactions = [
            value
            for value in transactions.values()
            if root_id in value["candidate_claim"]["replaced_root_ids"]
        ]
        if len(replacing_transactions) > 1:
            raise ClaimError(
                "state-conflict",
                "replaced root appears in multiple prepared takeovers",
                4,
                {"root_id": root_id},
            )
        if replacing_transactions:
            transaction = replacing_transactions[0]
            return {
                "ok": True,
                "command": "claim.status",
                "state": "takeover-prepared",
                "queried_root_id": root_id,
                "candidate_root_id": transaction["candidate_claim"]["root_id"],
                "transaction": transaction,
            }
        claim = claims.get(root_id)
        if claim:
            return {"ok": True, "command": "claim.status", "state": "active", "claim": claim}
        raise ClaimError("not-found", f"claim not found: {root_id}", 3)
    return {
        "ok": True,
        "command": "claim.status",
        "claims": list(claims.values()),
        "takeover_transactions": list(transactions.values()),
    }


def recover_takeover(args: argparse.Namespace) -> dict[str, Any]:
    root_id = check_id(args.root_id, "root_id")
    expected_transaction_id = check_transaction_id(args.expected_transaction_id)
    with locked_claim_store(create=False, exclusive=True) as root:
        if root is None:
            raise ClaimError("not-found", f"takeover transaction not found: {root_id}", 3)
        validate_release_receipt_store(root)
        transactions = load_takeover_transactions(root)
        transaction = transactions.get(root_id)
        if transaction:
            if transaction["transaction_id"] != expected_transaction_id:
                raise ClaimError("state-conflict", "takeover transaction id mismatch", 4)
            try:
                claim = finalize_takeover_transaction(root, transaction)
            except OSError as exc:
                raise ClaimError(
                    "takeover-pending",
                    "prepared takeover still requires recovery",
                    4,
                    {"root_id": root_id, "transaction_id": expected_transaction_id},
                ) from exc
            return {
                "ok": True,
                "command": "claim.recover-takeover",
                "state": "recovered",
                "transaction_id": expected_transaction_id,
                "claim": claim,
            }
        claims = load_claims(root)
        claim = claims.get(root_id)
        if (
            claim
            and isinstance(claim["takeover_evidence"], dict)
            and claim["takeover_evidence"].get("transaction_id") == expected_transaction_id
        ):
            return {
                "ok": True,
                "command": "claim.recover-takeover",
                "state": "already-finalized",
                "transaction_id": expected_transaction_id,
                "claim": claim,
            }
        raise ClaimError("not-found", f"takeover transaction not found: {root_id}", 3)


def heartbeat(args: argparse.Namespace) -> dict[str, Any]:
    root_id = check_id(args.root_id, "root_id")
    expected_fingerprint = check_fingerprint(args.expected_fingerprint)
    with locked_claim_store(create=False, exclusive=True) as root:
        if root is not None:
            recover_pending_takeovers(root)
        claims = load_claims(root)
        claim = claims.get(root_id)
        if not claim or root is None:
            raise ClaimError("not-found", f"claim not found: {root_id}", 3)
        if claim["fingerprint"] != expected_fingerprint:
            raise ClaimError("state-conflict", "claim ownership fingerprint mismatch", 4)
        claim["heartbeat_at"] = timestamp()
        write_claim(root / f"{root_id}.json", claim)
    return {"ok": True, "command": "claim.heartbeat", "state": "active", "claim": claim}


def release(args: argparse.Namespace) -> dict[str, Any]:
    root_id = check_id(args.root_id, "root_id")
    expected_fingerprint = check_fingerprint(args.expected_fingerprint)
    evidence = args.evidence.strip()
    if not evidence:
        raise ClaimError("invalid-input", "release evidence is required", 2)
    with locked_claim_store(create=False, exclusive=True) as root:
        if root is not None:
            recover_pending_takeovers(root)
        claims = load_claims(root)
        if root is None:
            raise ClaimError("not-found", f"claim not found: {root_id}", 3)
        claim = claims.get(root_id)
        receipt_path = release_receipt_path(root, root_id, expected_fingerprint)
        if claim is None:
            receipt = read_release_receipt(receipt_path)
            if (
                receipt is not None
                and receipt["evidence_ref"] == evidence
            ):
                return {
                    "ok": True,
                    "command": "claim.release",
                    "state": "already-released",
                    "root_id": root_id,
                    "release_receipt_ref": str(receipt_path),
                    "release_receipt": receipt,
                }
            raise ClaimError("not-found", f"claim not found: {root_id}", 3)
        if claim["fingerprint"] != expected_fingerprint:
            raise ClaimError("state-conflict", "claim ownership fingerprint mismatch", 4)
        receipt = build_release_receipt(claim, evidence=evidence, reason=args.release_reason)
        persist_release_receipt(root, receipt)
        unlink_durable(root / f"{root_id}.json")
    return {
        "ok": True,
        "command": "claim.release",
        "state": "released",
        "root_id": root_id,
        "release_receipt_ref": str(receipt_path),
        "release_receipt": receipt,
    }


def doctor() -> dict[str, Any]:
    root = claim_root()
    git = shutil.which("git")
    try:
        validate_cache_directory_components(
            root, field="claim cache", persisted=True
        )
        with locked_claim_store(create=False, exclusive=False) as locked_root:
            if locked_root is not None:
                validate_release_receipt_store(locked_root)
        claim_store_error = None
    except ClaimError as exc:
        normalized = normalize_claim_error(exc)
        claim_store_error = normalized.message
        claim_store_error_code = normalized.code
    except OSError as exc:
        normalized = classify_claim_store_error(exc, "claim store is unavailable to this runtime")
        claim_store_error = normalized.message
        claim_store_error_code = normalized.code
    else:
        claim_store_error_code = None
    try:
        task_model_policy = load_task_model_policy()
        policy_error = None
    except ClaimError as exc:
        task_model_policy = None
        policy_error = exc.message
    return {
        "ok": bool(git) and task_model_policy is not None and claim_store_error is None,
        "command": "doctor",
        "version": __version__,
        "offline": True,
        "claim_root": str(root),
        "claim_root_exists": root.exists(),
        "claim_store_error": claim_store_error,
        "claim_store_error_code": claim_store_error_code,
        "fcntl_available": True,
        "git": {"available": bool(git), "path": git},
        "task_model_policy": {
            "available": task_model_policy is not None,
            "error": policy_error,
            "profile": task_model_policy,
        },
    }


def check_fingerprint(value: str) -> str:
    if not isinstance(value, str) or not FINGERPRINT_RE.fullmatch(value):
        raise ClaimError("invalid-input", f"claim fingerprint is invalid: {value}", 2)
    return value


def check_transaction_id(value: str) -> str:
    if not isinstance(value, str) or not TRANSACTION_ID_RE.fullmatch(value):
        raise ClaimError("invalid-input", f"takeover transaction id is invalid: {value}", 2)
    return value


def add_claim_identity(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--root-id", required=True)
    parser.add_argument("--repository", action="append", required=True)
    parser.add_argument("--source", action="append", required=True)
    parser.add_argument("--ledger-ref", required=True)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Coordinate overlapping active-root claims for Implement Feature runs."
    )
    parser.add_argument("--version", action="version", version=__version__)
    parser.add_argument("--json", action="store_true")
    subcommands = parser.add_subparsers(dest="noun", required=True)
    subcommands.add_parser("doctor", help="Check local atomic-claim readiness without writing state.")
    claim = subcommands.add_parser(
        "claim",
        help="Acquire, inspect, recover, heartbeat, release, or take over a claim.",
    )
    verbs = claim.add_subparsers(dest="verb", required=True)
    acquire_parser = verbs.add_parser("acquire", help="Atomically acquire a non-overlapping active-root claim.")
    add_claim_identity(acquire_parser)
    status_parser = verbs.add_parser("status", help="Read one claim or the current claim set.")
    status_parser.add_argument("--root-id")
    recover_parser = verbs.add_parser(
        "recover-takeover", help="Idempotently finalize one prepared takeover transaction."
    )
    recover_parser.add_argument("--root-id", required=True)
    recover_parser.add_argument("--expected-transaction-id", required=True)
    heartbeat_parser = verbs.add_parser("heartbeat", help="Refresh one owned claim heartbeat.")
    heartbeat_parser.add_argument("--root-id", required=True)
    heartbeat_parser.add_argument("--expected-fingerprint", required=True)
    release_parser = verbs.add_parser("release", help="Release one terminal claim.")
    release_parser.add_argument("--root-id", required=True)
    release_parser.add_argument("--expected-fingerprint", required=True)
    release_parser.add_argument(
        "--release-reason", required=True, choices=sorted(RELEASE_REASONS)
    )
    release_parser.add_argument("--evidence", required=True)
    takeover_parser = verbs.add_parser("takeover", help="Replace the exact verified-stale conflicting roots.")
    add_claim_identity(takeover_parser)
    takeover_parser.add_argument("--expected-root-id", action="append", required=True)
    takeover_parser.add_argument(
        "--takeover-permission",
        required=True,
        choices=(TAKEOVER_PERMISSION,),
    )
    takeover_parser.add_argument("--takeover-reason", required=True, choices=sorted(TAKEOVER_REASONS))
    takeover_parser.add_argument("--expected-claim-fingerprint", action="append", required=True)
    takeover_parser.add_argument("--expected-claim-heartbeat", action="append", required=True)
    takeover_parser.add_argument("--expected-task-termination", action="append", required=True)
    takeover_parser.add_argument(
        "--expected-task-adoption",
        action="append",
        required=True,
        metavar="ROOT_ID=ABSOLUTE_JSON_PATH",
    )
    takeover_parser.add_argument("--evidence", required=True)
    return parser


def dispatch(args: argparse.Namespace) -> dict[str, Any]:
    if args.noun == "doctor":
        return doctor()
    if args.verb == "acquire":
        return acquire(args)
    if args.verb == "status":
        return status(args)
    if args.verb == "recover-takeover":
        return recover_takeover(args)
    if args.verb == "heartbeat":
        return heartbeat(args)
    if args.verb == "release":
        return release(args)
    return takeover(args)


def emit(value: dict[str, Any], as_json: bool) -> None:
    print(json.dumps(value, sort_keys=as_json, indent=None if as_json else 2))


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    try:
        emit(dispatch(args), args.json)
        return 0
    except ClaimError as exc:
        exc = normalize_claim_error(exc)
        emit(
            {"ok": False, "error": {"code": exc.code, "message": exc.message, "details": exc.details}},
            getattr(args, "json", False),
        )
        return exc.exit_code
    except OSError as exc:
        mapped = classify_claim_store_error(exc, "claim store is unavailable to this runtime")
        emit(
            {
                "ok": False,
                "error": {
                    "code": mapped.code,
                    "message": mapped.message,
                    "details": mapped.details,
                },
            },
            getattr(args, "json", False),
        )
        return mapped.exit_code


if __name__ == "__main__":
    raise SystemExit(main())
