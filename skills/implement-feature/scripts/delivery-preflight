#!/usr/bin/env python3
"""Inspect GitHub delivery capabilities before Implement Feature persists state."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path
from typing import Any
from urllib.parse import quote

__version__ = "1.0.0"
INPUT_SCHEMA_VERSION = "1.0.0"
OUTPUT_SCHEMA_VERSION = "1.0.0"
MAX_INPUT_BYTES = 1024 * 1024
MAX_OUTPUT_BYTES = 128 * 1024
MAX_DELIVERIES = 512
MAX_REQUESTS_PER_DELIVERY = 12
REQUEST_TIMEOUT_SECONDS = 15
GLOBAL_TIMEOUT_SECONDS = 120
DELIVERY_KEY_RE = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
GITHUB_REPOSITORY_RE = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
CI_CONFIG_PATHS = {
    ".buildkite/pipeline.yml",
    ".circleci/config.yml",
    ".github/workflows",
    ".gitlab-ci.yml",
    ".travis.yml",
    "Jenkinsfile",
    "azure-pipelines.yml",
    "bitbucket-pipelines.yml",
}
CI_TREE_JQ = (
    '[.tree[]?.path | select(. == ".buildkite/pipeline.yml" or '
    '. == ".circleci/config.yml" or . == ".github/workflows" or '
    'startswith(".github/workflows/") or . == ".gitlab-ci.yml" or '
    '. == ".travis.yml" or . == "Jenkinsfile" or '
    '. == "azure-pipelines.yml" or . == "bitbucket-pipelines.yml")]'
)
REPOSITORY_JQ = "{default_branch,permissions,viewerPermission}"
PULLS_JQ = "[.[].number]"
WORKFLOWS_JQ = (
    '[.workflows[]? | select(.state == "active") | (.path // .name)]'
)
COMMIT_SHA_JQ = "[.sha]"
CHECK_RUNS_JQ = "[.check_runs[]?.id]"
STATUSES_JQ = "[.statuses[]?.context]"


class PreflightError(Exception):
    def __init__(self, code: str, message: str, exit_code: int, details: Any = None):
        super().__init__(message)
        self.code = code
        self.message = message
        self.exit_code = exit_code
        self.details = details or {}


def exact_object(value: Any, fields: set[str], label: str) -> dict[str, Any]:
    if not isinstance(value, dict) or set(value) != fields:
        raise PreflightError(
            "invalid-input",
            f"{label} must contain exactly: {', '.join(sorted(fields))}",
            2,
        )
    return value


def nonempty(value: Any, label: str) -> str:
    if not isinstance(value, str) or not value.strip():
        raise PreflightError("invalid-input", f"{label} must be nonempty", 2)
    return value.strip()


def canonical_json(value: Any) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode()


def fingerprint(value: Any) -> str:
    return hashlib.sha256(canonical_json(value)).hexdigest()


def read_packet(path_value: str) -> dict[str, Any]:
    path = Path(path_value).expanduser()
    if not path.is_absolute():
        raise PreflightError("invalid-input", "--input must be an absolute path", 2)
    if path.is_symlink() or not path.is_file():
        raise PreflightError("invalid-input", "--input must be a regular file", 2)
    if path.stat().st_size > MAX_INPUT_BYTES:
        raise PreflightError("invalid-input", "input packet exceeds 1 MiB", 2)
    try:
        value = json.loads(path.read_text())
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise PreflightError("invalid-input", "input packet is unreadable JSON", 2) from exc
    packet = exact_object(value, {"schema_version", "deliveries"}, "packet")
    if packet["schema_version"] != INPUT_SCHEMA_VERSION:
        raise PreflightError("invalid-input", "input schema is unsupported", 2)
    deliveries = packet["deliveries"]
    if not isinstance(deliveries, list) or not deliveries or len(deliveries) > MAX_DELIVERIES:
        raise PreflightError("invalid-input", "deliveries must contain 1..512 items", 2)
    normalized: list[dict[str, str]] = []
    keys: set[str] = set()
    for index, raw in enumerate(deliveries):
        label = f"deliveries[{index}]"
        item = exact_object(
            raw,
            {"delivery_key", "github_repository", "target_branch"},
            label,
        )
        key = nonempty(item["delivery_key"], f"{label}.delivery_key")
        repository = nonempty(item["github_repository"], f"{label}.github_repository")
        branch = nonempty(item["target_branch"], f"{label}.target_branch")
        if not DELIVERY_KEY_RE.fullmatch(key):
            raise PreflightError("invalid-input", f"{label}.delivery_key is not lower-kebab", 2)
        if not GITHUB_REPOSITORY_RE.fullmatch(repository):
            raise PreflightError("invalid-input", f"{label}.github_repository is invalid", 2)
        if key in keys:
            raise PreflightError("invalid-input", f"{label} duplicates a delivery key", 2)
        keys.add(key)
        normalized.append(
            {
                "delivery_key": key,
                "github_repository": repository.lower(),
                "target_branch": branch,
            }
        )
    return {"schema_version": INPUT_SCHEMA_VERSION, "deliveries": normalized}


class GhClient:
    def __init__(self, executable: str, *, deadline: float | None = None):
        self.executable = executable
        self.deadline = deadline or time.monotonic() + GLOBAL_TIMEOUT_SECONDS
        self.request_count = 0

    def get(
        self,
        endpoint: str,
        *,
        allow_not_found: bool = False,
        jq: str | None = None,
    ) -> Any:
        remaining = self.deadline - time.monotonic()
        if remaining <= 0:
            raise PreflightError("timeout", "delivery preflight exceeded 120 seconds", 4)
        self.request_count += 1
        try:
            command = [self.executable, "api", endpoint]
            if jq is not None:
                command.extend(["--jq", jq])
            result = subprocess.run(
                command,
                text=True,
                capture_output=True,
                timeout=min(REQUEST_TIMEOUT_SECONDS, remaining),
                env=os.environ.copy(),
            )
        except subprocess.TimeoutExpired as exc:
            raise PreflightError("timeout", f"GitHub request timed out: {endpoint}", 4) from exc
        stderr = result.stderr.strip()
        if result.returncode:
            if allow_not_found and ("HTTP 404" in stderr or "status code 404" in stderr):
                return None
            code = "auth-unavailable" if any(token in stderr.lower() for token in ("auth", "login", "token")) else "github-unavailable"
            raise PreflightError(code, f"GitHub request failed: {endpoint}", 4)
        if len(result.stdout.encode()) > MAX_OUTPUT_BYTES:
            raise PreflightError("github-unavailable", f"GitHub response is too large: {endpoint}", 4)
        try:
            return json.loads(result.stdout)
        except json.JSONDecodeError as exc:
            raise PreflightError("github-unavailable", f"GitHub returned invalid JSON: {endpoint}", 4) from exc


def has_required_checks(value: Any) -> bool:
    if isinstance(value, dict):
        if value.get("type") == "required_status_checks":
            return True
        contexts = value.get("contexts")
        checks = value.get("checks")
        if isinstance(contexts, list) and contexts:
            return True
        if isinstance(checks, list) and checks:
            return True
        return any(has_required_checks(item) for item in value.values())
    if isinstance(value, list):
        return any(has_required_checks(item) for item in value)
    return False


def tree_has_ci_config(value: Any) -> bool:
    if isinstance(value, dict) and isinstance(value.get("tree"), list):
        paths = [
            item.get("path")
            for item in value["tree"]
            if isinstance(item, dict)
        ]
    elif isinstance(value, list):
        paths = value
    else:
        return False
    for path in paths:
        if not isinstance(path, str):
            continue
        if path in CI_CONFIG_PATHS or path.startswith(".github/workflows/"):
            return True
    return False


def inspect_delivery(client: GhClient, delivery: dict[str, str]) -> dict[str, Any]:
    start_requests = client.request_count
    repository = delivery["github_repository"]
    repo = client.get(f"repos/{repository}", jq=REPOSITORY_JQ)
    if not isinstance(repo, dict):
        raise PreflightError("github-unavailable", f"repository payload is invalid: {repository}", 4)
    default_base = nonempty(repo.get("default_branch"), "repository.default_branch")
    encoded_base = quote(default_base, safe="")
    permissions = repo.get("permissions") if isinstance(repo.get("permissions"), dict) else {}
    permission_level = repo.get("viewerPermission")
    if not isinstance(permission_level, str):
        if permissions.get("admin"):
            permission_level = "admin"
        elif permissions.get("maintain"):
            permission_level = "maintain"
        elif permissions.get("push"):
            permission_level = "write"
        elif permissions.get("pull"):
            permission_level = "read"
        else:
            permission_level = "unknown"
    push = bool(permissions.get("push") or permissions.get("admin") or permissions.get("maintain"))

    branch = delivery["target_branch"]
    protection = client.get(
        f"repos/{repository}/branches/{encoded_base}/protection", allow_not_found=True
    )
    rulesets = client.get(
        f"repos/{repository}/rules/branches/{encoded_base}", allow_not_found=True
    )
    pulls = client.get(
        f"repos/{repository}/pulls?state=open&per_page=1", jq=PULLS_JQ
    )
    workflows = client.get(
        f"repos/{repository}/actions/workflows?per_page=100", jq=WORKFLOWS_JQ
    )
    commit_shas = client.get(
        f"repos/{repository}/commits/{encoded_base}", jq=COMMIT_SHA_JQ
    )
    if (
        not isinstance(commit_shas, list)
        or len(commit_shas) != 1
        or not isinstance(commit_shas[0], str)
        or not re.fullmatch(r"[0-9a-fA-F]{40}", commit_shas[0])
    ):
        raise PreflightError("github-unavailable", f"default base is unreadable: {repository}@{default_base}", 4)
    sha = commit_shas[0].lower()
    checks = client.get(
        f"repos/{repository}/commits/{sha}/check-runs?per_page=100",
        jq=CHECK_RUNS_JQ,
    )
    statuses = client.get(
        f"repos/{repository}/commits/{sha}/status",
        jq=STATUSES_JQ,
    )
    tree = client.get(
        f"repos/{repository}/git/trees/{sha}?recursive=1",
        jq=CI_TREE_JQ,
    )
    used = client.request_count - start_requests
    if used > MAX_REQUESTS_PER_DELIVERY:
        raise PreflightError("request-limit", f"request bound exceeded for {repository}@{branch}", 4)

    blockers: list[str] = []
    if not push:
        blockers.append("push-permission-unavailable")
    if not isinstance(pulls, list):
        blockers.append("pull-request-visibility-unavailable")
    policy_visible = (
        (protection is None or isinstance(protection, dict))
        and (rulesets is None or isinstance(rulesets, list))
    )
    if not policy_visible:
        blockers.append("repository-rules-visibility-unavailable")
    workflows_list = workflows if isinstance(workflows, list) else None
    checks_list = checks if isinstance(checks, list) else None
    statuses_list = statuses if isinstance(statuses, list) else None
    if not isinstance(workflows_list, list) or not isinstance(checks_list, list) or not isinstance(statuses_list, list):
        raise PreflightError("github-unavailable", f"CI surfaces are incomplete: {repository}", 4)
    active_workflows = sorted(
        value for value in workflows_list if isinstance(value, str) and value
    )
    required_checks = has_required_checks(protection) or has_required_checks(rulesets)
    observed_checks = bool(checks_list or statuses_list)
    ci_config = tree_has_ci_config(tree)
    ci_availability = (
        "configured"
        if active_workflows or required_checks or observed_checks or ci_config
        else "not-configured"
    )
    normalized = {
        "github_repository": repository,
        "target_branch": branch,
        "default_base": default_base,
        "permission_level": permission_level.lower(),
        "capabilities": {
            "push": push,
            "pull_request_read": isinstance(pulls, list),
            "repository_rules_read": policy_visible,
        },
        "ci_availability": ci_availability,
        "ci_signals": {
            "active_workflows": active_workflows,
            "required_checks": required_checks,
            "observed_check_provider": observed_checks,
            "repository_config": ci_config,
        },
    }
    preflight_key = fingerprint(normalized)
    return {
        "delivery_key": delivery["delivery_key"],
        **normalized,
        "preflight_key": preflight_key,
        "evidence_ref": f"delivery-preflight://sha256:{preflight_key}",
        "blockers": blockers,
        "request_count": used,
    }


def inspect(packet: dict[str, Any], client: GhClient) -> dict[str, Any]:
    results: list[dict[str, Any]] = []
    cache: dict[tuple[str, str], dict[str, Any]] = {}
    for delivery in packet["deliveries"]:
        identity = (delivery["github_repository"], delivery["target_branch"])
        if identity not in cache:
            cache[identity] = inspect_delivery(client, delivery)
        result = dict(cache[identity])
        result["delivery_key"] = delivery["delivery_key"]
        results.append(result)
    blocked = any(item["blockers"] for item in results)
    return {
        "ok": not blocked,
        "command": "inspect",
        "schema_version": OUTPUT_SCHEMA_VERSION,
        "status": "blocked" if blocked else "passed",
        "request_count": client.request_count,
        "deliveries": results,
    }


def doctor() -> dict[str, Any]:
    executable = shutil.which("gh")
    auth_source = "env" if os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN") else "provider-default"
    authenticated = False
    api_reachable = False
    error = None
    if executable:
        try:
            client = GhClient(executable)
            client.get("rate_limit")
            authenticated = True
            api_reachable = True
        except PreflightError as exc:
            error = str(exc)
    return {
        "ok": bool(executable) and authenticated and api_reachable,
        "command": "doctor",
        "version": __version__,
        "gh": {
            "available": bool(executable),
            "path": executable,
            "authenticated": authenticated,
            "api_reachable": api_reachable,
            "auth_source": auth_source if executable else "missing",
            "error": error,
        },
    }


def emit(value: dict[str, Any], json_output: bool) -> None:
    payload = json.dumps(value, sort_keys=True, separators=(",", ":"))
    if len(payload.encode()) > MAX_OUTPUT_BYTES:
        raise PreflightError("output-limit", "command output exceeds 128 KiB", 4)
    if json_output:
        print(payload)
        return
    if value.get("ok"):
        print(f"{value['command']}: ok")
    else:
        print(f"{value.get('command', 'delivery-preflight')}: blocked", file=sys.stderr)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Inspect GitHub delivery capability and CI availability without writing state."
    )
    parser.add_argument("--version", action="version", version=__version__)
    parser.add_argument("--json", action="store_true")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("doctor", help="Check gh authentication and GitHub API reachability.")
    inspect_parser = commands.add_parser(
        "inspect", help="Inspect a strict delivery packet with bounded read-only GitHub queries."
    )
    inspect_parser.add_argument("--input", required=True, help="Absolute path to the JSON input packet.")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        if args.command == "doctor":
            result = doctor()
            emit(result, args.json)
            return 0
        executable = shutil.which("gh")
        if not executable:
            raise PreflightError("missing-tool", "gh is required", 3)
        packet = read_packet(args.input)
        result = inspect(packet, GhClient(executable))
        emit(result, args.json)
        return 0 if result["ok"] else 4
    except PreflightError as exc:
        result = {
            "ok": False,
            "command": getattr(args, "command", "delivery-preflight"),
            "error": {"code": exc.code, "message": exc.message, "details": exc.details},
        }
        emit(result, args.json)
        return exc.exit_code


if __name__ == "__main__":
    raise SystemExit(main())
