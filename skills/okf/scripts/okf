#!/usr/bin/env python3
from __future__ import annotations

import argparse
import datetime as dt
import errno
import json
import os
import re
import stat
import sys
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any

VERSION = "2.0.0"
SPEC_VERSION = "0.2"
SPEC_REQUIRED = ("type",)
RECOMMENDED = ("title", "description", "resource", "tags")
PREFERRED_KEY_ORDER = (
    "type",
    "title",
    "description",
    "resource",
    "tags",
    "status",
    "generated",
    "verified",
    "stale_after",
    "sources",
    "usage_window",
    "runtime",
    "parameters",
    "computation",
    "executor",
    "attester",
)
FRONTMATTER_DELIM = "---"
MARKDOWN_LINK_RE = re.compile(r"(?<!!)\[[^\]]+\]\(([^)]+)\)")
DATE_HEADING_RE = re.compile(r"^##\s+(\d{4}-\d{2}-\d{2})\s*$")

try:  # pragma: no cover - exercised only when PyYAML is installed.
    import yaml  # type: ignore
except Exception:  # pragma: no cover - default in this repo's Python.
    yaml = None

ANCHORED_IO_SUPPORTED = (
    hasattr(os, "O_DIRECTORY")
    and hasattr(os, "O_NOFOLLOW")
    and os.open in os.supports_dir_fd
    and os.mkdir in os.supports_dir_fd
)


@dataclass
class Message:
    severity: str
    path: str
    message: str


@dataclass
class ValidationResult:
    ok: bool = True
    errors: list[Message] = field(default_factory=list)
    warnings: list[Message] = field(default_factory=list)
    files_checked: int = 0
    concepts_checked: int = 0
    pyyaml: bool = yaml is not None

    def error(self, path: Path | str, message: str) -> None:
        self.ok = False
        self.errors.append(Message("error", str(path), message))

    def warn(self, path: Path | str, message: str) -> None:
        self.warnings.append(Message("warning", str(path), message))

    def to_dict(self) -> dict[str, Any]:
        return {
            "ok": self.ok,
            "pyyaml": self.pyyaml,
            "files_checked": self.files_checked,
            "concepts_checked": self.concepts_checked,
            "errors": [message.__dict__ for message in self.errors],
            "warnings": [message.__dict__ for message in self.warnings],
        }


class OkfError(ValueError):
    pass


class UnsafePathError(OkfError):
    pass


class OkfArgumentParser(argparse.ArgumentParser):
    json_errors = False

    def error(self, message: str) -> None:
        if self.json_errors:
            print(
                json.dumps(
                    {
                        "ok": False,
                        "command": "parse",
                        "error": {"code": "invalid_arguments", "message": message},
                    },
                    indent=2,
                )
            )
            raise SystemExit(2)
        super().error(message)


def _parse_scalar(value: str) -> Any:
    value = value.strip()
    if not value:
        return ""
    if value.startswith(('"', "'")):
        if not value.endswith(value[0]) or len(value) == 1:
            raise OkfError("Limited parser found an unterminated quoted scalar.")
        return value[1:-1]
    if value.startswith("{"):
        if not value.endswith("}"):
            raise OkfError("Limited parser found an unterminated flow mapping.")
        try:
            return json.loads(value)
        except json.JSONDecodeError as exc:
            raise OkfError(
                "Limited parser supports mappings only in JSON-compatible flow syntax."
            ) from exc
    if value.startswith("["):
        if not value.endswith("]"):
            raise OkfError("Limited parser found an unterminated flow list.")
        try:
            return json.loads(value)
        except json.JSONDecodeError:
            pass
        inner = value[1:-1].strip()
        if not inner:
            return []
        if "{" in inner or "}" in inner:
            raise OkfError(
                "Limited parser does not support mappings nested in flow lists."
            )
        return [_parse_scalar(part.strip()) for part in inner.split(",")]
    if value in {"true", "false"}:
        return value == "true"
    return value


def limited_yaml_load(text: str) -> tuple[dict[str, Any], list[str]]:
    data: dict[str, Any] = {}
    warnings = ["PyYAML is not installed; using limited frontmatter parser."]
    current_list_key: str | None = None
    for line_no, raw in enumerate(text.splitlines(), 1):
        line = raw.rstrip()
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        leading = line[: len(line) - len(line.lstrip())]
        if "\t" in leading:
            raise OkfError(
                f"Limited parser does not support tab indentation on line {line_no}."
            )
        indentation = len(leading)
        if current_list_key and stripped.startswith("- "):
            item = stripped[2:].strip()
            if re.match(r"^[A-Za-z_][^:]*:(?:\s|$)", item):
                raise OkfError(
                    f"Limited parser does not support nested mappings on line {line_no}."
                )
            if not isinstance(data.get(current_list_key), list):
                data[current_list_key] = []
            data[current_list_key].append(_parse_scalar(item))
            continue
        if indentation:
            raise OkfError(
                f"Limited parser does not support nested YAML on line {line_no}; "
                "use JSON-compatible flow syntax or install PyYAML."
            )
        current_list_key = None
        if ":" not in stripped:
            raise OkfError(f"Limited parser could not parse frontmatter line {line_no}: {raw}")
        key, value = stripped.split(":", 1)
        key = key.strip()
        if not key:
            raise OkfError(f"Empty frontmatter key on line {line_no}")
        if not value.strip():
            data[key] = ""
            current_list_key = key
        else:
            data[key] = _parse_scalar(value)
    return data, warnings


def parse_frontmatter(text: str) -> tuple[dict[str, Any], str, list[str]]:
    lines = text.splitlines()
    if not lines or lines[0].strip() != FRONTMATTER_DELIM:
        raise OkfError("Missing YAML frontmatter block")
    end_idx: int | None = None
    for idx in range(1, len(lines)):
        if lines[idx].strip() == FRONTMATTER_DELIM:
            end_idx = idx
            break
    if end_idx is None:
        raise OkfError("Unterminated YAML frontmatter block")

    raw_frontmatter = "\n".join(lines[1:end_idx])
    if yaml is not None:
        try:
            loaded = yaml.safe_load(raw_frontmatter) or {}
        except Exception as exc:
            raise OkfError(f"Invalid YAML frontmatter: {exc}") from exc
        if not isinstance(loaded, dict):
            raise OkfError("Frontmatter must be a YAML mapping")
        frontmatter = dict(loaded)
        warnings: list[str] = []
    else:
        frontmatter, warnings = limited_yaml_load(raw_frontmatter)

    body = "\n".join(lines[end_idx + 1 :])
    if body.startswith("\n"):
        body = body[1:]
    return frontmatter, body, warnings


def is_reserved(path: Path) -> bool:
    return path.name in {"index.md", "log.md"}


def discover_bundle_paths(bundle: Path) -> tuple[list[Path], list[Path]]:
    markdown_files: list[Path] = []
    symlinked_directories: list[Path] = []
    for root, directory_names, file_names in os.walk(
        bundle,
        topdown=True,
        followlinks=False,
    ):
        root_path = Path(root)
        traversable_directories: list[str] = []
        for name in directory_names:
            path = root_path / name
            if path.is_symlink():
                symlinked_directories.append(path)
            else:
                traversable_directories.append(name)
        directory_names[:] = traversable_directories
        markdown_files.extend(
            root_path / name
            for name in file_names
            if name.endswith(".md")
        )
    return sorted(markdown_files), sorted(symlinked_directories)


def first_symlink_component(root: Path, path: Path) -> Path | None:
    current = root
    for part in path.relative_to(root).parts:
        current = current / part
        if current.is_symlink():
            return current
    return None


def supports_anchored_io() -> bool:
    return ANCHORED_IO_SUPPORTED


def open_anchored_parent(
    bundle: Path,
    path: Path,
    *,
    create_parents: bool,
) -> tuple[int, str]:
    if not supports_anchored_io():
        raise UnsafePathError(
            "This platform cannot safely anchor bundle-relative file access."
        )

    relative = path.relative_to(bundle)
    if not relative.parts or any(part in {"", ".", ".."} for part in relative.parts):
        raise UnsafePathError("File path must be a safe bundle-relative path.")
    if create_parents:
        bundle.mkdir(parents=True, exist_ok=True)

    directory_flags = (
        os.O_RDONLY
        | os.O_DIRECTORY
        | os.O_NOFOLLOW
        | getattr(os, "O_CLOEXEC", 0)
    )
    descriptor = os.open(bundle, directory_flags)
    try:
        for part in relative.parts[:-1]:
            try:
                next_descriptor = os.open(part, directory_flags, dir_fd=descriptor)
            except FileNotFoundError:
                if not create_parents:
                    raise
                try:
                    os.mkdir(part, 0o777, dir_fd=descriptor)
                except FileExistsError:
                    pass
                next_descriptor = os.open(part, directory_flags, dir_fd=descriptor)
            os.close(descriptor)
            descriptor = next_descriptor
        return descriptor, relative.parts[-1]
    except OSError as exc:
        os.close(descriptor)
        if exc.errno in {errno.ELOOP, errno.ENOTDIR}:
            raise UnsafePathError(
                "Bundle-relative path changed or contains a symlink."
            ) from exc
        raise


def open_anchored_file(
    bundle: Path,
    path: Path,
    flags: int,
    *,
    mode: int = 0o666,
    create_parents: bool = False,
) -> int:
    parent_descriptor, leaf = open_anchored_parent(
        bundle,
        path,
        create_parents=create_parents,
    )
    try:
        return os.open(
            leaf,
            flags | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0),
            mode,
            dir_fd=parent_descriptor,
        )
    except OSError as exc:
        if exc.errno in {errno.ELOOP, errno.ENOTDIR}:
            raise UnsafePathError(
                "Bundle-relative path changed or contains a symlink."
            ) from exc
        raise
    finally:
        os.close(parent_descriptor)


def validate_markdown_path(
    bundle: Path,
    path: Path,
    result: ValidationResult,
) -> bool:
    rel = path.relative_to(bundle)
    symlink = first_symlink_component(bundle, path)
    if symlink is not None:
        result.error(
            rel,
            f"Markdown paths must not contain symlinks: {symlink.relative_to(bundle)}.",
        )
        return False
    try:
        resolved = path.resolve(strict=True)
        resolved.relative_to(bundle.resolve(strict=True))
    except (FileNotFoundError, ValueError):
        result.error(rel, "Markdown path is missing or resolves outside the bundle.")
        return False
    if not resolved.is_file():
        result.error(rel, "Markdown path must resolve to a regular file.")
        return False
    return True


def validate_reserved_file(bundle: Path, path: Path, result: ValidationResult) -> None:
    rel = path.relative_to(bundle)
    text = read_utf8(bundle, path, rel, result)
    if text is None:
        return
    if path.name == "index.md":
        body = text
        if text.splitlines()[:1] == [FRONTMATTER_DELIM]:
            try:
                fm, body, warnings = parse_frontmatter(text)
            except OkfError as exc:
                result.error(rel, f"Invalid index.md frontmatter: {exc}")
                return
            if rel != Path("index.md"):
                result.error(rel, "Only the bundle-root index.md may include frontmatter.")
            extra = set(fm).difference({"okf_version"})
            if extra:
                result.error(rel, f"index.md frontmatter may only contain okf_version, found {sorted(extra)!r}.")
            for warning in warnings:
                result.warn(rel, warning)
        validate_index_body(rel, body, result)
    elif path.name == "log.md":
        validate_log_body(rel, text, result)


def validate_index_body(rel: Path, body: str, result: ValidationResult) -> None:
    if not body.strip():
        result.error(rel, "index.md must contain at least one section heading and entry.")
        return
    saw_heading = False
    for line_no, line in enumerate(body.splitlines(), 1):
        stripped = line.strip()
        if not stripped:
            continue
        if stripped.startswith("#"):
            saw_heading = True
            continue
        if stripped.startswith(("* ", "- ")):
            if not saw_heading:
                result.error(rel, f"index.md bullet entry on line {line_no} appears before a section heading.")
            continue
        result.error(rel, f"index.md line {line_no} must be a section heading or bullet entry.")
    if not saw_heading:
        result.error(rel, "index.md must contain at least one section heading.")


def validate_log_body(rel: Path, body: str, result: ValidationResult) -> None:
    if not body.strip():
        result.error(rel, "log.md must contain at least one dated update group.")
        return
    saw_date = False
    for line_no, line in enumerate(body.splitlines(), 1):
        stripped = line.strip()
        if not stripped:
            continue
        if stripped.startswith("# "):
            continue
        if stripped.startswith("## "):
            if DATE_HEADING_RE.match(stripped):
                saw_date = True
            else:
                result.error(rel, f"log.md date heading on line {line_no} must use YYYY-MM-DD.")
            continue
        if stripped.startswith("#"):
            result.error(rel, f"log.md line {line_no} has an unsupported heading level.")
            continue
        if not saw_date:
            result.error(rel, f"log.md entry on line {line_no} appears before a YYYY-MM-DD date heading.")
    if not saw_date:
        result.error(rel, "log.md must contain at least one YYYY-MM-DD date heading.")


def link_target_exists(bundle: Path, source: Path, target: str) -> bool | None:
    clean = target.split("#", 1)[0].strip()
    if not clean or clean.startswith(("#", "http://", "https://", "mailto:")):
        return None
    if not clean.endswith(".md"):
        return None
    bundle_root = bundle.resolve()
    if clean.startswith("/"):
        candidate = (bundle / clean.lstrip("/")).resolve()
    else:
        candidate = (source.parent / clean).resolve()
    try:
        candidate.relative_to(bundle_root)
    except ValueError:
        return False
    return candidate.exists()


def read_utf8(
    bundle: Path,
    path: Path,
    rel: Path,
    result: ValidationResult,
) -> str | None:
    try:
        descriptor = open_anchored_file(bundle, path, os.O_RDONLY)
    except (OSError, UnsafePathError) as exc:
        result.error(rel, f"File could not be opened safely: {exc}.")
        return None
    try:
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            result.error(rel, "Markdown path must remain a regular file while reading.")
            return None
        with os.fdopen(descriptor, encoding="utf-8") as handle:
            descriptor = -1
            return handle.read()
    except UnicodeDecodeError as exc:
        result.error(rel, f"File is not valid UTF-8: {exc}")
        return None
    except OSError as exc:
        result.error(rel, f"File could not be read safely: {exc}.")
        return None
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def validate_concept_file(
    bundle: Path,
    path: Path,
    result: ValidationResult,
    *,
    strict_links: bool,
) -> None:
    rel = path.relative_to(bundle)
    result.concepts_checked += 1
    text = read_utf8(bundle, path, rel, result)
    if text is None:
        return
    try:
        frontmatter, body, parser_warnings = parse_frontmatter(text)
    except OkfError as exc:
        result.error(rel, str(exc))
        return

    invalid_required: list[str] = []
    for key in SPEC_REQUIRED:
        value = frontmatter.get(key)
        if not isinstance(value, str) or not value.strip():
            invalid_required.append(key)
    if invalid_required:
        result.error(
            rel,
            f"Required frontmatter keys must be non-empty strings: {', '.join(invalid_required)}.",
        )

    for key in RECOMMENDED:
        if key not in frontmatter:
            result.warn(rel, f"Recommended frontmatter key is missing: {key}.")

    for warning in parser_warnings:
        result.warn(rel, warning)

    for target in MARKDOWN_LINK_RE.findall(body):
        exists = link_target_exists(bundle, path, target)
        if exists is False:
            message = f"Broken local markdown link: {target}."
            if strict_links:
                result.error(rel, message)
            else:
                result.warn(rel, message)


def validate_bundle(bundle: Path, *, strict_links: bool) -> ValidationResult:
    result = ValidationResult()
    if bundle.is_symlink():
        result.error(bundle, "Bundle root must not be a symlink.")
        return result
    if not bundle.exists() or not bundle.is_dir():
        result.error(bundle, "Bundle path does not exist or is not a directory.")
        return result

    files, symlinked_directories = discover_bundle_paths(bundle)
    result.files_checked = len(files)
    for path in symlinked_directories:
        result.error(
            path.relative_to(bundle),
            "Bundle directories must not be symlinks because they can hide concepts.",
        )
    if not files:
        result.warn(bundle, "No markdown files found in bundle.")
        return result

    for path in files:
        if not validate_markdown_path(bundle, path, result):
            continue
        if is_reserved(path):
            validate_reserved_file(bundle, path, result)
        else:
            validate_concept_file(bundle, path, result, strict_links=strict_links)
    return result


def print_validation(result: ValidationResult, *, as_json: bool) -> int:
    if as_json:
        print(json.dumps(result.to_dict(), indent=2))
    else:
        status = "PASS" if result.ok else "FAIL"
        print(f"OKF validation {status}")
        print(f"- PyYAML available: {'yes' if result.pyyaml else 'no'}")
        print(f"- files checked: {result.files_checked}")
        print(f"- concepts checked: {result.concepts_checked}")
        for message in result.errors + result.warnings:
            print(f"{message.severity.upper()}: {message.path}: {message.message}")
    return 0 if result.ok else 65


def ordered_frontmatter(frontmatter: dict[str, Any]) -> dict[str, Any]:
    ordered: dict[str, Any] = {}
    for key in PREFERRED_KEY_ORDER:
        if key in frontmatter and frontmatter[key] not in (None, "", []):
            ordered[key] = frontmatter[key]
    for key, value in frontmatter.items():
        if key not in ordered and value not in (None, "", []):
            ordered[key] = value
    return ordered


def serialize_frontmatter(frontmatter: dict[str, Any]) -> str:
    lines = [FRONTMATTER_DELIM]
    for key, value in ordered_frontmatter(frontmatter).items():
        lines.append(f"{key}: {json.dumps(value, ensure_ascii=False)}")
    lines.append(FRONTMATTER_DELIM)
    return "\n".join(lines) + "\n"


def concept_path(bundle: Path, concept_id: str) -> Path:
    cid = concept_id.strip().strip("/")
    if cid.endswith(".md"):
        cid = cid[:-3]
    if not cid or cid.startswith(".") or ".." in Path(cid).parts:
        raise OkfError("Concept ID must be a safe bundle-relative path.")
    path = bundle / f"{cid}.md"
    if path.name in {"index.md", "log.md"}:
        raise OkfError("Reserved filenames index.md and log.md cannot be concept IDs.")
    bundle_root = bundle.resolve()
    resolved_path = path.parent.resolve() / path.name
    try:
        resolved_path.relative_to(bundle_root)
    except ValueError as exc:
        raise UnsafePathError("Concept path resolves outside the bundle root.") from exc
    symlink = first_symlink_component(bundle, path)
    if symlink is not None:
        raise UnsafePathError(
            f"Concept path contains a symlink: {symlink.relative_to(bundle)}."
        )
    return path


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def normalized_generated_at(value: str) -> str:
    if value == "now":
        return utc_now()
    if "T" not in value and " " not in value:
        raise OkfError("--generated-at must be an ISO 8601 datetime or \"now\".")
    parse_value = value[:-1] + "+00:00" if value.endswith("Z") else value
    try:
        dt.datetime.fromisoformat(parse_value)
    except ValueError as exc:
        raise OkfError("--generated-at must be an ISO 8601 datetime or \"now\".") from exc
    return value


def write_text_no_follow(
    bundle: Path,
    path: Path,
    text: str,
    *,
    force: bool,
) -> None:
    flags = os.O_WRONLY | os.O_CREAT
    flags |= os.O_TRUNC if force else os.O_EXCL
    try:
        descriptor = open_anchored_file(
            bundle,
            path,
            flags,
            create_parents=True,
        )
    except OSError as exc:
        if exc.errno == errno.ELOOP:
            raise UnsafePathError("Concept destination must not be a symlink.") from exc
        raise
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            descriptor = -1
            handle.write(text)
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def command_doctor(args: argparse.Namespace) -> int:
    anchored_io = supports_anchored_io()
    payload = {
        "ok": anchored_io,
        "version": VERSION,
        "spec_version": SPEC_VERSION,
        "checks": {
            "python": sys.version.split()[0],
            "pyyaml": bool(yaml is not None),
            "executable": os.access(Path(__file__), os.X_OK),
            "anchored_io": anchored_io,
        },
    }
    if args.json:
        print(json.dumps(payload, indent=2))
    else:
        print(f"okf {VERSION}")
        print(f"- Python: {payload['checks']['python']}")
        print(f"- PyYAML available: {'yes' if yaml is not None else 'no'}")
        print(f"- Anchored file access: {'yes' if anchored_io else 'no'}")
        if yaml is None:
            print("- YAML parser: limited stdlib fallback")
    return 0 if anchored_io else 69


def command_validate(args: argparse.Namespace) -> int:
    result = validate_bundle(Path(args.bundle), strict_links=args.strict_links)
    return print_validation(result, as_json=args.json)


def print_command_error(
    args: argparse.Namespace,
    command: str,
    message: str,
    exit_code: int,
    error_code: str,
) -> int:
    if args.json:
        print(
            json.dumps(
                {
                    "ok": False,
                    "command": command,
                    "error": {
                        "code": error_code,
                        "exit_code": exit_code,
                        "message": message,
                    },
                },
                indent=2,
            )
        )
    else:
        print(f"okf: {message}", file=sys.stderr)
    return exit_code


def command_scaffold(args: argparse.Namespace) -> int:
    bundle = Path(args.bundle)
    if bundle.is_symlink():
        return print_command_error(
            args,
            "scaffold",
            "Bundle root must not be a symlink.",
            64,
            "unsafe_path",
        )
    try:
        path = concept_path(bundle, args.concept_id)
    except UnsafePathError as exc:
        return print_command_error(
            args,
            "scaffold",
            str(exc),
            64,
            "unsafe_path",
        )
    if path.exists() and not args.force:
        return print_command_error(
            args,
            "scaffold",
            f"Refusing to overwrite existing concept: {path}",
            73,
            "overwrite_refused",
        )

    if bool(args.generated_by) != bool(args.generated_at):
        return print_command_error(
            args,
            "scaffold",
            "--generated-by and --generated-at must be supplied together.",
            64,
            "invalid_generation",
        )

    try:
        generated_at = (
            normalized_generated_at(args.generated_at)
            if args.generated_at
            else None
        )
    except OkfError as exc:
        return print_command_error(
            args,
            "scaffold",
            str(exc),
            64,
            "invalid_generation",
        )

    frontmatter: dict[str, Any] = {
        "type": args.type,
        "title": args.title,
        "description": args.description,
        "resource": args.resource,
        "tags": args.tag or [],
    }
    if args.generated_by and generated_at:
        frontmatter["generated"] = {"by": args.generated_by, "at": generated_at}

    missing = [key for key in SPEC_REQUIRED if not frontmatter.get(key)]
    if missing:
        return print_command_error(
            args,
            "scaffold",
            f"Missing required scaffold fields: {', '.join(missing)}",
            64,
            "missing_required_field",
        )

    if args.body_file:
        try:
            body = Path(args.body_file).read_text(encoding="utf-8")
        except UnicodeDecodeError as exc:
            return print_command_error(
                args,
                "scaffold",
                f"Body file is not valid UTF-8: {exc}",
                65,
                "invalid_utf8",
            )
    else:
        body = f"# {args.title or args.concept_id}\n\n"

    try:
        write_text_no_follow(
            bundle,
            path,
            serialize_frontmatter(frontmatter) + "\n" + body,
            force=args.force,
        )
    except FileExistsError:
        return print_command_error(
            args,
            "scaffold",
            f"Refusing to overwrite existing concept: {path}",
            73,
            "overwrite_refused",
        )
    except UnsafePathError as exc:
        return print_command_error(
            args,
            "scaffold",
            str(exc),
            64,
            "unsafe_path",
        )
    if args.json:
        print(
            json.dumps(
                {
                    "ok": True,
                    "command": "scaffold",
                    "version": VERSION,
                    "spec_version": SPEC_VERSION,
                    "path": str(path),
                },
                indent=2,
            )
        )
    else:
        print(path)
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = OkfArgumentParser(
        prog="okf",
        description=f"Work with Open Knowledge Format v{SPEC_VERSION} bundles.",
    )
    parser.add_argument("--version", action="version", version=VERSION)
    parser.add_argument("--json", action="store_true", help="Emit machine-readable JSON.")
    subparsers = parser.add_subparsers(dest="command", required=True)

    doctor = subparsers.add_parser("doctor")
    doctor.set_defaults(func=command_doctor)

    validate = subparsers.add_parser("validate")
    validate.add_argument("bundle")
    validate.add_argument("--strict-links", action="store_true")
    validate.set_defaults(func=command_validate)

    scaffold = subparsers.add_parser("scaffold")
    scaffold.add_argument("bundle")
    scaffold.add_argument("concept_id")
    scaffold.add_argument("--type", required=True)
    scaffold.add_argument("--title")
    scaffold.add_argument("--description")
    scaffold.add_argument("--resource")
    scaffold.add_argument("--tag", action="append", default=[])
    scaffold.add_argument("--generated-by")
    scaffold.add_argument("--generated-at", help='ISO 8601 datetime or "now".')
    scaffold.add_argument("--body-file")
    scaffold.add_argument("--force", action="store_true")
    scaffold.set_defaults(func=command_scaffold)
    return parser


def main(argv: list[str] | None = None) -> int:
    parse_argv = list(sys.argv[1:] if argv is None else argv)
    OkfArgumentParser.json_errors = "--json" in parse_argv
    parser = build_parser()
    args = parser.parse_args(parse_argv)
    try:
        return args.func(args)
    except UnsafePathError as exc:
        return print_command_error(args, args.command, str(exc), 64, "unsafe_path")
    except OkfError as exc:
        return print_command_error(args, args.command, str(exc), 64, "invalid_input")
    except OSError as exc:
        return print_command_error(args, args.command, str(exc), 74, "io_error")


if __name__ == "__main__":
    raise SystemExit(main())
