#!/bin/sh
set -eu

script_dir=$(CDPATH='' cd "$(dirname "$0")" && pwd)
bin_dir="$script_dir/bin"

os=$(uname -s | tr '[:upper:]' '[:lower:]')
arch=$(uname -m)

case "$os" in
  darwin)
    platform_os="darwin"
    ;;
  linux)
    platform_os="linux"
    ;;
  *)
    echo "postgres skill: unsupported operating system: $os" >&2
    exit 1
    ;;
esac

case "$arch" in
  arm64 | aarch64)
    platform_arch="arm64"
    ;;
  x86_64 | amd64)
    platform_arch="x86_64"
    ;;
  *)
    echo "postgres skill: unsupported CPU architecture: $arch" >&2
    exit 1
    ;;
esac

bin="$bin_dir/postgres-$platform_os-$platform_arch"

if [ ! -x "$bin" ]; then
  echo "postgres skill: missing runtime binary for $platform_os-$platform_arch" >&2
  echo "expected executable: $bin" >&2
  echo "build it from skills/postgres/projects/postgres and install it at that path" >&2
  exit 127
fi

exec "$bin" "$@"
