schema_version = "3.0.0"

[defaults]
profile = "local"

[tools.postgres]
ssl_mode = "disable"
migrations_path = "db/migrations"

[tools.postgres.profiles.local]
project = "app"
description = "local dev"
access_mode = "read-write"
host = "localhost"
port = 5432
database = "app_local"
