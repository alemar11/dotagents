#!/usr/bin/env python3
"""Run Chrome DevTools MCP actions through one long-lived MCP server session.

The script talks to the Homebrew-installed chrome-devtools-mcp server over
newline-delimited JSON-RPC on stdio. One server process is started per run, then
all requested actions are executed through that same MCP/browser session.
"""

from __future__ import annotations

import argparse
import json
import os
import queue
import signal
import shlex
import shutil
import subprocess
import sys
import threading
import time
from pathlib import Path
from typing import Any


RUNNER_VERSION = "1.0.0"
DEFAULT_MCP_COMMAND = (
    shutil.which("chrome-devtools-mcp")
    or next(
        (
            path
            for path in (
                "/opt/homebrew/bin/chrome-devtools-mcp",
                "/usr/local/bin/chrome-devtools-mcp",
            )
            if Path(path).exists()
        ),
        "chrome-devtools-mcp",
    )
)
DEFAULT_PROTOCOL_VERSION = "2025-06-18"


class McpError(RuntimeError):
    pass


def is_session_command(command: str) -> bool:
    try:
        tokens = shlex.split(command)
    except ValueError:
        tokens = command.split()

    if not tokens:
        return False

    command_name = Path(tokens[0]).name
    script_names = {"chrome-devtools-session", "chrome_devtools_mcp_session.py"}

    if command_name in {"chrome-devtools-session", "chrome-devtools-mcp"}:
        return True

    for index, token in enumerate(tokens[1:], start=1):
        previous_name = Path(tokens[index - 1]).name
        if Path(token).name in script_names and previous_name.startswith("python"):
            return True

    if len(tokens) >= 3 and command_name == "npm" and tokens[1] == "exec":
        return tokens[2].startswith("chrome-devtools-mcp")

    return False


def read_processes() -> list[dict[str, Any]]:
    output = subprocess.check_output(
        ["ps", "-axo", "pid=,ppid=,etime=,stat=,command="],
        text=True,
    )
    processes = []
    for line in output.splitlines():
        parts = line.strip().split(None, 4)
        if len(parts) < 5:
            continue
        pid, ppid, elapsed, status, command = parts
        try:
            processes.append(
                {
                    "pid": int(pid),
                    "ppid": int(ppid),
                    "elapsed": elapsed,
                    "status": status,
                    "command": command,
                }
            )
        except ValueError:
            continue
    return processes


def session_processes() -> list[dict[str, Any]]:
    current_pid = os.getpid()
    return [
        process
        for process in read_processes()
        if process["pid"] != current_pid and is_session_command(process["command"])
    ]


def print_session_processes(processes: list[dict[str, Any]]) -> None:
    if not processes:
        print("No running Chrome DevTools MCP runner/server sessions found.")
        return

    print("PID     PPID    ELAPSED   STAT  COMMAND")
    for process in sorted(processes, key=lambda item: item["pid"]):
        print(
            f"{process['pid']:<7} {process['ppid']:<7} "
            f"{process['elapsed']:<9} {process['status']:<5} {process['command']}"
        )


def collect_related_pids(target_pid: int, processes: list[dict[str, Any]]) -> set[int]:
    by_pid = {process["pid"]: process for process in processes}
    if target_pid not in by_pid:
        return set()

    children_by_parent: dict[int, list[int]] = {}
    for process in processes:
        children_by_parent.setdefault(process["ppid"], []).append(process["pid"])

    selected: set[int] = set()

    def add_descendants(pid: int) -> None:
        if pid in selected:
            return
        selected.add(pid)
        for child_pid in children_by_parent.get(pid, []):
            add_descendants(child_pid)

    add_descendants(target_pid)

    current = by_pid.get(target_pid)
    while current:
        parent = by_pid.get(current["ppid"])
        if not parent or not is_session_command(parent["command"]):
            break
        selected.add(parent["pid"])
        current = parent

    return selected


def terminate_pids(pids: set[int], timeout: float = 3.0) -> None:
    current_pid = os.getpid()
    pids = {pid for pid in pids if pid != current_pid}
    if not pids:
        print("No matching session processes to close.")
        return

    for pid in sorted(pids):
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass

    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        remaining = [pid for pid in pids if process_exists(pid)]
        if not remaining:
            print(f"Closed {len(pids)} session process(es).")
            return
        time.sleep(0.1)

    remaining = [pid for pid in pids if process_exists(pid)]
    for pid in remaining:
        try:
            os.kill(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
    print(f"Closed {len(pids)} session process(es); force-killed {len(remaining)}.")


def process_exists(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


class McpClient:
    def __init__(
        self,
        command: str,
        args: list[str],
        timeout: float,
        protocol_version: str,
    ) -> None:
        self.command = command
        self.args = args
        self.timeout = timeout
        self.protocol_version = protocol_version
        self._next_id = 1
        self._messages: queue.Queue[dict[str, Any] | Exception | None] = queue.Queue()
        self._process: subprocess.Popen[str] | None = None
        self._reader: threading.Thread | None = None
        self._notifications: list[dict[str, Any]] = []

    def __enter__(self) -> "McpClient":
        env = os.environ.copy()
        env["CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS"] = "1"

        self._process = subprocess.Popen(
            [self.command, *self.args],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=sys.stderr,
            text=True,
            bufsize=1,
            env=env,
        )

        self._reader = threading.Thread(target=self._read_stdout, daemon=True)
        self._reader.start()

        self.request(
            "initialize",
            {
                "protocolVersion": self.protocol_version,
                "capabilities": {},
                "clientInfo": {
                    "name": "single-session-chrome-devtools-mcp",
                    "version": RUNNER_VERSION,
                },
            },
        )
        self.notify("notifications/initialized", {})
        return self

    def __exit__(self, exc_type: Any, exc: Any, tb: Any) -> None:
        if not self._process:
            return

        if self._process.poll() is None:
            self._process.terminate()
            try:
                self._process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                self._process.kill()
                self._process.wait(timeout=5)

    def _read_stdout(self) -> None:
        assert self._process and self._process.stdout
        try:
            for line in self._process.stdout:
                line = line.strip()
                if not line:
                    continue
                try:
                    self._messages.put(json.loads(line))
                except json.JSONDecodeError as exc:
                    self._messages.put(McpError(f"invalid JSON from MCP server: {line}"))
                    self._messages.put(exc)
        finally:
            self._messages.put(None)

    def _write(self, message: dict[str, Any]) -> None:
        if not self._process or not self._process.stdin:
            raise McpError("MCP server is not running")
        if self._process.poll() is not None:
            raise McpError(f"MCP server exited with code {self._process.returncode}")

        self._process.stdin.write(json.dumps(message, separators=(",", ":")) + "\n")
        self._process.stdin.flush()

    def request(self, method: str, params: dict[str, Any] | None = None) -> dict[str, Any]:
        request_id = self._next_id
        self._next_id += 1
        self._write(
            {
                "jsonrpc": "2.0",
                "id": request_id,
                "method": method,
                "params": params or {},
            }
        )

        while True:
            try:
                message = self._messages.get(timeout=self.timeout)
            except queue.Empty as exc:
                raise McpError(f"timed out waiting for MCP response to {method}") from exc

            if message is None:
                raise McpError("MCP server closed stdout")
            if isinstance(message, Exception):
                raise message
            if message.get("id") != request_id:
                self._notifications.append(message)
                continue
            if "error" in message:
                raise McpError(f"MCP {method} failed: {json.dumps(message['error'])}")
            return message["result"]

    def notify(self, method: str, params: dict[str, Any] | None = None) -> None:
        self._write({"jsonrpc": "2.0", "method": method, "params": params or {}})

    def call_tool(self, name: str, arguments: dict[str, Any] | None = None) -> dict[str, Any]:
        return self.request("tools/call", {"name": name, "arguments": arguments or {}})


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Run navigate/evaluate/screenshot actions through one "
            "Homebrew chrome-devtools-mcp session."
        )
    )
    parser.add_argument("--mcp-command", default=DEFAULT_MCP_COMMAND)
    parser.add_argument("--mcp-arg", action="append", default=[], help="extra raw MCP server arg")
    parser.add_argument("--protocol-version", default=DEFAULT_PROTOCOL_VERSION)
    parser.add_argument("--timeout", type=float, default=30)
    parser.add_argument("--url", help="URL to navigate to before eval/screenshot actions")
    parser.add_argument("--new-page", action="store_true", help="open --url in a new tab when full tools are active")
    parser.add_argument("--page-id", type=int, help="select this MCP page ID before running CLI actions")
    parser.add_argument(
        "--use-selected-page",
        action="store_true",
        help="allow --url to navigate the currently selected page in --current-chrome mode",
    )
    parser.add_argument("--eval", action="append", default=[], dest="evals", help="JS to evaluate")
    parser.add_argument("--eval-file", action="append", default=[], help="path to JS file to evaluate")
    parser.add_argument("--screenshot", help="copy screenshot to this path after eval actions")
    parser.add_argument("--steps", help="JSON file containing a steps array")
    parser.add_argument("--list-tools", action="store_true", help="list MCP tools and exit")
    parser.add_argument("--version", action="store_true", help="print runner version and exit")
    parser.add_argument(
        "--interactive",
        action="store_true",
        help="keep the MCP session alive and read JSON commands, or @step-file paths, from stdin",
    )
    parser.add_argument(
        "--current-chrome",
        action="store_true",
        help="shortcut for attaching to the existing debuggable Chrome via --autoConnect",
    )
    parser.add_argument("--json", action="store_true", help="print raw JSON results")
    parser.add_argument("--headful", action="store_true", help="show Chrome instead of headless mode")
    parser.add_argument("--no-isolated", action="store_true", help="reuse the default MCP profile")
    parser.add_argument("--full-tools", action="store_true", help="do not pass --slim to the MCP server")
    parser.add_argument("--viewport", default="1280x720")
    parser.add_argument(
        "--list-running-sessions",
        action="store_true",
        help="list running skill runner and chrome-devtools-mcp processes",
    )
    parser.add_argument(
        "--close-session",
        type=int,
        metavar="PID",
        help="close one running session by runner or MCP server PID",
    )
    parser.add_argument(
        "--close-all-sessions",
        action="store_true",
        help="close all running skill runner and chrome-devtools-mcp processes",
    )

    args = parser.parse_args()
    has_process_action = any([args.list_running_sessions, args.close_session, args.close_all_sessions])
    has_action = any(
        [
            args.url,
            args.evals,
            args.eval_file,
            args.screenshot,
            args.steps,
            args.list_tools,
            args.interactive,
            args.version,
            has_process_action,
        ]
    )
    if not has_action:
        parser.error(
            "provide --url, --eval, --eval-file, --screenshot, --steps, --list-tools, --version, or --interactive"
        )
    if args.current_chrome and args.url and not any([args.new_page, args.page_id, args.use_selected_page]):
        parser.error("--current-chrome --url requires --new-page, --page-id, or --use-selected-page")
    return args


def build_mcp_args(args: argparse.Namespace) -> list[str]:
    mcp_args = ["--no-usage-statistics", "--viewport", args.viewport]
    if not args.headful and not args.current_chrome:
        mcp_args.append("--headless")
    if not args.no_isolated and not args.current_chrome:
        mcp_args.append("--isolated")
    if not args.full_tools and not args.current_chrome:
        mcp_args.append("--slim")
    if args.current_chrome and not any(
        option.startswith(("--autoConnect", "--auto-connect", "--browserUrl", "--browser-url", "--wsEndpoint", "--ws-endpoint"))
        for option in args.mcp_arg
    ):
        mcp_args.append("--autoConnect")
    mcp_args.extend(args.mcp_arg)
    return mcp_args


def load_steps(path: str) -> list[dict[str, Any]]:
    raw = json.loads(Path(path).read_text(encoding="utf-8"))
    if isinstance(raw, list):
        steps = raw
    elif isinstance(raw, dict) and isinstance(raw.get("steps"), list):
        steps = raw["steps"]
    else:
        raise ValueError("--steps must be a JSON array or an object with a steps array")

    for index, step in enumerate(steps):
        if not isinstance(step, dict):
            raise ValueError(f"step {index + 1} must be an object")
    return steps


def load_interactive_command(line: str) -> list[dict[str, Any]]:
    if line.startswith("@"):
        return load_steps(line[1:].strip())

    command = json.loads(line)
    if not isinstance(command, list):
        command = [command]

    steps = []
    for index, step in enumerate(command):
        if not isinstance(step, dict):
            raise ValueError(f"interactive step {index + 1} must be an object")
        steps.append(step)
    return steps


def cli_steps(args: argparse.Namespace) -> list[dict[str, Any]]:
    steps: list[dict[str, Any]] = []
    uses_full_tools = args.full_tools or args.current_chrome
    if args.page_id is not None:
        if not uses_full_tools:
            raise ValueError("--page-id requires --full-tools or --current-chrome")
        steps.append(
            {
                "tool": "select_page",
                "arguments": {"pageId": args.page_id, "bringToFront": True},
                "label": f"select page {args.page_id}",
            }
        )
    if args.url:
        if uses_full_tools and args.new_page:
            steps.append(
                {
                    "tool": "new_page",
                    "arguments": {"url": args.url},
                    "label": "new page",
                }
            )
        elif uses_full_tools:
            steps.append(
                {
                    "tool": "navigate_page",
                    "arguments": {"type": "url", "url": args.url},
                    "label": "navigate",
                }
            )
        else:
            steps.append({"tool": "navigate", "arguments": {"url": args.url}, "label": "navigate"})
    for script in args.evals:
        steps.append(evaluate_step(script, uses_full_tools, "evaluate"))
    for path in args.eval_file:
        script = Path(path).read_text(encoding="utf-8")
        steps.append(evaluate_step(script, uses_full_tools, f"evaluate {path}"))
    if args.screenshot:
        if uses_full_tools:
            steps.append(
                {
                    "tool": "take_screenshot",
                    "arguments": {"filePath": args.screenshot},
                    "label": "screenshot",
                }
            )
        else:
            steps.append({"tool": "screenshot", "arguments": {}, "path": args.screenshot, "label": "screenshot"})
    return steps


def evaluate_step(script: str, uses_full_tools: bool, label: str) -> dict[str, Any]:
    if not uses_full_tools:
        return {"tool": "evaluate", "arguments": {"script": script}, "label": label}

    function = script.strip()
    looks_like_function = function.startswith(("async ", "function ")) or "=>" in function[:120]
    if not looks_like_function:
        function = f"() => eval({json.dumps(script)})"

    return {"tool": "evaluate_script", "arguments": {"function": function}, "label": label}


def normalize_step(step: dict[str, Any]) -> tuple[str, dict[str, Any], str, str | None]:
    label = str(step.get("label") or step.get("name") or step.get("tool") or "step")
    output_path = step.get("path")

    if "tool" in step:
        return str(step["tool"]), dict(step.get("arguments") or {}), label, output_path
    if "navigate" in step:
        return "navigate", {"url": str(step["navigate"])}, label, output_path
    if "evaluate" in step:
        return "evaluate", {"script": str(step["evaluate"])}, label, output_path
    if "screenshot" in step:
        path = output_path or str(step["screenshot"])
        return "screenshot", dict(step.get("arguments") or {}), label, path

    raise ValueError(f"cannot determine MCP tool for step: {json.dumps(step)}")


def content_text(result: dict[str, Any]) -> str:
    parts = []
    for item in result.get("content", []):
        if item.get("type") == "text" and "text" in item:
            parts.append(str(item["text"]))
    return "\n".join(parts)


def copy_screenshot_if_requested(result: dict[str, Any], output_path: str | None) -> str | None:
    if not output_path:
        return None

    text = content_text(result).strip()
    if not text:
        raise McpError("screenshot result did not include a source path")

    source = Path(text)
    destination = Path(output_path)
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(source, destination)
    return str(destination)


def run_step(client: McpClient, step: dict[str, Any], index: int) -> dict[str, Any]:
    tool, arguments, label, path = normalize_step(step)
    result = client.call_tool(tool, arguments)
    copied_to = copy_screenshot_if_requested(result, path) if tool == "screenshot" else None
    return {
        "index": index,
        "label": label,
        "tool": tool,
        "arguments": arguments,
        "copiedTo": copied_to,
        "result": result,
    }


def print_record(record: dict[str, Any]) -> None:
    print(f"[{record['index']}] {record['label']} ({record['tool']})")
    if record.get("copiedTo"):
        print(f"  screenshot: {record['copiedTo']}")
        return

    text = content_text(record["result"])
    if text:
        for line in text.splitlines():
            print(f"  {line}")


def run_steps(client: McpClient, steps: list[dict[str, Any]], raw_json: bool) -> list[dict[str, Any]]:
    results = []
    for index, step in enumerate(steps, start=1):
        record = run_step(client, step, index)
        results.append(record)

        if not raw_json:
            print_record(record)
    return results


def run_interactive(client: McpClient) -> None:
    print(
        "interactive MCP session ready; send one JSON step, a JSON step array, @steps.json, or {\"exit\": true}.",
        flush=True,
    )
    next_index = 1
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            if line in {"exit", "quit"}:
                print("closing interactive MCP session", flush=True)
                return
            steps = load_interactive_command(line)
            if len(steps) == 1 and (steps[0] == {"exit": True} or steps[0] == {"quit": True}):
                print("closing interactive MCP session", flush=True)
                return

            for step in steps:
                record = run_step(client, step, next_index)
                next_index += 1
                print(json.dumps([record], indent=2), flush=True)
        except Exception as exc:
            print(f"error: {exc}", file=sys.stderr, flush=True)


def main() -> int:
    args = parse_args()

    if args.version:
        print(f"chrome-devtools-session {RUNNER_VERSION}")
        return 0

    if args.list_running_sessions:
        print_session_processes(session_processes())
        return 0

    if args.close_session is not None:
        processes = read_processes()
        matching = [process for process in processes if is_session_command(process["command"])]
        pids = collect_related_pids(args.close_session, matching)
        if not pids:
            raise McpError(f"no running Chrome DevTools MCP session found for PID {args.close_session}")
        terminate_pids(pids)
        return 0

    if args.close_all_sessions:
        pids = {process["pid"] for process in session_processes()}
        terminate_pids(pids)
        return 0

    mcp_args = build_mcp_args(args)

    steps = []
    if args.steps:
        steps.extend(load_steps(args.steps))
    steps.extend(cli_steps(args))

    with McpClient(
        command=args.mcp_command,
        args=mcp_args,
        timeout=args.timeout,
        protocol_version=args.protocol_version,
    ) as client:
        if args.list_tools:
            tools = client.request("tools/list")
            if args.json:
                print(json.dumps(tools, indent=2))
            else:
                for tool in tools.get("tools", []):
                    print(f"{tool['name']}: {tool.get('description', '')}")

        results = run_steps(client, steps, args.json)
        if args.json and results:
            print(json.dumps(results, indent=2))
        if args.interactive:
            run_interactive(client)

    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (McpError, OSError, ValueError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        raise SystemExit(1)
