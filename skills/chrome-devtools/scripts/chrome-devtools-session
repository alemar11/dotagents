#!/usr/bin/env python3
"""Run Chrome DevTools actions through the Homebrew chrome-devtools CLI.

This skill-local runner keeps a stable executable surface for JSON step files,
interactive batches, and session cleanup. Normal browser work delegates to the
official chrome-devtools CLI. Authenticated current-Chrome work uses the MCP
stdio server directly so Chrome can grant access to an existing browser window.
"""

from __future__ import annotations

import argparse
import json
import os
import queue
import signal
import shlex
import shutil
import subprocess
import sys
import threading
import time
from pathlib import Path
from typing import Any


RUNNER_VERSION = "1.1.0"


def existing_executable(paths: list[Path]) -> str | None:
    for path in paths:
        if path.exists() and os.access(path, os.X_OK):
            return str(path)
    return None


def brew_prefix(formula: str | None = None) -> Path | None:
    brew = shutil.which("brew")
    if not brew:
        return None

    command = [brew, "--prefix"]
    if formula:
        command.append(formula)

    try:
        completed = subprocess.run(
            command,
            text=True,
            capture_output=True,
            timeout=3,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None

    if completed.returncode != 0:
        return None

    prefix = completed.stdout.strip()
    if not prefix:
        return None
    return Path(prefix)


def cli_candidates_from_prefix(prefix: Path) -> list[Path]:
    return [
        prefix / "bin" / "chrome-devtools",
        prefix / "opt" / "chrome-devtools-mcp" / "bin" / "chrome-devtools",
    ]


def mcp_candidates_from_prefix(prefix: Path) -> list[Path]:
    return [
        prefix / "bin" / "chrome-devtools-mcp",
        prefix / "opt" / "chrome-devtools-mcp" / "bin" / "chrome-devtools-mcp",
    ]


def resolve_cli_command() -> str:
    found = shutil.which("chrome-devtools")
    if found:
        return found

    candidates: list[Path] = []
    mcp_command = shutil.which("chrome-devtools-mcp")
    if mcp_command:
        candidates.append(Path(mcp_command).with_name("chrome-devtools"))

    for value in (os.environ.get("HOMEBREW_PREFIX"), os.environ.get("BREW_PREFIX")):
        if value:
            candidates.extend(cli_candidates_from_prefix(Path(value)))

    for prefix in (brew_prefix("chrome-devtools-mcp"), brew_prefix()):
        if prefix:
            candidates.extend(cli_candidates_from_prefix(prefix))

    discovered = existing_executable(candidates)
    if discovered:
        return discovered

    return "chrome-devtools"


def resolve_mcp_command() -> str:
    found = shutil.which("chrome-devtools-mcp")
    if found:
        return found

    candidates: list[Path] = []
    cli_command = shutil.which("chrome-devtools")
    if cli_command:
        candidates.append(Path(cli_command).with_name("chrome-devtools-mcp"))

    for value in (os.environ.get("HOMEBREW_PREFIX"), os.environ.get("BREW_PREFIX")):
        if value:
            candidates.extend(mcp_candidates_from_prefix(Path(value)))

    for prefix in (brew_prefix("chrome-devtools-mcp"), brew_prefix()):
        if prefix:
            candidates.extend(mcp_candidates_from_prefix(prefix))

    discovered = existing_executable(candidates)
    if discovered:
        return discovered

    return "chrome-devtools-mcp"


DEFAULT_CLI_COMMAND = resolve_cli_command()
DEFAULT_MCP_COMMAND = resolve_mcp_command()
DEFAULT_PROTOCOL_VERSION = "2025-06-18"
OUTPUT_FORMAT_COMMANDS_WITHOUT_SUPPORT = {"start", "stop", "status"}
POSITIONAL_ARGUMENTS: dict[str, tuple[str, ...]] = {
    "new_page": ("url",),
    "select_page": ("pageId",),
    "close_page": ("pageId",),
    "evaluate_script": ("function",),
    "click": ("uid",),
    "hover": ("uid",),
    "fill": ("uid", "value"),
    "upload_file": ("uid", "file"),
    "press_key": ("key",),
    "type_text": ("text",),
    "resize_page": ("width", "height"),
    "get_console_message": ("msgid",),
    "performance_analyze_insight": ("traceId", "insightName"),
    "trigger_extension_action": ("extensionId",),
    "install_extension": ("extensionPath",),
}
OPTION_ALIASES = {
    "page_id": "pageId",
    "page": "pageId",
    "bring_to_front": "bringToFront",
    "file_path": "filePath",
    "filepath": "filePath",
    "output_format": "output-format",
    "request_file_path": "requestFilePath",
    "response_file_path": "responseFilePath",
    "output_dir_path": "outputDirPath",
}


class CliError(RuntimeError):
    pass


class McpError(RuntimeError):
    pass


def is_session_command(command: str) -> bool:
    try:
        tokens = shlex.split(command)
    except ValueError:
        tokens = command.split()

    if not tokens:
        return False

    command_name = Path(tokens[0]).name
    script_names = {"chrome-devtools-session", "chrome_devtools_mcp_session.py"}

    if command_name in {"chrome-devtools-session", "chrome-devtools-mcp"}:
        return True

    if "chrome-devtools-mcp" in command:
        return True

    for index, token in enumerate(tokens[1:], start=1):
        previous_name = Path(tokens[index - 1]).name
        if Path(token).name in script_names and previous_name.startswith("python"):
            return True

    if len(tokens) >= 3 and command_name == "npm" and tokens[1] == "exec":
        return tokens[2].startswith("chrome-devtools-mcp")

    return False


def read_processes() -> list[dict[str, Any]]:
    output = subprocess.check_output(
        ["ps", "-axo", "pid=,ppid=,etime=,stat=,command="],
        text=True,
    )
    processes = []
    for line in output.splitlines():
        parts = line.strip().split(None, 4)
        if len(parts) < 5:
            continue
        pid, ppid, elapsed, status, command = parts
        try:
            processes.append(
                {
                    "pid": int(pid),
                    "ppid": int(ppid),
                    "elapsed": elapsed,
                    "status": status,
                    "command": command,
                }
            )
        except ValueError:
            continue
    return processes


def session_processes() -> list[dict[str, Any]]:
    current_pid = os.getpid()
    return [
        process
        for process in read_processes()
        if process["pid"] != current_pid and is_session_command(process["command"])
    ]


def print_session_processes(processes: list[dict[str, Any]]) -> None:
    if not processes:
        print("No skill runner or chrome-devtools-mcp processes found.")
        return

    print("PID     PPID    ELAPSED   STAT  COMMAND")
    for process in sorted(processes, key=lambda item: item["pid"]):
        print(
            f"{process['pid']:<7} {process['ppid']:<7} "
            f"{process['elapsed']:<9} {process['status']:<5} {process['command']}"
        )


def collect_related_pids(target_pid: int, processes: list[dict[str, Any]]) -> set[int]:
    by_pid = {process["pid"]: process for process in processes}
    if target_pid not in by_pid:
        return set()

    children_by_parent: dict[int, list[int]] = {}
    for process in processes:
        children_by_parent.setdefault(process["ppid"], []).append(process["pid"])

    selected: set[int] = set()

    def add_descendants(pid: int) -> None:
        if pid in selected:
            return
        selected.add(pid)
        for child_pid in children_by_parent.get(pid, []):
            add_descendants(child_pid)

    add_descendants(target_pid)

    current = by_pid.get(target_pid)
    while current:
        parent = by_pid.get(current["ppid"])
        if not parent or not is_session_command(parent["command"]):
            break
        selected.add(parent["pid"])
        current = parent

    return selected


def terminate_pids(pids: set[int], timeout: float = 3.0) -> None:
    current_pid = os.getpid()
    pids = {pid for pid in pids if pid != current_pid}
    if not pids:
        print("No matching session processes to close.")
        return

    for pid in sorted(pids):
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass

    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        remaining = [pid for pid in pids if process_exists(pid)]
        if not remaining:
            print(f"Closed {len(pids)} session process(es).")
            return
        time.sleep(0.1)

    remaining = [pid for pid in pids if process_exists(pid)]
    for pid in remaining:
        try:
            os.kill(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
    print(f"Closed {len(pids)} session process(es); force-killed {len(remaining)}.")


def process_exists(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


class McpClient:
    def __init__(
        self,
        command: str,
        args: list[str],
        timeout: float,
        protocol_version: str,
    ) -> None:
        self.command = command
        self.args = args
        self.timeout = timeout
        self.protocol_version = protocol_version
        self._next_id = 1
        self._messages: queue.Queue[dict[str, Any] | Exception | None] = queue.Queue()
        self._process: subprocess.Popen[str] | None = None
        self._reader: threading.Thread | None = None
        self._notifications: list[dict[str, Any]] = []

    def __enter__(self) -> "McpClient":
        env = os.environ.copy()
        env["CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS"] = "1"

        self._process = subprocess.Popen(
            [self.command, *self.args],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=sys.stderr,
            text=True,
            bufsize=1,
            env=env,
        )

        self._reader = threading.Thread(target=self._read_stdout, daemon=True)
        self._reader.start()

        self.request(
            "initialize",
            {
                "protocolVersion": self.protocol_version,
                "capabilities": {},
                "clientInfo": {
                    "name": "chrome-devtools-session",
                    "version": RUNNER_VERSION,
                },
            },
        )
        self.notify("notifications/initialized", {})
        return self

    def __exit__(self, exc_type: Any, exc: Any, tb: Any) -> None:
        if not self._process:
            return

        if self._process.poll() is None:
            self._process.terminate()
            try:
                self._process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                self._process.kill()
                self._process.wait(timeout=5)

    def _read_stdout(self) -> None:
        assert self._process and self._process.stdout
        try:
            for line in self._process.stdout:
                line = line.strip()
                if not line:
                    continue
                try:
                    self._messages.put(json.loads(line))
                except json.JSONDecodeError as exc:
                    self._messages.put(McpError(f"invalid JSON from MCP server: {line}"))
                    self._messages.put(exc)
        finally:
            self._messages.put(None)

    def _write(self, message: dict[str, Any]) -> None:
        if not self._process or not self._process.stdin:
            raise McpError("MCP server is not running")
        if self._process.poll() is not None:
            raise McpError(f"MCP server exited with code {self._process.returncode}")

        self._process.stdin.write(json.dumps(message, separators=(",", ":")) + "\n")
        self._process.stdin.flush()

    def request(self, method: str, params: dict[str, Any] | None = None) -> dict[str, Any]:
        request_id = self._next_id
        self._next_id += 1
        self._write(
            {
                "jsonrpc": "2.0",
                "id": request_id,
                "method": method,
                "params": params or {},
            }
        )

        while True:
            try:
                message = self._messages.get(timeout=self.timeout)
            except queue.Empty as exc:
                raise McpError(f"timed out waiting for MCP response to {method}") from exc

            if message is None:
                raise McpError("MCP server closed stdout")
            if isinstance(message, Exception):
                raise message
            if message.get("id") != request_id:
                self._notifications.append(message)
                continue
            if "error" in message:
                raise McpError(f"MCP {method} failed: {json.dumps(message['error'])}")
            return message["result"]

    def notify(self, method: str, params: dict[str, Any] | None = None) -> None:
        self._write({"jsonrpc": "2.0", "method": method, "params": params or {}})

    def call_tool(self, name: str, arguments: dict[str, Any] | None = None) -> dict[str, Any]:
        return self.request("tools/call", {"name": name, "arguments": arguments or {}})


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Run browser actions through the Homebrew chrome-devtools CLI while "
            "keeping a skill-local JSON step runner."
        )
    )
    parser.add_argument("--cli-command", default=DEFAULT_CLI_COMMAND, help="chrome-devtools CLI path")
    parser.add_argument("--start-arg", action="append", default=[], help="extra raw chrome-devtools start arg")
    parser.add_argument("--mcp-command", default=DEFAULT_MCP_COMMAND, help="chrome-devtools-mcp path for --current-chrome")
    parser.add_argument("--mcp-arg", action="append", default=[], help="extra raw MCP server arg for --current-chrome")
    parser.add_argument("--protocol-version", default=DEFAULT_PROTOCOL_VERSION, help="MCP protocol version")
    parser.add_argument("--timeout", type=float, default=30)
    parser.add_argument("--url", help="URL to navigate to before eval/screenshot actions")
    parser.add_argument("--new-page", action="store_true", help="open --url in a new tab")
    parser.add_argument("--page-id", type=int, help="select this CLI page ID before running actions")
    parser.add_argument(
        "--use-selected-page",
        action="store_true",
        help="allow --url to navigate the currently selected page in --current-chrome mode",
    )
    parser.add_argument("--eval", action="append", default=[], dest="evals", help="JS to evaluate")
    parser.add_argument("--eval-file", action="append", default=[], help="path to JS file to evaluate")
    parser.add_argument("--screenshot", help="write screenshot to this path after eval actions")
    parser.add_argument("--steps", help="JSON file containing a steps array")
    parser.add_argument("--list-tools", action="store_true", help="list chrome-devtools CLI commands and exit")
    parser.add_argument("--version", action="store_true", help="print runner version and exit")
    parser.add_argument(
        "--interactive",
        action="store_true",
        help="keep reading CLI JSON commands, JSON step arrays, or @step-file paths from stdin",
    )
    parser.add_argument(
        "--current-chrome",
        action="store_true",
        help="attach to the existing Chrome window through chrome-devtools-mcp --autoConnect",
    )
    parser.add_argument("--json", action="store_true", help="request JSON output from CLI commands")
    parser.add_argument("--headful", action="store_true", help="start Chrome with --headless=false")
    parser.add_argument("--no-isolated", action="store_true", help="start without an isolated Chrome profile")
    parser.add_argument("--full-tools", action="store_true", help="compatibility no-op; the CLI exposes its commands")
    parser.add_argument("--viewport", help="resize the selected page, formatted as WIDTHxHEIGHT")
    parser.add_argument(
        "--list-running-sessions",
        action="store_true",
        help="show chrome-devtools daemon status and matching skill runner/server processes",
    )
    parser.add_argument(
        "--close-session",
        type=int,
        metavar="PID",
        help="close one skill runner or chrome-devtools-mcp process by PID",
    )
    parser.add_argument(
        "--close-all-sessions",
        action="store_true",
        help="stop the chrome-devtools daemon and close matching runner/server processes",
    )

    args = parser.parse_args()

    has_process_action = any([args.list_running_sessions, args.close_session, args.close_all_sessions])
    has_action = any(
        [
            args.url,
            args.evals,
            args.eval_file,
            args.screenshot,
            args.steps,
            args.list_tools,
            args.interactive,
            args.version,
            has_process_action,
        ]
    )
    if not has_action:
        parser.error(
            "provide --url, --eval, --eval-file, --screenshot, --steps, --list-tools, --version, or --interactive"
        )
    if args.current_chrome and args.url and not any([args.new_page, args.page_id, args.use_selected_page]):
        parser.error("--current-chrome --url requires --new-page, --page-id, or --use-selected-page")
    return args


def cli_env() -> dict[str, str]:
    env = os.environ.copy()
    env["CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS"] = "1"
    return env


def ensure_cli_exists(command: str) -> None:
    if Path(command).exists() or shutil.which(command):
        return
    raise CliError(
        "chrome-devtools CLI not found; install with `brew install chrome-devtools-mcp` "
        "and verify `chrome-devtools --version`"
    )


def run_cli(
    args: argparse.Namespace,
    argv: list[str],
    *,
    fail: bool = True,
) -> dict[str, Any]:
    ensure_cli_exists(args.cli_command)
    try:
        completed = subprocess.run(
            [args.cli_command, *argv],
            text=True,
            capture_output=True,
            timeout=args.timeout,
            env=cli_env(),
        )
    except subprocess.TimeoutExpired as exc:
        raise CliError(f"timed out after {args.timeout:g}s running chrome-devtools {' '.join(argv)}") from exc

    result = {
        "argv": argv,
        "returncode": completed.returncode,
        "stdout": completed.stdout,
        "stderr": completed.stderr,
    }
    if fail and completed.returncode != 0:
        message = completed.stderr.strip() or completed.stdout.strip() or f"exit code {completed.returncode}"
        raise CliError(f"chrome-devtools {' '.join(argv)} failed: {message}")
    return result


def print_cli_result(result: dict[str, Any]) -> None:
    if result["stdout"]:
        print(result["stdout"], end="" if result["stdout"].endswith("\n") else "\n")
    if result["stderr"]:
        print(result["stderr"], end="" if result["stderr"].endswith("\n") else "\n", file=sys.stderr)


def split_raw_args(values: list[str]) -> list[str]:
    args: list[str] = []
    for value in values:
        args.extend(shlex.split(value))
    return args


def build_start_args(args: argparse.Namespace) -> list[str]:
    start_args = ["start", "--usageStatistics=false"]
    if args.current_chrome:
        start_args.append("--autoConnect")
    if args.headful:
        start_args.append("--headless=false")
    if args.no_isolated:
        start_args.append("--isolated=false")
    start_args.extend(split_raw_args(args.start_arg))
    return start_args


def should_start_daemon(args: argparse.Namespace) -> bool:
    return bool(args.headful or args.no_isolated or args.start_arg)


def load_steps(path: str) -> list[dict[str, Any]]:
    raw = json.loads(Path(path).read_text(encoding="utf-8"))
    if isinstance(raw, list):
        steps = raw
    elif isinstance(raw, dict) and isinstance(raw.get("steps"), list):
        steps = raw["steps"]
    else:
        raise ValueError("--steps must be a JSON array or an object with a steps array")

    for index, step in enumerate(steps):
        if not isinstance(step, dict):
            raise ValueError(f"step {index + 1} must be an object")
    return steps


def load_interactive_command(line: str) -> list[dict[str, Any]]:
    if line.startswith("@"):
        return load_steps(line[1:].strip())

    command = json.loads(line)
    if not isinstance(command, list):
        command = [command]

    steps = []
    for index, step in enumerate(command):
        if not isinstance(step, dict):
            raise ValueError(f"interactive step {index + 1} must be an object")
        steps.append(step)
    return steps


def cli_steps(args: argparse.Namespace) -> list[dict[str, Any]]:
    steps: list[dict[str, Any]] = []
    if args.page_id is not None:
        steps.append(
            {
                "command": ["select_page", str(args.page_id), "--bringToFront", "true"],
                "label": f"select page {args.page_id}",
            }
        )
    if args.url:
        if args.new_page:
            steps.append({"command": ["new_page", args.url], "label": "new page"})
        else:
            steps.append({"command": ["navigate_page", "--url", args.url], "label": "navigate"})
    if args.viewport:
        width, height = parse_viewport(args.viewport)
        steps.append({"command": ["resize_page", str(width), str(height)], "label": f"resize {args.viewport}"})
    for script in args.evals:
        steps.append({"command": ["evaluate_script", js_function(script)], "label": "evaluate"})
    for path in args.eval_file:
        script = Path(path).read_text(encoding="utf-8")
        steps.append({"command": ["evaluate_script", js_function(script)], "label": f"evaluate {path}"})
    if args.screenshot:
        steps.append({"command": ["take_screenshot", "--filePath", args.screenshot], "label": "screenshot"})
    return steps


def parse_viewport(viewport: str) -> tuple[int, int]:
    parts = viewport.lower().split("x", 1)
    if len(parts) != 2:
        raise ValueError("--viewport must be formatted as WIDTHxHEIGHT")
    try:
        width = int(parts[0])
        height = int(parts[1])
    except ValueError as exc:
        raise ValueError("--viewport must be formatted as WIDTHxHEIGHT") from exc
    if width <= 0 or height <= 0:
        raise ValueError("--viewport dimensions must be positive")
    return width, height


def js_function(script: str) -> str:
    function = script.strip()
    looks_like_function = function.startswith(("async ", "function ")) or "=>" in function[:160]
    if looks_like_function:
        return function
    return f"() => eval({json.dumps(script)})"


def normalize_step(step: dict[str, Any]) -> tuple[str, list[str]]:
    label = str(step.get("label") or step.get("name") or step.get("tool") or step.get("command") or "step")

    if "command" in step:
        return label, normalize_command_value(step["command"], step)
    if "cli" in step:
        return label, normalize_command_value(step["cli"], step)
    if "tool" in step:
        return label, tool_step_to_cli(str(step["tool"]), dict(step.get("arguments") or {}), step)
    if "navigate" in step:
        return label, ["navigate_page", "--url", str(step["navigate"])]
    if "evaluate" in step:
        return label, ["evaluate_script", js_function(str(step["evaluate"]))]
    if "screenshot" in step:
        path = str(step.get("path") or step["screenshot"])
        return label, ["take_screenshot", "--filePath", path]

    raise ValueError(f"cannot determine CLI command for step: {json.dumps(step)}")


def normalize_command_value(command: Any, step: dict[str, Any]) -> list[str]:
    if isinstance(command, list):
        argv = [str(item) for item in command]
    elif isinstance(command, str):
        if "args" in step:
            raw_args = step["args"]
            if not isinstance(raw_args, list):
                raise ValueError("step args must be an array")
            argv = [command, *[str(item) for item in raw_args]]
        else:
            arguments = dict(step.get("arguments") or {})
            argv = [command, *arguments_to_argv(command, arguments)]
    else:
        raise ValueError("step command must be a string or array")

    if argv and Path(argv[0]).name == Path(DEFAULT_CLI_COMMAND).name:
        argv = argv[1:]
    if not argv:
        raise ValueError("step command cannot be empty")
    return argv


def tool_step_to_cli(tool: str, arguments: dict[str, Any], step: dict[str, Any]) -> list[str]:
    if tool == "navigate":
        url = arguments.get("url") or step.get("url")
        if not url:
            raise ValueError("navigate step requires arguments.url")
        return ["navigate_page", "--url", str(url)]

    if tool == "evaluate":
        script = arguments.get("script") or arguments.get("function") or step.get("script")
        if script is None:
            raise ValueError("evaluate step requires arguments.script")
        return ["evaluate_script", js_function(str(script))]

    if tool == "screenshot":
        path = step.get("path") or arguments.get("filePath") or arguments.get("path")
        if not path:
            raise ValueError("screenshot step requires path or arguments.filePath")
        return ["take_screenshot", "--filePath", str(path)]

    if tool == "new_page":
        url = arguments.get("url") or step.get("url") or "about:blank"
        remaining = {key: value for key, value in arguments.items() if key != "url"}
        return ["new_page", str(url), *dict_to_cli_options(remaining)]

    if tool == "select_page":
        page_id = arguments.get("pageId", arguments.get("page_id", step.get("pageId")))
        if page_id is None:
            raise ValueError("select_page step requires arguments.pageId")
        remaining = {
            key: value
            for key, value in arguments.items()
            if key not in {"pageId", "page_id"}
        }
        return ["select_page", str(page_id), *dict_to_cli_options(remaining)]

    if tool == "evaluate_script":
        script = arguments.get("function") or arguments.get("script")
        if script is None:
            raise ValueError("evaluate_script step requires arguments.function")
        remaining = {
            key: value
            for key, value in arguments.items()
            if key not in {"function", "script"}
        }
        return ["evaluate_script", js_function(str(script)), *dict_to_cli_options(remaining)]

    if tool == "take_screenshot":
        return [tool, *arguments_to_argv(tool, arguments)]

    return [tool, *arguments_to_argv(tool, arguments)]


def arguments_to_argv(command: str, arguments: dict[str, Any]) -> list[str]:
    command = Path(command).name
    positional_keys = POSITIONAL_ARGUMENTS.get(command, ())
    remaining = dict(arguments)
    argv: list[str] = []

    if command == "evaluate_script" and "script" in remaining and "function" not in remaining:
        remaining["function"] = js_function(str(remaining.pop("script")))
    elif command == "evaluate_script" and "function" in remaining:
        remaining["function"] = js_function(str(remaining["function"]))

    for key in positional_keys:
        if key in remaining:
            argv.append(str(remaining.pop(key)))
        elif key == "pageId" and "page_id" in remaining:
            argv.append(str(remaining.pop("page_id")))
        elif key == "file" and "path" in remaining:
            argv.append(str(remaining.pop("path")))

    argv.extend(dict_to_cli_options(remaining))
    return argv


def dict_to_cli_options(arguments: dict[str, Any]) -> list[str]:
    argv: list[str] = []
    for raw_key, value in arguments.items():
        if value is None:
            continue
        key = OPTION_ALIASES.get(raw_key, raw_key)
        option = f"--{key}"
        if isinstance(value, bool):
            argv.extend([option, "true" if value else "false"])
        elif isinstance(value, list):
            for item in value:
                argv.extend([option, str(item)])
        elif isinstance(value, dict):
            argv.extend([option, json.dumps(value, separators=(",", ":"))])
        else:
            argv.extend([option, str(value)])
    return argv


def add_output_format(argv: list[str], raw_json: bool) -> list[str]:
    if not raw_json:
        return argv
    command = Path(argv[0]).name
    if command in OUTPUT_FORMAT_COMMANDS_WITHOUT_SUPPORT:
        return argv
    if any(arg == "--output-format" or arg.startswith("--output-format=") for arg in argv):
        return argv
    return [*argv, "--output-format", "json"]


def run_step(args: argparse.Namespace, step: dict[str, Any], index: int) -> dict[str, Any]:
    label, argv = normalize_step(step)
    argv = add_output_format(argv, args.json)
    result = run_cli(args, argv)
    return {
        "index": index,
        "label": label,
        "command": argv,
        "returncode": result["returncode"],
        "stdout": result["stdout"],
        "stderr": result["stderr"],
    }


def print_record(record: dict[str, Any]) -> None:
    print(f"[{record['index']}] {record['label']} ({' '.join(record['command'])})")
    stdout = str(record.get("stdout") or "").strip()
    if stdout:
        for line in stdout.splitlines():
            print(f"  {line}")
    stderr = str(record.get("stderr") or "").strip()
    if stderr:
        for line in stderr.splitlines():
            print(f"  stderr: {line}", file=sys.stderr)


def run_steps(args: argparse.Namespace, steps: list[dict[str, Any]]) -> list[dict[str, Any]]:
    results = []
    for index, step in enumerate(steps, start=1):
        record = run_step(args, step, index)
        results.append(record)
        if not args.json:
            print_record(record)
    return results


def run_interactive(args: argparse.Namespace) -> None:
    print(
        "interactive chrome-devtools CLI runner ready; send one JSON step, a JSON step array, @steps.json, or exit.",
        flush=True,
    )
    next_index = 1
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            if line in {"exit", "quit"}:
                print("closing interactive chrome-devtools CLI runner", flush=True)
                return
            steps = load_interactive_command(line)
            if len(steps) == 1 and (steps[0] == {"exit": True} or steps[0] == {"quit": True}):
                print("closing interactive chrome-devtools CLI runner", flush=True)
                return

            for step in steps:
                record = run_step(args, step, next_index)
                next_index += 1
                print(json.dumps([record], indent=2), flush=True)
        except Exception as exc:
            print(f"error: {exc}", file=sys.stderr, flush=True)


def build_mcp_args(args: argparse.Namespace) -> list[str]:
    mcp_args = ["--no-usage-statistics"]
    raw_mcp_args = split_raw_args(args.mcp_arg)
    has_browser_target = any(
        option.startswith(
            (
                "--autoConnect",
                "--auto-connect",
                "--browserUrl",
                "--browser-url",
                "--wsEndpoint",
                "--ws-endpoint",
            )
        )
        for option in raw_mcp_args
    )
    if args.current_chrome and not has_browser_target:
        mcp_args.append("--autoConnect")
    mcp_args.extend(raw_mcp_args)
    return mcp_args


def mcp_steps(args: argparse.Namespace) -> list[dict[str, Any]]:
    steps: list[dict[str, Any]] = []
    if args.page_id is not None:
        steps.append(
            {
                "tool": "select_page",
                "arguments": {"pageId": args.page_id, "bringToFront": True},
                "label": f"select page {args.page_id}",
            }
        )
    if args.url:
        if args.new_page:
            steps.append({"tool": "new_page", "arguments": {"url": args.url}, "label": "new page"})
        else:
            steps.append(
                {
                    "tool": "navigate_page",
                    "arguments": {"type": "url", "url": args.url},
                    "label": "navigate",
                }
            )
    if args.viewport:
        width, height = parse_viewport(args.viewport)
        steps.append(
            {
                "tool": "resize_page",
                "arguments": {"width": width, "height": height},
                "label": f"resize {args.viewport}",
            }
        )
    for script in args.evals:
        steps.append(
            {
                "tool": "evaluate_script",
                "arguments": {"function": js_function(script)},
                "label": "evaluate",
            }
        )
    for path in args.eval_file:
        script = Path(path).read_text(encoding="utf-8")
        steps.append(
            {
                "tool": "evaluate_script",
                "arguments": {"function": js_function(script)},
                "label": f"evaluate {path}",
            }
        )
    if args.screenshot:
        steps.append(
            {
                "tool": "take_screenshot",
                "arguments": {"filePath": args.screenshot},
                "label": "screenshot",
            }
        )
    return steps


def normalize_mcp_step(step: dict[str, Any]) -> tuple[str, str, dict[str, Any]]:
    label = str(step.get("label") or step.get("name") or step.get("tool") or step.get("command") or "step")

    if "tool" in step:
        return label, *tool_step_to_mcp(str(step["tool"]), dict(step.get("arguments") or {}), step)
    if "command" in step:
        argv = normalize_command_value(step["command"], step)
        return label, *argv_to_mcp_tool(argv)
    if "cli" in step:
        argv = normalize_command_value(step["cli"], step)
        return label, *argv_to_mcp_tool(argv)
    if "navigate" in step:
        return label, "navigate_page", {"type": "url", "url": str(step["navigate"])}
    if "evaluate" in step:
        return label, "evaluate_script", {"function": js_function(str(step["evaluate"]))}
    if "screenshot" in step:
        path = str(step.get("path") or step["screenshot"])
        return label, "take_screenshot", {"filePath": path}

    raise ValueError(f"cannot determine MCP tool for step: {json.dumps(step)}")


def tool_step_to_mcp(tool: str, arguments: dict[str, Any], step: dict[str, Any]) -> tuple[str, dict[str, Any]]:
    if tool == "navigate":
        url = arguments.get("url") or step.get("url")
        if not url:
            raise ValueError("navigate step requires arguments.url")
        return "navigate_page", {"type": "url", "url": str(url)}

    if tool == "evaluate":
        script = arguments.get("script") or arguments.get("function") or step.get("script")
        if script is None:
            raise ValueError("evaluate step requires arguments.script")
        return "evaluate_script", {"function": js_function(str(script))}

    if tool == "screenshot":
        path = step.get("path") or arguments.get("filePath") or arguments.get("path")
        if not path:
            raise ValueError("screenshot step requires path or arguments.filePath")
        return "take_screenshot", {"filePath": str(path)}

    if tool == "evaluate_script" and "script" in arguments and "function" not in arguments:
        arguments["function"] = js_function(str(arguments.pop("script")))
    elif tool == "evaluate_script" and "function" in arguments:
        arguments["function"] = js_function(str(arguments["function"]))

    return tool, arguments


def argv_to_mcp_tool(argv: list[str]) -> tuple[str, dict[str, Any]]:
    if not argv:
        raise ValueError("step command cannot be empty")

    tool = Path(argv[0]).name
    positional_keys = POSITIONAL_ARGUMENTS.get(tool, ())
    arguments: dict[str, Any] = {}
    index = 1

    for key in positional_keys:
        if index >= len(argv) or argv[index].startswith("--"):
            break
        value: Any = argv[index]
        if key in {"pageId", "width", "height", "msgid"}:
            value = int(value)
        if tool == "evaluate_script" and key == "function":
            value = js_function(str(value))
        arguments[key] = value
        index += 1

    while index < len(argv):
        token = argv[index]
        if not token.startswith("--"):
            raise ValueError(f"unexpected positional argument for {tool}: {token}")
        raw_key = token[2:]
        if "=" in raw_key:
            key, value = raw_key.split("=", 1)
            index += 1
        else:
            key = raw_key
            if index + 1 < len(argv) and not argv[index + 1].startswith("--"):
                value = argv[index + 1]
                index += 2
            else:
                value = True
                index += 1
        key = OPTION_ALIASES.get(key, key)
        arguments[key] = coerce_cli_value(value)

    if tool == "navigate_page" and "url" in arguments and "type" not in arguments:
        arguments["type"] = "url"
    if tool == "evaluate_script" and "script" in arguments and "function" not in arguments:
        arguments["function"] = js_function(str(arguments.pop("script")))
    if tool == "evaluate_script" and "function" in arguments:
        arguments["function"] = js_function(str(arguments["function"]))
    return tool, arguments


def coerce_cli_value(value: Any) -> Any:
    if value in {"true", "True"}:
        return True
    if value in {"false", "False"}:
        return False
    if isinstance(value, str) and value.isdigit():
        return int(value)
    return value


def content_text(result: dict[str, Any]) -> str:
    parts = []
    for item in result.get("content", []):
        if item.get("type") == "text" and "text" in item:
            parts.append(str(item["text"]))
    return "\n".join(parts)


def run_mcp_step(client: McpClient, step: dict[str, Any], index: int) -> dict[str, Any]:
    label, tool, arguments = normalize_mcp_step(step)
    result = client.call_tool(tool, arguments)
    return {
        "index": index,
        "label": label,
        "tool": tool,
        "arguments": arguments,
        "result": result,
    }


def print_mcp_record(record: dict[str, Any]) -> None:
    print(f"[{record['index']}] {record['label']} ({record['tool']})")
    text = content_text(record["result"])
    if text:
        for line in text.splitlines():
            print(f"  {line}")


def run_mcp_steps(client: McpClient, steps: list[dict[str, Any]], raw_json: bool) -> list[dict[str, Any]]:
    results = []
    for index, step in enumerate(steps, start=1):
        record = run_mcp_step(client, step, index)
        results.append(record)
        if not raw_json:
            print_mcp_record(record)
    return results


def run_mcp_interactive(client: McpClient) -> None:
    print(
        "interactive chrome-devtools MCP session ready; send one JSON step, a JSON step array, @steps.json, or exit.",
        flush=True,
    )
    next_index = 1
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            if line in {"exit", "quit"}:
                print("closing interactive chrome-devtools MCP session", flush=True)
                return
            steps = load_interactive_command(line)
            if len(steps) == 1 and (steps[0] == {"exit": True} or steps[0] == {"quit": True}):
                print("closing interactive chrome-devtools MCP session", flush=True)
                return

            for step in steps:
                record = run_mcp_step(client, step, next_index)
                next_index += 1
                print(json.dumps([record], indent=2), flush=True)
        except Exception as exc:
            print(f"error: {exc}", file=sys.stderr, flush=True)


def run_current_chrome_mcp_mode(args: argparse.Namespace) -> int:
    steps = []
    if args.steps:
        steps.extend(load_steps(args.steps))
    steps.extend(mcp_steps(args))

    with McpClient(
        command=args.mcp_command,
        args=build_mcp_args(args),
        timeout=args.timeout,
        protocol_version=args.protocol_version,
    ) as client:
        if args.list_tools:
            tools = client.request("tools/list")
            if args.json:
                print(json.dumps(tools, indent=2))
            else:
                for tool in tools.get("tools", []):
                    print(f"{tool['name']}: {tool.get('description', '')}")

        results = run_mcp_steps(client, steps, args.json)
        if args.json and results:
            print(json.dumps(results, indent=2))
        if args.interactive:
            run_mcp_interactive(client)

    return 0


def print_daemon_status(args: argparse.Namespace) -> None:
    try:
        result = run_cli(args, ["status"], fail=False)
    except CliError as exc:
        print(f"chrome-devtools status unavailable: {exc}", file=sys.stderr)
        return

    print("chrome-devtools daemon status:")
    text = (result["stdout"] or result["stderr"]).strip()
    if text:
        for line in text.splitlines():
            print(f"  {line}")
    else:
        print(f"  status exited with code {result['returncode']}")


def main() -> int:
    args = parse_args()

    if args.version:
        print(f"chrome-devtools-session {RUNNER_VERSION}")
        return 0

    if args.list_running_sessions:
        print_daemon_status(args)
        print()
        print_session_processes(session_processes())
        return 0

    if args.close_session is not None:
        processes = read_processes()
        matching = [process for process in processes if is_session_command(process["command"])]
        pids = collect_related_pids(args.close_session, matching)
        if not pids:
            raise CliError(f"no skill runner or chrome-devtools-mcp process found for PID {args.close_session}")
        terminate_pids(pids)
        return 0

    if args.close_all_sessions:
        result = run_cli(args, ["stop"], fail=False)
        print_cli_result(result)
        pids = {process["pid"] for process in session_processes()}
        terminate_pids(pids)
        return 0

    if args.current_chrome:
        return run_current_chrome_mcp_mode(args)

    if args.list_tools:
        result = run_cli(args, ["--help"], fail=False)
        print_cli_result(result)
        return result["returncode"]

    if should_start_daemon(args):
        result = run_cli(args, build_start_args(args))
        if not args.json:
            print_cli_result(result)

    steps = []
    if args.steps:
        steps.extend(load_steps(args.steps))
    steps.extend(cli_steps(args))

    results = run_steps(args, steps)
    if args.json and results:
        print(json.dumps(results, indent=2))
    if args.interactive:
        run_interactive(args)

    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (CliError, McpError, OSError, ValueError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        raise SystemExit(1)
