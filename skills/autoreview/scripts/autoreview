from typing import Any

PROTOCOL_PATH = Path(__file__).resolve().with_name("autoreview_protocol.py")
PROTOCOL_SPEC = importlib.util.spec_from_file_location("dotagents_autoreview_protocol", PROTOCOL_PATH)
if PROTOCOL_SPEC is None or PROTOCOL_SPEC.loader is None:
    raise RuntimeError(f"cannot load shared AutoReview protocol: {PROTOCOL_PATH}")
protocol = importlib.util.module_from_spec(PROTOCOL_SPEC)
sys.modules[PROTOCOL_SPEC.name] = protocol
PROTOCOL_SPEC.loader.exec_module(protocol)

OPERATION_PATH = Path(__file__).resolve().with_name("autoreview_operation.py")
OPERATION_SPEC = importlib.util.spec_from_file_location("dotagents_autoreview_operation", OPERATION_PATH)
if OPERATION_SPEC is None or OPERATION_SPEC.loader is None:
    raise RuntimeError(f"cannot load AutoReview operation protocol: {OPERATION_PATH}")
owned_operation = importlib.util.module_from_spec(OPERATION_SPEC)
sys.modules[OPERATION_SPEC.name] = owned_operation
# The operation module imports the canonical public protocol name.
sys.modules.setdefault("autoreview_protocol", protocol)
OPERATION_SPEC.loader.exec_module(owned_operation)

VERSION = "5.0.0"

MAX_REVIEW_PROMPT_BYTES = 512_000
MAX_REVIEW_OUTPUT_BYTES = 128 * 1024
INVALID_OUTPUT_PREVIEW_BYTES = 2048
MAX_REPAIR_APPENDIX_BYTES = 2048
OPEN_SUPPORTS_DIR_FD = os.open in os.supports_dir_fd
REVIEW_MODEL = "gpt-5.6-sol"
REVIEW_REASONING_EFFORTS = {
    "standard": "high",
    "high-risk": "xhigh",
}

PRIORITIES = {0, 1, 2, 3}
FINDING_CATEGORIES = {"bug", "security", "regression", "test-gap", "maintainability"}
REVIEW_OUTCOMES = {"pass", "fail"}
REVIEW_INPUT_SOURCES = {
    "branch-diff",
    "commit-diff",
    "dataset",
    "fix-delta",
    "prompt-file",
    "review-prompt",
    "staged-diff",
    "unstaged-diff",
    "untracked-file",
}
REVIEW_INPUT_OMISSION_REASONS = {
    "binary",
    "changed-during-read",
    "non-utf8",
    "size-limit",
    "symlink",
    "unreadable",
    "unsafe-path",
}
REVIEW_PHASES = protocol.REVIEW_PHASES
TERMINAL_STATES = protocol.TERMINAL_STATES

