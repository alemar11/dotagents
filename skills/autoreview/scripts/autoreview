#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import importlib.util
import json
import os
import subprocess
import sys
import tempfile
import textwrap
from pathlib import Path
from typing import Any

PROTOCOL_PATH = Path(__file__).resolve().with_name("autoreview_protocol.py")
PROTOCOL_SPEC = importlib.util.spec_from_file_location("dotagents_autoreview_protocol", PROTOCOL_PATH)
if PROTOCOL_SPEC is None or PROTOCOL_SPEC.loader is None:
    raise RuntimeError(f"cannot load shared AutoReview protocol: {PROTOCOL_PATH}")
protocol = importlib.util.module_from_spec(PROTOCOL_SPEC)
sys.modules[PROTOCOL_SPEC.name] = protocol
PROTOCOL_SPEC.loader.exec_module(protocol)

VERSION = "2.1.0"

MAX_REVIEW_OUTPUT_BYTES = 128 * 1024
INVALID_OUTPUT_PREVIEW_BYTES = 2048
MAX_REPAIR_APPENDIX_BYTES = 2048

PRIORITIES = {0, 1, 2, 3}
FINDING_CATEGORIES = {"bug", "security", "regression", "test-gap", "maintainability"}
REVIEW_OUTCOMES = {"pass", "fail"}
REVIEW_PHASES = protocol.REVIEW_PHASES
TERMINAL_STATES = protocol.TERMINAL_STATES

SCHEMA: dict[str, Any] = {
    "type": "object",
    "additionalProperties": False,
    "required": [
        "findings",
        "review_outcome",
        "review_explanation",
        "review_confidence",
    ],
    "properties": {
        "findings": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": False,
                "required": [
                    "title",
                    "body",
                    "priority",
                    "confidence",
                    "finding_category",
                    "code_location",
                ],
                "properties": {
                    "title": {"type": "string", "minLength": 1, "maxLength": 140},
                    "body": {"type": "string", "minLength": 1, "maxLength": 2000},
                    "priority": {"type": "integer", "enum": sorted(PRIORITIES)},
                    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                    "finding_category": {"type": "string", "enum": sorted(FINDING_CATEGORIES)},
                    "code_location": {
                        "type": "object",
                        "additionalProperties": False,
                        "required": ["file_path", "line"],
                        "properties": {
                            "file_path": {"type": "string", "minLength": 1},
                            "line": {"type": "integer", "minimum": 1},
                        },
                    },
                },
            },
        },
        "review_outcome": {"type": "string", "enum": sorted(REVIEW_OUTCOMES)},
        "review_explanation": {"type": "string", "minLength": 1, "maxLength": 3000},
        "review_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    },
}

VERIFICATION_SCHEMA: dict[str, Any] = {
    "type": "object",
    "additionalProperties": False,
    "required": [
        "verified_findings",
        "findings",
        "review_outcome",
        "review_explanation",
        "review_confidence",
    ],
    "properties": {
        "verified_findings": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": False,
                "required": ["finding_id", "resolution", "explanation", "confidence"],
                "properties": {
                    "finding_id": {"type": "string", "minLength": 64, "maxLength": 64},
                    "resolution": {"type": "string", "enum": ["resolved", "unresolved"]},
                    "explanation": {"type": "string", "minLength": 1, "maxLength": 2000},
                    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                },
            },
        },
        "findings": SCHEMA["properties"]["findings"],
        "review_outcome": SCHEMA["properties"]["review_outcome"],
        "review_explanation": SCHEMA["properties"]["review_explanation"],
        "review_confidence": SCHEMA["properties"]["review_confidence"],
    },
}


class AutoreviewError(RuntimeError):
    def __init__(
        self,
        message: str,
        *,
        code: str = "autoreview-failed",
        recovery: str = "inspect-error",
    ) -> None:
        super().__init__(message)
        self.code = code
        self.recovery = recovery


class ReviewOutputError(AutoreviewError):
    def __init__(
        self,
        message: str,
        *,
        classification: str,
        validator_code: str,
        violated_rule: str,
    ) -> None:
        super().__init__(message, code=validator_code, recovery="repair-invalid-output")
        self.classification = classification
        self.validator_code = validator_code
        self.violated_rule = violated_rule


def writable_path_status(path: Path) -> dict[str, Any]:
    expanded = path.expanduser()
    exists = expanded.exists()
    is_directory = expanded.is_dir() if exists else None
    status: dict[str, Any] = {
        "path": str(expanded),
        "exists": exists,
        "is_directory": is_directory,
        "writable": None if not exists else False,
        "probe": "not-run",
        "error": None,
    }
    if not exists:
        status["probe"] = "unverified-missing-directory"
        return status
    if not is_directory:
        status["probe"] = "blocked-not-directory"
        return status

    probe_path: Path | None = None
    primary_error: OSError | None = None
    cleanup_errors: list[str] = []
    try:
        with tempfile.NamedTemporaryFile(
            "w",
            prefix=".autoreview-write-probe-",
            dir=expanded,
            delete=False,
        ) as handle:
            probe_path = Path(handle.name)
    except OSError as exc:
        primary_error = exc
    finally:
        if probe_path is not None:
            try:
                probe_path.unlink(missing_ok=True)
            except OSError as exc:
                cleanup_errors.append(
                    f"{probe_path}: {type(exc).__name__}: {exc}"
                )

    if primary_error is not None:
        status["probe"] = "blocked"
        status["error"] = f"{type(primary_error).__name__}: {primary_error}"
        if cleanup_errors:
            status["probe"] = "blocked-cleanup-failed"
            status["error"] += "; cleanup " + "; ".join(cleanup_errors)
        return status
    if cleanup_errors:
        status["probe"] = "blocked-cleanup-failed"
        status["error"] = "; ".join(cleanup_errors)
        return status

    status["writable"] = True
    status["probe"] = "create-delete-verified"
    return status


def environment_status() -> dict[str, Any]:
    codex_home = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))
    temp_root = Path(tempfile.gettempdir())
    return {
        "codex_home": writable_path_status(codex_home),
        "temp": writable_path_status(temp_root),
        "network": {
            "required": True,
            "status": "not-probed",
            "note": "Codex engine connectivity is classified from codex exec failures.",
        },
    }


def ensure_review_environment() -> None:
    status = environment_status()
    if status["codex_home"]["writable"] is False:
        raise AutoreviewError(
            f"CODEX_HOME is not writable: {status['codex_home']['path']}",
            code="codex-home-unwritable",
            recovery="reroute-to-capable-root",
        )
    if status["temp"]["writable"] is False:
        raise AutoreviewError(
            f"Temporary directory is not writable: {status['temp']['path']}",
            code="temp-unwritable",
            recovery="reroute-to-capable-root",
        )


def classify_codex_failure(detail: str) -> tuple[str, str]:
    lower = detail.lower()
    state_markers = ("state db", "state database", "sqlite", ".codex")
    permission_markers = ("permission denied", "operation not permitted", "read-only file system")
    network_markers = (
        "network is unreachable",
        "failed to connect",
        "connection refused",
        "connection reset",
        "connection error",
        "connect error",
        "error sending request",
        "dns error",
        "name or service not known",
        "temporary failure in name resolution",
    )
    if any(marker in lower for marker in state_markers) and any(
        marker in lower for marker in permission_markers
    ):
        return "codex-home-unwritable", "reroute-to-capable-root"
    if any(marker in lower for marker in network_markers):
        return "codex-network-unavailable", "reroute-to-capable-root"
    return "codex-engine-failed", "inspect-error"


def run(
    args: list[str],
    cwd: Path,
    *,
    input_text: str | None = None,
    check: bool = True,
) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        args,
        cwd=cwd,
        input=input_text,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if check and result.returncode != 0:
        command = " ".join(args)
        detail = result.stderr or result.stdout
        raise AutoreviewError(f"command failed ({result.returncode}): {command}\n{detail}")
    return result


def run_with_heartbeat(
    args: list[str],
    cwd: Path,
    *,
    input_text: str,
    label: str,
    heartbeat_seconds: int,
    on_started: Any | None = None,
) -> subprocess.CompletedProcess[str]:
    started = time_monotonic()
    proc = subprocess.Popen(
        args,
        cwd=cwd,
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if on_started is not None:
        try:
            on_started(proc.pid)
        except BaseException:
            proc.kill()
            proc.wait()
            raise
    first_communicate = True
    while True:
        try:
            stdout, stderr = proc.communicate(
                input=input_text if first_communicate else None,
                timeout=heartbeat_seconds,
            )
            return subprocess.CompletedProcess(args, int(proc.returncode or 0), stdout, stderr)
        except subprocess.TimeoutExpired:
            first_communicate = False
            elapsed = int(time_monotonic() - started)
            print(
                f"review still running: {label} elapsed={elapsed}s pid={proc.pid}",
                file=sys.stderr,
                flush=True,
            )


def time_monotonic() -> float:
    import time

    return time.monotonic()


def has_directory_component(name: str) -> bool:
    path = Path(name)
    separators = [sep for sep in (os.sep, os.altsep) if sep]
    return path.is_absolute() or bool(path.drive) or any(sep in name for sep in separators)


def is_within(path: Path, root: Path) -> bool:
    try:
        return path.resolve() == root.resolve() or path.resolve().is_relative_to(root.resolve())
    except OSError:
        return False


def first_executable(path: Path, *, reject_root: Path | None = None) -> str | None:
    candidates = [path]
    if os.name == "nt" and not path.suffix:
        exts = [ext for ext in os.environ.get("PATHEXT", ".COM;.EXE;.BAT;.CMD").split(";") if ext]
        candidates = [path.with_suffix(ext.lower()) for ext in exts]
        candidates.extend(path.with_suffix(ext.upper()) for ext in exts)
        candidates.append(path)
    for candidate in candidates:
        if candidate.is_file() and os.access(candidate, os.X_OK):
            if reject_root is not None and is_within(candidate, reject_root):
                continue
            return str(candidate)
    return None


def resolve_command(name: str, repo: Path | None = None) -> str:
    if has_directory_component(name):
        path = Path(name)
        candidate = path if path.is_absolute() else Path.cwd() / path
        found = first_executable(candidate)
        if found:
            return found
        raise AutoreviewError(f"executable not found or not executable: {name}")

    reject_root = repo.resolve() if repo else None
    for part in os.environ.get("PATH", "").split(os.pathsep):
        if not part or part == ".":
            continue
        parent = Path(part)
        if not parent.is_absolute():
            continue
        if reject_root is not None and is_within(parent, reject_root):
            continue
        found = first_executable(parent / name, reject_root=reject_root)
        if found:
            return found
    raise AutoreviewError(f"executable not found: {name}")


def git(repo: Path, *args: str, check: bool = True) -> str:
    return run([resolve_command("git", repo), *args], repo, check=check).stdout


def repo_root() -> Path:
    git_bin = resolve_command("git")
    result = run([git_bin, "rev-parse", "--show-toplevel"], Path.cwd(), check=False)
    if result.returncode != 0:
        raise AutoreviewError("autoreview must run inside a git repository")
    return Path(result.stdout.strip()).resolve()


def repo_root_or_none() -> Path | None:
    try:
        return repo_root()
    except AutoreviewError:
        return None


def current_branch(repo: Path) -> str:
    return git(repo, "branch", "--show-current", check=False).strip() or "detached"


def is_dirty(repo: Path) -> bool:
    return bool(git(repo, "status", "--porcelain").strip())


def default_base_ref(repo: Path) -> str:
    origin_head = git(repo, "symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD", check=False).strip()
    if origin_head:
        return origin_head
    for candidate in ("origin/main", "origin/master", "main", "master"):
        if git(repo, "rev-parse", "--verify", "--quiet", candidate, check=False).strip():
            return candidate
    return "origin/main"


def detect_pr_base(repo: Path) -> str | None:
    try:
        gh_bin = resolve_command("gh", repo)
    except AutoreviewError:
        return None
    result = run(
        [gh_bin, "pr", "view", "--json", "baseRefName", "--jq", ".baseRefName"],
        repo,
        check=False,
    )
    base = result.stdout.strip()
    if result.returncode != 0 or not base:
        return None
    return f"origin/{base}"


def choose_target(repo: Path, mode: str, base_ref: str | None) -> tuple[str, str | None]:
    branch = current_branch(repo)
    if mode == "local" or (mode == "auto" and is_dirty(repo)):
        return "local", None
    if mode == "commit":
        return "commit", None
    if mode == "branch":
        return "branch", base_ref or detect_pr_base(repo) or default_base_ref(repo)
    if branch not in {"main", "master"} and branch != "detached":
        return "branch", base_ref or detect_pr_base(repo) or default_base_ref(repo)
    raise AutoreviewError("no review target: clean default-branch checkout and no forced mode")


def bounded(text: str, limit: int = 180_000) -> str:
    if len(text) <= limit:
        return text
    return text[:limit] + f"\n\n[truncated at {limit} characters]\n"


def read_text(path: Path, limit: int = 40_000) -> str:
    try:
        data = path.read_bytes()
    except OSError as exc:
        return f"[unreadable: {exc}]"
    if b"\0" in data:
        return "[binary file omitted]"
    return bounded(data.decode("utf-8", errors="replace"), limit)


def local_bundle(repo: Path) -> str:
    parts = [
        "# Git Status",
        git(repo, "status", "--short"),
        "# Staged Diff",
        git(repo, "diff", "--cached", "--stat"),
        bounded(git(repo, "diff", "--cached", "--patch", "--find-renames")),
        "# Unstaged Diff",
        git(repo, "diff", "--stat"),
        bounded(git(repo, "diff", "--patch", "--find-renames")),
    ]
    untracked = [
        line
        for line in git(repo, "ls-files", "--others", "--exclude-standard").splitlines()
        if line.strip()
    ]
    if untracked:
        parts.append("# Untracked Files")
        for rel in untracked:
            parts.append(f"## {rel}\n{read_text(repo / rel)}")
    return "\n\n".join(parts)


def branch_bundle(repo: Path, base_ref: str) -> str:
    if base_ref.startswith("origin/"):
        git(repo, "fetch", "origin", "--quiet", check=False)
    return "\n\n".join(
        [
            "# Branch Diff",
            f"base: {base_ref}",
            git(repo, "diff", "--stat", f"{base_ref}...HEAD"),
            bounded(git(repo, "diff", "--patch", "--find-renames", f"{base_ref}...HEAD")),
        ]
    )


def commit_bundle(repo: Path, commit_ref: str) -> str:
    return "\n\n".join(
        [
            "# Commit Diff",
            f"commit: {commit_ref}",
            git(repo, "show", "--stat", "--format=fuller", commit_ref),
            bounded(git(repo, "show", "--patch", "--find-renames", "--format=fuller", commit_ref)),
        ]
    )


def changed_paths(repo: Path, target: str, target_ref: str | None, commit_ref: str) -> set[str]:
    if target == "local":
        sources = [
            git(repo, "diff", "--name-only", "--cached"),
            git(repo, "diff", "--name-only"),
            git(repo, "ls-files", "--others", "--exclude-standard"),
        ]
    elif target == "branch":
        if target_ref is None:
            raise AutoreviewError("branch target requires a base ref")
        sources = [git(repo, "diff", "--name-only", f"{target_ref}...HEAD")]
    else:
        sources = [git(repo, "show", "--name-only", "--format=", commit_ref)]
    return {line.strip() for source in sources for line in source.splitlines() if line.strip()}


def sha256_text(value: str) -> str:
    return hashlib.sha256(value.encode("utf-8")).hexdigest()


def canonical_json(value: Any) -> str:
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False)


def evidence_fingerprint(value: dict[str, Any]) -> str:
    return sha256_text(canonical_json({key: item for key, item in value.items() if key != "evidence_fingerprint"}))


def current_head(repo: Path) -> str:
    head = git(repo, "rev-parse", "HEAD").strip()
    if not head:
        raise AutoreviewError("review target has no HEAD revision")
    return head


def merge_base(repo: Path, base_ref: str, head: str = "HEAD") -> str:
    value = git(repo, "merge-base", base_ref, head).strip()
    if not value:
        raise AutoreviewError("branch review target has no merge base")
    return value


def repository_id(repo: Path) -> str:
    common = git(repo, "rev-parse", "--path-format=absolute", "--git-common-dir").strip()
    if not common:
        raise AutoreviewError("review repository identity is unavailable")
    return str(Path(common).resolve())


def finding_id(finding: dict[str, Any]) -> str:
    return sha256_text(canonical_json(finding))


def load_json_file(path: str, label: str) -> dict[str, Any]:
    try:
        value = json.loads(Path(path).read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise AutoreviewError(f"{label} is unreadable: {path}") from exc
    if not isinstance(value, dict):
        raise AutoreviewError(f"{label} must contain one JSON object")
    return value


def validate_evidence(value: dict[str, Any]) -> dict[str, Any]:
    try:
        return protocol.validate_evidence(value)
    except protocol.ProtocolError as exc:
        raise AutoreviewError(str(exc), code=exc.code, recovery=exc.recovery) from exc


def load_finding_file(
    path: str,
    prior: dict[str, Any],
    *,
    require_accepted: bool = True,
) -> tuple[str, list[dict[str, Any]], list[dict[str, Any]]]:
    value = load_json_file(path, "finding file")
    if set(value) != {"finding_source", "findings"} or value.get("finding_source") not in {"autoreview", "codex-review"}:
        raise AutoreviewError("finding file must use canonical finding_source")
    rows = value.get("findings")
    if not isinstance(rows, list) or not rows:
        raise AutoreviewError("finding file must contain at least one finding")
    accepted: list[dict[str, Any]] = []
    rejected: list[dict[str, Any]] = []
    prior_open = {row["finding_id"] for row in prior["finding_state"]["open"]}
    if value["finding_source"] == "codex-review" and prior_open:
        raise AutoreviewError("codex-review findings require prior AutoReview findings to be closed")
    seen: set[str] = set()
    for index, row in enumerate(rows):
        if not isinstance(row, dict) or set(row) != {"finding_id", "finding", "disposition", "reason"}:
            raise AutoreviewError(f"finding file row {index} is invalid")
        identifier = row.get("finding_id")
        if not isinstance(identifier, str) or len(identifier) != 64 or identifier in seen:
            raise AutoreviewError(f"finding file row {index} has invalid finding_id")
        seen.add(identifier)
        if row.get("disposition") not in {"accepted", "rejected"} or not isinstance(row.get("reason"), str) or not row["reason"]:
            raise AutoreviewError(f"finding file row {index} has invalid disposition")
        finding = row.get("finding")
        finding_path = finding.get("code_location", {}).get("file_path", "") if isinstance(finding, dict) else ""
        validate_finding(index, finding, {finding_path})
        if finding_id(finding) != identifier:
            raise AutoreviewError(f"finding file row {index} fingerprint mismatch")
        if value["finding_source"] == "autoreview" and identifier not in prior_open:
            raise AutoreviewError(f"finding file row {index} is not open in prior evidence")
        (accepted if row["disposition"] == "accepted" else rejected).append(row)
    if value["finding_source"] == "autoreview" and seen != prior_open:
        raise AutoreviewError("finding file must disposition every open AutoReview finding")
    if require_accepted and not accepted:
        raise AutoreviewError("fix verification requires at least one accepted finding")
    return value["finding_source"], accepted, rejected


def delta_bundle(repo: Path, previous_head: str) -> tuple[str, set[str], dict[str, list[tuple[int, int]]]]:
    ancestor = run([resolve_command("git", repo), "merge-base", "--is-ancestor", previous_head, "HEAD"], repo, check=False)
    if ancestor.returncode != 0:
        raise AutoreviewError("prior head is not an ancestor of HEAD", code="lineage-invalidated", recovery="start-new-full-lineage")
    patch = git(repo, "diff", "--patch", "--find-renames", "--unified=0", f"{previous_head}..HEAD")
    paths = {line.strip() for line in git(repo, "diff", "--name-only", f"{previous_head}..HEAD").splitlines() if line.strip()}
    if not paths:
        raise AutoreviewError("fix verification requires a changed HEAD", code="review-no-progress", recovery="needs-owner")
    ranges: dict[str, list[tuple[int, int]]] = {}
    current_path: str | None = None
    old_path: str | None = None
    import re
    for line in patch.splitlines():
        if line.startswith("--- a/"):
            old_path = line[6:]
        elif line == "+++ /dev/null":
            current_path = old_path
        elif line.startswith("+++ b/"):
            current_path = line[6:]
        elif current_path and line.startswith("@@"):
            match = re.search(r"\+(\d+)(?:,(\d+))?", line)
            if match:
                start = max(1, int(match.group(1))); length = int(match.group(2) or "1")
                if length == 0:
                    current_file = repo / current_path
                    if current_file.is_file():
                        line_count = len(current_file.read_text(errors="replace").splitlines())
                        start = min(start, max(1, line_count))
                ranges.setdefault(current_path, []).append((start, max(start, start + length - 1)))
    return bounded(patch), paths, ranges


def load_extra_prompt(args: argparse.Namespace) -> str:
    chunks: list[str] = []
    for value in args.prompt or []:
        chunks.append(value)
    for path in args.prompt_file or []:
        chunks.append(Path(path).read_text())
    return "\n\n".join(chunks)


def load_datasets(args: argparse.Namespace) -> str:
    chunks: list[str] = []
    for spec in args.dataset or []:
        path = Path(spec)
        if path.is_dir():
            raise AutoreviewError(f"--dataset must be a file, got directory: {path}")
        chunks.append(f"# Dataset: {path}\n{read_text(path)}")
    return "\n\n".join(chunks)


def build_prompt(
    repo: Path,
    target: str,
    target_ref: str | None,
    bundle: str,
    extra_prompt: str,
    datasets: str,
) -> str:
    target_line = f"{target} {target_ref}" if target_ref else target
    return textwrap.dedent(
        f"""
        You are a senior code reviewer. Review the provided git change bundle only.

        Hard rules:
        - Return exactly one JSON object and nothing else. Do not wrap it in Markdown.
        - The JSON object must match this schema exactly:
        {json.dumps(SCHEMA, indent=2)}
        - Do not modify files.
        - Do not invoke nested reviewers or review tools.
        - Forbidden nested review commands include: codex review, autoreview, claude review, oracle review.
        - You may use read-only tools and web search to inspect files, dependency contracts, upstream docs, current behavior, and security implications.
        - Shell commands, if available, must be read-only inspection commands.
        - Do not run tests, formatters, package installs, generators, network mutation commands, git mutation commands, or commands that write files.
        - Report only actionable defects introduced or exposed by this change.
        - Prefer high-signal findings over style feedback.
        - Include security findings for concrete injection, secret leak, authorization, path traversal, unsafe deserialization, shell, filesystem, privacy, or credential risks.
        - Do not reject legitimate functionality merely because it touches shell, filesystem, network, auth, or sensitive data.
        - For each finding, use the smallest file/line location that demonstrates the issue.
        - If there are no actionable findings, return an empty findings array and set review_outcome to pass.

        Review target: {target_line}
        Repository: {repo}

        {extra_prompt}

        {datasets}

        # Change Bundle
        {bundle}
        """
    ).strip()


def build_verification_prompt(
    repo: Path,
    delta: str,
    accepted: list[dict[str, Any]],
    extra_prompt: str,
    datasets: str,
) -> str:
    return textwrap.dedent(
        f"""
        You are a senior code reviewer performing a narrow fix verification.

        Hard rules:
        - Return exactly one JSON object matching this schema:
        {json.dumps(VERIFICATION_SCHEMA, indent=2)}
        - Do not modify files or invoke nested reviewers.
        - Verify every supplied accepted finding by finding_id.
        - Review only the supplied delta and regressions caused by its changed lines.
        - Do not perform a new broad review of the feature.
        - New findings must point to an added or modified line in the delta.
        - For deletion-only regressions, point to the nearest surviving line,
          or line 1 of a fully deleted file; the validator uses the same policy.
        - Set review_outcome to pass only when every accepted finding is resolved and no delta regression remains.
        - Read-only inspection is allowed; tests, formatters, generators, installs, and mutations are forbidden.

        Repository: {repo}

        # Accepted Findings
        {json.dumps(accepted, indent=2)}

        {extra_prompt}

        {datasets}

        # Fix Delta
        {delta}
        """
    ).strip()


def configured_codex_model() -> str | None:
    try:
        import tomllib
    except ModuleNotFoundError:
        return None
    codex_home = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))
    config_path = codex_home / "config.toml"
    try:
        with config_path.open("rb") as handle:
            config = tomllib.load(handle)
    except OSError:
        return None
    except tomllib.TOMLDecodeError:
        return None
    model = config.get("model")
    return model if isinstance(model, str) and model.strip() else None


def write_json_temp(data: dict[str, Any]) -> Path:
    handle = tempfile.NamedTemporaryFile("w", suffix=".json", delete=False)
    path = Path(handle.name)
    try:
        with handle:
            json.dump(data, handle)
    except BaseException as exc:
        try:
            path.unlink(missing_ok=True)
        except OSError as cleanup_exc:
            detail = (
                f"schema temporary file cleanup failed for {path}: "
                f"{type(cleanup_exc).__name__}: {cleanup_exc}"
            )
            if isinstance(exc, Exception):
                raise AutoreviewError(
                    f"schema temporary file write failed: {type(exc).__name__}: {exc}\n{detail}",
                    code="temp-cleanup-failed",
                    recovery="inspect-error",
                ) from exc
            exc.add_note(detail)
        raise
    return path


def read_review_output(path: Path) -> tuple[str, dict[str, Any]]:
    digest = hashlib.sha256()
    size = 0
    kept = bytearray()
    try:
        with path.open("rb") as handle:
            while chunk := handle.read(64 * 1024):
                digest.update(chunk)
                size += len(chunk)
                if len(kept) < MAX_REVIEW_OUTPUT_BYTES:
                    kept.extend(chunk[: MAX_REVIEW_OUTPUT_BYTES - len(kept)])
    except OSError as exc:
        raise AutoreviewError(
            f"review output is unreadable: {type(exc).__name__}: {exc}",
            code="review-output-unreadable",
            recovery="inspect-error",
        ) from exc
    preview = bounded_utf8_preview(bytes(kept))
    metadata = {
        "output_fingerprint": digest.hexdigest(),
        "output_size_bytes": size,
        "output_truncated": size > MAX_REVIEW_OUTPUT_BYTES,
        "preview": preview,
    }
    return bytes(kept).decode("utf-8", errors="replace"), metadata


def run_codex(args: argparse.Namespace, repo: Path, prompt: str, schema: dict[str, Any] | None = None) -> str:
    ensure_review_environment()
    codex_bin = resolve_command(args.codex_bin, repo)
    model = getattr(args, "_resolved_model", None) or args.model or configured_codex_model()
    cmd = [codex_bin, "--ask-for-approval", "never"]
    if args.web_search:
        cmd.append("--search")
    if model:
        cmd.extend(["--model", model])
    cmd.extend(
        [
            "exec",
            "--ephemeral",
            "-s",
            "read-only",
            "-C",
            str(repo),
            "--ignore-user-config",
            "--ignore-rules",
        ]
    )
    schema_path: Path | None = None
    output_path: Path | None = None
    result: subprocess.CompletedProcess[str] | None = None
    output = ""
    primary_error: AutoreviewError | None = None
    pending_base_exception: BaseException | None = None
    cleanup_errors: list[str] = []
    try:
        schema_path = write_json_temp(schema or SCHEMA)
        output_handle = tempfile.NamedTemporaryFile("w", suffix=".json", delete=False)
        with output_handle:
            output_path = Path(output_handle.name)
        run_cmd = [
            *cmd,
            "--output-schema",
            str(schema_path),
            "--output-last-message",
            str(output_path),
            "-",
        ]
        result = run_with_heartbeat(
            run_cmd,
            repo,
            input_text=prompt,
            label="codex",
            heartbeat_seconds=args.heartbeat_seconds,
            on_started=getattr(args, "_on_model_started", None),
        )
        if result.returncode != 0:
            detail = result.stderr or result.stdout or "codex exec failed without output"
            code, recovery = classify_codex_failure(detail)
            primary_error = AutoreviewError(
                f"codex engine failed ({result.returncode})\n{detail}",
                code=code,
                recovery=recovery,
            )
        else:
            output, metadata = read_review_output(output_path)
            args._last_review_output = metadata
    except AutoreviewError as exc:
        primary_error = exc
    except Exception as exc:
        primary_error = AutoreviewError(
            f"codex execution failed: {type(exc).__name__}: {exc}",
            code="codex-engine-failed",
            recovery="inspect-error",
        )
    except BaseException as exc:
        pending_base_exception = exc
    finally:
        for temp_path in (schema_path, output_path):
            if temp_path is None:
                continue
            try:
                temp_path.unlink(missing_ok=True)
            except OSError as exc:
                cleanup_errors.append(f"{temp_path}: {type(exc).__name__}: {exc}")

    if pending_base_exception is not None:
        if cleanup_errors:
            pending_base_exception.add_note(
                "temporary cleanup failed: " + "; ".join(cleanup_errors)
            )
        raise pending_base_exception

    if primary_error is not None:
        detail = str(primary_error)
        if cleanup_errors:
            detail += "\ntemporary cleanup failed: " + "; ".join(cleanup_errors)
        raise AutoreviewError(
            detail,
            code=primary_error.code,
            recovery=primary_error.recovery,
        )
    if cleanup_errors:
        raise AutoreviewError(
            "temporary cleanup failed: " + "; ".join(cleanup_errors),
            code="temp-cleanup-failed",
            recovery="inspect-error",
        )
    if result is None:
        raise AutoreviewError(
            "codex execution ended without a process result",
            code="codex-engine-failed",
            recovery="inspect-error",
        )
    return output or result.stdout


def parse_json_candidate(text: str) -> Any | None:
    stripped = text.strip()
    if stripped.startswith("```"):
        lines = stripped.splitlines()
        if lines and lines[0].startswith("```") and lines[-1].strip() == "```":
            stripped = "\n".join(lines[1:-1]).strip()
    try:
        parsed = json.loads(stripped)
    except json.JSONDecodeError:
        return None
    if isinstance(parsed, str) and parsed != text:
        nested = parse_json_candidate(parsed)
        return nested if nested is not None else parsed
    return parsed


def extract_json(text: str) -> dict[str, Any]:
    stripped = text.strip()
    if not stripped:
        raise ReviewOutputError(
            "review engine returned empty output",
            classification="schema-parse",
            validator_code="review-output-empty",
            violated_rule="The reviewer must return exactly one JSON object.",
        )
    parsed = parse_json_candidate(stripped)
    if isinstance(parsed, dict) and "findings" in parsed:
        return parsed
    if isinstance(parsed, dict) and isinstance(parsed.get("structured_output"), dict):
        return parsed["structured_output"]
    if isinstance(parsed, dict) and isinstance(parsed.get("result"), str):
        result = parse_json_candidate(parsed["result"])
        if isinstance(result, dict) and "findings" in result:
            return result
    preview = stripped[:2000]
    raise ReviewOutputError(
        f"review engine returned unexpected JSON shape:\n{preview}",
        classification="schema-parse",
        validator_code="review-output-shape-invalid",
        violated_rule="The reviewer output must match the requested object schema exactly.",
    )


def number_in_range(value: Any) -> bool:
    return isinstance(value, (int, float)) and not isinstance(value, bool) and 0 <= value <= 1


def validate_report(report: dict[str, Any], changed: set[str]) -> None:
    allowed_top = {"findings", "review_outcome", "review_explanation", "review_confidence"}
    extra_top = set(report) - allowed_top
    if extra_top:
        raise AutoreviewError(f"review JSON has unexpected top-level keys: {sorted(extra_top)}")
    for key in SCHEMA["required"]:
        if key not in report:
            raise AutoreviewError(f"review JSON missing required key: {key}")
    if not isinstance(report["findings"], list):
        raise AutoreviewError("review JSON findings must be an array")
    if report.get("review_outcome") not in REVIEW_OUTCOMES:
        raise AutoreviewError(f"review JSON has invalid review_outcome: {report.get('review_outcome')}")
    if report["findings"] and report["review_outcome"] != "fail":
        raise AutoreviewError("review JSON with findings must set review_outcome to fail")
    if not report["findings"] and report["review_outcome"] == "fail":
        raise AutoreviewError("review JSON fail outcome must include a discrete finding")
    if not isinstance(report.get("review_explanation"), str) or not report["review_explanation"]:
        raise AutoreviewError("review JSON review_explanation must be a non-empty string")
    if len(report["review_explanation"]) > 3000:
        raise AutoreviewError("review JSON review_explanation is too long")
    if not number_in_range(report.get("review_confidence")):
        raise AutoreviewError("review JSON review_confidence must be numeric")

    for index, finding in enumerate(report["findings"]):
        validate_finding(index, finding, changed)


def validate_finding(index: int, finding: Any, changed: set[str]) -> None:
    if not isinstance(finding, dict):
        raise AutoreviewError(f"finding {index} must be an object")
    allowed = {"title", "body", "priority", "confidence", "finding_category", "code_location"}
    extra = set(finding) - allowed
    if extra:
        raise AutoreviewError(f"finding {index} has unexpected keys: {sorted(extra)}")
    for key in allowed:
        if key not in finding:
            raise AutoreviewError(f"finding {index} missing required key: {key}")
    title = finding.get("title")
    if not isinstance(title, str) or not title or len(title) > 140:
        raise AutoreviewError(f"finding {index} has invalid title")
    body = finding.get("body")
    if not isinstance(body, str) or not body or len(body) > 2000:
        raise AutoreviewError(f"finding {index} has invalid body")
    priority = finding.get("priority")
    if not isinstance(priority, int) or isinstance(priority, bool) or priority not in PRIORITIES:
        raise AutoreviewError(f"finding {index} has invalid priority: {priority}")
    if finding.get("finding_category") not in FINDING_CATEGORIES:
        raise AutoreviewError(
            f"finding {index} has invalid finding_category: {finding.get('finding_category')}"
        )
    if not number_in_range(finding.get("confidence")):
        raise AutoreviewError(f"finding {index} has invalid confidence")
    location = finding.get("code_location")
    if not isinstance(location, dict):
        raise AutoreviewError(f"finding {index} missing code_location")
    rel = str(location.get("file_path", "")).strip()
    line = location.get("line")
    rel_path = Path(rel)
    if not rel or not isinstance(line, int) or line < 1:
        raise AutoreviewError(f"finding {index} has invalid location: {location}")
    if rel_path.is_absolute() or ".." in rel_path.parts:
        raise AutoreviewError(f"finding {index} uses invalid file path: {rel}")
    if rel not in changed:
        raise AutoreviewError(f"finding {index} points to a file outside the reviewed change: {rel}")


def validate_verification_report(
    report: dict[str, Any],
    accepted_ids: set[str],
    changed: set[str],
    ranges: dict[str, list[tuple[int, int]]],
) -> None:
    allowed = {"verified_findings", "findings", "review_outcome", "review_explanation", "review_confidence"}
    if set(report) != allowed:
        raise AutoreviewError("verification JSON has unexpected keys")
    verified = report.get("verified_findings")
    if not isinstance(verified, list):
        raise AutoreviewError("verification JSON verified_findings must be an array")
    seen: set[str] = set()
    unresolved = False
    for index, item in enumerate(verified):
        if not isinstance(item, dict) or set(item) != {"finding_id", "resolution", "explanation", "confidence"}:
            raise AutoreviewError(f"verified finding {index} is invalid")
        if item["finding_id"] not in accepted_ids or item["finding_id"] in seen:
            raise AutoreviewError(f"verified finding {index} has an unexpected finding_id")
        if item["resolution"] not in {"resolved", "unresolved"} or not item["explanation"] or not number_in_range(item["confidence"]):
            raise AutoreviewError(f"verified finding {index} has invalid values")
        seen.add(item["finding_id"])
        unresolved = unresolved or item["resolution"] == "unresolved"
    if seen != accepted_ids:
        raise AutoreviewError("verification JSON must cover every accepted finding")
    base_report = {key: report[key] for key in ("findings", "review_outcome", "review_explanation", "review_confidence")}
    validate_report(base_report, changed)
    for index, finding in enumerate(report["findings"]):
        location = finding["code_location"]
        if not any(start <= location["line"] <= end for start, end in ranges.get(location["file_path"], [])):
            raise AutoreviewError(f"finding {index} points outside the changed delta lines")
    expected_fail = unresolved or bool(report["findings"])
    if expected_fail != (report["review_outcome"] == "fail"):
        raise AutoreviewError("verification outcome does not match unresolved findings")


def classified_validation_error(exc: AutoreviewError, *, verification: bool) -> AutoreviewError:
    detail = str(exc)
    if (
        "unexpected finding_id" in detail
        or "must cover every accepted finding" in detail
        or "outside the changed delta lines" in detail
        or "outside the reviewed change" in detail
    ):
        return AutoreviewError(
            detail,
            code="review-output-identity-drift",
            recovery="needs-owner",
        )
    semantic_codes = {
        "review JSON with findings must set review_outcome to fail": "review-pass-with-finding",
        "review JSON fail outcome must include a discrete finding": "review-fail-without-finding",
        "verification outcome does not match unresolved findings": "verification-outcome-mismatch",
    }
    code = semantic_codes.get(detail)
    classification = "semantic-invariant" if code else "schema-parse"
    semantic_rules = {
        "review-pass-with-finding": "A result with findings must use review_outcome=fail.",
        "review-fail-without-finding": "A result with review_outcome=fail must include a discrete finding.",
        "verification-outcome-mismatch": "Verification outcome must match unresolved findings.",
    }
    return ReviewOutputError(
        detail,
        classification=classification,
        validator_code=code or ("verification-schema-invalid" if verification else "review-schema-invalid"),
        violated_rule=semantic_rules.get(
            code,
            "The reviewer output must satisfy the requested schema and field constraints.",
        ),
    )


def validate_model_response(
    args: argparse.Namespace,
    text: str,
    *,
    changed: set[str],
    verification: tuple[set[str], dict[str, list[tuple[int, int]]]] | None = None,
) -> dict[str, Any]:
    metadata = getattr(args, "_last_review_output", {})
    if metadata.get("output_truncated"):
        raise ReviewOutputError(
            f"review output exceeds {MAX_REVIEW_OUTPUT_BYTES} bytes",
            classification="schema-parse",
            validator_code="review-output-too-large",
            violated_rule=f"Reviewer output must not exceed {MAX_REVIEW_OUTPUT_BYTES} bytes.",
        )
    report = extract_json(text)
    try:
        if verification is None:
            validate_report(report, changed)
        else:
            accepted_ids, ranges = verification
            validate_verification_report(report, accepted_ids, changed, ranges)
    except ReviewOutputError:
        raise
    except AutoreviewError as exc:
        raise classified_validation_error(exc, verification=verification is not None) from exc
    return report


def invalid_output_record(args: argparse.Namespace, exc: ReviewOutputError, artifact_ref: str) -> dict[str, Any]:
    metadata = getattr(args, "_last_review_output", {})
    return {
        "classification": exc.classification,
        "validator_code": exc.validator_code,
        "violated_rule": exc.violated_rule,
        "output_fingerprint": metadata.get("output_fingerprint", hashlib.sha256(b"").hexdigest()),
        "output_size_bytes": metadata.get("output_size_bytes", 0),
        "output_truncated": bool(metadata.get("output_truncated")),
        "preview": bounded_utf8_preview(str(metadata.get("preview", "")).encode("utf-8")),
        "artifact_ref": artifact_ref,
    }


def bounded_utf8_preview(raw: bytes) -> str:
    preview = raw[:INVALID_OUTPUT_PREVIEW_BYTES].decode("utf-8", errors="replace")
    while len(preview.encode("utf-8")) > INVALID_OUTPUT_PREVIEW_BYTES:
        preview = preview[:-1]
    return preview


def build_repair_appendix(exc: ReviewOutputError) -> str:
    appendix = textwrap.dedent(
        f"""

        # Structured Output Repair
        The previous response was rejected with validator_code={exc.validator_code}.
        Violated rule: {exc.violated_rule}
        Return a valid result using only the immutable bundle and read-only repository context already supplied.
        Do not add context, broaden scope, synthesize findings, or repeat an invalid verdict.
        """
    ).rstrip()
    if len(appendix.encode("utf-8")) > MAX_REPAIR_APPENDIX_BYTES:
        raise AutoreviewError(
            "helper-owned repair appendix exceeds its bound",
            code="repair-appendix-too-large",
            recovery="needs-owner",
        )
    return appendix


def run_validated_model(
    args: argparse.Namespace,
    repo: Path,
    prompt: str,
    schema: dict[str, Any],
    *,
    changed: set[str],
    verification: tuple[set[str], dict[str, list[tuple[int, int]]]] | None = None,
) -> dict[str, Any]:
    args._active_prompt_fingerprint = sha256_text(prompt)
    try:
        return validate_model_response(
            args,
            run_codex(args, repo, prompt, schema),
            changed=changed,
            verification=verification,
        )
    except ReviewOutputError as first:
        args._pending_invalid_output = first
        prepare_repair = getattr(args, "_prepare_invalid_output_repair", None)
        start_repair = getattr(args, "_start_invalid_output_repair", None)
        validate_identity = getattr(args, "_validate_invalid_output_repair", None)
        if prepare_repair is None or start_repair is None or validate_identity is None:
            raise AutoreviewError(
                "review output is invalid and this invocation has no managed repair reservation",
                code=first.validator_code,
                recovery="needs-owner",
            ) from first
        repair_prompt = prompt + build_repair_appendix(first)
        validate_identity(prompt, schema)
        prepare_repair(first, prompt, repair_prompt)
        args._pending_invalid_output = None
        prior_callback = getattr(args, "_on_model_started", None)
        args._on_model_started = start_repair
        args._active_prompt_fingerprint = sha256_text(repair_prompt)
        try:
            text = run_codex(args, repo, repair_prompt, schema)
            return validate_model_response(
                args,
                text,
                changed=changed,
                verification=verification,
            )
        except ReviewOutputError as second:
            args._terminal_invalid_output = second
            raise AutoreviewError(
                "review output remained invalid after one bounded repair launch",
                code="invalid-output-repair-exhausted",
                recovery="needs-owner",
            ) from second
        finally:
            args._on_model_started = prior_callback


def finding_rows(report: dict[str, Any]) -> list[dict[str, Any]]:
    return [{"finding_id": finding_id(item), "finding": item} for item in report.get("findings", [])]


def make_evidence(
    *,
    phase: str,
    repo: Path,
    base_ref: str,
    bundle_fingerprint: str,
    changed: set[str],
    report: dict[str, Any],
    prompt_characters: int,
    elapsed_seconds: int,
    prior: dict[str, Any] | None = None,
    accepted: list[dict[str, Any]] | None = None,
    rejected: list[dict[str, Any]] | None = None,
    hosted_obligation: dict[str, Any] | None = None,
    target_override: dict[str, Any] | None = None,
) -> dict[str, Any]:
    head = current_head(repo)
    repo_id = repository_id(repo)
    review_scope = list(prior["target"]["review_scope"]) if prior else sorted(changed)
    review_target_key = protocol.make_review_target_key(
        repository_id=repo_id, base_ref=base_ref, review_scope=review_scope
    )
    reviewed_patch_fingerprint = sha256_text(branch_bundle(repo, base_ref))
    target = {
        "repository_id": repo_id,
        "base_ref": base_ref,
        "merge_base_sha": merge_base(repo, base_ref),
        "head_sha": head,
        "review_scope": review_scope,
        "review_target_key": review_target_key,
        "reviewed_patch_fingerprint": reviewed_patch_fingerprint,
        "phase_input_fingerprint": bundle_fingerprint,
        "committed_revision_key": protocol.make_committed_revision_key(
            review_target_key=review_target_key,
            head_sha=head,
            reviewed_patch_fingerprint=reviewed_patch_fingerprint,
        ),
    }
    if target_override is not None:
        target_override = protocol.validate_target(target_override)
        for field in ("repository_id", "base_ref", "merge_base_sha", "head_sha", "reviewed_patch_fingerprint"):
            if target_override[field] != target[field]:
                raise AutoreviewError(
                    f"reserved target {field} differs from the current committed patch",
                    code="reservation-stale",
                    recovery="derive-next-action-again",
                )
        target = dict(target_override)
    if prior is None:
        lineage_id = protocol.fingerprint(
            {"review_target_key": review_target_key, "initial_committed_revision_key": target["committed_revision_key"]}
        )
        counts = {"full_reviews": 1, "terminal_full_reviews": 0, "fix_verifications": 0, "model_calls": 1}
        resolved: list[str] = []
        rejected_rows: list[dict[str, Any]] = []
    else:
        lineage_id = prior["lineage_id"]
        counts = dict(prior["counts"])
        if phase == "terminal-full":
            counts["full_reviews"] += 1
            counts["terminal_full_reviews"] += 1
            counts["model_calls"] += 1
        elif phase == "fix-verification":
            counts["fix_verifications"] += 1
            counts["model_calls"] += 1
        resolved = list(prior["finding_state"]["resolved"])
        rejected_rows = list(prior["finding_state"]["rejected"])
    if phase == "fix-verification":
        for item in report["verified_findings"]:
            if item["resolution"] == "resolved" and item["finding_id"] not in resolved:
                resolved.append(item["finding_id"])
        rejected_rows.extend(rejected or [])
    elif phase == "disposition":
        rejected_rows.extend(rejected or [])
    open_rows = finding_rows(report)
    if phase == "fix-verification":
        unresolved_ids = {
            item["finding_id"] for item in report["verified_findings"]
            if item["resolution"] == "unresolved"
        }
        open_rows.extend(
            {"finding_id": row["finding_id"], "finding": row["finding"]}
            for row in accepted or [] if row["finding_id"] in unresolved_ids
        )
        open_rows = list({row["finding_id"]: row for row in open_rows}.values())
    if report["review_outcome"] == "pass":
        if phase in {"full", "terminal-full"}:
            terminal_state = "terminal-clean"
        elif phase == "disposition":
            terminal_state = "terminal-composite-clean"
        elif counts["full_reviews"] >= 2 or prior and prior["terminal_state"] in {"terminal-clean", "terminal-composite-clean"}:
            terminal_state = "terminal-composite-clean"
        else:
            terminal_state = "verification-clean"
    else:
        terminal_state = "fix-required"
    evidence: dict[str, Any] = {
        "schema_version": protocol.EVIDENCE_SCHEMA_VERSION,
        "protocol_version": protocol.PROTOCOL_VERSION,
        "review_phase": phase,
        "lineage_id": lineage_id,
        "parent_evidence_fingerprint": prior["evidence_fingerprint"] if prior else None,
        "target": target,
        "counts": counts,
        "finding_state": {"open": open_rows, "resolved": resolved, "rejected": rejected_rows},
        "hosted_obligation_id": hosted_obligation["obligation_id"] if hosted_obligation else None,
        "report": report,
        "terminal_state": terminal_state,
        "metrics": {"prompt_characters": prompt_characters, "elapsed_seconds": elapsed_seconds},
    }
    evidence["evidence_fingerprint"] = protocol.evidence_fingerprint(evidence)
    try:
        protocol.validate_transition(prior, evidence, hosted_obligation=hosted_obligation)
    except protocol.ProtocolError as exc:
        raise AutoreviewError(str(exc), code=exc.code, recovery=exc.recovery) from exc
    return evidence


def human_report(report: dict[str, Any]) -> str:
    lines: list[str] = []
    findings = report["findings"]
    if findings:
        lines.append(f"autoreview findings: {len(findings)}")
    elif report["review_outcome"] == "fail":
        lines.append("autoreview verdict: patch is incorrect without discrete findings")
    else:
        lines.append("autoreview clean: no accepted/actionable findings reported")
    for finding in findings:
        loc = finding["code_location"]
        lines.append("")
        lines.append(f"[P{finding['priority']}] {finding['title']}")
        lines.append(f"{loc['file_path']}:{loc['line']}")
        lines.append(finding["body"])
    lines.append("")
    outcome_text = "patch is correct" if report["review_outcome"] == "pass" else "patch is incorrect"
    lines.append(f"overall: {outcome_text} ({report['review_confidence']})")
    lines.append(report["review_explanation"])
    return "\n".join(lines)


def doctor(args: argparse.Namespace) -> int:
    repo = repo_root_or_none()
    missing: list[str] = []
    git_info = command_info("git", repo)
    codex_info = command_info(args.codex_bin, repo)
    gh_info = command_info("gh", repo)
    if not git_info["ok"]:
        missing.append("git")
    if not codex_info["ok"]:
        missing.append("codex")

    codex_exec = False
    structured_flags = False
    if codex_info["ok"]:
        result = run([codex_info["path"], "exec", "--help"], Path.cwd(), check=False)
        help_text = f"{result.stdout}\n{result.stderr}"
        codex_exec = result.returncode == 0
        structured_flags = "--output-schema" in help_text and "--output-last-message" in help_text
        if not codex_exec:
            missing.append("codex exec")
        if not structured_flags:
            missing.append("codex structured output flags")

    environment = environment_status()
    if environment["codex_home"]["writable"] is False:
        missing.append("writable CODEX_HOME")
    if environment["temp"]["writable"] is False:
        missing.append("writable temporary directory")

    payload = {
        "ok": not missing,
        "version": VERSION,
        "repo_root": str(repo) if repo else None,
        "git": git_info,
        "gh": {**gh_info, "optional": True, "purpose": "PR base detection"},
        "codex": codex_info,
        "configured_model": configured_codex_model(),
        "environment": environment,
        "recovery": (
            "reroute-to-capable-root"
            if environment["codex_home"]["writable"] is False
            or environment["temp"]["writable"] is False
            else "none"
        ),
        "supports": {
            "codex_exec": codex_exec,
            "structured_output_flags": structured_flags,
            "read_only_sandbox": True,
        },
        "missing": missing,
    }
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print(f"autoreview {VERSION}")
        print(f"repo: {payload['repo_root'] or 'not inside a git repository'}")
        print(f"git: {git_info.get('path') or 'missing'}")
        print(f"codex: {codex_info.get('path') or 'missing'}")
        print(f"structured output: {'yes' if structured_flags else 'no'}")
        print(f"ok: {'yes' if payload['ok'] else 'no'}")
        if missing:
            print("missing: " + ", ".join(missing))
    return 0 if payload["ok"] else 1


def command_info(name: str, repo: Path | None) -> dict[str, Any]:
    try:
        path = resolve_command(name, repo)
    except AutoreviewError as exc:
        return {"ok": False, "path": None, "version": None, "error": str(exc)}
    version = run([path, "--version"], Path.cwd(), check=False)
    return {
        "ok": version.returncode == 0,
        "path": path,
        "version": (version.stdout or version.stderr).strip() or None,
        "error": None if version.returncode == 0 else (version.stderr or version.stdout).strip(),
    }


def build_review(args: argparse.Namespace) -> tuple[Path, str, str | None, set[str], str, str]:
    repo = repo_root()
    target, target_ref = choose_target(repo, args.mode, args.base)
    if target == "local":
        bundle = local_bundle(repo)
    elif target == "branch":
        if target_ref is None:
            raise AutoreviewError("branch target requires a base ref")
        bundle = branch_bundle(repo, target_ref)
    else:
        bundle = commit_bundle(repo, args.commit)
    changed = changed_paths(repo, target, target_ref, args.commit)
    if not changed:
        raise AutoreviewError("review target has no changed files")
    prompt = build_prompt(repo, target, target_ref, bundle, load_extra_prompt(args), load_datasets(args))
    return repo, target, target_ref, changed, prompt, sha256_text(bundle)


def run_review(args: argparse.Namespace) -> int:
    if args.review_phase == "fix-verification":
        return run_fix_verification(args)
    if args.review_phase == "disposition":
        return run_disposition(args)
    if args.review_phase == "full" and (args.prior_evidence or args.finding_file):
        raise AutoreviewError("full review does not accept prior evidence or a finding file")
    if args.review_phase == "terminal-full" and (not args.prior_evidence or not args.evidence_output or args.finding_file):
        raise AutoreviewError("terminal-full requires --prior-evidence and --evidence-output only")
    repo, target, target_ref, changed, prompt, target_fingerprint = build_review(args)
    if args.evidence_output and (target != "branch" or target_ref is None):
        raise AutoreviewError("evidence chains require branch mode")
    prior: dict[str, Any] | None = None
    if args.review_phase == "terminal-full":
        prior = validate_evidence(getattr(args, "_managed_prior", None) or load_json_file(args.prior_evidence, "prior evidence"))
        validate_lineage(repo, target_ref, changed, prior)
        if prior["terminal_state"] != "verification-clean":
            raise AutoreviewError("terminal-full requires a clean verification chain")
        if prior["counts"]["full_reviews"] != 1:
            raise AutoreviewError("a third full review is forbidden in the same lineage", code="full-review-budget-exhausted", recovery="use-fix-verification")
    if args.dry_run:
        payload = {
            "ok": True,
            "dry_run": True,
            "repo_root": str(repo),
            "target": target,
            "base": target_ref,
            "changed_files": sorted(changed),
            "prompt_characters": len(prompt),
        }
        if args.output:
            Path(args.output).write_text(prompt)
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(f"autoreview dry run: {target}{f' {target_ref}' if target_ref else ''}")
            print(f"changed files: {len(changed)}")
            print(f"prompt characters: {len(prompt)}")
            if args.output:
                print(f"prompt written: {args.output}")
        return 0

    import time
    started = time.monotonic()
    report = run_validated_model(args, repo, prompt, SCHEMA, changed=changed)
    elapsed = int(time.monotonic() - started)
    if args.json_output:
        Path(args.json_output).write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
    if args.evidence_output:
        evidence = make_evidence(
            phase=args.review_phase, repo=repo, base_ref=target_ref,
            bundle_fingerprint=target_fingerprint, changed=changed, report=report,
            prompt_characters=len(prompt), elapsed_seconds=elapsed, prior=prior,
            target_override=getattr(args, "_managed_target", None),
        )
        Path(args.evidence_output).write_text(json.dumps(evidence, indent=2, sort_keys=True) + "\n")
    rendered = human_report(report)
    if args.output:
        Path(args.output).write_text(rendered + "\n")
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print(rendered)
    return 1 if report["review_outcome"] == "fail" else 0


def validate_lineage(repo: Path, base_ref: str, changed: set[str], prior: dict[str, Any]) -> None:
    target = prior["target"]
    if target["repository_id"] != repository_id(repo) or target["base_ref"] != base_ref:
        raise AutoreviewError("repository or base changed", code="lineage-invalidated", recovery="start-new-full-lineage")
    current_patch = sha256_text(branch_bundle(repo, base_ref))
    if target["merge_base_sha"] != merge_base(repo, base_ref) and current_patch != target["reviewed_patch_fingerprint"]:
        raise AutoreviewError("rebase changed the canonical reviewed patch", code="lineage-invalidated", recovery="request-lineage-reset-authority")
    if not changed.issubset(set(target["review_scope"])):
        raise AutoreviewError("review scope expanded to new paths", code="lineage-invalidated", recovery="start-new-full-lineage")


def run_fix_verification(args: argparse.Namespace) -> int:
    if not args.prior_evidence or not args.finding_file or not args.evidence_output:
        raise AutoreviewError("fix-verification requires --prior-evidence, --finding-file, and --evidence-output")
    repo = repo_root()
    target, base_ref = choose_target(repo, args.mode, args.base)
    if target != "branch" or base_ref is None or is_dirty(repo):
        raise AutoreviewError("fix-verification requires a clean committed branch target")
    prior = validate_evidence(getattr(args, "_managed_prior", None) or load_json_file(args.prior_evidence, "prior evidence"))
    full_changed = changed_paths(repo, "branch", base_ref, args.commit)
    validate_lineage(repo, base_ref, full_changed, prior)
    source, accepted, rejected = load_finding_file(args.finding_file, prior)
    delta, delta_paths, ranges = delta_bundle(repo, prior["target"]["head_sha"])
    if not delta_paths.issubset(set(prior["target"]["review_scope"])):
        raise AutoreviewError("fix delta expands the reviewed path set", code="lineage-invalidated", recovery="start-new-full-lineage")
    prompt = build_verification_prompt(repo, delta, accepted, load_extra_prompt(args), load_datasets(args))
    if args.dry_run:
        payload = {"ok": True, "dry_run": True, "review_phase": "fix-verification", "finding_source": source,
                   "changed_files": sorted(delta_paths), "prompt_characters": len(prompt)}
        if args.output:
            Path(args.output).write_text(prompt)
        print(json.dumps(payload, indent=2, sort_keys=True) if args.json else f"autoreview dry run: fix-verification\nchanged files: {len(delta_paths)}\nprompt characters: {len(prompt)}")
        return 0
    import time
    started = time.monotonic()
    accepted_ids = {row["finding_id"] for row in accepted}
    report = run_validated_model(
        args,
        repo,
        prompt,
        VERIFICATION_SCHEMA,
        changed=delta_paths,
        verification=(accepted_ids, ranges),
    )
    elapsed = int(time.monotonic() - started)
    if args.json_output:
        Path(args.json_output).write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
    evidence = make_evidence(
        phase="fix-verification", repo=repo, base_ref=base_ref,
        bundle_fingerprint=sha256_text(delta), changed=full_changed, report=report,
        prompt_characters=len(prompt), elapsed_seconds=elapsed, prior=prior,
        accepted=accepted, rejected=rejected,
        hosted_obligation=getattr(args, "_managed_obligation", None),
        target_override=getattr(args, "_managed_target", None),
    )
    Path(args.evidence_output).write_text(json.dumps(evidence, indent=2, sort_keys=True) + "\n")
    rendered = human_report({key: report[key] for key in ("findings", "review_outcome", "review_explanation", "review_confidence")})
    if args.output:
        Path(args.output).write_text(rendered + "\n")
    print(json.dumps(report, indent=2, sort_keys=True) if args.json else rendered)
    return 1 if report["review_outcome"] == "fail" else 0


def run_disposition(args: argparse.Namespace) -> int:
    if not args.prior_evidence or not args.finding_file or not args.evidence_output:
        raise AutoreviewError("disposition requires --prior-evidence, --finding-file, and --evidence-output")
    repo = repo_root()
    target, base_ref = choose_target(repo, args.mode, args.base)
    if target != "branch" or base_ref is None or is_dirty(repo):
        raise AutoreviewError("disposition requires a clean committed branch target")
    prior = validate_evidence(getattr(args, "_managed_prior", None) or load_json_file(args.prior_evidence, "prior evidence"))
    if current_head(repo) != prior["target"]["head_sha"]:
        raise AutoreviewError("disposition requires the unchanged reviewed head", code="lineage-invalidated", recovery="use-fix-verification")
    changed = changed_paths(repo, "branch", base_ref, args.commit)
    validate_lineage(repo, base_ref, changed, prior)
    source, accepted, rejected = load_finding_file(args.finding_file, prior, require_accepted=False)
    if source != "autoreview" or accepted or not rejected:
        raise AutoreviewError("disposition accepts only a rejection-only AutoReview finding file")
    report = {
        "findings": [],
        "review_outcome": "pass",
        "review_explanation": "Every prior finding was consciously rejected with a reason.",
        "review_confidence": 1.0,
    }
    evidence = make_evidence(
        phase="disposition", repo=repo, base_ref=base_ref,
        bundle_fingerprint=prior["target"]["phase_input_fingerprint"], changed=changed,
        report=report, prompt_characters=0, elapsed_seconds=0, prior=prior,
        target_override=getattr(args, "_managed_target", None),
        rejected=rejected,
    )
    Path(args.evidence_output).write_text(json.dumps(evidence, indent=2, sort_keys=True) + "\n")
    if args.json_output:
        Path(args.json_output).write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
    rendered = human_report(report)
    if args.output:
        Path(args.output).write_text(rendered + "\n")
    print(json.dumps(report, indent=2, sort_keys=True) if args.json else rendered)
    return 0


def findings_template(finding_source: str) -> dict[str, Any]:
    return {
        "schema_version": "1.0.0",
        "template": True,
        "finding_source": finding_source,
        "findings": [
            {
                "finding": {
                    "title": "REPLACE_ME",
                    "body": "REPLACE_ME",
                    "priority": 2,
                    "finding_category": "bug",
                    "confidence": 1.0,
                    "code_location": {
                        "file_path": "relative/path.py",
                        "line": 1,
                    },
                },
                "disposition": "accepted",
                "reason": "REPLACE_ME",
            }
        ],
    }


def prepare_findings(value: dict[str, Any]) -> dict[str, Any]:
    if set(value) != {"schema_version", "template", "finding_source", "findings"}:
        raise AutoreviewError("finding draft has an invalid shape", code="finding-fields-invalid", recovery="regenerate-finding-template")
    if value.get("schema_version") != "1.0.0" or value.get("template") is not False:
        raise AutoreviewError("finding draft is an unprepared template or unsupported schema", code="finding-fields-invalid", recovery="fill-finding-template")
    source = value.get("finding_source")
    rows = value.get("findings")
    if source not in {"autoreview", "codex-review"} or not isinstance(rows, list) or not rows:
        raise AutoreviewError("finding draft must use a canonical source and nonempty findings", code="finding-fields-invalid", recovery="fill-finding-template")
    prepared: list[dict[str, Any]] = []
    seen: set[str] = set()
    for index, row in enumerate(rows):
        if not isinstance(row, dict) or set(row) != {"finding", "disposition", "reason"}:
            raise AutoreviewError(f"finding draft row {index} is invalid", code="finding-fields-invalid", recovery="regenerate-finding-template")
        finding = row.get("finding")
        path = finding.get("code_location", {}).get("file_path", "") if isinstance(finding, dict) else ""
        validate_finding(index, finding, {path})
        disposition = row.get("disposition")
        reason = row.get("reason")
        if disposition not in {"accepted", "rejected"} or not isinstance(reason, str) or not reason:
            raise AutoreviewError(f"finding draft row {index} has invalid disposition", code="finding-fields-invalid", recovery="fill-finding-template")
        identifier = finding_id(finding)
        if identifier in seen:
            raise AutoreviewError(f"finding draft row {index} is duplicate", code="finding-fields-invalid", recovery="deduplicate-findings")
        seen.add(identifier)
        prepared.append({"finding_id": identifier, "finding": finding, "disposition": disposition, "reason": reason})
    return {"finding_source": source, "findings": prepared}


def run_findings_command(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description="Template or prepare canonical AutoReview finding intake.")
    parser.add_argument("--json", action="store_true")
    nouns = parser.add_subparsers(dest="noun", required=True)
    findings = nouns.add_parser("findings")
    verbs = findings.add_subparsers(dest="verb", required=True)
    template = verbs.add_parser("template")
    template.add_argument("--finding-source", choices=["autoreview", "codex-review"], required=True)
    template.add_argument("--output", required=True)
    prepare = verbs.add_parser("prepare")
    prepare.add_argument("--input", required=True)
    prepare.add_argument("--output", required=True)
    args = parser.parse_args(argv)
    try:
        output = Path(args.output)
        if not output.is_absolute():
            raise AutoreviewError("finding output must be absolute", code="finding-fields-invalid", recovery="use-absolute-output")
        if output.is_symlink() or (output.exists() and not output.is_file()):
            raise AutoreviewError("finding output must be a regular file path", code="finding-fields-invalid", recovery="use-regular-output")
        if args.verb == "template":
            value = findings_template(args.finding_source)
        else:
            input_path = Path(args.input)
            if not input_path.is_absolute() or input_path.is_symlink() or not input_path.is_file():
                raise AutoreviewError("finding input must be an absolute regular file", code="finding-fields-invalid", recovery="regenerate-finding-template")
            value = prepare_findings(load_json_file(str(input_path), "finding draft"))
        output.parent.mkdir(parents=True, exist_ok=True)
        output.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")
        result = {"ok": True, "command": f"findings-{args.verb}", "output": str(output), "finding_count": len(value["findings"])}
        print(json.dumps(result, indent=2, sort_keys=True) if args.json else f"{result['command']}: {output}")
        return 0
    except AutoreviewError as exc:
        if args.json:
            print(json.dumps({"ok": False, "error": str(exc), "error_code": exc.code, "recovery": exc.recovery}, indent=2, sort_keys=True), file=sys.stderr)
        else:
            print(f"autoreview: {exc}", file=sys.stderr)
        return 2


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Run a Codex-only structured closeout review.",
        epilog="Finding intake helpers: --json findings template|prepare ...",
    )
    parser.add_argument("command", nargs="?", choices=["doctor"], help="Optional command. Omit to run a review.")
    parser.add_argument("--version", action="store_true", help="Print the autoreview helper version.")
    parser.add_argument("--json", action="store_true", help="Print machine-readable JSON when supported.")
    parser.add_argument(
        "--review-phase",
        choices=sorted(REVIEW_PHASES),
        default="full",
        help="Review phase. Incremental phases require evidence files.",
    )
    parser.add_argument("--mode", choices=["auto", "local", "branch", "commit"], default="auto")
    parser.add_argument(
        "--base",
        help="Base ref for branch review. If omitted, branch mode tries gh PR base detection before fallback.",
    )
    parser.add_argument("--commit", default="HEAD", help="Commit ref for commit review.")
    parser.add_argument("--model", help="Codex model to pass to codex exec.")
    parser.add_argument("--codex-bin", default=os.environ.get("CODEX_BIN", "codex"), help="Codex executable path or name.")
    parser.add_argument("--prompt", action="append", help="Additional review instruction text.")
    parser.add_argument("--prompt-file", action="append", help="File containing additional review instructions.")
    parser.add_argument("--dataset", action="append", help="Evidence file to include in the review prompt.")
    parser.add_argument("--dry-run", action="store_true", help="Build the review prompt without calling Codex.")
    parser.add_argument("--output", help="Write human report output, or dry-run prompt, to a file.")
    parser.add_argument("--json-output", help="Write the validated structured review JSON to a file.")
    parser.add_argument("--evidence-output", help="Write a validated review-chain evidence envelope.")
    parser.add_argument("--prior-evidence", help="Prior review-chain evidence envelope.")
    parser.add_argument("--finding-file", help="Canonical accepted/rejected finding intake for fix verification.")
    parser.add_argument("--reservation-file", help="Protocol-derived Implement Feature reservation packet.")
    parser.add_argument("--attempt-file", help="Append-only managed attempt journal.")
    parser.add_argument("--candidate-output", help="Quarantined current-schema evidence candidate.")
    parser.add_argument("--operation-output", help="Write the exact ingest operation for interrupted-apply recovery.")
    parser.add_argument(
        "--heartbeat-seconds",
        type=positive_int,
        default=60,
        help="Seconds between long-running Codex review heartbeat lines on stderr.",
    )
    parser.add_argument("--no-web-search", dest="web_search", action="store_false", default=True)
    return parser.parse_args(argv)


def positive_int(value: str) -> int:
    parsed = int(value)
    if parsed < 1:
        raise argparse.ArgumentTypeError("must be >= 1")
    return parsed


def managed_owner(repo: Path) -> dict[str, Any] | None:
    root = Path.home() / ".cache/dotagents/skills/implement-feature/ledgers"
    if not root.is_dir():
        return None
    resolved = str(repo.resolve())
    matches: list[dict[str, Any]] = []
    for path in sorted(root.glob("*.json")):
        try:
            state = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        if not isinstance(state, dict) or state.get("schema_version") != "9.0.0":
            continue
        for task in state.get("tasks", []):
            for delivery in task.get("deliveries", []):
                checkout = delivery.get("managed_checkout")
                if isinstance(checkout, dict) and checkout.get("checkout") == resolved:
                    matches.append({"ledger": str(path), "task_key": task.get("task_key"), "delivery_key": delivery.get("delivery_key")})
    if len(matches) > 1:
        raise AutoreviewError(
            "managed checkout ownership is ambiguous",
            code="managed-checkout-ambiguous",
            recovery="needs-owner",
        )
    return matches[0] if matches else None


def load_attempt_journal(path: Path) -> list[dict[str, Any]]:
    try:
        raw = path.read_bytes()
        if raw and not raw.endswith(b"\n"):
            raise AutoreviewError(
                "attempt journal is truncated",
                code="attempt-invalid",
                recovery="needs-owner",
            )
        records = [json.loads(line) for line in raw.decode("utf-8").splitlines() if line]
        protocol.validate_attempt_journal(records)
        return records
    except AutoreviewError:
        raise
    except (OSError, UnicodeDecodeError, json.JSONDecodeError, protocol.ProtocolError) as exc:
        raise AutoreviewError(
            "attempt journal is unreadable or invalid",
            code="attempt-invalid",
            recovery="needs-owner",
        ) from exc


def append_attempt(path_value: str, record: dict[str, Any], *, create: bool = False) -> dict[str, Any]:
    path = Path(path_value)
    path.parent.mkdir(parents=True, exist_ok=True)
    prior: list[dict[str, Any]] = []
    existed = path.exists()
    if existed:
        prior = load_attempt_journal(path)
    elif not create:
        raise AutoreviewError("attempt journal is missing", code="attempt-invalid", recovery="needs-owner")
    if create and existed:
        raise AutoreviewError("reservation already has an attempt journal", code="review-relaunch-forbidden", recovery="resume-identical-operation")
    payload = {
        "schema_version": protocol.ATTEMPT_SCHEMA_VERSION,
        **record,
        "parent_record_fingerprint": protocol.fingerprint(prior[-1]) if prior else None,
    }
    try:
        protocol.validate_attempt_journal([*prior, payload])
    except protocol.ProtocolError as exc:
        raise AutoreviewError(str(exc), code=exc.code, recovery=exc.recovery) from exc
    mode = "x" if create else "a"
    with path.open(mode) as handle:
        handle.write(json.dumps(payload, sort_keys=True, separators=(",", ":")) + "\n")
        handle.flush()
        os.fsync(handle.fileno())
    return payload


def attempt_record(
    *,
    transition: str,
    attempt_id: str,
    reservation_id: str,
    model_launch_count: int,
    pid: int | None = None,
    invalid_output: dict[str, Any] | None = None,
    prompt_fingerprint: str | None = None,
    candidate_fingerprint: str | None = None,
    operation_id: str | None = None,
) -> dict[str, Any]:
    state = {
        "prepared": "prepared",
        "model-started": "model-started",
        "repair-prepared": "model-started",
        "repair-model-started": "model-started",
        "completed": "completed",
        "failed": "failed",
    }[transition]
    return {
        "transition": transition,
        "state": state,
        "model_call_started": model_launch_count > 0,
        "model_launch_count": model_launch_count,
        "attempt_id": attempt_id,
        "reservation_id": reservation_id,
        "pid": pid,
        "invalid_output": invalid_output,
        "prompt_fingerprint": prompt_fingerprint,
        "candidate_fingerprint": candidate_fingerprint,
        "operation_id": operation_id,
    }


def load_managed_reservation(args: argparse.Namespace) -> dict[str, Any] | None:
    if not args.reservation_file:
        owner = managed_owner(repo_root())
        if owner is not None:
            raise AutoreviewError(
                "managed checkout requires a protocol reservation before AutoReview launch; model_call_started=false",
                code="managed-reservation-required",
                recovery="run-ledger-cache-autoreview-next",
            )
        return None
    reservation = load_json_file(args.reservation_file, "reservation file")
    required = {
        "ok", "command", "version", "ledger_schema_version", "ledger", "root_id",
        "expected_claim_fingerprint", "task_key", "delivery_key", "generation",
        "current_state_fingerprint", "prior_evidence", "hosted_obligation",
        "protocol_version", "action", "packet", "allowed_transitions",
        "completion_criterion", "blockers", "projection_fingerprint", "reservation_event",
    }
    if set(reservation) != required or reservation["command"] != "autoreview.next" or reservation["protocol_version"] != protocol.PROTOCOL_VERSION:
        raise AutoreviewError("managed reservation packet is invalid", code="reservation-invalid", recovery="derive-next-action-again")
    event = reservation["reservation_event"]
    if reservation["action"] is None or not isinstance(event, dict) or reservation["blockers"]:
        raise AutoreviewError("managed reservation has no launchable action", code="action-not-allowed", recovery="resolve-blockers")
    ledger = Path(reservation["ledger"])
    try:
        state = json.loads(ledger.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise AutoreviewError("managed ledger is unreadable", code="reservation-invalid", recovery="needs-owner") from exc
    delivery = next(
        (
            delivery for task in state.get("tasks", []) if task.get("task_key") == reservation["task_key"]
            for delivery in task.get("deliveries", []) if delivery.get("delivery_key") == reservation["delivery_key"]
        ),
        None,
    )
    active = delivery.get("autoreview_reservation") if isinstance(delivery, dict) else None
    if not isinstance(active, dict) or active.get("reservation_id") != event.get("reservation_id") or active.get("state") != "reserved":
        raise AutoreviewError("managed reservation is not active in the ledger", code="reservation-stale", recovery="derive-next-action-again")
    packet = reservation["packet"]
    args.mode = packet["mode"]
    args.review_phase = packet["action"]
    args.base = packet["target"]["base_ref"]
    args.evidence_output = args.candidate_output
    args._managed_prior = reservation["prior_evidence"]
    args._managed_obligation = reservation["hosted_obligation"]
    args._managed_target = packet["target"]
    if reservation["prior_evidence"] is not None:
        args.prior_evidence = args.reservation_file
    if args.review_phase == "fix-verification":
        obligation = reservation["hosted_obligation"]
        if obligation is not None:
            args.finding_file = obligation["finding_set_ref"]
        else:
            rows = reservation["prior_evidence"]["finding_state"]["open"]
            finding_path = Path(args.attempt_file).with_suffix(".findings.json")
            payload = {
                "finding_source": "autoreview",
                "findings": [
                    {**row, "disposition": "accepted", "reason": "Accepted by the managed implementation run."}
                    for row in rows
                ],
            }
            finding_path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
            args.finding_file = str(finding_path)
    return reservation


def ledger_apply_events(reservation: dict[str, Any], events: list[dict[str, Any]], operation_id: str, *, dry_run: bool) -> dict[str, Any]:
    ledger = Path(reservation["ledger"])
    state = json.loads(ledger.read_text())
    with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as handle:
        json.dump(events, handle, sort_keys=True, separators=(",", ":"))
        events_path = Path(handle.name)
    command = [
        str(Path(__file__).resolve().parents[2] / "implement-feature/scripts/ledger-cache"),
        "--json", "ledger", "apply", "--ledger", str(ledger), "--root-id", reservation["root_id"],
        "--expected-claim-fingerprint", reservation["expected_claim_fingerprint"],
        "--expected-generation", str(state["generation"]), "--expected-state-fingerprint", state["content_fingerprint"],
        "--operation-id", operation_id, "--events-file", str(events_path),
    ]
    if dry_run:
        command.append("--dry-run")
    try:
        result = subprocess.run(command, text=True, capture_output=True)
        payload = json.loads(result.stdout) if result.stdout else {}
        if result.returncode:
            raise AutoreviewError(
                f"managed ledger apply failed: {payload}", code="ledger-preflight-failed", recovery="needs-owner"
            )
        return payload
    finally:
        events_path.unlink(missing_ok=True)


def main(argv: list[str] | None = None) -> int:
    raw_argv = argv or sys.argv[1:]
    positional_probe = [item for item in raw_argv if item != "--json"]
    if positional_probe and positional_probe[0] == "findings":
        return run_findings_command(raw_argv)
    args = parse_args(raw_argv)
    if args.version:
        print(f"autoreview {VERSION}")
        return 0
    try:
        if args.command == "doctor":
            return doctor(args)
        managed = load_managed_reservation(args)
        if managed is None:
            return run_review(args)
        if not args.attempt_file or not args.candidate_output or not args.operation_output:
            raise AutoreviewError(
                "managed AutoReview requires --attempt-file, --candidate-output, and --operation-output; model_call_started=false",
                code="managed-artifacts-required",
                recovery="regenerate-managed-manifest",
            )
        prohibited = {
            "--mode", "--review-phase", "--base", "--commit", "--prompt", "--prompt-file",
            "--dataset", "--prior-evidence", "--finding-file", "--evidence-output",
        }
        if any(item.split("=", 1)[0] in prohibited for item in raw_argv):
            raise AutoreviewError(
                "managed callers cannot select mode, phase, target, prompt, or evidence parents; model_call_started=false",
                code="managed-caller-control-forbidden",
                recovery="use-reservation-packet-only",
            )
        reservation_id = managed["reservation_event"]["reservation_id"]
        attempt_id = protocol.fingerprint({"reservation_id": reservation_id, "attempt_file": str(Path(args.attempt_file).resolve())})
        event_base = {
            "type": "autoreview-attempt-observed",
            "task_key": managed["task_key"],
            "delivery_key": managed["delivery_key"],
            "reservation_id": reservation_id,
            "attempt_id": attempt_id,
            "candidate_fingerprint": None,
            "operation_id": None,
            "evidence_ref": f"autoreview-attempt://{attempt_id}",
        }
        prepared_record = attempt_record(
            transition="prepared",
            attempt_id=attempt_id,
            reservation_id=reservation_id,
            model_launch_count=0,
        )
        append_attempt(args.attempt_file, prepared_record, create=True)
        prepared_event = {**event_base, "attempt_state": "prepared", "model_call_started": False}
        ledger_apply_events(
            managed, [prepared_event],
            protocol.fingerprint({"attempt_id": attempt_id, "state": "prepared"})[:32], dry_run=False,
        )
        launched = False
        model_launch_count = 0
        args._resolved_model = args.model or configured_codex_model()
        finding_fingerprint = (
            hashlib.sha256(Path(args.finding_file).read_bytes()).hexdigest()
            if args.finding_file
            else None
        )

        def model_started(pid: int) -> None:
            nonlocal launched, model_launch_count
            launched = True
            model_launch_count = 1
            record = attempt_record(
                transition="model-started",
                attempt_id=attempt_id,
                reservation_id=reservation_id,
                model_launch_count=model_launch_count,
                pid=pid,
                prompt_fingerprint=args._active_prompt_fingerprint,
            )
            append_attempt(args.attempt_file, record)
            event = {**event_base, "attempt_state": "model-started", "model_call_started": True}
            ledger_apply_events(
                managed, [event],
                protocol.fingerprint({"attempt_id": attempt_id, "state": "model-started"})[:32], dry_run=False,
            )

        def validate_invalid_output_repair(prompt: str, schema: dict[str, Any]) -> None:
            repo = repo_root()
            target = managed["packet"]["target"]
            if current_head(repo) != target["head_sha"] or is_dirty(repo):
                raise AutoreviewError(
                    "managed review target changed before invalid-output repair",
                    code="repair-identity-drift",
                    recovery="needs-owner",
                )
            if args.finding_file:
                current_findings = hashlib.sha256(Path(args.finding_file).read_bytes()).hexdigest()
                if current_findings != finding_fingerprint:
                    raise AutoreviewError(
                        "managed finding input changed before invalid-output repair",
                        code="repair-identity-drift",
                        recovery="needs-owner",
                    )
            state = json.loads(Path(managed["ledger"]).read_text())
            delivery = next(
                delivery
                for task in state["tasks"] if task["task_key"] == managed["task_key"]
                for delivery in task["deliveries"] if delivery["delivery_key"] == managed["delivery_key"]
            )
            active = delivery.get("autoreview_reservation")
            committed = delivery.get("committed_revision")
            if (
                not isinstance(active, dict)
                or active.get("reservation_id") != reservation_id
                or active.get("state") != "reserved"
                or not isinstance(committed, dict)
                or committed.get("target") != target
            ):
                raise AutoreviewError(
                    "managed reservation changed before invalid-output repair",
                    code="repair-identity-drift",
                    recovery="needs-owner",
                )
            identity = protocol.fingerprint(
                {
                    "reservation_id": reservation_id,
                    "packet": managed["packet"],
                    "prior_evidence": managed["prior_evidence"],
                    "hosted_obligation": managed["hosted_obligation"],
                    "prompt_fingerprint": sha256_text(prompt),
                    "schema_fingerprint": protocol.fingerprint(schema),
                    "finding_fingerprint": finding_fingerprint,
                    "model": args._resolved_model,
                    "web_search": args.web_search,
                }
            )
            expected = getattr(args, "_repair_identity_fingerprint", None)
            if expected is None:
                args._repair_identity_fingerprint = identity
            elif expected != identity:
                raise AutoreviewError(
                    "managed operation identity changed before invalid-output repair",
                    code="repair-identity-drift",
                    recovery="needs-owner",
                )

        def prepare_invalid_output_repair(
            exc: ReviewOutputError, original_prompt: str, repair_prompt: str
        ) -> None:
            records = load_attempt_journal(Path(args.attempt_file))
            invalid = invalid_output_record(
                args,
                exc,
                f"{Path(args.attempt_file).resolve()}#record-{len(records) + 1}",
            )
            append_attempt(
                args.attempt_file,
                attempt_record(
                    transition="repair-prepared",
                    attempt_id=attempt_id,
                    reservation_id=reservation_id,
                    model_launch_count=model_launch_count,
                    invalid_output=invalid,
                    prompt_fingerprint=sha256_text(repair_prompt),
                ),
            )

        def start_invalid_output_repair(pid: int) -> None:
            nonlocal model_launch_count
            model_launch_count = 2
            append_attempt(
                args.attempt_file,
                attempt_record(
                    transition="repair-model-started",
                    attempt_id=attempt_id,
                    reservation_id=reservation_id,
                    model_launch_count=model_launch_count,
                    pid=pid,
                    prompt_fingerprint=args._active_prompt_fingerprint,
                ),
            )

        args._on_model_started = model_started
        args._prepare_invalid_output_repair = prepare_invalid_output_repair
        args._start_invalid_output_repair = start_invalid_output_repair
        args._validate_invalid_output_repair = validate_invalid_output_repair
        try:
            exit_code = run_review(args)
            candidate = validate_evidence(load_json_file(args.candidate_output, "candidate evidence"))
            candidate_fingerprint = protocol.fingerprint(candidate)
            operation_id = protocol.fingerprint(
                {"reservation_id": reservation_id, "candidate_fingerprint": candidate_fingerprint}
            )[:32]
            completed_record = attempt_record(
                transition="completed",
                attempt_id=attempt_id,
                reservation_id=reservation_id,
                model_launch_count=model_launch_count,
                prompt_fingerprint=getattr(args, "_active_prompt_fingerprint", None),
                candidate_fingerprint=candidate_fingerprint,
                operation_id=operation_id,
            )
            append_attempt(args.attempt_file, completed_record)
            completed_event = {
                **event_base, "attempt_state": "completed", "model_call_started": launched,
                "candidate_fingerprint": candidate_fingerprint, "operation_id": operation_id,
            }
            observed_event = {
                "type": "autoreview-observed", "task_key": managed["task_key"],
                "delivery_key": managed["delivery_key"], "reservation_id": reservation_id,
                "candidate_fingerprint": candidate_fingerprint, "operation_id": operation_id,
                "evidence_ref": str(Path(args.candidate_output).resolve()), "evidence": candidate,
            }
            operation = {
                "schema_version": protocol.PROTOCOL_VERSION,
                "operation_id": operation_id,
                "ledger": managed["ledger"],
                "reservation_id": reservation_id,
                "candidate_path": str(Path(args.candidate_output).resolve()),
                "candidate_fingerprint": candidate_fingerprint,
                "events": [completed_event, observed_event],
            }
            Path(args.operation_output).write_text(json.dumps(operation, indent=2, sort_keys=True) + "\n")
            ledger_apply_events(managed, operation["events"], operation_id, dry_run=True)
            return exit_code
        except BaseException:
            records = load_attempt_journal(Path(args.attempt_file))
            if records and records[-1]["state"] not in {"completed", "failed"}:
                terminal_invalid = (
                    getattr(args, "_terminal_invalid_output", None)
                    or getattr(args, "_pending_invalid_output", None)
                )
                invalid = None
                if terminal_invalid is not None:
                    invalid = invalid_output_record(
                        args,
                        terminal_invalid,
                        f"{Path(args.attempt_file).resolve()}#record-{len(records) + 1}",
                    )
                failed_record = attempt_record(
                    transition="failed",
                    attempt_id=attempt_id,
                    reservation_id=reservation_id,
                    model_launch_count=model_launch_count,
                    invalid_output=invalid,
                    prompt_fingerprint=getattr(args, "_active_prompt_fingerprint", None),
                )
                append_attempt(args.attempt_file, failed_record)
                failed_event = {**event_base, "attempt_state": "failed", "model_call_started": launched}
                ledger_apply_events(
                    managed, [failed_event],
                    protocol.fingerprint({"attempt_id": attempt_id, "state": "failed"})[:32], dry_run=False,
                )
            raise
    except AutoreviewError as exc:
        if args.json:
            print(
                json.dumps(
                    {
                        "ok": False,
                        "error": str(exc),
                        "error_code": exc.code,
                        "recovery": exc.recovery,
                    },
                    indent=2,
                    sort_keys=True,
                ),
                file=sys.stderr,
            )
        else:
            print(f"autoreview: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
