#!/usr/bin/env python3
"""Inspect and validate the shared AutoReview protocol."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

import autoreview_protocol as protocol


def parser() -> argparse.ArgumentParser:
    value = argparse.ArgumentParser(description="Validate the shared AutoReview lifecycle protocol.")
    value.add_argument("--version", action="version", version=protocol.PROTOCOL_VERSION)
    value.add_argument("--json", action="store_true")
    commands = value.add_subparsers(dest="command", required=True)
    commands.add_parser("doctor", help="Report offline protocol readiness without writing state.")
    validate = commands.add_parser("validate", help="Validate one current-schema artifact.")
    validate.add_argument("kind", choices=["evidence", "target", "hosted-obligation"])
    validate.add_argument("--input", required=True)
    return value


def main() -> int:
    args = parser().parse_args()
    try:
        if args.command == "doctor":
            result = {
                "ok": True,
                "command": "doctor",
                "version": protocol.PROTOCOL_VERSION,
                "evidence_schema_version": protocol.EVIDENCE_SCHEMA_VERSION,
                "offline": True,
                "module": str(Path(protocol.__file__).resolve()),
            }
        else:
            value = json.loads(Path(args.input).read_text())
            validators = {
                "evidence": protocol.validate_evidence,
                "target": protocol.validate_target,
                "hosted-obligation": protocol.validate_hosted_obligation,
            }
            validated = validators[args.kind](value)
            result = {"ok": True, "command": "validate", "kind": args.kind, "fingerprint": protocol.fingerprint(validated)}
        print(json.dumps(result, sort_keys=True) if args.json else json.dumps(result, indent=2, sort_keys=True))
        return 0
    except (OSError, json.JSONDecodeError, protocol.ProtocolError) as exc:
        result = {"ok": False, "error": {"code": getattr(exc, "code", "invalid-input"), "message": str(exc), "recovery": getattr(exc, "recovery", "needs-owner")}}
        print(json.dumps(result, sort_keys=True), file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
