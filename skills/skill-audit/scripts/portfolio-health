#!/usr/bin/env python3
"""Report skill inventory, prompt-budget, duplicate, and usage signals."""

from __future__ import annotations

import argparse
import hashlib
import json
import math
import os
import re
import shutil
import subprocess
import sys
from collections import Counter, defaultdict
from dataclasses import dataclass
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any


VERSION = "1.1.1"
LIVE_LINE_RE = re.compile(r"^\s*-\s+([^:]+(?::[^:]+)?):\s*(.*?)\s+\(file:\s*(.*?)\)\s*$")
LIVE_CANDIDATE_RE = re.compile(r"^\s*-\s+.*\(file:")
FRONTMATTER_RE = re.compile(r"\A---\s*\n(.*?)\n---\s*\n", re.S)
SKILL_ROOT_RE = re.compile(r"^\s*-\s+`([^`]+)`\s*=\s*`([^`]+)`")
SKILL_ROOT_SECTION_START_RE = re.compile(r"^\s*### Skill roots\s*$")
SKILL_ROOT_SECTION_END_RE = re.compile(r"^\s*###\s+")
SKILL_CATALOG_START_RE = re.compile(r"^\s*### Available skills\s*$")
SKILL_CATALOG_END_RE = re.compile(r"^\s*(?:</skills_instructions>|## (?!#))")
ENTRYPOINT_BYTES_PER_TOKEN = 4
ENTRYPOINT_REVIEW_TOKENS = 2_500
ENTRYPOINT_HIGH_DENSITY_TOKENS = 4_000
ENTRYPOINT_GUIDELINE_TOKENS = 5_000
ENTRYPOINT_GUIDELINE_LINES = 500
ENTRYPOINT_BAND_ORDER = {
    "normal": 0,
    "review": 1,
    "high-density": 2,
    "over-guideline": 3,
}


@dataclass(frozen=True)
class SkillRecord:
    name: str
    description: str
    path: str
    realpath: str
    source: str
    root: str | None
    body_hash: str
    body_bytes: int
    description_bytes: int
    entrypoint_tokens_estimate: int
    entrypoint_lines: int
    entrypoint_size_band: str


@dataclass(frozen=True)
class InventoryResult:
    records: list[SkillRecord]
    source: str
    requested_roots: tuple[str, ...]
    effective_roots: tuple[str, ...]
    fallback_reason: str | None = None
    diagnostics: tuple[dict[str, Any], ...] = ()


class InputError(ValueError):
    def __init__(self, code: str, message: str, details: Any = None) -> None:
        super().__init__(message)
        self.code = code
        self.details = details


def entrypoint_size_band(tokens: int, lines: int) -> str:
    if tokens > ENTRYPOINT_GUIDELINE_TOKENS or lines >= ENTRYPOINT_GUIDELINE_LINES:
        return "over-guideline"
    if tokens > ENTRYPOINT_HIGH_DENSITY_TOKENS:
        return "high-density"
    if tokens > ENTRYPOINT_REVIEW_TOKENS:
        return "review"
    return "normal"


def entrypoint_policy() -> dict[str, Any]:
    return {
        "estimator": f"ceil(utf8_bytes/{ENTRYPOINT_BYTES_PER_TOKEN})",
        "normal_max_tokens": ENTRYPOINT_REVIEW_TOKENS,
        "review_max_tokens": ENTRYPOINT_HIGH_DENSITY_TOKENS,
        "high_density_max_tokens": ENTRYPOINT_GUIDELINE_TOKENS,
        "over_guideline_min_lines": ENTRYPOINT_GUIDELINE_LINES,
        "size_alone_fails_health": False,
    }


def git_root(start: Path) -> Path | None:
    candidate = start.expanduser()
    if not candidate.is_dir():
        candidate = candidate.parent
    try:
        candidate = candidate.resolve()
    except OSError:
        pass
    for ancestor in (candidate, *candidate.parents):
        if (ancestor / ".git").exists():
            return ancestor
    return None


def default_roots(start: Path | None = None) -> list[Path]:
    cwd = start or Path.cwd()
    local_root = git_root(cwd) or cwd
    codex_home = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex")).expanduser()
    roots = [
        local_root / "skills",
        local_root / ".agents" / "skills",
        codex_home / "skills",
        Path.home() / ".codex" / "skills",
        Path.home() / ".agents" / "skills",
        codex_home / "plugins" / "cache",
    ]
    return dedupe_paths(roots)


def default_log_roots(deep: bool) -> list[Path]:
    codex_home = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex")).expanduser()
    roots = [codex_home / "history.jsonl", codex_home / "sessions"]
    if deep:
        roots.append(codex_home / "archived_sessions")
    return roots


def dedupe_paths(paths: list[Path]) -> list[Path]:
    seen: set[str] = set()
    result: list[Path] = []
    for path in paths:
        expanded = path.expanduser()
        try:
            key = str(expanded.resolve())
        except OSError:
            key = str(expanded)
        if key in seen:
            continue
        seen.add(key)
        result.append(expanded)
    return result


def parse_frontmatter(text: str, fallback_name: str) -> tuple[str, str]:
    match = FRONTMATTER_RE.match(text)
    if not match:
        return fallback_name, ""
    fields: dict[str, str] = {}
    for line in match.group(1).splitlines():
        if ":" not in line:
            continue
        key, value = line.split(":", 1)
        value = value.strip().strip('"').strip("'")
        fields[key.strip()] = value
    return fields.get("name") or fallback_name, fields.get("description") or ""


def read_skill(
    path: Path,
    source: str,
    *,
    name: str | None = None,
    description: str | None = None,
    root: str | None = None,
) -> SkillRecord | None:
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
        realpath = str(path.resolve())
    except OSError:
        return None
    parsed_name, parsed_description = parse_frontmatter(text, path.parent.name)
    skill_name = name or parsed_name
    skill_description = description if description is not None else parsed_description
    body_bytes = len(text.encode("utf-8", errors="replace"))
    entrypoint_tokens = math.ceil(body_bytes / ENTRYPOINT_BYTES_PER_TOKEN)
    entrypoint_lines = len(text.splitlines())
    return SkillRecord(
        name=skill_name,
        description=" ".join(skill_description.split()),
        path=str(path),
        realpath=realpath,
        source=source,
        root=root,
        body_hash=hashlib.sha256(text.encode("utf-8", errors="replace")).hexdigest(),
        body_bytes=body_bytes,
        description_bytes=len(skill_description.encode("utf-8", errors="replace")),
        entrypoint_tokens_estimate=entrypoint_tokens,
        entrypoint_lines=entrypoint_lines,
        entrypoint_size_band=entrypoint_size_band(entrypoint_tokens, entrypoint_lines),
    )


def live_root_for_path(path: Path, roots: dict[str, Path]) -> str | None:
    try:
        resolved_path = path.resolve()
    except OSError:
        resolved_path = path
    for root in roots.values():
        try:
            resolved_root = root.resolve()
        except OSError:
            resolved_root = root
        if resolved_path == resolved_root or resolved_root in resolved_path.parents:
            return str(root)
    return None


def live_inventory() -> InventoryResult:
    source = "codex-debug-prompt-input"
    codex = shutil.which("codex")
    if not codex:
        return InventoryResult([], source, (), (), fallback_reason="codex not found")
    try:
        result = subprocess.run(
            [codex, "debug", "prompt-input"],
            check=False,
            capture_output=True,
            text=True,
            timeout=20,
        )
    except (OSError, subprocess.SubprocessError) as error:
        return InventoryResult([], source, (), (), fallback_reason=str(error))
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()
        return InventoryResult([], source, (), (), fallback_reason=detail[:500] or f"codex exited {result.returncode}")
    lines = prompt_input_lines(result.stdout)
    try:
        roots = skill_root_aliases(lines)
    except InputError as error:
        return InventoryResult(
            [],
            source,
            (),
            (),
            fallback_reason=str(error),
            diagnostics=(
                {
                    "code": error.code,
                    "message": str(error),
                },
            ),
        )
    effective_roots = tuple(str(root) for root in dedupe_paths(list(roots.values())))
    records: list[SkillRecord] = []
    candidate_lines = 0
    parse_failures = 0
    unreadable_paths: list[str] = []
    for line in skill_catalog_lines(lines):
        if not LIVE_CANDIDATE_RE.search(line):
            continue
        candidate_lines += 1
        match = LIVE_LINE_RE.match(line)
        if not match:
            parse_failures += 1
            continue
        name, description, raw_path = match.groups()
        path = expand_skill_path(raw_path, roots)
        record = read_skill(
            path,
            source,
            name=name,
            description=description,
            root=live_root_for_path(path, roots),
        )
        if record:
            records.append(record)
        else:
            unreadable_paths.append(str(path))

    diagnostics: list[dict[str, Any]] = []
    if parse_failures or unreadable_paths:
        diagnostics.append(
            {
                "code": "partial-live-inventory",
                "candidate_lines": candidate_lines,
                "parsed_records": len(records),
                "parse_failures": parse_failures,
                "unreadable_paths": sorted(set(unreadable_paths)),
            }
        )
    if not records:
        reason = "codex debug prompt-input succeeded but no skill inventory lines were parsed"
        return InventoryResult(
            [],
            source,
            (),
            effective_roots,
            fallback_reason=reason,
            diagnostics=tuple(diagnostics),
        )
    if diagnostics:
        return InventoryResult(
            [],
            source,
            (),
            effective_roots,
            fallback_reason="codex debug prompt-input returned a partial skill inventory",
            diagnostics=tuple(diagnostics),
        )
    return InventoryResult(dedupe_records(records), source, (), effective_roots)


def prompt_input_lines(stdout: str) -> list[str]:
    try:
        parsed = json.loads(stdout)
    except json.JSONDecodeError:
        parsed = None
    values = collect_strings(parsed) if parsed is not None else [stdout]
    lines: list[str] = []
    for value in values:
        lines.extend(str(value).splitlines())
    return lines


def skill_catalog_lines(lines: list[str]) -> list[str]:
    """Return only entries from Codex's authoritative available-skills catalog."""
    lines = authoritative_skill_lines(lines)
    catalog: list[str] = []
    in_catalog = False
    for line in lines:
        if SKILL_CATALOG_START_RE.match(line):
            in_catalog = True
            continue
        if in_catalog and SKILL_CATALOG_END_RE.match(line):
            break
        if in_catalog:
            catalog.append(line)
    return catalog


def authoritative_skill_lines(lines: list[str]) -> list[str]:
    """Return lines inside Codex's structured skills-instructions block."""
    blocks: list[list[str]] = []
    current: list[str] | None = None
    start_marker = "<skills_instructions>"
    end_marker = "</skills_instructions>"
    for line in lines:
        remainder = line
        while remainder:
            if current is None:
                start_index = remainder.find(start_marker)
                if start_index < 0:
                    break
                current = []
                remainder = remainder[start_index + len(start_marker) :]
                continue
            end_index = remainder.find(end_marker)
            if end_index < 0:
                current.append(remainder)
                break
            current.append(remainder[:end_index])
            blocks.append(current)
            current = None
            remainder = remainder[end_index + len(end_marker) :]
    return blocks[0] if blocks else []


def collect_strings(value: Any) -> list[str]:
    if isinstance(value, str):
        return [value]
    if isinstance(value, list):
        result: list[str] = []
        for item in value:
            result.extend(collect_strings(item))
        return result
    if isinstance(value, dict):
        result = []
        for item in value.values():
            result.extend(collect_strings(item))
        return result
    return []


def skill_root_aliases(lines: list[str]) -> dict[str, Path]:
    lines = authoritative_skill_lines(lines)
    roots: dict[str, Path] = {}
    in_root_section = False
    for line in lines:
        if SKILL_ROOT_SECTION_START_RE.match(line):
            in_root_section = True
            continue
        if in_root_section and SKILL_ROOT_SECTION_END_RE.match(line):
            break
        if not in_root_section:
            continue
        match = SKILL_ROOT_RE.match(line)
        if match:
            alias, raw_path = match.groups()
            if alias in roots:
                raise InputError(
                    "live-root-alias-conflict",
                    f"duplicate skill root alias in authoritative section: {alias}",
                )
            roots[alias] = Path(raw_path).expanduser()
    return roots


def expand_skill_path(raw_path: str, roots: dict[str, Path]) -> Path:
    if raw_path.startswith("/"):
        return Path(raw_path)
    first, _, rest = raw_path.partition("/")
    if first in roots and rest:
        return roots[first] / rest
    return Path(raw_path).expanduser()


def scan_inventory(roots: list[Path]) -> list[SkillRecord]:
    records: list[SkillRecord] = []
    for root in roots:
        if root.is_file() and root.name == "SKILL.md":
            record = read_skill(root, str(root.parent), root=str(root.parent))
            if record:
                records.append(record)
            continue
        if not root.exists():
            continue
        for path in root.rglob("SKILL.md"):
            parts = set(path.parts)
            if ".git" in parts or ".cache" in parts or "__pycache__" in parts:
                continue
            record = read_skill(path, str(root), root=str(root))
            if record:
                records.append(record)
    return dedupe_records(records)


def dedupe_records(records: list[SkillRecord]) -> list[SkillRecord]:
    seen: set[str] = set()
    result: list[SkillRecord] = []
    for record in records:
        key = record.realpath
        if key in seen:
            continue
        seen.add(key)
        result.append(record)
    return sorted(result, key=lambda item: (item.name.lower(), item.path))


def validate_explicit_roots(roots: list[Path]) -> None:
    invalid: list[dict[str, str]] = []
    for root in roots:
        expanded = root.expanduser()
        if not expanded.exists():
            invalid.append({"path": str(root), "reason": "does not exist"})
        elif not os.access(expanded, os.R_OK):
            invalid.append({"path": str(root), "reason": "is not readable"})
        elif expanded.is_file() and expanded.name != "SKILL.md":
            invalid.append({"path": str(root), "reason": "file is not SKILL.md"})
    if invalid:
        raise InputError(
            "invalid-root",
            "every explicit --root must exist, be readable, and be a SKILL.md file or directory",
            invalid,
        )


def filesystem_inventory(
    roots: list[Path],
    *,
    requested_roots: list[Path],
    fallback_reason: str | None = None,
    diagnostics: tuple[dict[str, Any], ...] = (),
) -> InventoryResult:
    return InventoryResult(
        records=scan_inventory(roots),
        source="filesystem",
        requested_roots=tuple(str(root) for root in requested_roots),
        effective_roots=tuple(str(root) for root in roots),
        fallback_reason=fallback_reason,
        diagnostics=diagnostics,
    )


def select_inventory(args: argparse.Namespace) -> InventoryResult:
    requested_roots = dedupe_paths(args.root)
    if requested_roots:
        validate_explicit_roots(requested_roots)
        return filesystem_inventory(requested_roots, requested_roots=requested_roots)

    roots = dedupe_paths(default_roots())
    if args.inventory_source == "filesystem":
        return filesystem_inventory(roots, requested_roots=[])

    live = live_inventory()
    if live.records:
        return live
    return filesystem_inventory(
        roots,
        requested_roots=[],
        fallback_reason=live.fallback_reason,
        diagnostics=live.diagnostics,
    )


def iter_log_files(roots: list[Path], since: datetime) -> list[Path]:
    files: list[Path] = []
    for root in roots:
        root = root.expanduser()
        if root.is_file() and root.suffix == ".jsonl":
            try:
                if datetime.fromtimestamp(root.stat().st_mtime, timezone.utc) >= since:
                    files.append(root)
            except OSError:
                pass
            continue
        if not root.exists():
            continue
        for path in root.rglob("*.jsonl"):
            try:
                if datetime.fromtimestamp(path.stat().st_mtime, timezone.utc) >= since:
                    files.append(path)
            except OSError:
                continue
    return sorted(files)


def evidence_needles(record: SkillRecord) -> tuple[str, ...]:
    lower_name = record.name.lower()
    parent = Path(record.path).parent.name.lower()
    return (
        f"${lower_name}",
        f"<name>{lower_name}</name>",
        f"/{parent}/skill.md",
        f"{parent}/skill.md",
    )


def usage_counts(records: list[SkillRecord], roots: list[Path], months: int, max_log_mb: int) -> dict[str, dict[str, Any]]:
    since = datetime.now(timezone.utc) - timedelta(days=months * 31)
    files = iter_log_files(roots, since)
    max_bytes = max_log_mb * 1024 * 1024
    scanned_bytes = 0
    files_scanned = 0
    files_skipped_budget = 0
    counters: dict[str, Counter[str]] = {record.name: Counter() for record in records}
    sessions: dict[str, set[str]] = {record.name: set() for record in records}
    needles = {record.name: evidence_needles(record) for record in records}

    for path in files:
        try:
            size = path.stat().st_size
        except OSError:
            continue
        remaining = max_bytes - scanned_bytes
        if size > remaining:
            files_skipped_budget += 1
            continue
        try:
            with path.open("rb") as handle:
                data = handle.read(remaining + 1)
        except OSError:
            continue
        if len(data) > remaining:
            files_skipped_budget += 1
            continue
        scanned_bytes += len(data)
        files_scanned += 1
        text = data.decode("utf-8", errors="replace").lower()
        session_id = path.stem
        for name, checks in needles.items():
            matches = sum(text.count(check) for check in checks)
            if matches:
                counters[name]["mentions"] += matches
                sessions[name].add(session_id)

    return {
        name: {
            "mentions": counter["mentions"],
            "sessions": len(sessions[name]),
        }
        for name, counter in counters.items()
    } | {
        "_scan": {
            "status": "completed",
            "files_considered": len(files),
            "files_scanned": files_scanned,
            "files_skipped_budget": files_skipped_budget,
            "bytes": scanned_bytes,
            "since": since.date().isoformat(),
            "max_log_mb": max_log_mb,
        }
    }


def duplicate_groups(records: list[SkillRecord]) -> dict[str, list[dict[str, Any]]]:
    by_name: dict[str, list[SkillRecord]] = defaultdict(list)
    by_body: dict[str, list[SkillRecord]] = defaultdict(list)
    by_description: dict[str, list[SkillRecord]] = defaultdict(list)
    for record in records:
        by_name[record.name.lower()].append(record)
        by_body[record.body_hash].append(record)
        if record.description:
            by_description[record.description.lower()].append(record)

    def group(items: dict[str, list[SkillRecord]]) -> list[dict[str, Any]]:
        result = []
        for key, values in sorted(items.items()):
            if len(values) < 2:
                continue
            result.append(
                {
                    "key": key,
                    "count": len(values),
                    "items": [
                        {
                            "name": value.name,
                            "path": value.path,
                            "source": value.source,
                            "root": value.root,
                        }
                        for value in values
                    ],
                }
            )
        return result

    return {
        "same_name": group(by_name),
        "same_body": group(by_body),
        "same_description": group(by_description),
    }


def build_report(args: argparse.Namespace) -> dict[str, Any]:
    inventory = select_inventory(args)
    records = inventory.records

    usage: dict[str, Any] = {
        "_scan": {
            "status": "skipped",
            "files_considered": 0,
            "files_scanned": 0,
            "files_skipped_budget": 0,
            "bytes": 0,
        }
    }
    if not args.no_logs:
        usage = usage_counts(records, args.log_root or default_log_roots(args.deep_logs), args.months, args.max_log_mb)

    budget_tokens = math.floor(args.context_tokens * (args.budget_percent / 100))
    inventory_tokens = sum(math.ceil(len(f"- {r.name}: {r.description} (file: {r.path})".encode("utf-8")) / 4) for r in records)
    descriptions = sorted(
        [
            {
                "name": record.name,
                "description_bytes": record.description_bytes,
                "path": record.path,
                "description": record.description,
            }
            for record in records
            if record.description_bytes >= args.long_description_bytes
        ],
        key=lambda item: item["description_bytes"],
        reverse=True,
    )
    entrypoints = sorted(
        [
            {
                "name": record.name,
                "path": record.path,
                "entrypoint_tokens_estimate": record.entrypoint_tokens_estimate,
                "entrypoint_lines": record.entrypoint_lines,
                "entrypoint_size_band": record.entrypoint_size_band,
            }
            for record in records
            if record.entrypoint_size_band != "normal"
        ],
        key=lambda item: (
            ENTRYPOINT_BAND_ORDER[item["entrypoint_size_band"]],
            item["entrypoint_tokens_estimate"],
            item["entrypoint_lines"],
        ),
        reverse=True,
    )
    unused = sorted(
        [
            {
                "name": record.name,
                "path": record.path,
                "source": record.source,
                "mentions": usage.get(record.name, {}).get("mentions", 0),
                "sessions": usage.get(record.name, {}).get("sessions", 0),
            }
            for record in records
            if usage["_scan"]["status"] == "completed"
            and usage.get(record.name, {}).get("mentions", 0) == 0
        ],
        key=lambda item: item["name"].lower(),
    )
    roots_summary = Counter(record.root or record.source for record in records)

    return {
        "generated_at": datetime.now(timezone.utc).isoformat(),
        "inventory_source": inventory.source,
        "live_error": inventory.fallback_reason,
        "fallback_reason": inventory.fallback_reason,
        "diagnostics": list(inventory.diagnostics),
        "requested_roots": list(inventory.requested_roots),
        "effective_roots": list(inventory.effective_roots),
        "skill_count": len(records),
        "budget": {
            "context_tokens": args.context_tokens,
            "budget_percent": args.budget_percent,
            "budget_tokens": budget_tokens,
            "inventory_tokens_estimate": inventory_tokens,
            "budget_used_percent": round((inventory_tokens / budget_tokens) * 100, 2) if budget_tokens else None,
        },
        "entrypoint_policy": entrypoint_policy(),
        "entrypoint_candidates": entrypoints[: args.limit],
        "description_candidates": descriptions[: args.limit],
        "duplicates": duplicate_groups(records),
        "unused_candidates": unused[: args.limit],
        "root_summary": dict(roots_summary.most_common()),
        "usage_scan": usage.get("_scan", {}),
        "skills": [
            {
                "name": record.name,
                "description": record.description,
                "path": record.path,
                "source": record.source,
                "root": record.root,
                "body_bytes": record.body_bytes,
                "description_bytes": record.description_bytes,
                "entrypoint_tokens_estimate": record.entrypoint_tokens_estimate,
                "entrypoint_lines": record.entrypoint_lines,
                "entrypoint_size_band": record.entrypoint_size_band,
                "usage": usage.get(record.name, {}),
            }
            for record in records
        ],
    }


def doctor() -> dict[str, Any]:
    roots = default_roots()
    log_roots = default_log_roots(False)
    return {
        "python": shutil.which("python3") or "python3",
        "codex": shutil.which("codex"),
        "default_roots": [{"path": str(root), "exists": root.exists()} for root in roots],
        "default_log_roots": [{"path": str(root), "exists": root.exists()} for root in log_roots],
        "network_required": False,
    }


def print_text(report: dict[str, Any]) -> None:
    print(f"portfolio-health {VERSION}")
    print(f"inventory: {report['skill_count']} skills from {report['inventory_source']}")
    if report.get("live_error"):
        print(f"live inventory fallback: {report['live_error']}")
    if report["requested_roots"]:
        print(f"requested roots: {', '.join(report['requested_roots'])}")
    if report["effective_roots"]:
        print(f"effective roots: {', '.join(report['effective_roots'])}")
    budget = report["budget"]
    print(
        "budget: estimate={inventory_tokens_estimate} tokens, limit={budget_tokens} tokens ({budget_used_percent}% used)".format(
            **budget
        )
    )
    print("\n## Description candidates")
    for item in report["description_candidates"]:
        print(f"- {item['name']} ({item['description_bytes']} bytes): {item['path']}")
    if not report["description_candidates"]:
        print("- none")

    print("\n## Entrypoint candidates")
    for item in report["entrypoint_candidates"]:
        print(
            "- {name} ({entrypoint_size_band}, ~{entrypoint_tokens_estimate} tokens, "
            "{entrypoint_lines} lines): {path}".format(**item)
        )
    if not report["entrypoint_candidates"]:
        print("- none")

    print("\n## Duplicates")
    any_duplicate = False
    for kind, groups in report["duplicates"].items():
        if not groups:
            continue
        any_duplicate = True
        print(f"{kind}:")
        for group in groups:
            names = ", ".join(item["path"] for item in group["items"])
            print(f"- {group['key']} ({group['count']}): {names}")
    if not any_duplicate:
        print("- none")

    print("\n## Unused candidates")
    if report["usage_scan"]["status"] == "skipped":
        print("- skipped (--no-logs)")
    elif report["unused_candidates"]:
        for item in report["unused_candidates"]:
            print(f"- {item['name']}: {item['path']}")
    else:
        print("- none")

    print("\n## Root summary")
    for root, count in report["root_summary"].items():
        print(f"- {root}: {count}")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Audit skill portfolio health signals: inventory budget, entrypoint size, duplicate skills, descriptions, and recent usage evidence."
    )
    parser.add_argument("command", nargs="?", choices=["scan", "doctor"], default="scan")
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    parser.add_argument("--json", action="store_true", help="Emit a stable JSON envelope.")
    parser.add_argument("--root", action="append", type=Path, default=[], help="Skill root, SKILL.md file, or plugin cache root to scan.")
    parser.add_argument("--log-root", action="append", type=Path, default=[], help="Session/history JSONL root to scan for usage evidence.")
    parser.add_argument("--months", type=int, default=3, help="Recent log window for usage evidence.")
    parser.add_argument("--max-log-mb", type=int, default=500, help="Maximum JSONL bytes to scan.")
    parser.add_argument("--deep-logs", action="store_true", help="Include archived Codex sessions.")
    parser.add_argument(
        "--inventory-source",
        choices=("auto", "filesystem"),
        default="auto",
        help="Inventory discovery mode: auto tries Codex prompt input then falls back; explicit --root always uses filesystem.",
    )
    parser.add_argument("--no-logs", action="store_true", help="Skip session/history usage evidence.")
    parser.add_argument("--context-tokens", type=int, default=272000, help="Context window used for budget estimates.")
    parser.add_argument("--budget-percent", type=float, default=2.0, help="Prompt budget percentage reserved for skill inventory.")
    parser.add_argument("--long-description-bytes", type=int, default=220, help="Threshold for long description candidates.")
    parser.add_argument("--limit", type=int, default=25, help="Maximum candidates shown per section.")
    return parser


def validate_args(args: argparse.Namespace) -> None:
    checks = (
        (args.months >= 1, "--months must be positive"),
        (args.max_log_mb >= 1, "--max-log-mb must be positive"),
        (args.context_tokens >= 1, "--context-tokens must be positive"),
        (0 < args.budget_percent <= 100, "--budget-percent must be greater than 0 and at most 100"),
        (args.long_description_bytes >= 0, "--long-description-bytes must not be negative"),
        (args.limit >= 0, "--limit must not be negative"),
    )
    for valid, message in checks:
        if not valid:
            raise InputError("invalid-option", message)


def emit_json(command: str, data: dict[str, Any]) -> None:
    print(
        json.dumps(
            {
                "ok": True,
                "version": VERSION,
                "command": [command],
                "data": data,
            },
            indent=2,
            sort_keys=True,
        )
    )


def emit_error(command: str, error: InputError, *, as_json: bool) -> int:
    if as_json:
        payload: dict[str, Any] = {
            "ok": False,
            "version": VERSION,
            "command": [command],
            "error": {"code": error.code, "message": str(error)},
        }
        if error.details is not None:
            payload["error"]["details"] = error.details
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print(f"portfolio-health: error: {error}", file=sys.stderr)
    return 2


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    try:
        validate_args(args)
        if args.command == "doctor":
            data = doctor()
            if args.json:
                emit_json("doctor", data)
            else:
                print(f"portfolio-health {VERSION}")
                print(f"python: {data['python']}")
                print(f"codex: {data['codex'] or 'not found'}")
                print("network: not required")
            return 0

        report = build_report(args)
        if args.json:
            emit_json("scan", report)
        else:
            print_text(report)
        return 0
    except InputError as error:
        return emit_error(args.command, error, as_json=args.json)


if __name__ == "__main__":
    raise SystemExit(main())
