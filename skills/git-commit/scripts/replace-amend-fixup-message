#!/usr/bin/env python3
"""Replace an amend-fixup message while preserving Git's target matcher."""

from __future__ import annotations

import os
import sys
from pathlib import Path


MESSAGE_ENV = "G_AMEND_MESSAGE_FILE"


def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)


def main() -> None:
    if len(sys.argv) != 2:
        fail("expected the Git commit-message path")

    replacement_value = os.environ.get(MESSAGE_ENV)
    if not replacement_value:
        fail(f"{MESSAGE_ENV} must name the replacement message file")

    edit_path = Path(sys.argv[1])
    replacement_path = Path(replacement_value)

    try:
        generated_lines = edit_path.read_text(encoding="utf-8").splitlines()
        replacement = replacement_path.read_text(encoding="utf-8").rstrip()
    except (OSError, UnicodeError) as error:
        fail(str(error))

    if not generated_lines or not generated_lines[0].startswith("amend! "):
        fail("Git did not generate an amend-fixup matcher")
    if not replacement or not replacement.splitlines()[0].strip():
        fail("replacement message must begin with a non-empty subject")
    if replacement.splitlines()[0].startswith("amend! "):
        fail("replacement message must omit the amend-fixup matcher")

    matcher = generated_lines[0].rstrip()
    try:
        edit_path.write_text(f"{matcher}\n\n{replacement}\n", encoding="utf-8")
    except (OSError, UnicodeError) as error:
        fail(str(error))


if __name__ == "__main__":
    main()
